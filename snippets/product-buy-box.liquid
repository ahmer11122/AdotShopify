{% doc %}
  Product Buy Box
  - Header block: breadcrumb, title, price (sale shown as a plain percentage + strike), one-line summary
  - Size scale: one connected ruler of cells with a single indicator that slides to the choice
  - Add to bag: a single state machine (needs-size / ready / sold-out / loading / done) with a
    rolling label, a price on the right, and an inversion sweep on hover
  - Trust rows use the three theme-editor reassurance settings (title + subtitle)
  - Native <details> accordions, exclusive, with animated height where supported
  - Real stock only: "Only N left" appears when inventory is tracked and <= 3

  @param {product} product - The product object
  @param {section} section - The parent section
{% enddoc %}

{%- liquid
  assign adot_title = product.title
  assign adot_category = product.type
  assign adot_price = product.price
  assign adot_compare_at = product.compare_at_price | default: 0
  assign adot_image = product.featured_image | image_url: width: 1200
  assign adot_description = product.description

  assign is_on_sale = false
  assign discount_pct = 0
  if adot_compare_at > adot_price
    assign is_on_sale = true
    assign discount_diff = adot_compare_at | minus: adot_price
    assign discount_pct = discount_diff | times: 100.0 | divided_by: adot_compare_at | round
  endif

  assign only_default = false
  if product.has_only_default_variant or product.variants.size == 1
    assign only_default = true
  endif

  assign has_size_option = false
  for option in product.options_with_values
    assign option_lower = option.name | downcase
    if option_lower contains 'size'
      assign has_size_option = true
    endif
  endfor
-%}
{% capture adot_price_formatted %}{% render 'money', price: adot_price %}{% endcapture %}
{% assign adot_price_formatted = adot_price_formatted | strip %}
{% capture adot_compare_formatted %}{% render 'money', price: adot_compare_at %}{% endcapture %}
{% assign adot_compare_formatted = adot_compare_formatted | strip %}

<div class="product-buy-box" id="ProductBuyBox-{{ section.id }}" data-product-buy-box>
  <nav class="product-buy-box__crumbs" aria-label="Breadcrumb" style="--i:0">
    <a href="{{ routes.all_products_collection_url }}">Shop</a>
    {%- if adot_category != blank -%}
      <span class="product-buy-box__crumb-sep" aria-hidden="true"></span>
      <a href="{{ adot_category | url_for_type }}">{{ adot_category }}</a>
    {%- endif -%}
  </nav>

  <h1 class="product-buy-box__title" style="--i:1">{{ adot_title | default: product.title }}</h1>

  <div class="product-buy-box__price" id="ProductPrice-{{ section.id }}" data-price-root style="--i:2">
    <span class="product-buy-box__price-now{% if is_on_sale %} is-sale{% endif %}" data-price-now>{{ adot_price_formatted }}</span>
    <s class="product-buy-box__price-was" data-price-was{% unless is_on_sale %} hidden{% endunless %}>{{ adot_compare_formatted }}</s>
    <span class="product-buy-box__price-off" data-price-off{% unless is_on_sale %} hidden{% endunless %}>{% if is_on_sale %}−{{ discount_pct }}%{% endif %}</span>
  </div>

  {%- liquid
    assign clean_desc = adot_description | default: product.description | strip_html | strip | split: '. ' | first | remove_last: '.'
  -%}
  {%- if clean_desc != blank -%}
    <p class="product-buy-box__summary" style="--i:3">{{ clean_desc }}.</p>
  {%- endif -%}

  {%- assign size_guide_cat = adot_category | downcase | default: 'hoodies' -%}

  <form
    method="post"
    action="{{ routes.cart_add_url }}"
    id="ProductForm-{{ section.id }}"
    class="product-buy-box__form"
    novalidate="novalidate"
  >
    <input type="hidden" name="id" value="" id="ProductVariantInput-{{ section.id }}" required>
    <input type="hidden" name="properties[_adot_title]" value="{{ adot_title | default: product.title | escape }}">
    <input type="hidden" name="properties[_adot_image]" value="{{ adot_image }}">
    <input type="hidden" name="properties[_adot_price]" value="{{ adot_price_formatted }}">
    <input type="hidden" name="properties[_adot_category]" value="{{ adot_category | default: 'Essentials' | escape }}">
    <input type="hidden" name="properties[Size]" value="" id="ProductSizeProperty-{{ section.id }}">

    {%- unless only_default -%}
      <div class="product-buy-box__options" id="ProductOptions-{{ section.id }}" style="--i:4">
        {%- for option in product.options_with_values -%}
          {%- liquid
            assign option_name_lower = option.name | downcase
            assign is_size_option = false
            if option_name_lower contains 'size'
              assign is_size_option = true
            endif
            assign cols = option.values.size
            if cols > 6
              assign cols = 5
            endif
          -%}
          {%- if option_name_lower contains 'color' or option_name_lower contains 'colour' -%}
            {%- continue -%}
          {%- endif -%}

          <fieldset class="product-buy-box__option-group" data-option-index="{{ forloop.index0 }}">
            <legend class="visually-hidden">{{ option.name }}</legend>

            <div class="product-buy-box__option-header">
              <span class="product-buy-box__option-label" aria-hidden="true">
                <span>{{ option.name }}</span>
                <span class="product-buy-box__option-selected" data-option-selected-label>Select</span>
              </span>

              {%- if is_size_option -%}
                <button
                  type="button"
                  class="product-buy-box__size-guide-trigger"
                  data-open-size-guide
                  data-size-category="{{ size_guide_cat }}"
                  aria-haspopup="dialog"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="6" width="20" height="12"></rect>
                    <path d="M6 6v5M10 6v3M14 6v5M18 6v3"></path>
                  </svg>
                  <span>Size guide</span>
                </button>
              {%- endif -%}
            </div>

            <div class="product-buy-box__sizes" role="radiogroup" aria-label="{{ option.name }}" style="--cols:{{ cols }}">
              <span class="product-buy-box__sizes-indicator" aria-hidden="true"></span>
              {%- for value in option.values -%}
                {%- liquid
                  assign option_available = false
                  for variant in product.variants
                    if variant.options[forloop.parentloop.index0] == value and variant.available
                      assign option_available = true
                      break
                    endif
                  endfor
                -%}
                <button
                  type="button"
                  role="radio"
                  aria-checked="false"
                  class="product-buy-box__size{% unless option_available %} is-sold-out{% endunless %}"
                  data-option-name="{{ option.name }}"
                  data-option-value="{{ value | escape }}"
                  tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                  {% unless option_available %}
                    aria-disabled="true"
                    aria-label="{{ value | escape }}, sold out"
                  {% endunless %}
                >
                  <span class="product-buy-box__size-text">{{ value }}</span>
                  {%- unless option_available -%}
                    <span class="product-buy-box__sold-out-slash" aria-hidden="true"></span>
                  {%- endunless -%}
                </button>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      </div>
    {%- endunless -%}

    <div class="product-buy-box__stock-notice" id="StockNotice-{{ section.id }}" hidden>
      <span class="product-buy-box__stock-pulse" aria-hidden="true"></span>
      <span data-stock-text></span>
    </div>

    <div class="product-buy-box__error" id="ProductAlert-{{ section.id }}" role="alert" hidden></div>

    <div class="product-buy-box__actions" style="--i:5">
      <button
        type="submit"
        name="add"
        class="product-buy-box__submit-btn"
        id="AddToCartBtn-{{ section.id }}"
        data-state="{% if only_default %}ready{% else %}needs-size{% endif %}"
        aria-disabled="{% if only_default %}false{% else %}true{% endif %}"
      >
        <span class="product-buy-box__btn-fill" aria-hidden="true"></span>
        <span class="product-buy-box__btn-main">
          <span class="product-buy-box__btn-text" data-btn-label>{% if only_default %}Add to bag{% elsif has_size_option %}Select a size{% else %}Select an option{% endif %}</span>
          <span class="product-buy-box__btn-icon" aria-hidden="true">
            <svg class="product-buy-box__btn-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M1.5 8h13M14.5 8L9 2.5M14.5 8L9 13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <svg class="product-buy-box__btn-check" width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M2.5 8.5l3.5 3.5 7.5-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </span>
        <span class="product-buy-box__btn-price" data-btn-price>{{ adot_price_formatted }}</span>
        <span class="product-buy-box__btn-loader" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="9" stroke-dasharray="42" stroke-dashoffset="14"></circle>
          </svg>
        </span>
      </button>

      {%- if section.settings.show_whatsapp_button -%}
        {%- assign wa_phone = section.settings.whatsapp_number | default: '923131707080' -%}
        <button
          type="button"
          class="product-buy-box__whatsapp-btn"
          id="WhatsAppBtn-{{ section.id }}"
          data-phone="{{ wa_phone }}"
          data-product-title="{{ adot_title | default: product.title | escape }}"
          data-product-price="{{ adot_price_formatted }}"
          data-product-url="{{ shop.url }}{{ product.url }}"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Order on WhatsApp</span>
        </button>
      {%- endif -%}
    </div>
  </form>

  {%- if section.settings.show_trust_strip -%}
    <ul class="product-buy-box__trust" aria-label="Order guarantees" style="--i:6">
      <li class="product-buy-box__trust-item">
        <svg class="product-buy-box__trust-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="2" y="5" width="20" height="14"></rect>
          <path d="M2 10h20M6 15h4"></path>
        </svg>
        <span class="product-buy-box__trust-copy">
          <span class="product-buy-box__trust-title">{{ section.settings.trust_badge_1_title | default: 'Cash on Delivery' }}</span>
          <span class="product-buy-box__trust-sub">{{ section.settings.trust_badge_1_subtitle }}</span>
        </span>
      </li>
      <li class="product-buy-box__trust-item">
        <svg class="product-buy-box__trust-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
          <path d="M21 3v5h-5"></path>
          <path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
          <path d="M3 21v-5h5"></path>
        </svg>
        <span class="product-buy-box__trust-copy">
          <span class="product-buy-box__trust-title">{{ section.settings.trust_badge_2_title | default: '7-Day Easy Exchange' }}</span>
          <span class="product-buy-box__trust-sub">{{ section.settings.trust_badge_2_subtitle }}</span>
        </span>
      </li>
      <li class="product-buy-box__trust-item">
        <svg class="product-buy-box__trust-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="1" y="4" width="14" height="12"></rect>
          <path d="M15 8h4l3 3v5h-7"></path>
          <circle cx="5.5" cy="18.5" r="2"></circle>
          <circle cx="18" cy="18.5" r="2"></circle>
        </svg>
        <span class="product-buy-box__trust-copy">
          <span class="product-buy-box__trust-title">{{ section.settings.trust_badge_3_title | default: '2–4 Day Delivery' }}</span>
          <span class="product-buy-box__trust-sub">{{ section.settings.trust_badge_3_subtitle }}</span>
        </span>
      </li>
    </ul>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="product-buy-box__accordions" style="--i:7">
      {%- for block in section.blocks -%}
        {%- if block.type == 'accordion' and block.settings.content != blank -%}
          <details class="product-accordion" name="pdp-info-{{ section.id }}" {{ block.shopify_attributes }}>
            <summary class="product-accordion__summary">
              <span>{{ block.settings.title }}</span>
              <span class="product-accordion__icon" aria-hidden="true"></span>
            </summary>
            <div class="product-accordion__content">
              <p>{{ block.settings.content }}</p>
            </div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  <span class="visually-hidden" role="status" aria-live="polite" data-sr-status></span>

  <script type="application/json" id="ProductVariants-{{ section.id }}">
    {{ product.variants | json }}
  </script>
</div>

<style>
  .product-buy-box {
    --pdp-line: oklch(0 0 0 / 0.1);
    interpolate-size: allow-keywords;
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .product-buy-box [hidden] {
    display: none !important;
  }

  /* ---------------------------------------------------------------- Choreography
     One staggered entrance on arrival: 60ms between groups, transform + opacity only. */
  @media (prefers-reduced-motion: no-preference) {
    .product-buy-box > :not(form):not(script):not([role='status']),
    .product-buy-box__form > * {
      animation: pdp-rise 560ms var(--ease-out) both;
      animation-delay: calc(var(--i, 0) * 60ms + 120ms);
    }

    [data-pdp-vt] .product-buy-box > :not(form):not(script):not([role='status']),
    [data-pdp-vt] .product-buy-box__form > * {
      animation-delay: calc(var(--i, 0) * 60ms + 420ms);
    }
  }

  @keyframes pdp-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ------------------------------------------------------------- Header block */
  .product-buy-box__crumbs {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle, #6b6b6b);
  }

  .product-buy-box__crumbs a {
    color: inherit;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .product-buy-box__crumbs a:last-child {
    color: var(--color-text, #111);
  }

  .product-buy-box__crumb-sep {
    width: 1rem;
    height: 1px;
    background: currentColor;
    opacity: 0.5;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-buy-box__crumbs a:hover {
      color: var(--color-text, #111);
      opacity: 1;
    }
  }

  .product-buy-box__title {
    margin: 1rem 0 0;
    font-family: var(--font-display, inherit);
    font-size: clamp(1.875rem, 8.2vw, 2.25rem);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: var(--color-text, #111);
  }

  .product-buy-box__price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin-top: 1rem;
    font-variant-numeric: tabular-nums;
  }

  .product-buy-box__price-now {
    font-family: var(--font-display, inherit);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-text, #111);
  }

  .product-buy-box__price-now.is-sale {
    color: var(--color-sale, #991b1b);
  }

  .product-buy-box__price-was {
    font-size: 1rem;
    color: var(--color-text-subtle, #6b6b6b);
    text-decoration-thickness: 1px;
  }

  .product-buy-box__price-off {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-sale, #991b1b);
  }

  .product-buy-box__summary {
    max-width: 44ch;
    margin: 1rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-muted, #555);
    text-wrap: pretty;
  }

  /* -------------------------------------------------------------- Size scale */
  .product-buy-box__form {
    display: flex;
    flex-direction: column;
  }

  .product-buy-box__options {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .product-buy-box__option-group {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  .product-buy-box__option-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .product-buy-box__option-label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.625rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text, #111);
  }

  .product-buy-box__option-selected {
    font-weight: 400;
    color: var(--color-text-subtle, #6b6b6b);
    transition: color 160ms ease;
  }

  .product-buy-box__option-group.has-selection .product-buy-box__option-selected {
    color: var(--color-text, #111);
  }

  .product-buy-box__size-guide-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    margin-block: -0.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-text-muted, #555);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    text-decoration-color: oklch(0 0 0 / 0.25);
    transition: color 150ms ease, text-decoration-color 150ms ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-buy-box__size-guide-trigger:hover {
      color: var(--color-text, #111);
      text-decoration-color: currentColor;
    }
  }

  /* A ruler: shared hairlines, one indicator that travels between cells */
  .product-buy-box__sizes {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
    border-top: 1px solid var(--color-border-strong, #8a8a8a);
    border-left: 1px solid var(--color-border-strong, #8a8a8a);
    background: var(--color-background, #fff);
  }

  .product-buy-box__sizes-indicator {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    background: var(--color-btn-bg, #111);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 340ms var(--ease-drawer),
      opacity 160ms var(--ease-out);
  }

  .product-buy-box__sizes-indicator.is-on {
    opacity: 1;
  }

  .product-buy-box__size {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 3.25rem;
    min-width: 0;
    padding: 0;
    border: 0;
    border-right: 1px solid var(--color-border-strong, #8a8a8a);
    border-bottom: 1px solid var(--color-border-strong, #8a8a8a);
    background: transparent;
    color: var(--color-text, #111);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      color 200ms var(--ease-out),
      background-color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .product-buy-box__size:active:not(.is-sold-out) {
    transform: scale(0.96);
  }

  .product-buy-box__size.is-selected {
    color: var(--color-btn-text, #fff);
  }

  @media (hover: hover) and (pointer: fine) {
    .product-buy-box__size:hover:not(.is-sold-out):not(.is-selected) {
      background-color: var(--color-surface, #f5f5f5);
    }
  }

  .product-buy-box__size.is-sold-out {
    color: var(--color-text-subtle, #6b6b6b);
    cursor: not-allowed;
  }

  .product-buy-box__size.is-sold-out .product-buy-box__size-text {
    opacity: 0.55;
  }

  .product-buy-box__sold-out-slash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top right,
      transparent calc(50% - 0.5px),
      var(--color-border-strong, #8a8a8a) calc(50% - 0.5px),
      var(--color-border-strong, #8a8a8a) calc(50% + 0.5px),
      transparent calc(50% + 0.5px)
    );
    opacity: 0.7;
  }

  /* Missing size: ruler turns oxblood, one short nudge */
  .product-buy-box__option-group.has-error .product-buy-box__sizes {
