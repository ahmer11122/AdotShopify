            <span class="product-buy-box__trust-sub">{{ section.settings.trust_badge_3_subtitle }}</span>
          {% endif %}
        </div>
      </div>
    </div>
  {% endif %}

  <!-- Minimal Collapsed Disclosures (Clean & Calm) -->
  {% if section.blocks.size > 0 %}
    <div class="product-buy-box__accordions">
      {% for block in section.blocks %}
        {% if block.type == 'accordion' and block.settings.content != blank %}
          <details class="product-accordion" {{ block.shopify_attributes }}>
            <summary class="product-accordion__summary">
              <span>{{ block.settings.title }}</span>
              <span class="product-accordion__icon" aria-hidden="true">+</span>
            </summary>
            <div class="product-accordion__content">
              <p>{{ block.settings.content }}</p>
            </div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  {% endif %}

  <!-- Real Variants JSON for JS state matching -->
  <script type="application/json" id="ProductVariants-{{ section.id }}">
    {{ product.variants | json }}
  </script>
</div>

