{% doc %}
  Product Buy Box Snippet
  - Breadcrumbs & Title
  - Dynamic PKR Price
  - Real Shopify Variant Selector (No pre-selected size)
  - Native Size Guide Trigger
  - Instant Add to Bag with AJAX Cart Drawer Integration
  - Direct WhatsApp Order Button with prefilled details
  - Reassurance Strip (Configurable via Theme Editor)
  - Native <details> / <summary> Accordions (Zero-JS)

  @param {product} product - The product object
  @param {section} section - The parent section
{% enddoc %}

<div class="product-buy-box" id="ProductBuyBox-{{ section.id }}" data-product-buy-box>
  <!-- Breadcrumbs -->
  <nav class="product-breadcrumbs text-micro" aria-label="Breadcrumb">
    <ol class="product-breadcrumbs__list">
      <li class="product-breadcrumbs__item">
        <a href="{{ routes.root_url }}">Home</a>
      </li>
      <li class="product-breadcrumbs__sep" aria-hidden="true">/</li>
      {% if collection %}
        <li class="product-breadcrumbs__item">
          <a href="{{ collection.url }}">{{ collection.title }}</a>
        </li>
        <li class="product-breadcrumbs__sep" aria-hidden="true">/</li>
      {% elsif product.type != blank %}
        <li class="product-breadcrumbs__item">
          <span>{{ product.type }}</span>
        </li>
        <li class="product-breadcrumbs__sep" aria-hidden="true">/</li>
      {% endif %}
      <li class="product-breadcrumbs__item product-breadcrumbs__item--active" aria-current="page">
        {{ product.title }}
      </li>
    </ol>
  </nav>

  <!-- Product Category Eyebrow & Metafield Specs (Only shown if real data exists) -->
  {% assign has_specs = false %}
  {% if product.metafields.custom.fabric != blank or product.metafields.custom.gsm != blank or product.metafields.custom.fit != blank %}
    {% assign has_specs = true %}
  {% endif %}

  {% if has_specs %}
    <div class="product-buy-box__specs text-micro">
      {% if product.metafields.custom.fabric != blank %}
        <span class="product-buy-box__spec-item">{{ product.metafields.custom.fabric }}</span>
      {% endif %}
      {% if product.metafields.custom.gsm != blank %}
        <span class="product-buy-box__spec-dot" aria-hidden="true">•</span>
        <span class="product-buy-box__spec-item">{{ product.metafields.custom.gsm }} GSM</span>
      {% endif %}
      {% if product.metafields.custom.fit != blank %}
        <span class="product-buy-box__spec-dot" aria-hidden="true">•</span>
        <span class="product-buy-box__spec-item">{{ product.metafields.custom.fit }}</span>
      {% endif %}
    </div>
  {% endif %}

  <!-- Title & Price -->
  <h1 class="product-buy-box__title">{{ product.title }}</h1>

  <div class="product-buy-box__price" id="ProductPrice-{{ section.id }}">
    {% render 'price', product: product, use_variant: true %}
    <span class="product-buy-box__tax-note text-micro">Taxes included. Cash on Delivery available nationwide.</span>
  </div>

  <!-- Determine Size Guide Category Tab based on Product context -->
  {% assign product_type_lower = product.type | downcase %}
  {% assign product_title_lower = product.title | downcase %}
  {% assign size_guide_cat = 'hoodies' %}
  {% if product_type_lower contains 'shirt' or product_title_lower contains 'shirt' %}
    {% assign size_guide_cat = 'shirts' %}
  {% elsif product_type_lower contains 'trouser' or product_title_lower contains 'trouser' or product_type_lower contains 'pant' %}
    {% assign size_guide_cat = 'trousers' %}
  {% endif %}

  <!-- Native Shopify Product Form -->
  <form
    method="post"
    action="{{ routes.cart_add_url }}"
    id="ProductForm-{{ section.id }}"
    class="product-buy-box__form"
    novalidate="novalidate"
  >
    <!-- Hidden variant input — starts EMPTY until buyer selects a size -->
    <input type="hidden" name="id" value="" id="ProductVariantInput-{{ section.id }}" required>

    <!-- Variant Options (Sizes / Colors) -->
    {% unless product.has_only_default_variant %}
      <div class="product-buy-box__options" id="ProductOptions-{{ section.id }}">
        {% for option in product.options_with_values %}
          {% assign option_name_lower = option.name | downcase %}
          {% assign is_size_option = false %}
          {% if option_name_lower contains 'size' %}
            {% assign is_size_option = true %}
          {% endif %}

          <fieldset class="product-buy-box__option-group" data-option-index="{{ forloop.index0 }}">
            <div class="product-buy-box__option-header">
              <legend class="product-buy-box__option-label text-micro">
                <span>{{ option.name | upcase }}:</span>
                <span class="product-buy-box__option-selected" data-option-selected-label>
                  {% if is_size_option %}Select a size{% else %}Select {{ option.name | downcase }}{% endif %}
                </span>
              </legend>

              {% if is_size_option %}
                <button
                  type="button"
                  class="product-buy-box__size-guide-trigger text-micro"
                  data-open-size-guide
                  data-size-category="{{ size_guide_cat }}"
                  aria-haspopup="dialog"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="5" width="20" height="14" rx="0"></rect>
                    <line x1="6" y1="5" x2="6" y2="10"></line>
                    <line x1="10" y1="5" x2="10" y2="8"></line>
                    <line x1="14" y1="5" x2="14" y2="10"></line>
                    <line x1="18" y1="5" x2="18" y2="8"></line>
                  </svg>
                  <span>Size Guide</span>
                </button>
              {% endif %}
            </div>

            <!-- Options Pills -->
            <div class="product-buy-box__option-values" role="radiogroup" aria-label="{{ option.name }}">
              {% for value in option.values %}
                {% comment %}Check if all variants with this option value are sold out{% endcomment %}
                {% assign option_available = false %}
                {% for variant in product.variants %}
                  {% if variant.options[forloop.parentloop.index0] == value and variant.available %}
                    {% assign option_available = true %}
                    {% break %}
                  {% endif %}
                {% endfor %}

                <button
                  type="button"
                  class="product-buy-box__pill text-micro {% unless option_available %}is-sold-out{% endunless %}"
                  data-option-name="{{ option.name }}"
                  data-option-value="{{ value | escape }}"
                  {% unless option_available %}
                    aria-disabled="true"
                  {% endunless %}
                >
                  <span>{{ value }}</span>
                  {% unless option_available %}
                    <span class="product-buy-box__sold-out-slash" aria-hidden="true"></span>
                  {% endunless %}
                </button>
              {% endfor %}
            </div>
          </fieldset>
        {% endfor %}
      </div>
    {% endunless %}

    <!-- Inventory Low-Stock Indicator (Only shown if real stock is tracked and <= 3) -->
    <div class="product-buy-box__stock-notice text-micro" id="StockNotice-{{ section.id }}" hidden>
      <span class="product-buy-box__stock-pulse" aria-hidden="true"></span>
      <span data-stock-text></span>
    </div>

    <!-- Error / Validation Alert Box -->
    <div class="product-buy-box__error text-micro" id="ProductAlert-{{ section.id }}" role="alert" aria-live="polite" hidden></div>

    <!-- Actions Area: Add to Bag & WhatsApp Direct Order -->
    <div class="product-buy-box__actions">
      <!-- Add to Bag CTA (Disabled until size is picked) -->
      <button
        type="submit"
        name="add"
        class="product-buy-box__submit-btn"
        id="AddToCartBtn-{{ section.id }}"
        disabled
        aria-disabled="true"
      >
        <span class="product-buy-box__btn-text" data-btn-label>
          {% if product.has_only_default_variant %}
            ADD TO BAG — {{ product.price | money }}
          {% else %}
            SELECT A SIZE
          {% endif %}
        </span>
        <span class="product-buy-box__btn-loader" aria-hidden="true" hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" stroke-dasharray="40" stroke-dashoffset="10"></circle>
          </svg>
        </span>
      </button>

      <!-- WhatsApp Direct Order Button -->
      {% if section.settings.show_whatsapp_button %}
        {% assign wa_phone = section.settings.whatsapp_number | default: '923131707080' %}
        <button
          type="button"
          class="product-buy-box__whatsapp-btn text-micro"
          id="WhatsAppBtn-{{ section.id }}"
          data-phone="{{ wa_phone }}"
          data-product-title="{{ product.title | escape }}"
          data-product-price="{{ product.price | money }}"
          data-product-url="{{ shop.url }}{{ product.url }}"
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>ORDER VIA WHATSAPP (CASH ON DELIVERY)</span>
        </button>
      {% endif %}
    </div>
  </form>

  <!-- Reassurance Strip (Configured in Theme Editor) -->
  {% if section.settings.show_trust_strip %}
    <div class="product-buy-box__trust-strip">
      <div class="product-buy-box__trust-item">
        <svg class="product-buy-box__trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <rect x="2" y="4" width="20" height="16" rx="0"></rect>
          <line x1="2" y1="10" x2="22" y2="10"></line>
        </svg>
        <div class="product-buy-box__trust-text">
          <strong>{{ section.settings.trust_badge_1_title | default: 'Cash on Delivery' }}</strong>
          <span>{{ section.settings.trust_badge_1_subtitle | default: 'Pay at your doorstep' }}</span>
        </div>
      </div>

      <div class="product-buy-box__trust-item">
        <svg class="product-buy-box__trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
          <path d="M21 3v5h-5"></path>
          <path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
          <path d="M3 21v-5h5"></path>
        </svg>
        <div class="product-buy-box__trust-text">
          <strong>{{ section.settings.trust_badge_2_title | default: '7-Day Easy Exchange' }}</strong>
          <span>{{ section.settings.trust_badge_2_subtitle | default: 'Hassle-free size replacement' }}</span>
        </div>
      </div>

      <div class="product-buy-box__trust-item">
        <svg class="product-buy-box__trust-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
          <rect x="1" y="3" width="15" height="13"></rect>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon>
          <circle cx="5.5" cy="18.5" r="2.5"></circle>
          <circle cx="18.5" cy="18.5" r="2.5"></circle>
        </svg>
        <div class="product-buy-box__trust-text">
          <strong>{{ section.settings.trust_badge_3_title | default: '2–4 Day Delivery' }}</strong>
          <span>{{ section.settings.trust_badge_3_subtitle | default: 'Fast dispatch across Pakistan' }}</span>
        </div>
      </div>
    </div>
  {% endif %}

  <!-- Product Description & Native <details> Accordions (Zero JS) -->
  <div class="product-buy-box__accordions">
    {% if product.description != blank %}
      <details class="product-accordion" open>
        <summary class="product-accordion__summary text-micro">
          <span>PRODUCT DETAILS</span>
          <span class="product-accordion__icon" aria-hidden="true">+</span>
        </summary>
        <div class="product-accordion__content">
          <div class="product-description-rte">
            {{ product.description }}
          </div>
        </div>
      </details>
    {% endif %}

    <!-- Schema Blocks for Accordions (Customizable by merchant) -->
    {% for block in section.blocks %}
      {% if block.type == 'accordion' %}
        {% assign content = block.settings.content %}
        {% comment %}If block has a metafield key set, try pulling from product metafields{% endcomment %}
        {% if block.settings.metafield_key != blank %}
          {% assign mf_parts = block.settings.metafield_key | split: '.' %}
          {% if mf_parts.size == 2 %}
            {% assign mf_val = product.metafields[mf_parts[0]][mf_parts[1]] %}
            {% if mf_val != blank %}
              {% assign content = mf_val %}
            {% endif %}
          {% endif %}
        {% endif %}

        {% if content != blank %}
          <details class="product-accordion" {{ block.shopify_attributes }}>
            <summary class="product-accordion__summary text-micro">
              <span>{{ block.settings.title | upcase }}</span>
              <span class="product-accordion__icon" aria-hidden="true">+</span>
            </summary>
            <div class="product-accordion__content">
              <p>{{ content }}</p>
            </div>
          </details>
        {% endif %}
      {% endif %}
    {% endfor %}
  </div>

  <!-- Real Variants JSON for JS state matching -->
  <script type="application/json" id="ProductVariants-{{ section.id }}">
    {{ product.variants | json }}
  </script>
</div>

<style>
  .product-buy-box {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Breadcrumbs */
  .product-breadcrumbs {
    color: var(--color-text-subtle);
  }

  .product-breadcrumbs__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
  }

  .product-breadcrumbs__item a {
    color: var(--color-text-subtle);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .product-breadcrumbs__item a:hover {
    color: var(--color-text);
  }

  .product-breadcrumbs__item--active {
    color: var(--color-text);
  }

  .product-breadcrumbs__sep {
    color: var(--color-border-strong);
    opacity: 0.5;
  }

  /* Specs Eyebrow */
  .product-buy-box__specs {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-text-subtle);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-buy-box__spec-dot {
    opacity: 0.5;
  }

  /* Title & Price */
  .product-buy-box__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 500;
    line-height: 1.15;
    margin: 0;
    color: var(--color-text);
  }

  .product-buy-box__price {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1.25rem;
  }

  .product-buy-box__tax-note {
    color: var(--color-text-subtle);
  }

  /* Variant Selection Options */
  .product-buy-box__options {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .product-buy-box__option-group {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .product-buy-box__option-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .product-buy-box__option-label {
    margin: 0;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text);
    display: inline-flex;
    gap: 0.35rem;
  }

  .product-buy-box__option-selected {
    color: var(--color-text-muted);
  }

  .product-buy-box__size-guide-trigger {
    background: transparent;
    border: none;
    padding: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-text-muted);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
    letter-spacing: 0.04em;
    transition: color 150ms ease;
  }

  .product-buy-box__size-guide-trigger:hover {
    color: var(--color-text);
  }

  .product-buy-box__option-values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Size & Variant Pills */
  .product-buy-box__pill {
    position: relative;
    border: 1px solid var(--color-border);
    background-color: var(--color-background);
    color: var(--color-text);
    padding: 0.625rem 1.125rem;
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: all 180ms ease;
    min-width: 48px;
    text-align: center;
    border-radius: var(--radius-none, 0px);
    -webkit-tap-highlight-color: transparent;
  }

  .product-buy-box__pill:hover:not(.is-sold-out) {
    border-color: var(--color-text);
  }

  .product-buy-box__pill.is-selected {
    background-color: var(--color-btn-bg, #111111);
    color: var(--color-btn-text, #FFFFFF);
    border-color: var(--color-btn-bg, #111111);
  }

  .product-buy-box__pill.is-sold-out {
    opacity: 0.4;
    cursor: not-allowed;
    background-color: var(--color-surface);
    border-color: var(--color-border);
  }

  .product-buy-box__sold-out-slash {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .product-buy-box__sold-out-slash::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background-color: var(--color-text-muted);
    transform: rotate(-25deg);
  }

  /* Attention / Shake animation for missing size */
  @keyframes shake-pulse {
    0%, 100% { transform: translateX(0); }
    20%, 60% { transform: translateX(-4px); }
    40%, 80% { transform: translateX(4px); }
  }

  .product-buy-box__option-group.has-error .product-buy-box__pill {
    border-color: var(--color-sale, #991B1B);
    animation: shake-pulse 300ms ease;
  }

  /* Low stock indicator */
  .product-buy-box__stock-notice {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-sale, #991B1B);
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .product-buy-box__stock-pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-sale, #991B1B);
    animation: pulse 1.5s infinite;
  }

  @keyframes pulse {
    0% { transform: scale(0.95); opacity: 0.8; }
    50% { transform: scale(1.35); opacity: 1; }
    100% { transform: scale(0.95); opacity: 0.8; }
  }

  /* Inline Error */
  .product-buy-box__error {
    color: var(--color-sale, #991B1B);
    background-color: rgba(153, 27, 27, 0.06);
    padding: 0.625rem 0.875rem;
    border-left: 2px solid var(--color-sale, #991B1B);
  }

  /* Action Buttons */
  .product-buy-box__actions {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: 0.5rem;
  }

  .product-buy-box__submit-btn {
    width: 100%;
    padding: 1rem 1.5rem;
    background-color: var(--color-btn-bg, #111111);
    color: var(--color-btn-text, #FFFFFF);
    border: none;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 180ms ease, opacity 180ms ease;
    border-radius: var(--radius-none, 0px);
    min-height: 52px;
  }

  .product-buy-box__submit-btn:hover:not(:disabled) {
    background-color: var(--color-btn-hover-bg, #333333);
  }

  .product-buy-box__submit-btn:disabled {
    background-color: var(--color-btn-disabled-bg, #F5F5F5);
    color: var(--color-btn-disabled-text, #A3A3A3);
    cursor: not-allowed;
  }

  /* WhatsApp Order Button */
  .product-buy-box__whatsapp-btn {
    width: 100%;
    padding: 0.875rem 1.25rem;
    background-color: transparent;
    color: var(--color-text, #111111);
    border: 1px solid var(--color-border-strong, #8A8A8A);
    font-family: var(--font-body);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    transition: all 180ms ease;
    border-radius: var(--radius-none, 0px);
    min-height: 48px;
  }

  .product-buy-box__whatsapp-btn:hover {
    border-color: var(--color-text);
    background-color: var(--color-surface);
  }

  /* Trust Strip */
  .product-buy-box__trust-strip {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.875rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding: 1.25rem 0;
  }

  @media (min-width: 480px) {
    .product-buy-box__trust-strip {
      grid-template-columns: repeat(3, 1fr);
      gap: 0.75rem;
    }
  }

  .product-buy-box__trust-item {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
  }

  .product-buy-box__trust-icon {
    flex-shrink: 0;
    color: var(--color-text);
    margin-top: 2px;
  }

  .product-buy-box__trust-text {
    display: flex;
    flex-direction: column;
    font-family: var(--font-body);
  }

  .product-buy-box__trust-text strong {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--color-text);
  }

  .product-buy-box__trust-text span {
    font-size: 0.6875rem;
    color: var(--color-text-subtle);
    line-height: 1.3;
    margin-top: 1px;
  }

  /* Native <details> Accordions (Zero JS) */
  .product-buy-box__accordions {
    display: flex;
    flex-direction: column;
  }

  .product-accordion {
    border-bottom: 1px solid var(--color-border);
  }

  .product-accordion__summary {
    padding: 1.125rem 0;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    list-style: none;
    font-family: var(--font-body);
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--color-text);
    user-select: none;
  }

  .product-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .product-accordion__icon {
    font-size: 1.25rem;
    line-height: 1;
    font-weight: 300;
    transition: transform 200ms ease;
  }

  .product-accordion[open] .product-accordion__icon {
    transform: rotate(45deg);
  }

  .product-accordion__content {
    padding-bottom: 1.25rem;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .product-accordion__content p {
    margin: 0;
  }

  .product-description-rte {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }
</style>

<script>
  (function() {
    const buyBox = document.getElementById('ProductBuyBox-{{ section.id }}');
    if (!buyBox) return;

    const variantsDataEl = document.getElementById('ProductVariants-{{ section.id }}');
    if (!variantsDataEl) return;

    let variants = [];
    try {
      variants = JSON.parse(variantsDataEl.textContent);
    } catch (e) {
      console.error('Failed to parse variant data', e);
    }

    const form = document.getElementById('ProductForm-{{ section.id }}');
    const variantInput = document.getElementById('ProductVariantInput-{{ section.id }}');
    const addToCartBtn = document.getElementById('AddToCartBtn-{{ section.id }}');
    const btnLabel = addToCartBtn ? addToCartBtn.querySelector('[data-btn-label]') : null;
    const btnLoader = addToCartBtn ? addToCartBtn.querySelector('.product-buy-box__btn-loader') : null;
    const alertBox = document.getElementById('ProductAlert-{{ section.id }}');
    const stockNotice = document.getElementById('StockNotice-{{ section.id }}');
    const stockText = stockNotice ? stockNotice.querySelector('[data-stock-text]') : null;
    const whatsAppBtn = document.getElementById('WhatsAppBtn-{{ section.id }}');

    // Currently selected options map: { "0": "M", "1": "Black" }
    const selectedOptions = {};

    // Check if product only has 1 default variant
    const hasOnlyDefaultVariant = {% if product.has_only_default_variant %}true{% else %}false{% endif %};
    if (hasOnlyDefaultVariant && variants.length > 0) {
      variantInput.value = variants[0].id;
      addToCartBtn.disabled = !variants[0].available;
      addToCartBtn.removeAttribute('aria-disabled');
    }

    // Handle Option Pill clicks
    const pillButtons = buyBox.querySelectorAll('.product-buy-box__pill');
    pillButtons.forEach(pill => {
      pill.addEventListener('click', () => {
        if (pill.classList.contains('is-sold-out')) return;

        const group = pill.closest('.product-buy-box__option-group');
        if (!group) return;

        group.classList.remove('has-error');
        if (alertBox) alertBox.hidden = true;

        const optionIndex = group.dataset.optionIndex;
        const val = pill.dataset.optionValue;

        // Deselect other pills in same group
        group.querySelectorAll('.product-buy-box__pill').forEach(p => p.classList.remove('is-selected'));
        pill.classList.add('is-selected');

        // Update selected option label text
        const label = group.querySelector('[data-option-selected-label]');
        if (label) label.textContent = val;

        selectedOptions[optionIndex] = val;

        // Check if all options are selected
        const totalOptions = buyBox.querySelectorAll('.product-buy-box__option-group').length;
        const selectedCount = Object.keys(selectedOptions).length;

        if (selectedCount === totalOptions) {
          // Find matching variant
          const matchedVariant = variants.find(variant => {
            return variant.options.every((optVal, idx) => selectedOptions[idx.toString()] === optVal);
          });

          if (matchedVariant) {
            onVariantSelected(matchedVariant);
          } else {
            onVariantUnavailable();
          }
        }
      });
    });

    function onVariantSelected(variant) {
      variantInput.value = variant.id;

      // Update URL with ?variant= without reload
      const url = new URL(window.location);
      url.searchParams.set('variant', variant.id);
      window.history.replaceState({}, '', url);

      // Dispatch global variant:change event for gallery & sticky bar
      window.dispatchEvent(new CustomEvent('variant:change', {
        detail: {
          variant: variant,
          mediaId: variant.featured_media ? variant.featured_media.id : (variant.featured_image ? variant.featured_image.id : null)
        }
      }));

      // Update stock notice (real data only, never invented)
      if (stockNotice && stockText) {
        if (variant.inventory_management && variant.inventory_quantity > 0 && variant.inventory_quantity <= 3) {
          stockText.textContent = `Only ${variant.inventory_quantity} left in this size`;
          stockNotice.hidden = false;
        } else {
          stockNotice.hidden = true;
        }
      }

      // Update Button State
      if (variant.available) {
        addToCartBtn.disabled = false;
        addToCartBtn.removeAttribute('aria-disabled');
        if (btnLabel) {
          const formattedPrice = formatMoney(variant.price);
          btnLabel.textContent = `ADD TO BAG — ${formattedPrice}`;
        }
      } else {
        addToCartBtn.disabled = true;
        addToCartBtn.setAttribute('aria-disabled', 'true');
        if (btnLabel) btnLabel.textContent = 'SOLD OUT';
      }
    }

    function onVariantUnavailable() {
      variantInput.value = '';
      addToCartBtn.disabled = true;
      addToCartBtn.setAttribute('aria-disabled', 'true');
      if (btnLabel) btnLabel.textContent = 'UNAVAILABLE';
      if (stockNotice) stockNotice.hidden = true;
    }

    function formatMoney(cents) {
      // Formats cents into PKR or store currency format
      const amount = (cents / 100).toLocaleString('en-PK', { maximumFractionDigits: 0 });
      return `Rs. ${amount}`;
    }

    // Helper: Highlight size option if user tries to order without choosing size
    function requireSizeSelection() {
      const sizeGroup = buyBox.querySelector('.product-buy-box__option-group');
      if (sizeGroup) {
        sizeGroup.classList.add('has-error');
        sizeGroup.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      if (alertBox) {
        alertBox.textContent = 'Please select your size before proceeding.';
        alertBox.hidden = false;
      }
    }

    // Add To Bag AJAX Submission
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        // Validate size selection
        if (!variantInput.value) {
          requireSizeSelection();
          return;
        }

        // Show loading spinner
        if (addToCartBtn) {
          addToCartBtn.disabled = true;
          if (btnLoader) btnLoader.hidden = false;
        }

        const formData = new FormData();
        formData.append('id', variantInput.value);
        formData.append('quantity', 1);

        fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST',
          headers: { 'Accept': 'application/json' },
          body: formData
        })
        .then(res => {
          if (!res.ok) {
            return res.json().then(errData => {
              throw new Error(errData.description || 'Could not add item to bag.');
            });
          }
          return res.json();
        })
        .then(item => {
          if (alertBox) alertBox.hidden = true;
          // Refresh and open cart drawer
          window.dispatchEvent(new CustomEvent('cart:refresh'));
          window.dispatchEvent(new CustomEvent('cart:open'));
        })
        .catch(err => {
          if (alertBox) {
            alertBox.textContent = err.message || 'Something went wrong. Please try again.';
            alertBox.hidden = false;
          }
        })
        .finally(() => {
          if (addToCartBtn) {
            addToCartBtn.disabled = false;
            if (btnLoader) btnLoader.hidden = true;
          }
        });
      });
    }

    // WhatsApp Order Button
    if (whatsAppBtn) {
      whatsAppBtn.addEventListener('click', () => {
        if (!variantInput.value) {
          requireSizeSelection();
          return;
        }

        const phone = whatsAppBtn.dataset.phone;
        const title = whatsAppBtn.dataset.productTitle;
        const selectedSize = selectedOptions["0"] || 'Standard';
        const price = whatsAppBtn.dataset.productPrice;
        const url = window.location.href;

        const message = `Hi ADOT, I'd like to order *${title}* in Size *${selectedSize}* (Price: ${price}).\nLink: ${url}\nPayment Method: Cash on Delivery.`;
        const encoded = encodeURIComponent(message);
        const waUrl = `https://wa.me/${phone}?text=${encoded}`;

        window.open(waUrl, '_blank');
      });
    }

    // Listen for sticky-bar add triggers
    window.addEventListener('pdp:sticky-add', () => {
      if (!variantInput.value) {
        requireSizeSelection();
      } else if (form) {
        form.requestSubmit();
      }
    });
  })();
</script>
