    .product-buy-box__price-now {
      font-size: 1.5rem;
    }

    .product-buy-box__summary {
      margin-top: 1.25rem;
    }

    .product-buy-box__options {
      margin-top: 2.5rem;
    }

    .product-buy-box__actions {
      margin-top: 1.75rem;
    }

    .product-buy-box__trust {
      margin-top: 2.5rem;
    }
