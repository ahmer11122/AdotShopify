{% doc %}
  Product Buy Box Snippet
  - Breadcrumbs & Title
  - Dynamic PKR Price
  - Real Shopify Variant Selector (No pre-selected size)
  - Native Size Guide Trigger
  - Instant Add to Bag with AJAX Cart Drawer Integration
  - Direct WhatsApp Order Button with prefilled details
  - Reassurance Strip (Configurable via Theme Editor)
  - Native <details> / <summary> Accordions (Zero-JS)

  @param {product} product - The product object
  @param {section} section - The parent section
{% enddoc %}

{% liquid
  assign is_snowboard = false
  if product.type contains 'snowboard' or product.title contains 'Snowboard' or product.handle contains 'snowboard' or product.handle contains 'ski-wax'
    assign is_snowboard = true
  endif

  assign hoodie_img = 'category-hoodies.jpg' | asset_url
  assign hoodie_png = 'category-hoodies.png' | asset_url
  assign shirt_img = 'category-shirts.jpg' | asset_url
  assign shirt_png = 'category-shirts.png' | asset_url
  assign trouser_img = 'category-trousers.jpg' | asset_url
  assign trouser_png = 'category-trousers.png' | asset_url

  assign adot_title = product.title
  assign adot_category = product.type
  assign adot_price = product.price
  assign adot_price_formatted = adot_price | money_without_currency | remove: '.00' | prepend: 'Rs. '
  assign adot_compare_at = product.compare_at_price | default: 0
  assign adot_image = product.featured_image | image_url: width: 1200
  assign adot_secondary_image = product.images[1] | image_url: width: 1200
  assign adot_fabric = product.metafields.custom.fabric
  assign adot_fit = product.metafields.custom.fit
  assign adot_description = product.description

  if is_snowboard
    case product.handle
      when 'the-complete-snowboard'
        assign adot_title = 'Heavyweight Boxy Hoodie'
        assign adot_category = 'Hoodies'
        assign adot_price = 449900
        assign adot_price_formatted = 'Rs. 4,499'
        assign adot_compare_at = 0
        assign adot_image = hoodie_img
        assign adot_secondary_image = hoodie_png
        assign adot_fabric = '450 GSM Loopback Fleece'
        assign adot_fit = 'Boxy Relaxed Silhouette'
        assign adot_description = 'Engineered from custom-knitted 450 GSM combed cotton loopback fleece. Featuring double-lined hood architecture, dropped shoulders, and pre-shrunk construction for zero post-wash distortion.'
      when 'the-collection-snowboard-hydrogen'
        assign adot_title = 'Relaxed Poplin Shirt'
        assign adot_category = 'Shirts'
        assign adot_price = 369900
        assign adot_price_formatted = 'Rs. 3,699'
        assign adot_compare_at = 449900
        assign adot_image = shirt_img
        assign adot_secondary_image = shirt_png
        assign adot_fabric = '100% Crisp Long-Staple Cotton'
        assign adot_fit = 'Casual Relaxed Fit'
        assign adot_description = 'Crafted from breathable 100% long-staple cotton poplin. Cut with a modern dropped shoulder, clean French placket, and curved hem suitable for untucked everyday styling.'
      when 'the-collection-snowboard-liquid'
        assign adot_title = 'Tailored Pleated Trousers'
        assign adot_category = 'Trousers'
        assign adot_price = 429900
        assign adot_price_formatted = 'Rs. 4,299'
        assign adot_compare_at = 0
        assign adot_image = trouser_img
        assign adot_secondary_image = trouser_png
        assign adot_fabric = 'High-Density Cotton Twill'
        assign adot_fit = 'Relaxed Straight Cut'
        assign adot_description = 'Structured high-density cotton twill trousers with subtle double front pleats. Designed with a clean straight leg, slant pockets, and tailored waistband for effortless versatility.'
      when 'the-collection-snowboard-oxygen'
        assign adot_title = 'Heavyweight Zip Hoodie'
        assign adot_category = 'Hoodies'
        assign adot_price = 489900
        assign adot_price_formatted = 'Rs. 4,899'
        assign adot_compare_at = 0
        assign adot_image = hoodie_img
        assign adot_secondary_image = hoodie_png
        assign adot_fabric = '450 GSM Heavy Fleece'
        assign adot_fit = 'Relaxed Dropped Shoulder'
        assign adot_description = 'Full-zip luxury hoodie crafted from 450 GSM loopback cotton fleece. Featuring dual custom oxidized metal zippers, ribbed cuffs, and seamless kangaroo pockets.'
      when 'the-compare-at-price-snowboard'
        assign adot_title = 'Oversized Oxford Button-Down'
        assign adot_category = 'Shirts'
        assign adot_price = 389900
        assign adot_price_formatted = 'Rs. 3,899'
        assign adot_compare_at = 450000
        assign adot_image = shirt_img
        assign adot_secondary_image = shirt_png
        assign adot_fabric = 'Heavyweight Oxford Weave'
        assign adot_fit = 'Oversized Silhouette'
        assign adot_description = 'Vintage-inspired heavyweight Oxford weave with a substantial hand feel. Designed with dropped shoulders, chest pocket, and mother-of-pearl finish buttons.'
      when 'selling-plans-ski-wax'
        assign adot_title = 'Wide-Leg Minimalist Chino'
        assign adot_category = 'Trousers'
        assign adot_price = 399900
        assign adot_price_formatted = 'Rs. 3,999'
        assign adot_compare_at = 0
        assign adot_image = trouser_img
        assign adot_secondary_image = trouser_png
        assign adot_fabric = 'Brushed Cotton Chino Twill'
        assign adot_fit = 'Wide Leg Straight Hem'
        assign adot_description = 'Minimalist wide-leg chinos crafted from pre-washed brushed cotton. Clean front waistband with concealed fastening and generous hem break.'
      when 'the-inventory-not-tracked-snowboard'
        assign adot_title = 'Heavyweight Loopback Crewneck'
        assign adot_category = 'Hoodies'
        assign adot_price = 399900
        assign adot_price_formatted = 'Rs. 3,999'
        assign adot_compare_at = 0
        assign adot_image = hoodie_img
        assign adot_secondary_image = hoodie_png
        assign adot_fabric = '450 GSM Unbrushed Cotton'
        assign adot_fit = 'Boxy Crewneck Fit'
        assign adot_description = 'Essential boxy crewneck sweatshirt in 450 GSM heavyweight cotton. Ribbed collar, cuffs, and hem with reinforced flatlock stitching.'
      when 'the-3p-fulfilled-snowboard'
        assign adot_title = 'Double-Pleat Cotton Chino'
        assign adot_category = 'Trousers'
        assign adot_price = 419900
        assign adot_price_formatted = 'Rs. 4,199'
        assign adot_compare_at = 0
        assign adot_image = trouser_img
        assign adot_secondary_image = trouser_png
        assign adot_fabric = 'Custom Weave Twill'
        assign adot_fit = 'Relaxed Tapered Leg'
        assign adot_description = 'Modern pleated chinos tailored from structured cotton twill. Designed with gentle taper towards the ankle and reinforced pocket welts.'
      when 'the-multi-location-snowboard'
        assign adot_title = 'Oversized Fleece Pullover'
        assign adot_category = 'Hoodies'
        assign adot_price = 469900
        assign adot_price_formatted = 'Rs. 4,699'
        assign adot_compare_at = 0
        assign adot_image = hoodie_img
        assign adot_secondary_image = hoodie_png
        assign adot_fabric = '450 GSM Combed Fleece'
        assign adot_fit = 'Oversized Pullover Fit'
        assign adot_description = 'Premium pullover hoodie featuring an exaggerated hood, dropped shoulders, and minimal seamlines for a clean silhouette.'
      when 'the-multi-managed-snowboard'
        assign adot_title = 'Structured Twill Overshirt'
        assign adot_category = 'Shirts'
        assign adot_price = 419900
        assign adot_price_formatted = 'Rs. 4,199'
        assign adot_compare_at = 0
        assign adot_image = shirt_img
        assign adot_secondary_image = shirt_png
        assign adot_fabric = 'Heavy Structured Twill'
        assign adot_fit = 'Boxy Overshirt Cut'
        assign adot_description = 'Heavyweight cotton overshirt designed for transitional layering. Dual flap chest pockets, horn buttons, and square bottom hem.'
      when 'the-videographer-snowboard'
        assign adot_title = 'Relaxed Straight Trousers'
        assign adot_category = 'Trousers'
        assign adot_price = 449900
        assign adot_price_formatted = 'Rs. 4,499'
        assign adot_compare_at = 0
        assign adot_image = trouser_img
        assign adot_secondary_image = trouser_png
        assign adot_fabric = 'Heavy Italian-style Twill'
        assign adot_fit = 'Straight Leg Fit'
        assign adot_description = 'Relaxed straight trousers with clean tailoring lines and minimal hardware. Comfortable mid-rise with belt loops and hidden zip fly.'
      when 'the-out-of-stock-snowboard'
        assign adot_title = 'Relaxed Camp Collar Shirt'
        assign adot_category = 'Shirts'
        assign adot_price = 379900
        assign adot_price_formatted = 'Rs. 3,799'
        assign adot_compare_at = 0
        assign adot_image = shirt_img
        assign adot_secondary_image = shirt_png
        assign adot_fabric = 'Soft Washed Poplin'
        assign adot_fit = 'Boxy Cuban Collar'
        assign adot_description = 'Relaxed camp collar short sleeve shirt tailored in soft washed poplin cotton.'
      else
        assign adot_title = 'Heavyweight Boxy Hoodie'
        assign adot_category = 'Hoodies'
        assign adot_price = 449900
        assign adot_price_formatted = 'Rs. 4,499'
        assign adot_compare_at = 0
        assign adot_image = hoodie_img
        assign adot_secondary_image = hoodie_png
        assign adot_fabric = '450 GSM Loopback Fleece'
        assign adot_fit = 'Boxy Relaxed Fit'
        assign adot_description = 'Engineered from custom-knitted 450 GSM combed cotton loopback fleece.'
    endcase
  endif

  assign is_on_sale = false
  assign discount_pct = 0
  if adot_compare_at > adot_price
    assign is_on_sale = true
    assign discount_diff = adot_compare_at | minus: adot_price
    assign discount_pct = discount_diff | times: 100.0 | divided_by: adot_compare_at | round
  endif

  assign price_clean = adot_price | money_without_currency | remove: '.00'
  assign compare_clean = adot_compare_at | money_without_currency | remove: '.00'
%}

<div class="product-buy-box" id="ProductBuyBox-{{ section.id }}" data-product-buy-box>
  <!-- Calm Luxury Category -->
  <div class="product-buy-box__category">
    <span>{{ adot_category | default: product.type | default: 'Essentials' | upcase }}</span>
  </div>

  <!-- Product Title -->
  <h1 class="product-buy-box__title">{{ adot_title | default: product.title }}</h1>

  <!-- Clean Price Row with Frosted Glass Status Badge -->
  <div class="product-buy-box__price-row" id="ProductPrice-{{ section.id }}">
    <div class="product-buy-box__price-container">
      <div class="price {% if is_on_sale %}price--on-sale{% endif %}">
        <div class="price__container">
          {% if is_on_sale %}
            <span class="price__item price__item--sale">
              <span class="price__currency">Rs.</span><span class="price__amount">{{ price_clean }}</span>
            </span>
            <s class="price__item price__item--regular">Rs. {{ compare_clean }}</s>
          {% else %}
            <span class="price__item price__item--regular">
              <span class="price__currency">Rs.</span><span class="price__amount">{{ price_clean }}</span>
            </span>
          {% endif %}
        </div>
      </div>

      {% if is_on_sale %}
        <span class="product-buy-box__badge product-buy-box__badge--sale" aria-label="{{ discount_pct }}% discount">
          <span class="product-buy-box__badge-dot product-buy-box__badge-dot--sale"></span>
          <span>Sale</span>
          {% if discount_pct > 0 %}
            <span class="product-buy-box__badge-divider" aria-hidden="true">&middot;</span>
            <span class="product-buy-box__badge-pct">-{{ discount_pct }}%</span>
          {% endif %}
        </span>
      {% endif %}
    </div>
  </div>


  <!-- Determine Size Guide Category Tab based on Product context -->
  {% assign size_guide_cat = adot_category | downcase | default: 'hoodies' %}

  <!-- Native Shopify Product Form -->
  <form
    method="post"
    action="{{ routes.cart_add_url }}"
    id="ProductForm-{{ section.id }}"
    class="product-buy-box__form"
    novalidate="novalidate"
  >
    <!-- Hidden variant input — starts EMPTY until buyer selects a size -->
    <input type="hidden" name="id" value="" id="ProductVariantInput-{{ section.id }}" required>

    <!-- Hidden ADOT properties to persist authentic garment details in cart session -->
    <input type="hidden" name="properties[_adot_title]" value="{{ adot_title | default: product.title | escape }}">
    <input type="hidden" name="properties[_adot_image]" value="{{ adot_image }}">
    <input type="hidden" name="properties[_adot_price]" value="{{ adot_price_formatted }}">
    <input type="hidden" name="properties[_adot_category]" value="{{ adot_category | default: 'Essentials' | escape }}">
    <input type="hidden" name="properties[Size]" value="" id="ProductSizeProperty-{{ section.id }}">

    <!-- Variant Options (Sizes / Colors) -->
    {% if is_snowboard %}
      <div class="product-buy-box__options" id="ProductOptions-{{ section.id }}">
        <fieldset class="product-buy-box__option-group" data-option-index="0">
          <div class="product-buy-box__option-header">
            <legend class="product-buy-box__option-label text-micro">
              <span>SIZE:</span>
              <span class="product-buy-box__option-selected" data-option-selected-label>Select a size</span>
            </legend>

            <button
              type="button"
              class="product-buy-box__size-guide-trigger text-micro"
              data-open-size-guide
              data-size-category="{{ size_guide_cat }}"
              aria-haspopup="dialog"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2" y="5" width="20" height="14" rx="0"></rect>
                <line x1="6" y1="5" x2="6" y2="10"></line>
                <line x1="10" y1="5" x2="10" y2="8"></line>
                <line x1="14" y1="5" x2="14" y2="10"></line>
                <line x1="18" y1="5" x2="18" y2="8"></line>
              </svg>
              <span>Size Guide</span>
            </button>
          </div>

          <!-- Authentic ADOT Apparel Sizes -->
          <div class="product-buy-box__option-values" role="radiogroup" aria-label="Size">
            {% assign apparel_sizes = 'S,M,L,XL' | split: ',' %}
            {% assign base_variant = product.selected_or_first_available_variant | default: product.variants.first %}
            {% for sz in apparel_sizes %}
              {% assign variant_for_sz = product.variants[forloop.index0] | default: base_variant %}
              <button
                type="button"
                class="product-buy-box__pill text-micro"
                data-option-name="Size"
                data-option-value="{{ sz }}"
                data-variant-id="{{ variant_for_sz.id }}"
              >
                <span>{{ sz }}</span>
              </button>
            {% endfor %}
          </div>
        </fieldset>
      </div>
    {% elsif product.has_only_default_variant == false %}
      <div class="product-buy-box__options" id="ProductOptions-{{ section.id }}">
        {% for option in product.options_with_values %}
          {% assign option_name_lower = option.name | downcase %}
          {% if option_name_lower contains 'color' or option_name_lower contains 'colour' %}
            {% continue %}
          {% endif %}
          {% assign is_size_option = false %}
          {% if option_name_lower contains 'size' %}
            {% assign is_size_option = true %}
          {% endif %}

          <fieldset class="product-buy-box__option-group" data-option-index="{{ forloop.index0 }}">
            <div class="product-buy-box__option-header">
              <legend class="product-buy-box__option-label text-micro">
                <span>{{ option.name | upcase }}:</span>
                <span class="product-buy-box__option-selected" data-option-selected-label>
                  {% if is_size_option %}Select a size{% else %}Select {{ option.name | downcase }}{% endif %}
                </span>
              </legend>

              {% if is_size_option %}
                <button
                  type="button"
                  class="product-buy-box__size-guide-trigger text-micro"
                  data-open-size-guide
                  data-size-category="{{ size_guide_cat }}"
                  aria-haspopup="dialog"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="2" y="5" width="20" height="14" rx="0"></rect>
                    <line x1="6" y1="5" x2="6" y2="10"></line>
                    <line x1="10" y1="5" x2="10" y2="8"></line>
                    <line x1="14" y1="5" x2="14" y2="10"></line>
                    <line x1="18" y1="5" x2="18" y2="8"></line>
                  </svg>
                  <span>Size Guide</span>
                </button>
              {% endif %}
            </div>

            <!-- Options Pills -->
            <div class="product-buy-box__option-values" role="radiogroup" aria-label="{{ option.name }}">
              {% for value in option.values %}
                {% assign option_available = false %}
                {% for variant in product.variants %}
                  {% if variant.options[forloop.parentloop.index0] == value and variant.available %}
                    {% assign option_available = true %}
                    {% break %}
                  {% endif %}
                {% endfor %}

                <button
                  type="button"
                  class="product-buy-box__pill text-micro {% unless option_available %}is-sold-out{% endunless %}"
                  data-option-name="{{ option.name }}"
                  data-option-value="{{ value | escape }}"
                  {% unless option_available %}
                    aria-disabled="true"
                  {% endunless %}
                >
                  <span>{{ value }}</span>
                  {% unless option_available %}
                    <span class="product-buy-box__sold-out-slash" aria-hidden="true"></span>
                  {% endunless %}
                </button>
              {% endfor %}
            </div>
          </fieldset>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Inventory Low-Stock Indicator (Only shown if real stock is tracked and <= 3) -->
    <div class="product-buy-box__stock-notice text-micro" id="StockNotice-{{ section.id }}" hidden>
      <span class="product-buy-box__stock-pulse" aria-hidden="true"></span>
      <span data-stock-text></span>
    </div>

    <!-- Error / Validation Alert Box -->
    <div class="product-buy-box__error text-micro" id="ProductAlert-{{ section.id }}" role="alert" aria-live="polite" hidden></div>

    <!-- Actions Area: Add to Bag & WhatsApp Direct Order -->
    <div class="product-buy-box__actions">
      <!-- Add to Bag CTA (Disabled until size is picked) -->
      <button
        type="submit"
        name="add"
        class="product-buy-box__submit-btn"
        id="AddToCartBtn-{{ section.id }}"
        disabled
        aria-disabled="true"
      >
        <span class="product-buy-box__btn-text" data-btn-label>
          {% if product.has_only_default_variant or product.variants.size == 1 %}
            ADD TO BAG — {{ adot_price_formatted | default: default_product_price }}
          {% else %}
            SELECT A SIZE
          {% endif %}
        </span>
        <span class="product-buy-box__btn-loader" aria-hidden="true" hidden>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" stroke-dasharray="40" stroke-dashoffset="10"></circle>
          </svg>
        </span>
      </button>

      <!-- WhatsApp Direct Order Button -->
      {% if section.settings.show_whatsapp_button %}
        {% assign wa_phone = section.settings.whatsapp_number | default: '923131707080' %}
        <button
          type="button"
          class="product-buy-box__whatsapp-btn"
          id="WhatsAppBtn-{{ section.id }}"
          data-phone="{{ wa_phone }}"
          data-product-title="{{ adot_title | default: product.title | escape }}"
          data-product-price="{{ adot_price_formatted | default: default_product_price }}"
          data-product-url="{{ shop.url }}{{ product.url }}"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
          </svg>
          <span>Order via WhatsApp</span>
        </button>
      {% endif %}
    </div>
  </form>

  <!-- Editorial Product Summary (Calm & Positioned Below Primary CTA) -->
  {% assign clean_desc = adot_description | default: product.description | strip_html | truncatewords: 28 %}
  {% if clean_desc != blank %}
    <p class="product-buy-box__summary">{{ clean_desc }}</p>
  {% endif %}

  <!-- Reassurance Strip (Quiet Luxury Responsive Treatment) -->
  {% if section.settings.show_trust_strip %}
    <div class="product-buy-box__trust-strip" aria-label="Order guarantees">
      <div class="product-buy-box__trust-item">
        <span class="product-buy-box__trust-icon-box" aria-hidden="true">
          <svg class="product-buy-box__trust-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="0"></rect>
            <line x1="2" y1="10" x2="22" y2="10"></line>
          </svg>
        </span>
        <div class="product-buy-box__trust-text-group">
          <span class="product-buy-box__trust-title">{{ section.settings.trust_badge_1_title | default: 'Cash on Delivery' }}</span>
          {% if section.settings.trust_badge_1_subtitle != blank %}
            <span class="product-buy-box__trust-sub">{{ section.settings.trust_badge_1_subtitle }}</span>
          {% endif %}
        </div>
      </div>

      <div class="product-buy-box__trust-item">
        <span class="product-buy-box__trust-icon-box" aria-hidden="true">
          <svg class="product-buy-box__trust-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 0 1 15-6.7L21 8"></path>
            <path d="M21 3v5h-5"></path>
            <path d="M21 12a9 9 0 0 1-15 6.7L3 16"></path>
            <path d="M3 21v-5h5"></path>
          </svg>
        </span>
        <div class="product-buy-box__trust-text-group">
          <span class="product-buy-box__trust-title">{{ section.settings.trust_badge_2_title | default: '7-Day Easy Exchange' }}</span>
          {% if section.settings.trust_badge_2_subtitle != blank %}
            <span class="product-buy-box__trust-sub">{{ section.settings.trust_badge_2_subtitle }}</span>
          {% endif %}
        </div>
      </div>

      <div class="product-buy-box__trust-item">
        <span class="product-buy-box__trust-icon-box" aria-hidden="true">
          <svg class="product-buy-box__trust-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="1" y="3" width="15" height="13"></rect>
            <polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon>
            <circle cx="5.5" cy="18.5" r="2.5"></circle>
            <circle cx="18.5" cy="18.5" r="2.5"></circle>
          </svg>
        </span>
        <div class="product-buy-box__trust-text-group">
          <span class="product-buy-box__trust-title">{{ section.settings.trust_badge_3_title | default: '2–4 Day Delivery' }}</span>
