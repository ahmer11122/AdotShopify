                <td data-col="Length"><span class="sg__num"><span class="sg__cm">70</span><span class="sg__in" aria-hidden="true">27.6</span></span></td>
                <td data-col="Shoulder"><span class="sg__num"><span class="sg__cm">52</span><span class="sg__in" aria-hidden="true">20.5</span></span></td>
                <td data-col="Sleeve"><span class="sg__num"><span class="sg__cm">89</span><span class="sg__in" aria-hidden="true">35.0</span></span></td>
                <td class="sg__act">
                  <button type="button" class="sg__pick" data-sg-pick aria-label="Select size L">
                    <span class="sg__pick-text">Select</span>
