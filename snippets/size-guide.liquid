                  <span class="sg__unit" aria-hidden="true"><span class="sg__cm">cm</span><span class="sg__in">in</span></span>
                </th>
                <th scope="col" class="sg__act-head"><span class="visually-hidden">Action</span></th>
              </tr>
            </thead>
            <tbody>
              <tr class="sg__row" data-keys="M">
                <th scope="row"><span class="sg__size">M</span></th>
                <td data-col="Chest"><span class="sg__num"><span class="sg__cm">55</span><span class="sg__in" aria-hidden="true">21.7</span></span></td>
                <td data-col="Length"><span class="sg__num"><span class="sg__cm">68</span><span class="sg__in" aria-hidden="true">26.8</span></span></td>
                <td data-col="Shoulder"><span class="sg__num"><span class="sg__cm">50</span><span class="sg__in" aria-hidden="true">19.7</span></span></td>
                <td data-col="Sleeve"><span class="sg__num"><span class="sg__cm">87</span><span class="sg__in" aria-hidden="true">34.3</span></span></td>
