                  <line x1="120" y1="20" x2="120" y2="205" stroke="currentColor" stroke-width="1.75" stroke-dasharray="3 3"/>
                  <circle cx="120" cy="20" r="2.5" fill="currentColor"/>
                  <circle cx="120" cy="205" r="2.5" fill="currentColor"/>
                  <rect x="110" y="115" width="20" height="20" rx="10" fill="var(--pdp-paper, #fff)" stroke="currentColor" stroke-width="1"/>
