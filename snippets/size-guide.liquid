                <!-- Measurement line 1: Chest (Pit to pit) -->
                <g class="sg__m-line" data-measure="Chest">
                  <line x1="62" y1="95" x2="178" y2="95" stroke="currentColor" stroke-width="1.75" stroke-dasharray="3 3"/>
                  <circle cx="62" cy="95" r="2.5" fill="currentColor"/>
                  <circle cx="178" cy="95" r="2.5" fill="currentColor"/>
