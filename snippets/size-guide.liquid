                  <rect x="110" y="52" width="20" height="20" rx="10" fill="var(--pdp-paper, #fff)" stroke="currentColor" stroke-width="1"/>
                  <text x="120" y="66" text-anchor="middle" font-size="10" font-weight="600" fill="currentColor">3</text>
                </g>

                <!-- Measurement line 4: Sleeve -->
                <g class="sg__m-line" data-measure="Sleeve">
                  <line x1="120" y1="20" x2="225" y2="120" stroke="currentColor" stroke-width="1.75" stroke-dasharray="3 3"/>
                  <circle cx="120" cy="20" r="2.5" fill="currentColor"/>
                  <circle cx="225" cy="120" r="2.5" fill="currentColor"/>
                  <rect x="175" y="58" width="20" height="20" rx="10" fill="var(--pdp-paper, #fff)" stroke="currentColor" stroke-width="1"/>
                  <text x="185" y="72" text-anchor="middle" font-size="10" font-weight="600" fill="currentColor">4</text>
                </g>
              </svg>
            </div>

            <div class="sg__steps-list">
              <button type="button" class="sg__step-btn" data-trigger-measure="Chest">
                <span class="sg__step-num">1</span>
                <div>
                  <strong>Chest:</strong> Measured flat from armpit seam to armpit seam.
