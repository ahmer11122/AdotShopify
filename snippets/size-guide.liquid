{% doc %}
  Size Guide — Luxury Fit Concierge

  - Native <dialog>. Desktop: 34rem side drawer. Mobile: bottom sheet with elastic rubber-band gesture dismiss.
  - Interactive Garment Blueprint (SVG line art) with live column-to-diagram hover highlight sync.
  - Visual Fit Spectrum (Slim -> Regular -> Relaxed -> Oversized) & Model Anchor Specs.
  - Sold-out state handling with balanced status pills.
  - Direct 1-tap size selection with checkmark micro-animation and PDP buy box sync.
  - One data block below (AdotSizeData) drives the tables and live measurements.
  - cm / in flips each number in place (no re-render).
{% enddoc %}

<script type="application/json" id="AdotSizeData">[{"key":"hoodies","label":"Hoodies","cols":["Chest","Length","Shoulder","Sleeve"],"note":"Laid flat, relaxed. Chest is half-chest width. Sleeve measured from center back. Fits true to size for a relaxed silhouette.","rows":[{"size":"M","keys":["M"],"v":[55,68,50,87]},{"size":"L","keys":["L"],"v":[58,70,52,89]},{"size":"XL","keys":["XL"],"v":[61,72,54,91]},{"size":"XXL","keys":["XXL"],"v":[64,74,56,93]}]},{"key":"sweatshirts","label":"Sweatshirts","cols":["Chest","Length","Shoulder","Sleeve"],"note":"Same chart as hoodies. Laid flat, relaxed. Chest is half-chest width. Sleeve measured from center back.","rows":[{"size":"M","keys":["M"],"v":[55,68,50,87]},{"size":"L","keys":["L"],"v":[58,70,52,89]},{"size":"XL","keys":["XL"],"v":[61,72,54,91]},{"size":"XXL","keys":["XXL"],"v":[64,74,56,93]}]},{"key":"trousers","label":"Trousers","cols":["Waist","Inseam","Rise","Opening"],"note":"Relaxed straight leg with a tailored waistband. Order your standard waist size.","rows":[{"size":"30 (S)","keys":["30","S"],"v":[78,76,30,22]},{"size":"32 (M)","keys":["32","M"],"v":[83,77,31,23]},{"size":"34 (L)","keys":["34","L"],"v":[88,78,32,24]},{"size":"36 (XL)","keys":["36","XL"],"v":[93,79,33,25]}]}]</script>

<dialog id="SizeGuideDialog" class="sg" aria-labelledby="SizeGuideTitle" data-unit="cm">
  <div class="sg__sheet" data-sg-sheet>
    <div class="sg__grab" data-sg-grab aria-hidden="true"><i></i></div>

    <header class="sg__head" data-sg-grab>
      <div>
        <h2 id="SizeGuideTitle" class="sg__title">Size & Fit Guide</h2>
        <p class="sg__sub">Garment measurements taken laid flat in relaxed state.</p>
      </div>
      <button type="button" class="sg__close" data-close-size-guide aria-label="Close size guide">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M1.5 1.5l11 11M12.5 1.5l-11 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>
    </header>

    <div class="sg__tools">
      <div class="sg__seg" role="tablist" aria-label="Garment type" data-seg>
        <span class="sg__seg-ind" aria-hidden="true"></span>
        <button
          type="button"
          role="tab"
          id="SgTab-hoodies"
          aria-controls="SgPanel-hoodies"
          aria-selected="true"
          tabindex="0"
          data-tab="hoodies"
        >Hoodies</button>
        <button
          type="button"
          role="tab"
          id="SgTab-sweatshirts"
          aria-controls="SgPanel-sweatshirts"
          aria-selected="false"
          tabindex="-1"
          data-tab="sweatshirts"
        >Sweatshirts</button>
        <button
          type="button"
          role="tab"
          id="SgTab-trousers"
          aria-controls="SgPanel-trousers"
          aria-selected="false"
          tabindex="-1"
          data-tab="trousers"
        >Trousers</button>
      </div>

      <div class="sg__seg" role="radiogroup" aria-label="Units" data-seg>
        <span class="sg__seg-ind" aria-hidden="true"></span>
        <button type="button" role="radio" aria-checked="true" tabindex="0" data-unit-btn="cm">cm</button>
        <button type="button" role="radio" aria-checked="false" tabindex="-1" data-unit-btn="in">in</button>
      </div>
    </div>

    <div class="sg__body">
      <!-- PANEL: HOODIES -->
      <section
        class="sg__panel"
        id="SgPanel-hoodies"
        role="tabpanel"
        aria-labelledby="SgTab-hoodies"
        data-panel="hoodies"
      >
        <!-- Fit Spectrum & Model Anchor -->
        <div class="sg__fit-card">
          <div class="sg__fit-top">
            <span class="sg__fit-label">Silhouette & Fit</span>
            <span class="sg__fit-badge">Boxy Relaxed</span>
          </div>
          <div class="sg__fit-meter" aria-hidden="true">
            <span class="sg__fit-step" data-pos="1">Slim</span>
            <span class="sg__fit-step" data-pos="2">Regular</span>
            <span class="sg__fit-step is-active" data-pos="3">Relaxed</span>
            <span class="sg__fit-step" data-pos="4">Oversized</span>
          </div>
          <div class="sg__model-anchor">
            <svg class="sg__model-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="8" cy="4.5" r="2.5" stroke="currentColor" stroke-width="1.25"/>
              <path d="M3 14c0-2.8 2.2-5 5-5s5 2.2 5 5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
            </svg>
            <span><strong>Model Specs:</strong> 6'1" (185 cm) / 175 lbs (79 kg) wearing size <strong>L</strong>.</span>
          </div>
        </div>

        <!-- Sizing Table -->
        <div class="sg__table-wrap">
          <table class="sg__table">
            <thead>
              <tr>
                <th scope="col">Size</th>
                <th scope="col" data-col="Chest">
                  Chest
                  <span class="sg__unit" aria-hidden="true"><span class="sg__cm">cm</span><span class="sg__in">in</span></span>
                </th>
                <th scope="col" data-col="Length">
