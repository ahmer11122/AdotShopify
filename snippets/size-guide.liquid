<style>
  /* -------------------------------------------------------------------------
     SIZE GUIDE STYLES — LUXURY MINIMALIST FIT CONCIERGE
     ------------------------------------------------------------------------- */
  .sg {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--pdp-ink, #111);
    overflow: hidden;
    overscroll-behavior: none;
    z-index: 9999;
    transition: display 380ms allow-discrete, overlay 380ms allow-discrete;
  }

  /* Backdrop */
  .sg::backdrop {
    background: oklch(0 0 0 / 0);
    transition: background-color 380ms var(--ease-drawer, cubic-bezier(0.32, 0.72, 0, 1));
  }

  .sg[open]::backdrop {
    background: oklch(0 0 0 / 0.44);
  }

  @starting-style {
    .sg[open]::backdrop {
      background: oklch(0 0 0 / 0);
    }
  }

  /* Main Sheet Container */
  .sg__sheet {
    position: absolute;
    display: flex;
    flex-direction: column;
    background: var(--pdp-paper, #fff);
    font-family: var(--pdp-font, inherit);
    transition: transform 380ms var(--ease-drawer, cubic-bezier(0.32, 0.72, 0, 1));
    will-change: transform;
    backface-visibility: hidden;
    contain: layout paint;
  }

  .sg__sheet.is-dragging,
  .sg__sheet.is-prep {
    transition: none;
  }

  /* Mobile: Bottom Sheet */
  @media (max-width: 989px) {
    .sg__sheet {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      max-height: min(88svh, 100%);
      border-radius: 20px 20px 0 0;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      transform: translate3d(0, 0, 0);
      overscroll-behavior: contain;
    }

    .sg__sheet[data-closed] {
      transform: translate3d(0, 100%, 0);
    }
  }

  /* Desktop: Side Sheet (34rem) */
  @media (min-width: 990px) {
    .sg__sheet {
      top: 0;
      right: 0;
      bottom: 0;
      width: min(34rem, 100%);
      transform: translate3d(0, 0, 0);
      border-left: 1px solid var(--pdp-line-2, oklch(0 0 0 / 0.12));
    }

    .sg__sheet[data-closed] {
      transform: translate3d(100%, 0, 0);
    }
  }

  /* Grab handle (Mobile only) */
  .sg__grab {
    display: none;
    justify-content: center;
    padding: 0.75rem 0 0.25rem;
    touch-action: none;
    cursor: grab;
  }

  .sg__grab i {
    display: block;
    width: 2.75rem;
    height: 4px;
    border-radius: 999px;
    background: var(--pdp-line-2, oklch(0 0 0 / 0.22));
  }

  @media (max-width: 989px) {
    .sg__grab {
      display: flex;
    }

    .sg__head {
      touch-action: none;
    }
  }

  /* Header */
  .sg__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1rem, 2.5vw, 1.75rem) clamp(1.25rem, 3vw, 2rem) 0.5rem;
  }

  .sg__title {
    margin: 0;
    font-family: var(--pdp-font-display, inherit);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--pdp-ink, #111);
  }

  .sg__sub {
    margin: 0.375rem 0 0;
    font-size: var(--pdp-fs-small, 0.8125rem);
    line-height: 1.4;
    color: var(--pdp-ink-3, #6b6b6b);
  }

  .sg__close {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    margin: -0.5rem -0.5rem 0 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    border-radius: 50%;
    transition: transform 160ms ease-out, background-color 160ms ease-out;
  }

  .sg__close:active {
    transform: scale(0.94);
  }

  .sg__close:focus-visible {
    outline: 2px solid var(--pdp-ink, #111);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .sg__close:hover {
      background: var(--pdp-sunk, #f5f5f5);
    }
  }

  /* Segmented Controls Toolbar */
  .sg__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem clamp(1.25rem, 3vw, 2rem) 1rem;
    border-bottom: 1px solid var(--pdp-line, oklch(0 0 0 / 0.08));
  }

  .sg__seg {
    position: relative;
    display: inline-flex;
    padding: 3px;
    background: var(--pdp-sunk, #f5f5f5);
    border-radius: 6px;
  }

  .sg__seg-ind {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 0;
    width: 0;
    background: var(--pdp-paper, #fff);
    border-radius: 4px;
    box-shadow: 0 1px 3px oklch(0 0 0 / 0.08), inset 0 0 0 1px var(--pdp-line-2, oklch(0 0 0 / 0.12));
    transition:
      transform 360ms var(--pdp-spring, cubic-bezier(0.34, 1.35, 0.64, 1)),
      width 360ms var(--pdp-spring, cubic-bezier(0.34, 1.35, 0.64, 1));
  }

  .sg__seg-ind.is-still {
    transition: none;
  }

  .sg__seg button {
    position: relative;
    z-index: 1;
    min-height: 2.125rem;
    padding: 0 0.875rem;
    border: 0;
    background: none;
    color: var(--pdp-ink-3, #6b6b6b);
    font-family: var(--pdp-font, inherit);
    font-size: var(--pdp-fs-ui, 0.8125rem);
    font-weight: 500;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    transition: color 180ms ease;
  }

  .sg__seg button[aria-selected='true'],
  .sg__seg button[aria-checked='true'] {
    color: var(--pdp-ink, #111);
    font-weight: 600;
  }

  /* Body Scroll Container */
  .sg__body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.25rem clamp(1.25rem, 3vw, 2rem) clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Fit Card & Spectrum */
  .sg__fit-card {
    padding: 1rem 1.125rem;
    background: var(--pdp-sunk, #fafafa);
    border: 1px solid var(--pdp-line, oklch(0 0 0 / 0.08));
    border-radius: 10px;
  }

  .sg__fit-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .sg__fit-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--pdp-ink-3, #777);
  }

  .sg__fit-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 2px 8px;
    background: var(--pdp-paper, #fff);
    border: 1px solid var(--pdp-line-2, oklch(0 0 0 / 0.16));
    border-radius: 999px;
    color: var(--pdp-ink, #111);
  }

  .sg__fit-meter {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
    position: relative;
    margin-bottom: 0.875rem;
  }

  .sg__fit-step {
    position: relative;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--pdp-ink-3, #777);
    background: oklch(0 0 0 / 0.04);
    border-radius: 4px;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .sg__fit-step.is-active {
    background: var(--pdp-ink, #111);
    color: var(--pdp-paper, #fff);
    font-weight: 600;
    box-shadow: 0 1px 3px oklch(0 0 0 / 0.12);
  }

  .sg__model-anchor {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--pdp-fs-small, 0.78125rem);
    color: var(--pdp-ink-2, #444);
    border-top: 1px solid var(--pdp-line, oklch(0 0 0 / 0.06));
    padding-top: 0.625rem;
  }

  .sg__model-icon {
    flex-shrink: 0;
    color: var(--pdp-ink-3, #777);
  }

  /* Table Wrapping & Structure */
  .sg__table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .sg__table {
    width: 100%;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .sg__table th {
    padding: 0 0.5rem 0.75rem 0;
    text-align: left;
    vertical-align: bottom;
    font-size: var(--pdp-fs-small, 0.75rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--pdp-ink-3, #777);
    transition: color 180ms ease;
  }

  .sg__table th.is-col-active {
    color: var(--pdp-ink, #111);
  }

  .sg__table thead th:first-child,
  .sg__table tbody th {
    width: 4.25rem;
  }

  .sg__table td {
    padding: 0 0.5rem 0 0;
    font-size: var(--pdp-fs-body, 0.9375rem);
    color: var(--pdp-ink, #111);
    transition: background-color 180ms ease;
  }

  .sg__table td.is-col-active {
    background: oklch(0 0 0 / 0.02);
  }

  .sg__row > * {
    height: 3.25rem;
    border-top: 1px solid var(--pdp-line, oklch(0 0 0 / 0.1));
    transition: background-color 180ms ease;
  }

  .sg__row:last-child > * {
    border-bottom: 1px solid var(--pdp-line, oklch(0 0 0 / 0.1));
  }

  .sg__row > :first-child {
    padding-left: 0.625rem;
  }

  .sg__table thead th:first-child {
    padding-left: 0.625rem;
  }

  .sg__size {
    font-family: var(--pdp-font-display, inherit);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--pdp-ink, #111);
  }

  @media (hover: hover) and (pointer: fine) {
    .sg__row:hover > * {
      background: var(--pdp-sunk, #f5f5f5);
    }
  }

  /* Size row currently selected in buy box */
  .sg__row.is-yours > * {
    background: var(--pdp-sunk, #f5f5f5);
  }

  .sg__row.is-yours > :first-child {
    box-shadow: inset 3px 0 0 var(--pdp-ink, #111);
  }

  /* Unit flip numbers */
  .sg__num,
  .sg__unit {
    display: inline-grid;
    overflow: hidden;
    vertical-align: bottom;
  }

  .sg__num > span,
  .sg__unit > span {
    grid-area: 1 / 1;
    transition:
      transform 360ms var(--pdp-ease-expo, cubic-bezier(0.16, 1, 0.3, 1)),
      opacity 220ms ease;
  }

  .sg__unit {
    margin-left: 0.25rem;
    font-weight: 400;
  }

  .sg[data-unit='cm'] .sg__in {
    transform: translateY(110%);
    opacity: 0;
  }

  .sg[data-unit='in'] .sg__cm {
    transform: translateY(-110%);
    opacity: 0;
  }

  /* Actions & Pick Button */
  .sg__act-head {
    width: 1%;
    padding-right: 0 !important;
  }

  .sg__act {
    width: 1%;
    padding-right: 0.5rem !important;
    text-align: right;
    white-space: nowrap;
  }

  .sg__pick {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    height: 2.125rem;
    padding: 0 0.875rem;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: var(--pdp-ink, #111);
    box-shadow: inset 0 0 0 1px var(--pdp-line-2, oklch(0 0 0 / 0.24));
    font-family: var(--pdp-font, inherit);
    font-size: var(--pdp-fs-small, 0.78125rem);
    font-weight: 600;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      box-shadow 160ms ease,
      transform 140ms ease;
  }

  .sg__pick:active {
    transform: scale(0.96);
  }

  .sg__pick-icon {
    display: none;
  }

  .sg__pick.is-selected {
    background: var(--pdp-btn-bg, #111);
    color: var(--pdp-btn-fg, #fff);
    box-shadow: inset 0 0 0 1px var(--pdp-btn-bg, #111);
  }

  .sg__pick.is-selected .sg__pick-icon {
    display: block;
  }

  @media (hover: hover) and (pointer: fine) {
    .sg__pick:hover:not(.is-selected) {
      background: var(--pdp-btn-bg, #111);
      color: var(--pdp-btn-fg, #fff);
      box-shadow: inset 0 0 0 1px var(--pdp-btn-bg, #111);
    }
  }

  .sg__sold-out {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--pdp-ink-3, #888);
    padding: 0.25rem 0.5rem;
    background: oklch(0 0 0 / 0.04);
    border-radius: 4px;
  }

  /* Blueprint Card & Diagram */
  .sg__blueprint-card {
    padding: 1.25rem;
    background: var(--pdp-sunk, #fafafa);
    border: 1px solid var(--pdp-line, oklch(0 0 0 / 0.08));
    border-radius: 12px;
  }

  .sg__blueprint-head {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 1rem;
  }

  .sg__blueprint-title {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--pdp-ink, #111);
  }

  .sg__blueprint-sub {
    font-size: 0.75rem;
    color: var(--pdp-ink-3, #777);
  }

  .sg__blueprint-grid {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 1.25rem;
    align-items: center;
  }

  @media (max-width: 600px) {
    .sg__blueprint-grid {
      grid-template-columns: 1fr;
    }
  }

  .sg__diagram-box {
    background: var(--pdp-paper, #fff);
    border: 1px solid var(--pdp-line, oklch(0 0 0 / 0.08));
    border-radius: 8px;
    padding: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sg__diagram-svg {
    width: 100%;
    max-height: 160px;
    color: var(--pdp-ink, #111);
  }

  .sg__garment-base {
    color: var(--pdp-line-2, oklch(0 0 0 / 0.3));
  }

  .sg__garment-detail {
    color: var(--pdp-line-2, oklch(0 0 0 / 0.18));
  }

  .sg__m-line {
    color: var(--pdp-ink-3, #777);
    transition: color 200ms ease, opacity 200ms ease;
  }

  .sg__m-line.is-active {
    color: var(--pdp-ink, #111);
  }

  .sg__m-line.is-active line {
    stroke-width: 2.25px;
    stroke-dasharray: none;
  }

  .sg__m-line.is-active circle,
  .sg__m-line.is-active rect {
    fill: var(--pdp-ink, #111);
  }

  .sg__m-line.is-active text {
    fill: var(--pdp-paper, #fff);
  }

  /* Step buttons */
  .sg__steps-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .sg__step-btn {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid transparent;
    background: transparent;
    border-radius: 6px;
    text-align: left;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--pdp-ink-2, #444);
    cursor: pointer;
    touch-action: manipulation;
    transition: background-color 160ms ease, border-color 160ms ease;
  }

  .sg__step-btn:hover,
  .sg__step-btn.is-active {
    background: var(--pdp-paper, #fff);
    border-color: var(--pdp-line-2, oklch(0 0 0 / 0.12));
    color: var(--pdp-ink, #111);
  }

  .sg__step-num {
    display: grid;
    place-items: center;
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    border-radius: 50%;
    background: oklch(0 0 0 / 0.08);
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--pdp-ink, #111);
    margin-top: 1px;
  }

  .sg__step-btn.is-active .sg__step-num {
    background: var(--pdp-ink, #111);
    color: var(--pdp-paper, #fff);
  }

  .sg__care-footer {
    padding: 0.875rem 1rem;
    border-left: 2px solid var(--pdp-ink-3, #999);
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--pdp-ink-3, #666);
    background: var(--pdp-sunk, #fafafa);
    border-radius: 0 6px 6px 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .sg,
    .sg::backdrop,
    .sg__sheet,
    .sg__seg-ind,
    .sg__num > span,
    .sg__unit > span,
    .sg__m-line,
    .sg__step-btn {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  (function () {
    const dialog = document.getElementById('SizeGuideDialog');
    if (!dialog) return;

    const sheet = dialog.querySelector('[data-sg-sheet]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = window.matchMedia('(max-width: 989px)');
    const tabs = [...dialog.querySelectorAll('[role="tab"]')];
    const panels = [...dialog.querySelectorAll('.sg__panel')];
    const unitBtns = [...dialog.querySelectorAll('[data-unit-btn]')];
    const segs = [...dialog.querySelectorAll('[data-seg]')];

    let productCat = '';
    let yours = [];

    /* ------------------------------------------------------- sliding thumbs */
    function moveThumb(seg, still) {
      const ind = seg.querySelector('.sg__seg-ind');
      const on = seg.querySelector('[aria-selected="true"], [aria-checked="true"]');
      if (!ind || !on) return;
      if (still) ind.classList.add('is-still');
      ind.style.width = on.offsetWidth + 'px';
      ind.style.transform = 'translateX(' + on.offsetLeft + 'px)';
      if (still) {
        /* Clear is-still after frame paint */
        requestAnimationFrame(() => ind.classList.remove('is-still'));
      }
    }

    function moveAllThumbs(still) {
      segs.forEach((s) => moveThumb(s, still));
    }

    /* ----------------------------------------------------------- categories */
    function setCategory(key, animate) {
      const target = panels.find((p) => p.dataset.panel === key) || panels[0];
      if (!target) return;
      tabs.forEach((t) => {
        const on = t.dataset.tab === target.dataset.panel;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => { p.hidden = p !== target; });
      if (animate && !reduce.matches && target.animate) {
        target.animate(
          [{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'translateY(0)' }],
          { duration: 280, easing: 'cubic-bezier(0.23, 1, 0.32, 1)' }
        );
      }
      moveThumb(tabs[0].parentElement, false);
      refreshRows();
    }

    /* ---------------------------------------------------------------- units */
    function setUnit(unit) {
      dialog.dataset.unit = unit;
      unitBtns.forEach((b) => {
        const on = b.dataset.unitBtn === unit;
        b.setAttribute('aria-checked', on ? 'true' : 'false');
        b.tabIndex = on ? 0 : -1;
      });
      dialog.querySelectorAll('.sg__in').forEach((el) => el.setAttribute('aria-hidden', unit === 'in' ? 'false' : 'true'));
      dialog.querySelectorAll('.sg__num .sg__cm').forEach((el) => el.setAttribute('aria-hidden', unit === 'cm' ? 'false' : 'true'));
      moveThumb(unitBtns[0].parentElement, false);
    }

    /* Arrow keys inside a segmented control */
    function arrowNav(buttons, activate) {
      buttons.forEach((btn) => {
        btn.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          e.preventDefault();
          const step = e.key === 'ArrowRight' ? 1 : -1;
          const next = buttons[(buttons.indexOf(btn) + step + buttons.length) % buttons.length];
          next.focus();
          activate(next);
        });
      });
    }

    tabs.forEach((t) => t.addEventListener('click', () => setCategory(t.dataset.tab, true)));
    unitBtns.forEach((b) => b.addEventListener('click', () => setUnit(b.dataset.unitBtn)));
    arrowNav(tabs, (t) => setCategory(t.dataset.tab, true));
    arrowNav(unitBtns, (b) => setUnit(b.dataset.unitBtn));

    /* ------------------------------------- rows: "your size" + select buttons */
    function findCell(keys) {
      return [...document.querySelectorAll('.pdp-size')].find((c) =>
        keys.some((k) => k === String(c.dataset.optionValue).toUpperCase())
      );
    }

    function refreshRows() {
      panels.forEach((panel) => {
        const isProductPanel = panel.dataset.panel === productCat;
        panel.querySelectorAll('.sg__row').forEach((row) => {
          const keys = row.dataset.keys.split('|').map((k) => k.toUpperCase());
          const isSelected = isProductPanel && keys.some((k) => yours.includes(k));
          row.classList.toggle('is-yours', isSelected);
          
          const pick = row.querySelector('[data-sg-pick]');
          const soldOutBadge = row.querySelector('[data-sg-soldout]');
          const cell = isProductPanel ? findCell(keys) : null;

          if (pick && soldOutBadge) {
            if (!cell) {
              pick.hidden = true;
              soldOutBadge.hidden = true;
            } else if (cell.classList.contains('is-sold-out')) {
              pick.hidden = true;
              soldOutBadge.hidden = false;
            } else {
              pick.hidden = false;
              soldOutBadge.hidden = true;
              pick._cell = cell;
              pick.classList.toggle('is-selected', isSelected);
              const pickText = pick.querySelector('.sg__pick-text');
              if (pickText) pickText.textContent = isSelected ? 'Selected' : 'Select';
            }
          }
        });
      });
    }

    dialog.querySelectorAll('[data-sg-pick]').forEach((pick) => {
      pick.addEventListener('click', () => {
        if (!pick._cell) return;
        pick.classList.add('is-selected');
        const pickText = pick.querySelector('.sg__pick-text');
        if (pickText) pickText.textContent = 'Selected';
        window.dispatchEvent(new CustomEvent('pdp:select-option', { detail: { value: pick._cell.dataset.optionValue } }));
        window.setTimeout(() => requestClose(), reduce.matches ? 0 : 220);
      });
    });

    window.addEventListener('variant:change', (e) => {
      const variant = e.detail && e.detail.variant;
      yours = variant ? variant.options.map((o) => String(o).toUpperCase()) : [];
      refreshRows();
    });

    /* ------------------------------------- column <-> diagram interactive sync */
    panels.forEach((panel) => {
      const diagram = panel.querySelector('.sg__diagram-box');
      if (!diagram) return;

      function highlightMeasure(measureName, active) {
        const lines = panel.querySelectorAll(`.sg__m-line[data-measure="${measureName}"]`);
        const steps = panel.querySelectorAll(`.sg__step-btn[data-trigger-measure="${measureName}"]`);
        const cols = panel.querySelectorAll(`[data-col="${measureName}"]`);

        lines.forEach((l) => l.classList.toggle('is-active', active));
        steps.forEach((s) => s.classList.toggle('is-active', active));
        cols.forEach((c) => c.classList.toggle('is-col-active', active));
      }

      panel.querySelectorAll('[data-col]').forEach((cell) => {
        const col = cell.dataset.col;
        cell.addEventListener('mouseenter', () => highlightMeasure(col, true));
        cell.addEventListener('mouseleave', () => highlightMeasure(col, false));
      });

      panel.querySelectorAll('[data-trigger-measure]').forEach((btn) => {
        const measure = btn.dataset.triggerMeasure;
        btn.addEventListener('mouseenter', () => highlightMeasure(measure, true));
        btn.addEventListener('mouseleave', () => highlightMeasure(measure, false));
        btn.addEventListener('focus', () => highlightMeasure(measure, true));
        btn.addEventListener('blur', () => highlightMeasure(measure, false));
      });
    });

    /* ------------------------------------------------------------ open / close */
    let unlockTimer = 0;
    let closing = false;

    function lockPage() {
      if (window.AdotUI && typeof window.AdotUI.lock === 'function') {
        window.AdotUI.lock('size-guide');
      }
    }

    function unlockPage() {
      if (window.AdotUI && typeof window.AdotUI.unlock === 'function') {
        window.AdotUI.unlock('size-guide');
      }
    }

    function setClosed(on) {
      if (on) sheet.setAttribute('data-closed', '');
      else sheet.removeAttribute('data-closed');
    }

    function open(trigger) {
      productCat = (trigger && trigger.dataset.sizeCategory) || productCat || (panels[0] && panels[0].dataset.panel);
      setCategory(productCat, false);
      setUnit(dialog.dataset.unit || 'cm');
      if (dialog.open) return;
      window.clearTimeout(unlockTimer);
      closing = false;

      sheet.classList.add('is-prep');
      setClosed(true);
      dialog.showModal();
      lockPage();

      const closeBtn = dialog.querySelector('[data-close-size-guide]');
      if (closeBtn && typeof closeBtn.focus === 'function') {
        try { closeBtn.focus({ preventScroll: true }); }
        catch (err) { closeBtn.focus(); }
      }

      requestAnimationFrame(() => {
        sheet.classList.remove('is-prep');
        setClosed(false);
        moveAllThumbs(true);
      });
    }

    function requestClose() {
      if (!dialog.open || closing) return;
      closing = true;
      setClosed(true);
      requestAnimationFrame(() => {
        sheet.style.transform = '';
      });
      const delay = reduce.matches ? 0 : 380;
      window.clearTimeout(unlockTimer);
      unlockTimer = window.setTimeout(() => {
        if (dialog.open) dialog.close();
      }, delay);
    }

    dialog.addEventListener('cancel', (e) => {
      e.preventDefault();
      requestClose();
    });

    dialog.addEventListener('close', () => {
      closing = false;
      setClosed(true);
      sheet.classList.remove('is-prep');
      sheet.style.transform = '';
      unlockPage();
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) requestClose();
    });

    dialog.querySelectorAll('[data-close-size-guide]').forEach((b) => {
      b.addEventListener('click', () => requestClose());
    });

    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-open-size-guide], [data-open-size-modal]');
      if (!trigger) return;
      e.preventDefault();
      open(trigger);
    });

    setClosed(true);

    /* ---------------------- mobile: drag with iOS rubber-band physics & velocity */
    dialog.querySelectorAll('[data-sg-grab]').forEach((handle) => {
      let drag = null;

      handle.addEventListener('pointerdown', (e) => {
        if (!mobile.matches || e.target.closest('button')) return;
        drag = { y: e.clientY, dy: 0, lastY: e.clientY, lastT: performance.now(), v: 0 };
        handle.setPointerCapture(e.pointerId);
        sheet.classList.add('is-dragging');
      });

      handle.addEventListener('pointermove', (e) => {
        if (!drag) return;
        const now = performance.now();
        const rawDy = e.clientY - drag.y;
        
        /* Elastic rubber-band resistance when pulling upwards */
        if (rawDy < 0) {
          drag.dy = -Math.pow(-rawDy, 0.72) * 0.45;
        } else {
          drag.dy = rawDy;
        }

        const dt = Math.max(1, now - drag.lastT);
        drag.v = (e.clientY - drag.lastY) / dt;
        drag.lastY = e.clientY;
        drag.lastT = now;
        sheet.style.transform = 'translate3d(0, ' + drag.dy + 'px, 0)';
      });

      const end = () => {
        if (!drag) return;
        const shouldClose = drag.dy > 100 || drag.v > 0.55;
        drag = null;
        sheet.classList.remove('is-dragging');
        if (shouldClose) {
          requestClose();
        } else {
          sheet.style.transform = '';
        }
      };
      handle.addEventListener('pointerup', end);
      handle.addEventListener('pointercancel', end);
    });

    window.addEventListener('resize', () => { if (dialog.open) moveAllThumbs(true); }, { passive: true });
  })();
</script>
