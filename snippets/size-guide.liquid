              <button type="button" class="sg__step-btn" data-trigger-measure="Sleeve">
                <span class="sg__step-num">4</span>
                <div>
                  <strong>Sleeve:</strong> Measured from center back of neck along sleeve to cuff.
                </div>
              </button>
            </div>
          </div>
        </div>

        <!-- Quality & Care note -->
        <div class="sg__care-footer">
          <p><strong>Fabric Note:</strong> Crafted from 480 GSM organic cotton terry. Pre-washed for zero shrinkage. Machine wash cold, hang dry.</p>
        </div>
