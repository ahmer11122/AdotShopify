<style>
  /* -------------------------------------------------------------------------
     SIZE GUIDE STYLES — 100% RESPONSIVE FIT (ZERO HORIZONTAL SCROLL)
     ------------------------------------------------------------------------- */
  /* ---------- Shell: never scrollable, never sized in vw/vh ---------- */
  .sg {
    --sg-dur: 380ms;
    --sg-ease: var(--ease-drawer, cubic-bezier(0.32, 0.72, 0, 1));

    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--pdp-ink, #111);
    overflow: hidden;            /* legacy fallback */
    overscroll-behavior: none;
    z-index: 9999;
    outline: none;
    /* NO transition on display/overlay. Exit is driven from JS. */
  }
  /* `clip` is NOT a scroll container, so focus / scrollIntoView can never scroll the dialog. */
  @supports (overflow: clip) {
    .sg { overflow: clip; }
  }
  .sg[data-state='closing'] { pointer-events: none; }

  /* ---------- Backdrop: fully keyframe-driven, same duration as the sheet ---------- */
  .sg::backdrop {
    background: oklch(0 0 0 / 0.44);
    animation: sg-backdrop-in 380ms cubic-bezier(0.32, 0.72, 0, 1) backwards;
  }
  .sg[data-state='closing']::backdrop {
    animation: sg-backdrop-out 380ms cubic-bezier(0.32, 0.72, 0, 1) forwards;
  }
  @keyframes sg-backdrop-in  { from { opacity: 0; } }
  @keyframes sg-backdrop-out { to   { opacity: 0; } }

  /* ---------- Sheet: resting state is OPEN ---------- */
  .sg__sheet {
    position: absolute;
    display: flex;
    flex-direction: column;
    background: var(--pdp-paper, #fff);
    font-family: var(--pdp-font, inherit);
    transform: none;
    /* Only used for the drag spring-back. Enter/exit are Web Animations (JS). */
    transition: transform var(--sg-dur) var(--sg-ease);
  }
  .sg__sheet.is-dragging { transition: none; }

  /* Mobile: Bottom Sheet */
  @media (max-width: 989px) {
    .sg__sheet {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      max-height: min(88svh, 100%);
      border-radius: 18px 18px 0 0;
      padding-bottom: env(safe-area-inset-bottom, 0px);
      overscroll-behavior: contain;
    }
  }

  /* Desktop: Side Sheet (34rem) */
  @media (min-width: 990px) {
    .sg__sheet {
      top: 0;
      right: 0;
      bottom: 0;
      width: min(34rem, 100%);
      border-left: 1px solid var(--pdp-line-2, oklch(0 0 0 / 0.12));
    }
  }

  /* Grab handle (Mobile only) */
  .sg__grab {
    display: none;
    justify-content: center;
    padding: 0.75rem 0 0.25rem;
    touch-action: none;
    cursor: grab;
  }

  .sg__grab i {
    display: block;
    width: 2.75rem;
    height: 4px;
    border-radius: 999px;
    background: var(--pdp-line-2, oklch(0 0 0 / 0.22));
  }

  @media (max-width: 989px) {
    .sg__grab {
      display: flex;
    }

    .sg__head {
      touch-action: none;
    }
  }

  /* Header */
  .sg__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: clamp(1.25rem, 3vw, 2rem) clamp(1.25rem, 3vw, 2rem) 0;
  }

  .sg__title {
    margin: 0;
    font-family: var(--pdp-font-display, inherit);
    font-size: clamp(1.75rem, 4.5vw, 2.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--pdp-ink, #111);
  }

  .sg__sub {
    margin: 0.375rem 0 0;
    font-size: var(--pdp-fs-small, 0.8125rem);
    color: var(--pdp-ink-3, #6b6b6b);
  }

  .sg__close {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    margin: -0.375rem -0.5rem 0 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    border-radius: 50%;
    transition: transform 160ms ease-out, background-color 160ms ease-out;
  }

  .sg__close:active {
    transform: scale(0.94);
  }

  .sg__close:focus-visible {
    outline: 2px solid var(--pdp-ink, #111);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .sg__close:hover {
      background: var(--pdp-sunk, #f5f5f5);
    }
  }

  /* Segmented Controls */
  .sg__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 1.25rem clamp(1.25rem, 3vw, 2rem) 0;
  }

  .sg__seg {
    position: relative;
    display: inline-flex;
    padding: 3px;
    background: var(--pdp-sunk, #f5f5f5);
    border-radius: 6px;
  }

  .sg__seg-ind {
    position: absolute;
    top: 3px;
    bottom: 3px;
    left: 0;
    width: 0;
    background: var(--pdp-paper, #fff);
    border-radius: 4px;
    box-shadow: 0 1px 3px oklch(0 0 0 / 0.08), inset 0 0 0 1px var(--pdp-line-2, oklch(0 0 0 / 0.12));
    transition:
      transform 360ms var(--pdp-spring, cubic-bezier(0.34, 1.35, 0.64, 1)),
      width 360ms var(--pdp-spring, cubic-bezier(0.34, 1.35, 0.64, 1));
  }

  /* Constant weight, so selecting a button never changes its width or its neighbours' positions */
  .sg__seg button {
    position: relative;
    z-index: 1;
    min-height: 2.125rem;
    padding: 0 0.875rem;
    border: 0;
    background: none;
    color: var(--pdp-ink-3, #6b6b6b);
    font-family: var(--pdp-font, inherit);
    font-size: var(--pdp-fs-ui, 0.8125rem);
    font-weight: 500;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    transition: color 180ms ease;
  }

  .sg__seg button[aria-selected='true'],
  .sg__seg button[aria-checked='true'] {
    color: var(--pdp-ink, #111);
    /* no font-weight change here */
  }

  /* Body & Stacking Panels */
  .sg__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    overscroll-behavior: contain;
    padding: 1.5rem clamp(1.25rem, 3vw, 2rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .sg__panel {
    grid-area: 1 / 1;
  }

  /* Override the UA `[hidden]{display:none}`: inactive panels still take up space, but are invisible,
     unfocusable and removed from the accessibility tree (visibility:hidden). */
  .sg__panel[hidden] {
    display: block;
    visibility: hidden;
    pointer-events: none;
  }

  /* 100% Width Table — Clean Typographic Headers without cluttered units */
  .sg__table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
    margin: 0;
  }

  .sg__table th {
    padding: 0 4px 0.75rem 4px;
    text-align: right;
    vertical-align: bottom;
    font-size: clamp(0.6875rem, 2.5vw, 0.75rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--pdp-ink-3, #6b6b6b);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: clip;
  }

  .sg__table td {
    padding: 0 4px;
    text-align: right;
    font-size: clamp(0.8125rem, 3.2vw, 0.9375rem);
    color: var(--pdp-ink, #111);
    white-space: nowrap;
  }

  /* First column (Size) aligned left */
  .sg__table th:first-child,
  .sg__table td:first-child {
    text-align: left;
    padding-left: 0.25rem;
  }

  .sg__table th:last-child,
  .sg__table td:last-child {
    padding-right: 0.25rem;
  }

  .sg__row > * {
    height: 3.25rem;
    border-top: 1px solid var(--pdp-line, oklch(0 0 0 / 0.1));
    transition: background-color 180ms ease;
  }

  .sg__row:last-child > * {
    border-bottom: 1px solid var(--pdp-line, oklch(0 0 0 / 0.1));
  }

  .sg__size {
    font-family: var(--pdp-font-display, inherit);
    font-size: clamp(0.9375rem, 3.5vw, 1.125rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--pdp-ink, #111);
  }

  /* Desktop generous spacing */
  @media (min-width: 990px) {
    .sg__table th {
      padding: 0 0.75rem 0.875rem;
      font-size: 0.8125rem;
    }
    .sg__table td {
      padding: 0 0.75rem;
      font-size: 0.9375rem;
    }
    .sg__table th:first-child,
    .sg__table td:first-child {
      padding-left: 0.75rem;
    }
    .sg__table th:last-child,
    .sg__table td:last-child {
      padding-right: 0.75rem;
    }
    .sg__row > * {
      height: 3.5rem;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .sg__row:hover > * {
      background: var(--pdp-sunk, #f5f5f5);
    }
  }

  /* Selected size row */
  .sg__row.is-yours > * {
    background: var(--pdp-sunk, #f5f5f5);
  }

  .sg__row.is-yours > :first-child {
    box-shadow: inset 3px 0 0 var(--pdp-ink, #111);
  }

  /* Unit flip numbers in table cells */
  .sg__num {
    display: inline-grid;
    overflow: hidden;
    vertical-align: bottom;
  }

  .sg__num > span {
    grid-area: 1 / 1;
    transition:
      transform 360ms var(--pdp-ease-expo, cubic-bezier(0.16, 1, 0.3, 1)),
      opacity 220ms ease;
  }

  .sg[data-unit='cm'] .sg__in {
    transform: translateY(110%);
    opacity: 0;
  }

  .sg[data-unit='in'] .sg__cm {
    transform: translateY(-110%);
    opacity: 0;
  }

  .sg__note {
    max-width: 48ch;
    margin: 1.25rem 0 0;
    font-size: var(--pdp-fs-small, 0.8125rem);
    line-height: 1.55;
    color: var(--pdp-ink-2, #555);
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .sg { --sg-dur: 0.01ms; }
    .sg::backdrop,
    .sg[data-state='closing']::backdrop { animation-duration: 0.01ms; }
    .sg__seg-ind,
    .sg__num > span { transition-duration: 0.01ms !important; }
  }
</style>

<script>
  (function () {
    const dialog = document.getElementById('SizeGuideDialog');
    if (!dialog) return;

    const sheet = dialog.querySelector('[data-sg-sheet]');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = window.matchMedia('(max-width: 989px)');
    const tabs = [...dialog.querySelectorAll('[role="tab"]')];
    const panels = [...dialog.querySelectorAll('.sg__panel')];
    const unitBtns = [...dialog.querySelectorAll('[data-unit-btn]')];
    const segs = [...dialog.querySelectorAll('[data-seg]')];

    const DURATION = 380;                                   /* keep in sync with --sg-dur */
    const EASING = 'cubic-bezier(0.32, 0.72, 0, 1)';
    const REST = 'translate3d(0, 0, 0)';

    let productCat = '';
    let yours = [];
    let openerTrigger = null;
    let closing = false;

    const duration = () => (reduce.matches ? 1 : DURATION);
    const offscreen = () =>
      mobile.matches ? 'translate3d(0, 100%, 0)' : 'translate3d(100%, 0, 0)';

    /* ------------------------------------------------ sheet housekeeping */
    function resetSheet() {
      /* WAAPI animations on a display:none element are NOT auto-cancelled. Cancel explicitly,
         otherwise a fill:forwards exit animation would keep the sheet off-screen on re-open. */
      sheet.getAnimations().forEach((a) => a.cancel());
      dialog.removeAttribute('data-state');
      sheet.classList.remove('is-dragging');
      sheet.style.transform = '';
    }

    /* Safety net for browsers without overflow:clip. With clip this never fires. */
    function pinDialogScroll() {
      if (dialog.scrollTop) dialog.scrollTop = 0;
      if (dialog.scrollLeft) dialog.scrollLeft = 0;
    }
    dialog.addEventListener('scroll', pinDialogScroll, { passive: true });

    /* ------------------------------------------------------- sliding thumbs */
    function moveThumb(seg, still) {
      const ind = seg.querySelector('.sg__seg-ind');
      const on = seg.querySelector('[aria-selected="true"], [aria-checked="true"]');
      if (!ind || !on || !on.offsetWidth) return;   /* not laid out yet: never write width 0 */
      if (still) ind.style.transition = 'none';
      ind.style.width = on.offsetWidth + 'px';
      ind.style.transform = 'translateX(' + on.offsetLeft + 'px)';
      if (still) {
        void ind.offsetWidth;                       /* flush while transitions are off */
        ind.style.transition = '';
      }
    }

    function moveAllThumbs(still) {
      segs.forEach((s) => moveThumb(s, still));
    }

    /* ----------------------------------------------------------- categories */
    function setCategory(key, animate) {
      const target = panels.find((p) => p.dataset.panel === key) || panels[0];
      if (!target) return;
      tabs.forEach((t) => {
        const on = t.dataset.tab === target.dataset.panel;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
      panels.forEach((p) => { p.hidden = p !== target; });
      if (animate && !reduce.matches && target.animate) {
        /* opacity only: a translate would briefly extend the scroll extent of .sg__body */
        target.animate([{ opacity: 0 }, { opacity: 1 }], {
          duration: 220,
          easing: 'cubic-bezier(0.23, 1, 0.32, 1)',
        });
      }
      moveThumb(tabs[0].parentElement, false);
      refreshRows();
    }

    /* ---------------------------------------------------------------- units */
    function setUnit(unit) {
      dialog.dataset.unit = unit;
      unitBtns.forEach((b) => {
        const on = b.dataset.unitBtn === unit;
        b.setAttribute('aria-checked', on ? 'true' : 'false');
        b.tabIndex = on ? 0 : -1;
      });
      dialog.querySelectorAll('.sg__in').forEach((el) => el.setAttribute('aria-hidden', unit === 'in' ? 'false' : 'true'));
      dialog.querySelectorAll('.sg__num .sg__cm').forEach((el) => el.setAttribute('aria-hidden', unit === 'cm' ? 'false' : 'true'));
      moveThumb(unitBtns[0].parentElement, false);
    }

    function arrowNav(buttons, activate) {
      buttons.forEach((btn) => {
        btn.addEventListener('keydown', (e) => {
          if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
          e.preventDefault();
          const step = e.key === 'ArrowRight' ? 1 : -1;
          const next = buttons[(buttons.indexOf(btn) + step + buttons.length) % buttons.length];
          next.focus();
          activate(next);
        });
      });
    }

    tabs.forEach((t) => t.addEventListener('click', () => setCategory(t.dataset.tab, true)));
    unitBtns.forEach((b) => b.addEventListener('click', () => setUnit(b.dataset.unitBtn)));
    arrowNav(tabs, (t) => setCategory(t.dataset.tab, true));
    arrowNav(unitBtns, (b) => setUnit(b.dataset.unitBtn));

    /* --------------------------------------------- rows: highlight active size */
    function refreshRows() {
      panels.forEach((panel) => {
        const isProductPanel = panel.dataset.panel === productCat;
        panel.querySelectorAll('.sg__row').forEach((row) => {
          const keys = row.dataset.keys.split('|').map((k) => k.toUpperCase());
          const isSelected = isProductPanel && keys.some((k) => yours.includes(k));
          row.classList.toggle('is-yours', isSelected);
        });
      });
    }

    window.addEventListener('variant:change', (e) => {
      const variant = e.detail && e.detail.variant;
      yours = variant ? variant.options.map((o) => String(o).toUpperCase()) : [];
      refreshRows();
    });

    /* ------------------------------------------------------------ open / close */
    function open(trigger) {
      openerTrigger = trigger || null;
      if (dialog.open) return;
      productCat =
        (trigger && trigger.dataset.sizeCategory) || productCat || (panels[0] && panels[0].dataset.panel);

      closing = false;
      resetSheet();
      setCategory(productCat, false);
      setUnit(dialog.dataset.unit || 'cm');

      /* 1. Sheet is at REST (fully on-screen) when showModal() runs its focus step -> nothing to scroll to.
         2. The scroll lock is pure CSS (html:has(dialog.sg[open])) and lands in the same style recalc. */
      dialog.showModal();
      pinDialogScroll();

      /* 3. Start the slide immediately. fill:'backwards' applies keyframe 0 (off-screen) from the first
            painted frame, so there is no frame-0 flash and no reflow/rAF trick needed. */
      if (sheet.animate) {
        sheet.animate([{ transform: offscreen() }, { transform: REST }], {
          duration: duration(),
          easing: EASING,
          fill: 'backwards',
        });
      }

      /* 4. Layout exists now: measure the thumbs synchronously, before first paint. */
      moveAllThumbs(true);
    }

    function finishClose() {
      if (dialog.open) dialog.close();
    }

    function requestClose() {
      if (!dialog.open || closing) return;
      closing = true;
      dialog.dataset.state = 'closing';               /* CSS fades the backdrop in sync */

      if (!sheet.animate) { finishClose(); return; }

      /* Start from wherever the sheet currently is (mid-drag or mid-open) so there is no jump. */
      const current = getComputedStyle(sheet).transform;
      const exit = sheet.animate(
        [{ transform: current === 'none' ? REST : current }, { transform: offscreen() }],
        { duration: duration(), easing: EASING, fill: 'forwards' }
      );
      exit.finished.then(finishClose, finishClose);   /* guarded by dialog.open */
    }

    dialog.addEventListener('cancel', (e) => {        /* Esc */
      e.preventDefault();
      requestClose();
    });

    dialog.addEventListener('close', () => {
      closing = false;
      resetSheet();
      if (openerTrigger && typeof openerTrigger.focus === 'function') {
        try { openerTrigger.focus({ preventScroll: true }); } catch (_) {}
      }
    });

    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) requestClose();        /* backdrop tap */
    });

    dialog.querySelectorAll('[data-close-size-guide]').forEach((b) => {
      b.addEventListener('click', () => requestClose());
    });

    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-open-size-guide], [data-open-size-modal]');
      if (!trigger) return;
      e.preventDefault();
      open(trigger);
    });

    /* ---------------------- mobile: drag with rubber-band physics & velocity */
    dialog.querySelectorAll('[data-sg-grab]').forEach((handle) => {
      let drag = null;

      handle.addEventListener('pointerdown', (e) => {
        if (!mobile.matches || closing || e.target.closest('button')) return;
        if (sheet.getAnimations().length) return;     /* enter animation / spring-back still running */
        drag = { y: e.clientY, dy: 0, lastY: e.clientY, lastT: performance.now(), v: 0 };
        handle.setPointerCapture(e.pointerId);
        sheet.classList.add('is-dragging');
      });

      handle.addEventListener('pointermove', (e) => {
        if (!drag) return;
        const now = performance.now();
        const rawDy = e.clientY - drag.y;
        drag.dy = rawDy < 0 ? -Math.pow(-rawDy, 0.72) * 0.45 : rawDy;
        const dt = Math.max(1, now - drag.lastT);
        drag.v = (e.clientY - drag.lastY) / dt;
        drag.lastY = e.clientY;
        drag.lastT = now;
        sheet.style.transform = 'translate3d(0, ' + drag.dy + 'px, 0)';
      });

      const end = () => {
        if (!drag) return;
        const shouldClose = drag.dy > 100 || drag.v > 0.55;
        drag = null;
        if (shouldClose) {
          requestClose();                             /* keeps .is-dragging; exit starts from current drag offset */
        } else {
          sheet.classList.remove('is-dragging');
          sheet.style.transform = '';                 /* CSS transition springs it back */
        }
      };
      handle.addEventListener('pointerup', end);
      handle.addEventListener('pointercancel', end);
    });

    /* ------------------------------------------- keep thumbs correct on any size change */
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(() => { if (dialog.open) moveAllThumbs(true); });
      segs.forEach((s) => ro.observe(s));
    }
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => { if (dialog.open) moveAllThumbs(true); });
    }
  })();
</script>
