                <td data-col="Chest"><span class="sg__num"><span class="sg__cm">61</span><span class="sg__in" aria-hidden="true">24.0</span></span></td>
                <td data-col="Length"><span class="sg__num"><span class="sg__cm">72</span><span class="sg__in" aria-hidden="true">28.3</span></span></td>
                <td data-col="Shoulder"><span class="sg__num"><span class="sg__cm">54</span><span class="sg__in" aria-hidden="true">21.3</span></span></td>
                <td data-col="Sleeve"><span class="sg__num"><span class="sg__cm">91</span><span class="sg__in" aria-hidden="true">35.8</span></span></td>
                <td class="sg__act">
                  <button type="button" class="sg__pick" data-sg-pick aria-label="Select size XL">
                    <span class="sg__pick-text">Select</span>
                    <svg class="sg__pick-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                      <path d="M2.5 8.5l3.5 3.5 7.5-8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                  <span class="sg__sold-out" data-sg-soldout hidden>Sold out</span>
                </td>
              </tr>
              <tr class="sg__row" data-keys="XXL">
