{%- comment -%}
  Bottom-docked WhatsApp bar for phones.
  Params: message
{%- endcomment -%}
{%- assign wa_msg = message | default: 'Hello ADOT, I need help with…' -%}
{%- capture wa_href -%}{% render 'adot-wa-link', message: wa_msg %}{%- endcapture -%}
<a
  href="{{ wa_href }}"
  class="adot-mbar"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Ask on WhatsApp, opens in a new tab"
>
  <span class="adot-mbar__label">
    <span class="adot-live__dot" aria-hidden="true"></span>
    Ask on WhatsApp
  </span>
  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <line x1="1" y1="7" x2="13" y2="7"></line>
    <polyline points="8 2 13 7 8 12"></polyline>
  </svg>
</a>
