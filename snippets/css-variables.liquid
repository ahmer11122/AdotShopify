{% style %}
  :root {
    {% if settings.max_page_width %}
      --page-width: {{ settings.max_page_width }};
    {% endif %}
    {% if settings.min_page_margin %}
      --page-margin: {{ settings.min_page_margin }}px;
    {% endif %}

    {% if settings.background_color and settings.background_color != blank %}
      --color-background: {{ settings.background_color }};
    {% endif %}
    {% if settings.foreground_color and settings.foreground_color != blank %}
      --color-foreground: {{ settings.foreground_color }};
      --color-text: {{ settings.foreground_color }};
    {% endif %}
    {% if settings.input_corner_radius %}
      --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
      --radius-input: {{ settings.input_corner_radius }}px;
    {% endif %}
  }
{% endstyle %}
