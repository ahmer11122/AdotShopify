{%- liquid
  assign brand_name = settings.brand_name | default: 'ADOT Wear' | strip
  if brand_name == blank
    assign brand_name = shop.name
  endif
  assign brand_description = settings.brand_description | default: 'ADOT Wear menswear — shirts, hoodies, sweatshirts, and trousers with cash on delivery across Pakistan.' | strip
  assign fallback_description = shop.description | default: brand_description

  assign og_title = page_title | default: brand_name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: fallback_description

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif

  assign title_has_brand = false
  if page_title contains brand_name or page_title contains shop.name
    assign title_has_brand = true
  endif
  if page_title contains 'ADOT Wear' or page_title contains 'AdotWear' or page_title contains 'ADOT Official'
    assign title_has_brand = true
  endif
-%}

<meta
  property="og:site_name"
  content="{{ brand_name | escape }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- if page_image -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>

  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {%- if page_title == blank -%}
    {{ brand_name }}
  {%- else -%}
    {{ page_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless title_has_brand %} &ndash; {{ brand_name }}{% endunless -%}
  {%- endif -%}
</title>

<link
  rel="canonical"
  href="{{ canonical_url }}"
>

<meta
  name="description"
  content="{{ og_description | escape }}"
>

{%- liquid
  if settings.logo != blank
    assign org_logo = settings.logo | image_url: width: 512 | prepend: 'https:' | replace: 'https:https:', 'https:'
  else
    assign org_logo = 'logo.png' | asset_url | prepend: 'https:' | replace: 'https:https:', 'https:'
  endif
  assign search_target = request.origin | append: routes.search_url | append: '?q={search_term_string}'

  assign alt_raw = settings.brand_alternate_names | default: 'ADOT Wear, AdotWear, ADOT'
  assign alt_parts = alt_raw | split: ','
  assign alt_json_items = ''
  for part in alt_parts
    assign cleaned = part | strip
    if cleaned != blank
      assign piece = cleaned | json
      if alt_json_items == blank
        assign alt_json_items = piece
      else
        assign alt_json_items = alt_json_items | append: ',' | append: piece
      endif
    endif
  endfor

  assign same_as_items = ''
  if settings.social_instagram_url != blank
    assign same_as_items = settings.social_instagram_url | json
  endif
  if settings.social_facebook_url != blank
    assign piece = settings.social_facebook_url | json
    if same_as_items == blank
      assign same_as_items = piece
    else
      assign same_as_items = same_as_items | append: ',' | append: piece
    endif
  endif
  if settings.social_tiktok_url != blank
    assign piece = settings.social_tiktok_url | json
    if same_as_items == blank
      assign same_as_items = piece
    else
      assign same_as_items = same_as_items | append: ',' | append: piece
    endif
  endif
  if settings.social_youtube_url != blank
    assign piece = settings.social_youtube_url | json
    if same_as_items == blank
      assign same_as_items = piece
    else
      assign same_as_items = same_as_items | append: ',' | append: piece
    endif
  endif
-%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": {{ request.origin | append: '/#organization' | json }},
    "name": {{ brand_name | json }},
    "url": {{ request.origin | json }},
    "logo": {{ org_logo | json }},
    "description": {{ brand_description | json }}
    {%- if same_as_items != blank -%}
    ,"sameAs": [{{ same_as_items }}]
    {%- endif -%}
  }
</script>
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": {{ request.origin | append: '/#website' | json }},
    "name": {{ brand_name | json }},
    "url": {{ request.origin | json }},
    "publisher": { "@id": {{ request.origin | append: '/#organization' | json }} }
    {%- if alt_json_items != blank -%}
    ,"alternateName": [{{ alt_json_items }}]
    {%- endif -%}
    ,"potentialAction": {
      "@type": "SearchAction",
      "target": {{ search_target | json }},
      "query-input": "required name=search_term_string"
    }
  }
</script>
