{%- comment -%}
  Quiet page hero. Params: label, headline (*accent*), intro, meta (optional)
  num kept for Theme Editor callers but not rendered (clutter-free).
{%- endcomment -%}
<header class="adot-hero">
  {% if label != blank %}
    <p class="adot-hero__eyebrow">{{ label | escape }}</p>
  {% endif %}
  <h1 class="adot-hero__title">{% render 'adot-title', headline: headline %}</h1>
  {% if intro != blank %}
    <div class="adot-hero__intro">
      {% if intro contains '<' %}
        {{ intro }}
      {% else %}
        <p>{{ intro | escape }}</p>
      {% endif %}
    </div>
  {% endif %}
  {% if meta != blank %}
    <span class="adot-hero__meta">{{ meta | escape }}</span>
  {% endif %}
</header>
