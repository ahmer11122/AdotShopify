{% doc %}
  Product Sticky Mobile Bar
  - Pinned to bottom of viewport on mobile (< 990px)
  - Safe area inset padding for modern iOS/Android gesture bars
  - Synchronized with real variant selector
  - Auto-hides when Size Guide <dialog> or <cart-drawer> is open

  @param {product} product - The product object
  @param {section} section - The parent section
{% enddoc %}

{% capture sticky_price_formatted %}{% render 'money', price: product.price %}{% endcapture %}

<div class="product-sticky-bar" id="ProductStickyBar-{{ section.id }}" data-sticky-bar aria-label="Quick add navigation">
  <div class="product-sticky-bar__container">
    <!-- Thumbnail & Info -->
    <div class="product-sticky-bar__product">
      <div class="product-sticky-bar__media">
        {% if product.featured_image %}
          {% assign featured_alt = product.title | escape %}
          {{
            product.featured_image
            | image_url: width: 120
            | image_tag:
              loading: 'lazy',
              alt: featured_alt,
              class: 'product-sticky-bar__img',
              width: 48,
              height: 64
          }}
        {% endif %}
      </div>

      <div class="product-sticky-bar__meta">
        <span class="product-sticky-bar__title text-micro">{{ product.title }}</span>
        <div class="product-sticky-bar__price-row text-micro">
          <span class="product-sticky-bar__price" data-sticky-price>{{ sticky_price_formatted | strip }}</span>
          <span class="product-sticky-bar__size-label" data-sticky-size-label>• Select Size</span>
        </div>
      </div>
    </div>

    <!-- Sticky CTA Button -->
    <button
      type="button"
      class="product-sticky-bar__cta"
      id="ProductStickyCta-{{ section.id }}"
      data-sticky-cta
    >
      <span data-sticky-btn-text>Select Size</span>
    </button>
  </div>
</div>

<style>
  /* Fixed Mobile Bar Layout (Apple Frosted Glass) */
  .product-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 85;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    padding: 0.625rem var(--page-margin, 1rem) max(0.625rem, env(safe-area-inset-bottom)) var(--page-margin, 1rem);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.05);
    transform: translateY(105%);
    opacity: 0;
    pointer-events: none;
    transition: transform 260ms cubic-bezier(0.23, 1, 0.32, 1), opacity 200ms ease;
  }

  .product-sticky-bar.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  /* Hidden on Desktop (>= 990px) */
  @media (min-width: 990px) {
    .product-sticky-bar {
      display: none !important;
    }
  }

  /* Automatically hide when native dialog or cart drawer is open */
  body:has(dialog[open]) .product-sticky-bar,
  body:has(cart-drawer.is-open) .product-sticky-bar,
  .product-sticky-bar.is-hidden {
    transform: translateY(105%) !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  .product-sticky-bar__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    max-width: var(--container-max, 1440px);
    margin: 0 auto;
  }

  .product-sticky-bar__product {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    overflow: hidden;
  }

  .product-sticky-bar__media {
    width: 40px;
    height: 52px;
    flex-shrink: 0;
    background-color: var(--color-surface, #F5F5F5);
    overflow: hidden;
    border-radius: 2px;
    border: 1px solid rgba(0, 0, 0, 0.06);
  }

  .product-sticky-bar__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .product-sticky-bar__meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .product-sticky-bar__title {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-text, #111111);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    letter-spacing: -0.01em;
  }

  .product-sticky-bar__price-row {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 2px;
    font-size: 0.6875rem;
    color: var(--color-text-muted, #555555);
  }

  .product-sticky-bar__price {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-text, #111111);
  }

  .product-sticky-bar__size-label {
    color: var(--color-text-subtle, #767676);
  }

  /* CTA Button */
  .product-sticky-bar__cta {
    flex-shrink: 0;
    padding: 0.625rem 1.25rem;
    background-color: var(--color-btn-bg, #0A0A0A);
    color: var(--color-btn-text, #FFFFFF);
    border: none;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: var(--radius-none);
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: manipulation;
    transition:
      background-color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }

  .product-sticky-bar__cta:active {
    transform: scale(0.98);
  }

  /* Page compensation spacing so sticky bar does not cover footer */
  @media (max-width: 989px) {
    .section-product {
      padding-bottom: 85px !important;
    }
  }
</style>

<script>
  (function() {
    const stickyBar = document.getElementById('ProductStickyBar-{{ section.id }}');
    if (!stickyBar) return;

    const stickyCta = document.getElementById('ProductStickyCta-{{ section.id }}');
    const stickyBtnText = stickyBar.querySelector('[data-sticky-btn-text]');
    const stickyPrice = stickyBar.querySelector('[data-sticky-price]');
    const stickySizeLabel = stickyBar.querySelector('[data-sticky-size-label]');

    let hasSelectedSize = {% if product.has_only_default_variant or product.variants.size == 1 %}true{% else %}false{% endif %};

    if (hasSelectedSize && stickyBtnText) {
      stickyBtnText.textContent = 'Add to Bag';
      if (stickySizeLabel) stickySizeLabel.textContent = '';
    }

    // Smart IntersectionObserver: show sticky bar only after main Buy Box button scrolls past top
    const mainAddToCartBtn = document.getElementById('AddToCartBtn-{{ section.id }}');
    let isPastButton = false;

    function updateStickyVisibility() {
      if (isPastButton && window.scrollY >= 300) {
        stickyBar.classList.add('is-visible');
      } else {
        stickyBar.classList.remove('is-visible');
      }
    }

    if (mainAddToCartBtn && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          const bounding = entry.boundingClientRect;
          // If the button is visible or below the viewport, keep sticky bar hidden
          if (entry.isIntersecting || bounding.top > 0) {
            isPastButton = false;
          } else {
            // Main button has scrolled past the top of the viewport
            isPastButton = true;
          }
          updateStickyVisibility();
        });
      }, {
        threshold: 0
      });

      observer.observe(mainAddToCartBtn);
    } else {
      // Fallback for older browsers
      window.addEventListener('scroll', () => {
        isPastButton = window.scrollY > 450;
        updateStickyVisibility();
      }, { passive: true });
    }
    
    // Ensure scroll coordinates are respected even if observer fires early on load
    window.addEventListener('scroll', updateStickyVisibility, { passive: true });

    // Listen for variant selections dispatched from buy box
    window.addEventListener('variant:change', (e) => {
      const variant = e.detail?.variant;
      if (!variant) return;

      hasSelectedSize = true;

      if (stickySizeLabel) {
        stickySizeLabel.textContent = `• Size: ${variant.title}`;
      }

      if (stickyPrice) {
        const amount = (variant.price / 100).toLocaleString('en-PK', { maximumFractionDigits: 0 });
        stickyPrice.textContent = `Rs. ${amount}`;
      }

      if (stickyBtnText) {
        if (variant.available) {
          stickyBtnText.textContent = 'Add to Bag';
        } else {
          stickyBtnText.textContent = 'Sold Out';
        }
      }
    });

    // Sticky CTA Click Handler
    if (stickyCta) {
      stickyCta.addEventListener('click', () => {
        if (!hasSelectedSize) {
          // Smooth scroll to size selector in the buy box
          const sizeSelector = document.querySelector('.product-buy-box__option-group') || document.getElementById('ProductBuyBox-{{ section.id }}');
          if (sizeSelector) {
            sizeSelector.classList.add('has-error');
            sizeSelector.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
          const alert = document.getElementById('ProductAlert-{{ section.id }}');
          if (alert) {
            alert.textContent = 'Please select a size to continue.';
            alert.hidden = false;
          }
        } else {
          // Size is selected, dispatch event to buy box form submit
          window.dispatchEvent(new CustomEvent('pdp:sticky-add'));
        }
      });
    }
  })();
</script>
