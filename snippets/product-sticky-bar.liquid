{% doc %}
  Product Sticky Mobile Bar
  - Appears on mobile (< 990px) once the main Add to bag button scrolls out of view
  - Mirrors the buy box through the `pdp:state` and `variant:change` events
  - Safe-area aware; hides itself while a dialog or the cart drawer is open
  - With no size chosen, the tap brings the size ruler into view and flags it

  @param {product} product - The product object
  @param {section} section - The parent section
{% enddoc %}

{% capture sticky_price_formatted %}{% render 'money', price: product.price %}{% endcapture %}
{%- liquid
  assign sticky_only_default = false
  if product.has_only_default_variant or product.variants.size == 1
    assign sticky_only_default = true
  endif
-%}

<div class="product-sticky-bar" id="ProductStickyBar-{{ section.id }}" data-sticky-bar role="region" aria-label="Quick add">
  <div class="product-sticky-bar__container">
    <div class="product-sticky-bar__product">
      <div class="product-sticky-bar__media">
        {%- if product.featured_image -%}
          {{
            product.featured_image
            | image_url: width: 120
            | image_tag:
              loading: 'lazy',
              alt: '',
              class: 'product-sticky-bar__img',
              width: 48,
              height: 64
          }}
        {%- endif -%}
      </div>

      <div class="product-sticky-bar__meta">
        <span class="product-sticky-bar__title">{{ product.title }}</span>
        <span class="product-sticky-bar__sub">
          <span class="product-sticky-bar__price" data-sticky-price>{{ sticky_price_formatted | strip }}</span>
          <span class="product-sticky-bar__size-label" data-sticky-size-label>{% unless sticky_only_default %}Select a size{% endunless %}</span>
        </span>
      </div>
    </div>

    <button
      type="button"
      class="product-sticky-bar__cta"
      id="ProductStickyCta-{{ section.id }}"
      data-sticky-cta
      data-state="{% if sticky_only_default %}ready{% else %}needs-size{% endif %}"
    >
      <span data-sticky-btn-text>{% if sticky_only_default %}Add to bag{% else %}Select a size{% endif %}</span>
    </button>
  </div>
</div>

<style>
  .product-sticky-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 85;
    padding: 0.75rem var(--page-margin, 1rem) max(0.75rem, env(safe-area-inset-bottom, 0px));
    background: rgb(255 255 255 / 0.82);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    border-top: 1px solid oklch(0 0 0 / 0.08);
    transform: translateY(100%);
    opacity: 0;
    pointer-events: none;
    transition:
      transform 320ms var(--ease-drawer),
      opacity 200ms var(--ease-out);
  }

  .product-sticky-bar.is-visible {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  @media (min-width: 990px) {
    .product-sticky-bar {
      display: none !important;
    }
  }

  body:has(dialog[open]) .product-sticky-bar,
  body:has(cart-drawer.is-open) .product-sticky-bar,
  .product-sticky-bar.is-hidden {
    transform: translateY(100%) !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  @media (prefers-reduced-transparency: reduce) {
    .product-sticky-bar {
      background: var(--color-background, #fff);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .product-sticky-bar__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    max-width: var(--container-max, 1440px);
    margin: 0 auto;
  }

  .product-sticky-bar__product {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .product-sticky-bar__media {
    position: relative;
    flex-shrink: 0;
    width: 40px;
    height: 52px;
    overflow: hidden;
    background: var(--color-surface, #f5f5f5);
  }

  .product-sticky-bar__media::after {
    content: '';
    position: absolute;
    inset: 0;
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
  }

  .product-sticky-bar__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-sticky-bar__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .product-sticky-bar__title {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.005em;
    color: var(--color-text, #111);
  }

  .product-sticky-bar__sub {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted, #555);
  }

  .product-sticky-bar__price {
    font-weight: 500;
    color: var(--color-text, #111);
  }

  .product-sticky-bar__size-label:not(:empty)::before {
    content: '';
    display: inline-block;
    width: 1px;
    height: 0.75em;
    margin-right: 0.5rem;
    background: currentColor;
    opacity: 0.4;
  }

  .product-sticky-bar__cta {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 9.5rem;
    min-height: 3rem;
    padding: 0 1.25rem;
    border: 0;
    background: var(--color-btn-bg, #111);
    color: var(--color-btn-text, #fff);
    box-shadow: inset 0 0 0 1px var(--color-btn-bg, #111);
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 200ms var(--ease-out),
      color 200ms var(--ease-out),
      box-shadow 200ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .product-sticky-bar__cta:active {
    transform: scale(0.97);
  }

  .product-sticky-bar__cta[data-state='needs-size'] {
    background: var(--color-background, #fff);
    color: var(--color-text, #111);
  }

  .product-sticky-bar__cta[data-state='sold-out'] {
    background: var(--color-surface, #f5f5f5);
    color: var(--color-text-subtle, #6b6b6b);
    box-shadow: inset 0 0 0 1px oklch(0 0 0 / 0.1);
  }

  .product-sticky-bar__cta[data-state='done'] {
    background: var(--color-in-stock, #166534);
    box-shadow: inset 0 0 0 1px var(--color-in-stock, #166534);
  }

  .product-sticky-bar__cta[data-state='loading'] {
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-sticky-bar {
      transition-property: opacity;
    }
  }
</style>

<script>
  (function () {
    const stickyBar = document.getElementById('ProductStickyBar-{{ section.id }}');
    if (!stickyBar) return;

    const stickyCta = document.getElementById('ProductStickyCta-{{ section.id }}');
    const stickyBtnText = stickyBar.querySelector('[data-sticky-btn-text]');
    const stickyPrice = stickyBar.querySelector('[data-sticky-price]');
    const stickySizeLabel = stickyBar.querySelector('[data-sticky-size-label]');
    const mainAddToCartBtn = document.getElementById('AddToCartBtn-{{ section.id }}');

    let state = '{% if sticky_only_default %}ready{% else %}needs-size{% endif %}';
    let isPastButton = false;

    function updateStickyVisibility() {
      stickyBar.classList.toggle('is-visible', isPastButton && window.scrollY >= 300);
    }

    /* Show the bar only after the main button has left the top of the viewport */
    if (mainAddToCartBtn && 'IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isPastButton = !(entry.isIntersecting || entry.boundingClientRect.top > 0);
            updateStickyVisibility();
          });
        },
        { threshold: 0 }
      ).observe(mainAddToCartBtn);
    } else {
      window.addEventListener('scroll', () => {
        isPastButton = window.scrollY > 450;
        updateStickyVisibility();
      }, { passive: true });
    }
    window.addEventListener('scroll', updateStickyVisibility, { passive: true });

    /* Mirror the buy box's single CTA state */
    window.addEventListener('pdp:state', (e) => {
      const detail = e.detail || {};
      state = detail.state || state;
      if (stickyCta) stickyCta.dataset.state = state;
      if (stickyBtnText && detail.label) stickyBtnText.textContent = detail.label;
      if (stickyPrice && typeof detail.cents === 'number') {
        stickyPrice.textContent = 'Rs. ' + (detail.cents / 100).toLocaleString('en-PK', { maximumFractionDigits: 0 });
      }
    });

    window.addEventListener('variant:change', (e) => {
      const variant = e.detail && e.detail.variant;
      if (variant && stickySizeLabel) stickySizeLabel.textContent = variant.title;
    });

    if (stickyCta) {
      stickyCta.addEventListener('click', () => {
        // Same path as the main button: validation, scrolling and the nudge live in one place.
        window.dispatchEvent(new CustomEvent('pdp:sticky-add'));
      });
    }
  })();
</script>
