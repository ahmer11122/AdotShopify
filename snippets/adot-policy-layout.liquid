{%- comment -%}
  Quiet layout for /policies/* .
  Shopify ignores templates/policy.liquid; theme.liquid renders this snippet.
{%- endcomment -%}
{%- assign page_label = 'Policy' -%}
{%- assign policy_title = '' -%}
{%- assign policy_body = '' -%}
{%- assign path_l = request.path | downcase -%}

{%- if path_l contains 'refund' -%}
  {%- assign page_label = 'Exchange policy' -%}
  {%- if shop.refund_policy != blank -%}
    {%- assign policy_title = shop.refund_policy.title -%}
    {%- assign policy_body = shop.refund_policy.body -%}
  {%- endif -%}
{%- elsif path_l contains 'privacy' -%}
  {%- assign page_label = 'Privacy' -%}
  {%- if shop.privacy_policy != blank -%}
    {%- assign policy_title = shop.privacy_policy.title -%}
    {%- assign policy_body = shop.privacy_policy.body -%}
  {%- endif -%}
{%- elsif path_l contains 'shipping' -%}
  {%- assign page_label = 'Shipping policy' -%}
  {%- if shop.shipping_policy != blank -%}
    {%- assign policy_title = shop.shipping_policy.title -%}
    {%- assign policy_body = shop.shipping_policy.body -%}
  {%- endif -%}
{%- elsif path_l contains 'terms' -%}
  {%- assign page_label = 'Terms' -%}
  {%- if shop.terms_of_service != blank -%}
    {%- assign policy_title = shop.terms_of_service.title -%}
    {%- assign policy_body = shop.terms_of_service.body -%}
  {%- endif -%}
{%- endif -%}

{%- if policy_title == blank -%}
  {%- assign policy_title = page_label -%}
{%- endif -%}

{%- capture wa_msg -%}Hello ADOT, I have a question about {{ policy_title }}.{%- endcapture -%}

<div class="adot-page adot-page--policy">
  <div class="adot-wrap">
    {% render 'adot-hero',
      label: page_label,
      headline: policy_title
    %}

    <div class="adot-body">
      <div class="adot-main">
        <article class="adot-policy rte" data-adot-policy-body>
          {{ policy_body }}
        </article>
      </div>
    </div>

    {% render 'adot-help-card', message: wa_msg %}
  </div>
  {% render 'adot-mobile-help', message: wa_msg %}
</div>
