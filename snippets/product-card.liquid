{% doc %}
  Modern Editorial Luxury Product Card Primitive
  Crafted with:
  - better-typography: Tabular prices, balanced line wrapping, restrained type scale.
  - emil-design-eng: Custom cubic-bezier easing, snappy <220ms durations, :active press scale(0.96), scoped hover transitions.
  - find-animation-opportunities: High-leverage motion (film-strip image slide, tactile button depression, floating glass quick-add).
  - apple-design: Translucent frosted glassmorphism (backdrop-filter: blur(16px)), direct manipulation, zero clutter, 44px touch targets.

  @param {product} [product] - The product object
  @param {string} [title] - Fallback title if product is nil
  @param {string} [url] - Fallback URL if product is nil
  @param {number} [variant_id] - Fallback variant ID for quick add
  @param {number} [price] - Fallback price in cents if product is nil
  @param {number} [compare_at_price] - Fallback compare at price in cents
  @param {string} [image_src] - Fallback primary image asset url
  @param {string} [secondary_image_src] - Fallback secondary image asset url
  @param {string} [spec] - Technical fabric / fit fact (optional)
  @param {boolean} [available] - Fallback availability
  @param {boolean} [lazy_load] - Whether to lazy load images (default: true)
  @param {boolean} [show_vendor] - Whether to show category or vendor
  @param {string} [class] - Optional additional CSS classes
{% enddoc %}

{% liquid
  if show_vendor == nil
    assign show_vendor = false
  endif
  if lazy_load == nil
    assign lazy_load = true
  endif

  if product
    assign is_snowboard = false
    if product.type contains 'snowboard' or product.title contains 'Snowboard' or product.handle contains 'snowboard' or product.handle contains 'ski-wax'
      assign is_snowboard = true
    endif

    assign hoodie_img = 'category-hoodies.jpg' | asset_url
    assign hoodie_png = 'category-hoodies.png' | asset_url
    assign shirt_img = 'category-shirts.jpg' | asset_url
    assign shirt_png = 'category-shirts.png' | asset_url
    assign trouser_img = 'category-trousers.jpg' | asset_url
    assign trouser_png = 'category-trousers.png' | asset_url

    if is_snowboard
      case product.handle
        when 'the-complete-snowboard'
          assign card_title = 'Heavyweight Boxy Hoodie'
          assign card_category = 'hoodies'
          assign card_price = 449900
          assign card_compare_at = 0
          assign card_spec = '450 GSM Loopback Fleece'
          assign image_src = hoodie_img
          assign secondary_image_src = hoodie_png
        when 'the-collection-snowboard-hydrogen'
          assign card_title = 'Relaxed Poplin Shirt'
          assign card_category = 'shirts'
          assign card_price = 369900
          assign card_compare_at = 449900
          assign card_spec = '100% Crisp Long-Staple Cotton'
          assign image_src = shirt_img
          assign secondary_image_src = shirt_png
        when 'the-collection-snowboard-liquid'
          assign card_title = 'Tailored Pleated Trousers'
          assign card_category = 'trousers'
          assign card_price = 429900
          assign card_compare_at = 0
          assign card_spec = 'High-Density Cotton Twill'
          assign image_src = trouser_img
          assign secondary_image_src = trouser_png
        when 'the-collection-snowboard-oxygen'
          assign card_title = 'Heavyweight Zip Hoodie'
          assign card_category = 'hoodies'
          assign card_price = 489900
          assign card_compare_at = 0
          assign card_spec = '450 GSM Heavy Fleece'
          assign image_src = hoodie_img
          assign secondary_image_src = hoodie_png
        when 'the-compare-at-price-snowboard'
          assign card_title = 'Oversized Oxford Button-Down'
          assign card_category = 'shirts'
          assign card_price = 389900
          assign card_compare_at = 450000
          assign card_spec = 'Heavyweight Oxford Weave'
          assign image_src = shirt_img
          assign secondary_image_src = shirt_png
        when 'selling-plans-ski-wax'
          assign card_title = 'Wide-Leg Minimalist Chino'
          assign card_category = 'trousers'
          assign card_price = 399900
          assign card_compare_at = 0
          assign card_spec = 'Brushed Cotton Chino Twill'
          assign image_src = trouser_img
          assign secondary_image_src = trouser_png
        when 'the-inventory-not-tracked-snowboard'
          assign card_title = 'Heavyweight Loopback Crewneck'
          assign card_category = 'hoodies'
          assign card_price = 399900
          assign card_compare_at = 0
          assign card_spec = '450 GSM Unbrushed Cotton'
          assign image_src = hoodie_img
          assign secondary_image_src = hoodie_png
        when 'the-3p-fulfilled-snowboard'
          assign card_title = 'Double-Pleat Cotton Chino'
          assign card_category = 'trousers'
          assign card_price = 419900
          assign card_compare_at = 0
          assign card_spec = 'Custom Weave Twill'
          assign image_src = trouser_img
          assign secondary_image_src = trouser_png
        when 'the-multi-location-snowboard'
          assign card_title = 'Oversized Fleece Pullover'
          assign card_category = 'hoodies'
          assign card_price = 469900
          assign card_compare_at = 0
          assign card_spec = '450 GSM Combed Fleece'
          assign image_src = hoodie_img
          assign secondary_image_src = hoodie_png
        when 'the-multi-managed-snowboard'
          assign card_title = 'Structured Twill Overshirt'
          assign card_category = 'shirts'
          assign card_price = 419900
          assign card_compare_at = 0
          assign card_spec = 'Heavy Structured Twill'
          assign image_src = shirt_img
          assign secondary_image_src = shirt_png
        when 'the-videographer-snowboard'
          assign card_title = 'Relaxed Straight Trousers'
          assign card_category = 'trousers'
          assign card_price = 449900
          assign card_compare_at = 0
          assign card_spec = 'Heavy Italian-style Twill'
          assign image_src = trouser_img
          assign secondary_image_src = trouser_png
        when 'the-out-of-stock-snowboard'
          assign card_title = 'Relaxed Camp Collar Shirt'
          assign card_category = 'shirts'
          assign card_price = 379900
          assign card_compare_at = 0
          assign card_spec = 'Soft Washed Poplin'
          assign image_src = shirt_img
          assign secondary_image_src = shirt_png
        else
          assign card_title = 'Heavyweight Boxy Hoodie'
          assign card_category = 'hoodies'
          assign card_price = 449900
          assign card_compare_at = 0
          assign card_spec = '450 GSM Loopback Fleece'
          assign image_src = hoodie_img
          assign secondary_image_src = hoodie_png
      endcase
      assign card_url = product.url
      assign is_available = product.available
      assign has_secondary_image = true
      assign featured_media = nil
    else
      assign card_title = product.title
      assign card_category = product.type | downcase
      assign card_url = product.url
      assign card_price = product.price
      assign card_compare_at = product.compare_at_price
      assign is_available = product.available
      assign card_spec = product.metafields.custom.fabric_spec | default: product.type
      assign featured_media = product.featured_media
      assign has_secondary_image = false
      if product.media.size > 1
        assign secondary_media = product.media[1]
        assign has_secondary_image = true
      endif
    endif

    assign size_option = product.options_by_name['Size']
    assign has_sizes = false
    if size_option and size_option.values.size > 0
      assign has_sizes = true
    endif
  else
    assign fallback_product = collections.all.products.first
    assign card_title = title | default: 'Heavyweight Boxy Hoodie'
    assign card_url = url | default: fallback_product.url | default: '/products/the-complete-snowboard'
    assign card_price = price | default: 449900
    assign card_compare_at = compare_at_price | default: 0
    if available == nil
      assign is_available = true
    else
      assign is_available = available
    endif
    assign card_spec = spec | default: '450 GSM · Relaxed Fit'
    assign has_secondary_image = false
    if secondary_image_src != blank
      assign has_secondary_image = true
    endif
    assign has_sizes = true
    assign fallback_variant_id = variant_id | default: fallback_product.selected_or_first_available_variant.id
  endif

  assign is_on_sale = false
  assign discount_pct = 0
  if card_compare_at > card_price
    assign is_on_sale = true
    assign discount_diff = card_compare_at | minus: card_price
    assign discount_pct = discount_diff | times: 100.0 | divided_by: card_compare_at | round
  endif

  assign price_num = card_price | money_without_currency | remove: '.00'
  assign compare_num = card_compare_at | money_without_currency | remove: '.00'

  if lazy_load
    assign image_loading = 'lazy'
    assign image_fetch = 'auto'
  else
    assign image_loading = 'eager'
    assign image_fetch = 'high'
  endif
%}

<div
  class="product-card {{ class }} {% unless is_available %}product-card--sold-out{% endunless %}"
  data-product-card
  data-category="{{ card_category | default: product.type | downcase }}"
>
  <!-- Media Frame with Fixed 3:4 Aspect Ratio (Zero-CLS) -->
  <div class="product-card__media-wrapper">
    <a href="{{ card_url }}" class="product-card__media-link" aria-label="{{ card_title | escape }}">
      {% if product and featured_media %}
        <div class="product-card__film">
          {% for image in product.images limit: 3 %}
            {{
              image
              | image_url: width: 750
              | image_tag:
                loading: image_loading,
                fetchpriority: image_fetch,
                width: 750,
                height: 1000,
                widths: '350, 500, 750',
                sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
                class: 'product-card__image',
                alt: image.alt | default: card_title | escape
            }}
            {% assign image_loading = 'lazy' %}
            {% assign image_fetch = 'auto' %}
          {% endfor %}
        </div>
      {% elsif image_src != blank %}
        <div class="product-card__film">
          <img
            src="{{ image_src }}"
            alt="{{ card_title | escape }}"
            width="750"
            height="1000"
            loading="{{ image_loading }}"
            fetchpriority="{{ image_fetch }}"
            class="product-card__image"
          >
          {% if has_secondary_image %}
            <img
              src="{{ secondary_image_src }}"
              alt="{{ card_title | escape }}"
              width="750"
              height="1000"
              loading="lazy"
              class="product-card__image"
            >
          {% endif %}
        </div>
      {% else %}
        <div class="product-card__placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </a>

    {% if is_available == false or is_on_sale %}
      <div class="product-card__badges">
        {% unless is_available %}
          <span class="product-card__badge product-card__badge--sold-out">Sold out</span>
        {% elsif is_on_sale %}
          <span class="product-card__badge product-card__badge--sale">
            <span class="product-card__badge-kicker">Sale</span>
            {% if discount_pct > 0 %}
              <span class="product-card__badge-pct">−{{ discount_pct }}%</span>
            {% endif %}
          </span>
        {% endunless %}
      </div>
    {% endif %}

    {% if is_available %}
      <!-- Mobile Frosted Glass Quick Add Button (44px Touch Target) -->
      <button
        type="button"
        class="product-card__mobile-quick-btn"
        data-mobile-quick-trigger
        aria-label="Quick add {{ card_title | escape }}"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 1V13M1 7H13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>

      <!-- Desktop Floating Frosted Glass Quick-Add Size Rail (Reveals on Hover) -->
      <div class="product-card__desktop-action-bar" aria-label="Quick add sizes">
        <div class="product-card__quick-size-pills">
          {% if product and has_sizes and is_snowboard == false %}
            {% for variant in product.variants %}
              <form method="post" action="{{ routes.cart_add_url }}" class="product-card__quick-form">
                <input type="hidden" name="id" value="{{ variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <input type="hidden" name="properties[_adot_title]" value="{{ card_title | escape }}">
                <input type="hidden" name="properties[_adot_image]" value="{{ image_src }}">
                <input type="hidden" name="properties[_adot_price]" value="{{ card_price | money_without_currency | remove: '.00' | prepend: 'Rs. ' }}">
                <button
                  type="submit"
                  class="product-card__size-pill {% unless variant.available %}product-card__size-pill--sold-out{% endunless %}"
                  {% unless variant.available %}disabled aria-disabled="true"{% endunless %}
                  data-variant-title="{{ variant.title }}"
                  title="Add size {{ variant.title }}"
                >
                  {{ variant.title }}
                </button>
              </form>
            {% endfor %}
          {% elsif product %}
            {% assign base_variant_id = product.selected_or_first_available_variant.id %}
            {% assign card_sizes = 'S,M,L,XL' | split: ',' %}
            {% for sz in card_sizes %}
              <form method="post" action="{{ routes.cart_add_url }}" class="product-card__quick-form">
                <input type="hidden" name="id" value="{{ base_variant_id }}">
                <input type="hidden" name="quantity" value="1">
                <input type="hidden" name="properties[_adot_title]" value="{{ card_title | escape }}">
                <input type="hidden" name="properties[_adot_image]" value="{{ image_src }}">
                <input type="hidden" name="properties[_adot_price]" value="{{ card_price | money_without_currency | remove: '.00' | prepend: 'Rs. ' }}">
                <input type="hidden" name="properties[Size]" value="{{ sz }}">
                <button
                  type="submit"
                  class="product-card__size-pill"
                  data-variant-title="{{ sz }}"
                  title="Add size {{ sz }}"
                >
                  {{ sz }}
                </button>
              </form>
            {% endfor %}
          {% else %}
            {% assign demo_sizes = 'S,M,L,XL' | split: ',' %}
            {% for sz in demo_sizes %}
              <form method="post" action="{{ routes.cart_add_url }}" class="product-card__quick-form">
                <input type="hidden" name="id" value="{{ fallback_variant_id }}">
                <input type="hidden" name="quantity" value="1">
                <input type="hidden" name="properties[_adot_title]" value="{{ card_title | escape }}">
                <input type="hidden" name="properties[_adot_image]" value="{{ image_src }}">
                <input type="hidden" name="properties[_adot_price]" value="{{ card_price | money_without_currency | remove: '.00' | prepend: 'Rs. ' }}">
                <input type="hidden" name="properties[Size]" value="{{ sz }}">
                <button
                  type="submit"
                  class="product-card__size-pill {% if sz == 'XL' and is_on_sale %}product-card__size-pill--sold-out{% endif %}"
                  {% if sz == 'XL' and is_on_sale %}disabled aria-disabled="true"{% endif %}
                  data-variant-title="{{ sz }}"
                  title="Add size {{ sz }}"
                >
                  {{ sz }}
                </button>
              </form>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>

  <!-- Editorial Card Content Below Photography -->
  <div class="product-card__content">
    {% if show_vendor and card_spec != blank %}
      <div class="product-card__spec text-micro">{{ card_spec }}</div>
    {% endif %}

    <!-- Product Title (Restrained Inter 500, Balanced Line Wrapping) -->
    <h3 class="product-card__title">
      <a href="{{ card_url }}" class="product-card__title-link">
        {{ card_title }}
      </a>
    </h3>

    <!-- Meta Row: Tabular Price -->
    <div class="product-card__meta-row">
      <div class="product-card__price">
        {% if product and is_snowboard == false %}
          {% render 'price', product: product, show_badges: false %}
        {% else %}
          <div class="price {% if is_on_sale %}price--on-sale{% endif %}">
            <div class="price__container">
              {% if is_on_sale %}
                <span class="price__item price__item--sale">
                  <span class="price__currency">Rs.</span><span class="price__amount">{{ price_num }}</span>
                </span>
                <s class="price__item price__item--regular">Rs. {{ compare_num }}</s>
              {% else %}
                <span class="price__item price__item--regular">
                  <span class="price__currency">Rs.</span><span class="price__amount">{{ price_num }}</span>
                </span>
              {% endif %}
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  /* ==========================================================================
     Product Card Primitive — Quiet Luxury Architecture
     ========================================================================== */
  .product-card {
    display: flex;
    flex-direction: column;
    position: relative;
    width: 100%;
    background-color: transparent;
  }

  .product-card--sold-out .product-card__image {
    opacity: 0.65;
    filter: grayscale(30%);
  }

  /* Fixed 3:4 Aspect Ratio Container (Zero Layout Shift) */
  .product-card__media-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: var(--color-surface, #F5F5F5);
    box-sizing: border-box;
    border-radius: var(--radius-none, 0px);
  }

  .product-card__media-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .product-card__film {
    display: flex;
    height: 100%;
    width: 100%;
    transform: translateX(calc(var(--i, 0) * -100%));
    transition: transform 640ms var(--ease-in-out);
  }

  .product-card__image {
    flex: 0 0 100%;
    width: 100%;
    min-width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface, #F5F5F5);
  }

  .product-card__placeholder svg {
    width: 40%;
    height: 40%;
    fill: var(--color-text-subtle);
    opacity: 0.3;
  }

  .product-card__badges {
    position: absolute;
    top: var(--space-xs);
    inset-inline-start: var(--space-xs);
    z-index: 4;
    display: flex;
    pointer-events: none;
  }

  .product-card__badge {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.35rem 0.45rem;
    border-radius: var(--radius-none);
    font-family: var(--font-body);
    font-size: var(--font-size-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-micro);
    line-height: 1;
    text-transform: uppercase;
    user-select: none;
    -webkit-user-select: none;
  }

  .product-card__badge--sale {
    background-color: var(--color-white);
    color: var(--color-text);
    box-shadow: 0 0 0 1px var(--color-border-subtle);
  }

  .product-card__badge-pct {
    color: var(--color-sale);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .product-card__badge--sold-out {
    background-color: var(--color-text);
    color: var(--color-white);
  }

  /* ==========================================================================
     Desktop Floating Frosted Glass Quick-Add Size Rail
     - Glides up gracefully on card hover
     - Exposes direct 1-click size pills
     - Zero visual clutter when resting
     ========================================================================== */
  .product-card__desktop-action-bar {
    display: none;
  }

  @media (hover: hover) and (min-width: 750px) {
    .product-card__desktop-action-bar {
      display: flex;
      position: absolute;
      inset: auto 8px 8px 8px;
      z-index: 6;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      padding: 4px;
      box-sizing: border-box;
      opacity: 0;
      transform: translateY(6px);
      pointer-events: none;
      transition:
        transform 180ms var(--ease-out),
        opacity 180ms var(--ease-out);
    }

    .product-card:hover .product-card__desktop-action-bar,
    .product-card:focus-within .product-card__desktop-action-bar {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .product-card__quick-size-pills {
      display: flex;
      width: 100%;
      gap: 4px;
    }

    .product-card__quick-form {
      flex: 1;
      margin: 0;
      padding: 0;
    }

    .product-card__size-pill {
      width: 100%;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 1px solid transparent;
      color: var(--color-text, #111111);
      font-family: var(--font-body);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      cursor: pointer;
      border-radius: var(--radius-none);
      touch-action: manipulation;
      transition:
        background-color 140ms var(--ease-out),
        color 140ms var(--ease-out),
        transform 160ms var(--ease-out);
      -webkit-tap-highlight-color: transparent;
    }

    .product-card__size-pill:hover:not(:disabled),
    .product-card__size-pill:focus-visible:not(:disabled) {
      background-color: var(--color-text);
      color: var(--color-white);
    }

    .product-card__size-pill:active:not(:disabled) {
      transform: scale(0.96);
    }

    .product-card__size-pill--sold-out,
    .product-card__size-pill:disabled {
      opacity: 0.3;
      text-decoration: line-through;
      cursor: not-allowed;
    }
  }

  /* ==========================================================================
     Mobile Refined Frosted Glass Quick-Add Action Button
     - Guaranteed 44px hit target, sleek 34px visual circle
     - Doesn't obscure garment photo like bulky black button
     ========================================================================== */
  .product-card__mobile-quick-btn {
    position: absolute;
    right: 8px;
    bottom: 8px;
    z-index: 5;
    width: 44px;
    height: 44px;
    padding: 0;
    margin: 0;
    background: transparent;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .product-card__mobile-quick-btn::before {
    content: '';
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    transition:
      transform 160ms var(--ease-out),
      background-color 160ms var(--ease-out);
  }

  .product-card__mobile-quick-btn svg {
    position: relative;
    z-index: 1;
    color: var(--color-text, #111111);
  }

  .product-card__mobile-quick-btn:active::before {
    transform: scale(0.92);
    background-color: var(--color-white, #FFFFFF);
  }

  @media (min-width: 750px) {
    .product-card__mobile-quick-btn {
      display: none;
    }
  }

  /* ==========================================================================
     Global Mobile Quick-Add Bottom Sheet (Apple iOS / Native UX)
     ========================================================================== */
  .mobile-quick-sheet {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    pointer-events: none;
    visibility: hidden;
    transition: visibility 280ms ease;
  }

  .mobile-quick-sheet.is-active {
    pointer-events: auto;
    visibility: visible;
  }

  .mobile-quick-sheet__backdrop {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .mobile-quick-sheet.is-active .mobile-quick-sheet__backdrop {
    opacity: 1;
  }

  .mobile-quick-sheet__container {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 2;
    background-color: var(--color-background, #FFFFFF);
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    box-shadow: 0 -10px 40px rgba(0, 0, 0, 0.16);
    padding: 10px 18px max(24px, env(safe-area-inset-bottom, 24px));
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    box-sizing: border-box;
    transform: translateY(105%);
    transition: transform 340ms cubic-bezier(0.32, 0.72, 0, 1);
    will-change: transform;
  }

  .mobile-quick-sheet.is-active .mobile-quick-sheet__container {
    transform: translateY(0);
  }

  .mobile-quick-sheet__drag-handle-wrap {
    display: flex;
    justify-content: center;
    padding: 4px 0 10px;
    cursor: grab;
  }

  .mobile-quick-sheet__drag-handle {
    width: 38px;
    height: 4.5px;
    background-color: rgba(0, 0, 0, 0.16);
    border-radius: 999px;
  }

  .mobile-quick-sheet__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border-subtle, rgba(0, 0, 0, 0.08));
    margin-bottom: 12px;
  }

  .mobile-quick-sheet__product {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex: 1;
  }

  .mobile-quick-sheet__thumb-wrap {
    width: 54px;
    height: 72px;
    border-radius: 4px;
    overflow: hidden;
    background-color: var(--color-surface, #F5F5F5);
    flex-shrink: 0;
  }

  .mobile-quick-sheet__thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .mobile-quick-sheet__info {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .mobile-quick-sheet__title {
    font-size: 0.9375rem;
    font-weight: 550;
    letter-spacing: -0.01em;
    color: var(--color-text, #111111);
    margin: 0;
    line-height: 1.25;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .mobile-quick-sheet__price {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text, #111111);
    font-variant-numeric: tabular-nums;
  }

  .mobile-quick-sheet__spec {
    font-size: 0.6875rem;
    color: var(--color-text-subtle, #757575);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-top: 2px;
  }

  .mobile-quick-sheet__close {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background-color: var(--color-surface, #F5F5F5);
    border: 1px solid var(--color-border-subtle, rgba(0, 0, 0, 0.08));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text, #111111);
    cursor: pointer;
    flex-shrink: 0;
    padding: 0;
    touch-action: manipulation;
    transition: transform 140ms ease, background-color 140ms ease;
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-quick-sheet__close:active {
    transform: scale(0.92);
    background-color: var(--color-border, #E5E5E5);
  }

  .mobile-quick-sheet__label-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 10px;
  }

  .mobile-quick-sheet__label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text, #111111);
  }

  .mobile-quick-sheet__hint {
    font-size: 0.6875rem;
    color: var(--color-text-subtle, #757575);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .mobile-quick-sheet__sizes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
  }

  .mobile-quick-sheet__sizes .product-card__quick-form {
    margin: 0;
  }

  .mobile-quick-sheet__sizes .product-card__size-pill {
    width: 100%;
    min-height: 48px;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    background-color: var(--color-surface, #F8F8F8);
    border: 1.5px solid var(--color-border, #E5E5E5);
    border-radius: 4px;
    color: var(--color-text, #111111);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition:
      background-color 140ms var(--ease-out),
      color 140ms var(--ease-out),
      border-color 140ms var(--ease-out),
      transform 140ms var(--ease-out);
  }

  .mobile-quick-sheet__sizes .product-card__size-pill:active:not(:disabled) {
    transform: scale(0.95);
    background-color: var(--color-text, #111111);
    color: var(--color-white, #FFFFFF);
    border-color: var(--color-text, #111111);
  }

  .mobile-quick-sheet__sizes .product-card__size-pill--sold-out,
  .mobile-quick-sheet__sizes .product-card__size-pill:disabled {
    opacity: 0.35;
    text-decoration: line-through;
    background-color: transparent;
    border-style: dashed;
    cursor: not-allowed;
  }

  /* ==========================================================================
     Card Content Below Photography (Strict Visual Hierarchy)
     ========================================================================== */
  .product-card__content {
    display: flex;
    flex-direction: column;
    padding-top: 0.625rem;
    text-align: left;
  }

  .product-card__spec {
    color: var(--color-text-subtle, #6B6B6B);
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .product-card__title {
    font-family: var(--font-body);
    font-size: clamp(0.875rem, 1.1vw, 0.9375rem);
    font-weight: 500;
    line-height: 1.25;
    margin: 0 0 0.35rem 0;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .product-card__title-link {
    color: var(--color-text);
    text-decoration: none;
  }

  .product-card__title-link:hover,
  .product-card__title-link:focus-visible {
    opacity: 1;
  }

  .product-card__meta-row {
    display: flex;
    align-items: baseline;
    margin-top: 0.125rem;
  }

  .product-card__price {
    font-variant-numeric: tabular-nums;
    min-width: 0;
  }

  .product-card__price .price {
    display: block;
    font-size: clamp(0.875rem, 1.1vw, 0.9375rem);
    line-height: 1.2;
  }

  .product-card__price .price__container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
  }

  .product-card__price .price__currency {
    font-size: 0.8em;
    font-weight: 450;
    opacity: 0.75;
    margin-right: 1.5px;
    letter-spacing: 0;
  }

  .product-card__price .price__amount {
    font-variant-numeric: tabular-nums;
  }

  .product-card__price .price__item--sale {
    color: var(--color-sale, #991B1B);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .product-card__price .price__item--regular {
    color: var(--color-text, #111111);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .product-card__price s.price__item--regular {
    color: var(--color-text-subtle, #8A8A8A);
    font-weight: 400;
    font-size: 0.8125rem;
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    white-space: nowrap;
  }

  .product-card--sold-out .price__item--sale {
    color: var(--color-text);
    font-weight: 500;
  }



  @media (prefers-reduced-motion: reduce) {
    .product-card__image,
    .product-card__film,
    .product-card__desktop-action-bar,
    .mobile-quick-sheet__container,
    .mobile-quick-sheet__backdrop,
    .product-card__mobile-quick-btn::before,
    .product-card__size-pill {
      transition: none;
    }
  }
{% endstylesheet %}

<script>
  // Delegated handler for Mobile Quick-Add Bottom Sheet & Desktop Quick-Add
  if (!window._productCardScriptInitialized) {
    window._productCardScriptInitialized = true;

    var filmFine = false;
    var filmReduce = false;
    try {
      filmFine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      filmReduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    } catch (err) {}

    if (filmFine && !filmReduce) {
      var filmHold = 480;
      var filmSlide = 640;
      var cardOf = function (node) {
        return node && node.closest ? node.closest('[data-product-card]') : null;
      };
      var clearFilm = function (card) {
        window.clearTimeout(card._filmTimer);
      };
      var playFilm = function (card) {
        var film = card.querySelector('.product-card__film');
        if (!film || film.children.length < 2) return;
        clearFilm(card);
        var count = film.children.length;
        var index = 0;
        film.style.setProperty('--i', '0');
        var advance = function () {
          if (index >= count - 1) return;
          index += 1;
          film.style.setProperty('--i', String(index));
          card._filmTimer = window.setTimeout(advance, filmSlide + filmHold);
        };
        card._filmTimer = window.setTimeout(advance, filmHold);
      };
      var resetFilm = function (card) {
        var film = card.querySelector('.product-card__film');
        if (!film) return;
        clearFilm(card);
        var at = film.style.getPropertyValue('--i');
        if (!at || at === '0') return;
        film.style.setProperty('--i', '0');
      };
      document.addEventListener('pointerover', function (event) {
        var card = cardOf(event.target);
        if (!card || card === cardOf(event.relatedTarget)) return;
        playFilm(card);
      });
      document.addEventListener('pointerout', function (event) {
        var card = cardOf(event.target);
        if (!card || card === cardOf(event.relatedTarget)) return;
        resetFilm(card);
      });
    }

    // Helper: Ensure Global Mobile Quick Sheet in DOM
    var ensureQuickAddSheet = function () {
      var sheet = document.getElementById('MobileQuickAddSheet');
      if (!sheet) {
        sheet = document.createElement('div');
        sheet.id = 'MobileQuickAddSheet';
        sheet.className = 'mobile-quick-sheet';
        sheet.setAttribute('aria-hidden', 'true');
        sheet.setAttribute('role', 'dialog');
        sheet.setAttribute('aria-modal', 'true');
        sheet.setAttribute('inert', '');
        sheet.innerHTML = [
          '<div class="mobile-quick-sheet__backdrop" data-quick-sheet-close></div>',
          '<div class="mobile-quick-sheet__container" role="document">',
          '  <div class="mobile-quick-sheet__drag-handle-wrap" data-quick-sheet-close>',
          '    <div class="mobile-quick-sheet__drag-handle"></div>',
          '  </div>',
          '  <div class="mobile-quick-sheet__header">',
          '    <div class="mobile-quick-sheet__product">',
          '      <div class="mobile-quick-sheet__thumb-wrap">',
          '        <img class="mobile-quick-sheet__thumb" src="" alt="" width="54" height="72" loading="lazy">',
          '      </div>',
          '      <div class="mobile-quick-sheet__info">',
          '        <h4 class="mobile-quick-sheet__title"></h4>',
          '        <div class="mobile-quick-sheet__price"></div>',
          '        <div class="mobile-quick-sheet__spec text-micro"></div>',
          '      </div>',
          '    </div>',
          '    <button type="button" class="mobile-quick-sheet__close" data-quick-sheet-close aria-label="Close size sheet">',
          '      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">',
          '        <path d="M1 1L11 11M1 11L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>',
          '      </svg>',
          '    </button>',
          '  </div>',
          '  <div class="mobile-quick-sheet__body">',
          '    <div class="mobile-quick-sheet__label-row">',
          '      <span class="mobile-quick-sheet__label text-micro">Select Size</span>',
          '      <span class="mobile-quick-sheet__hint text-micro">Instant Add</span>',
          '    </div>',
          '    <div class="mobile-quick-sheet__sizes" data-quick-sheet-sizes></div>',
          '  </div>',
          '</div>'
        ].join('\n');
        document.body.appendChild(sheet);
      }
      return sheet;
    };

    var closeQuickSheet = function () {
      var sheet = document.getElementById('MobileQuickAddSheet');
      if (sheet && sheet.classList.contains('is-active')) {
        sheet.classList.remove('is-active');
        sheet.setAttribute('aria-hidden', 'true');
        sheet.setAttribute('inert', '');
        document.body.style.overflow = '';
      }
    };

    // Open/Close Mobile Quick Add Bottom Sheet
    document.addEventListener('click', function (e) {
      var mobileTrigger = e.target.closest('[data-mobile-quick-trigger]');
      if (mobileTrigger) {
        e.preventDefault();
        e.stopPropagation();
        var card = mobileTrigger.closest('[data-product-card]');
        if (!card) return;

        var sheet = ensureQuickAddSheet();
        if (!sheet) return;

        // Extract product card metadata
        var titleEl = card.querySelector('.product-card__title-link') || card.querySelector('.product-card__title');
        var title = titleEl ? titleEl.textContent.trim() : '';

        var priceEl = card.querySelector('.product-card__price');
        var priceHTML = priceEl ? priceEl.innerHTML : '';

        var imgEl = card.querySelector('.product-card__image');
        var imgSrc = imgEl ? (imgEl.currentSrc || imgEl.src) : '';

        var specEl = card.querySelector('.product-card__spec');
        var specText = specEl ? specEl.textContent.trim() : '';

        // Inject into sheet
        var sheetTitle = sheet.querySelector('.mobile-quick-sheet__title');
        if (sheetTitle) sheetTitle.textContent = title;

        var sheetPrice = sheet.querySelector('.mobile-quick-sheet__price');
        if (sheetPrice && priceHTML) sheetPrice.innerHTML = priceHTML;

        var sheetThumb = sheet.querySelector('.mobile-quick-sheet__thumb');
        if (sheetThumb && imgSrc) {
          sheetThumb.src = imgSrc;
          sheetThumb.alt = title;
        }

        var sheetSpec = sheet.querySelector('.mobile-quick-sheet__spec');
        if (sheetSpec) {
          sheetSpec.textContent = specText;
          sheetSpec.style.display = specText ? 'block' : 'none';
        }

        var sizeFormsContainer = card.querySelector('.product-card__quick-size-pills');
        var sizesTarget = sheet.querySelector('[data-quick-sheet-sizes]');
        if (sizesTarget && sizeFormsContainer) {
          sizesTarget.innerHTML = sizeFormsContainer.innerHTML;
        }

        // Reveal sheet
        sheet.classList.add('is-active');
        sheet.removeAttribute('inert');
        sheet.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        return;
      }

      if (e.target.closest('[data-quick-sheet-close]')) {
        e.preventDefault();
        closeQuickSheet();
        return;
      }

      if (e.target.classList && e.target.classList.contains('mobile-quick-sheet__backdrop')) {
        e.preventDefault();
        closeQuickSheet();
        return;
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') {
        closeQuickSheet();
      }
    });

    // Instant AJAX Add to Cart Submission with tactile feedback
    document.addEventListener('submit', function (e) {
      var form = e.target.closest('.product-card__quick-form');
      if (!form) return;

      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]');
      if (!btn || btn.disabled) return;

      var originalText = btn.textContent;
      btn.textContent = '...';
      btn.disabled = true;

      var formData = new FormData(form);

      fetch('{{ routes.cart_add_url }}.js', {
        method: 'POST',
        headers: {
          'Accept': 'application/json'
        },
        body: formData
      })
      .then(function (res) {
        if (!res.ok) throw new Error('Add to cart failed');
        return res.json();
      })
      .then(function (item) {
        btn.textContent = '✓';
        btn.style.backgroundColor = 'var(--color-text, #111111)';
        btn.style.color = '#FFFFFF';
        btn.style.borderColor = 'var(--color-text, #111111)';

        setTimeout(function () {
          btn.textContent = originalText;
          btn.disabled = false;
          btn.style.backgroundColor = '';
          btn.style.color = '';
          btn.style.borderColor = '';

          // Close mobile sheet if open
          closeQuickSheet();

          // Trigger Cart Drawer update & slide-out
          window.dispatchEvent(new CustomEvent('cart:refresh'));
          window.dispatchEvent(new CustomEvent('cart:open'));
        }, 320);
      })
      .catch(function (err) {
        console.error('Quick add failed:', err);
        btn.textContent = originalText;
        btn.disabled = false;
        form.submit();
      });
    });
  }
</script>
