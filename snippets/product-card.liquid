{% doc %}
  Product card

  A 3:4 image frame holding up to three views, a quiet caption underneath, and quick add.

  Fine pointer (desktop): moving across the image steps through the views with a clip-path
  wipe and a "1 / 3" tab; a solid size strip rises from the bottom edge of the image.
  Touch: a flush "+" tab in the corner opens a size sheet that can be dragged down to dismiss.

  The caption sets its own layout from the width the card is given (container query), so the
  same card works in a 4-up grid, an editorial layout, a rail or a two-column phone grid.
  Only transform, opacity and clip-path are animated.

  @param {product} [product] - The product object
  @param {string} [title] - Fallback title if product is nil
  @param {string} [url] - Fallback URL if product is nil
  @param {number} [variant_id] - Fallback variant ID for quick add
  @param {number} [price] - Fallback price in cents if product is nil
  @param {number} [compare_at_price] - Fallback compare at price in cents
  @param {string} [image_src] - Fallback primary image asset url
  @param {string} [secondary_image_src] - Fallback secondary image asset url
  @param {string} [spec] - Technical fabric / fit fact (optional)
  @param {boolean} [available] - Fallback availability
  @param {boolean} [lazy_load] - Whether to lazy load images (default: true)
  @param {boolean} [show_vendor] - Whether to show the category / fabric line
  @param {string} [class] - Optional additional CSS classes
  @param {string} [sizes] - Optional `sizes` attribute for the images (default suits a 4-up grid)
  @param {string} [image_sizes] - Legacy alias for `sizes` (kept so older callers keep working)
  @param {boolean} [include_script] - Set to false to leave out the script when another card on the page already carries it (default: true)
{% enddoc %}

{%- liquid
  if show_vendor == nil
    assign show_vendor = false
  endif
  if lazy_load == nil
    assign lazy_load = true
  endif

  assign card_sizes = sizes | default: image_sizes | default: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
  assign srcset_widths = '350,500,750,1000,1200' | split: ','
  assign frame_count = 1

  if product
    assign card_title = product.title
    assign card_category = product.type | downcase
    assign card_url = product.url
    assign card_price = product.price
    assign card_compare_at = product.compare_at_price
    assign is_available = product.available
    assign card_spec = product.metafields.custom.fabric_spec | default: product.type
    assign featured_media = product.featured_media
    assign has_secondary_image = false
    if product.images.size > 1
      assign has_secondary_image = true
    endif
    assign frame_count = product.images.size | at_most: 3
    if product.featured_image
      assign image_src = product.featured_image | image_url: width: 750
    endif

    assign size_option = product.options_by_name['Size']
    assign has_sizes = false
    if size_option and size_option.values.size > 0 and product.has_only_default_variant == false
      assign has_sizes = true
    endif
  else
    assign fallback_product = collections.all.products.first
    assign card_title = title | default: 'Product'
    assign card_url = url | default: fallback_product.url | default: routes.all_products_collection_url
    assign card_price = price | default: fallback_product.price | default: 0
    assign card_compare_at = compare_at_price | default: 0
    if available == nil
      assign is_available = true
    else
      assign is_available = available
    endif
    assign card_spec = spec | default: ''
    assign has_secondary_image = false
    if secondary_image_src != blank
      assign has_secondary_image = true
      assign frame_count = 2
    endif
    assign has_sizes = false
    assign fallback_variant_id = variant_id | default: fallback_product.selected_or_first_available_variant.id
  endif

  if frame_count < 1
    assign frame_count = 1
  endif

  assign is_on_sale = false
  assign discount_pct = 0
  if card_compare_at > card_price
    assign is_on_sale = true
    assign discount_diff = card_compare_at | minus: card_price
    assign discount_pct = discount_diff | times: 100.0 | divided_by: card_compare_at | round
  endif

  if lazy_load
    assign image_loading = 'lazy'
    assign image_fetch = 'auto'
  else
    assign image_loading = 'eager'
    assign image_fetch = 'high'
  endif
-%}

<div
  class="product-card {{ class }}{% unless is_available %} product-card--sold-out{% endunless %}{% if frame_count < 2 %} product-card--single{% endif %}"
  data-product-card
  data-category="{{ card_category | default: product.type | downcase }}"
>
  <div class="product-card__media-wrapper" data-frames="{{ frame_count }}">
    {%- comment -%}
      The image link is a pointer convenience only. The title link below is the one
      keyboard and screen reader users get, so the two never double up.
    {%- endcomment -%}
    <a href="{{ card_url }}" class="product-card__media-link" tabindex="-1" aria-hidden="true">
      {%- if product and featured_media -%}
        <div class="product-card__film">
          {%- for image in product.images limit: 3 -%}
            {%- liquid
              assign frame_srcset = ''
              for w in srcset_widths
                assign w_num = w | plus: 0
                if w_num <= image.width
                  assign candidate = image | image_url: width: w_num | append: ' ' | append: w_num | append: 'w'
                  if frame_srcset == ''
                    assign frame_srcset = candidate
                  else
                    assign frame_srcset = frame_srcset | append: ', ' | append: candidate
                  endif
                endif
              endfor
              if forloop.first
                assign frame_loading = image_loading
                assign frame_fetch = image_fetch
              else
                assign frame_loading = 'lazy'
                assign frame_fetch = 'auto'
              endif
            -%}
            <span class="product-card__frame">
              <img
                src="{{ image | image_url: width: 750 }}"
                {% if frame_srcset != blank %}srcset="{{ frame_srcset }}" sizes="{{ card_sizes }}"{% endif %}
                alt="{{ image.alt | default: card_title | escape }}"
                width="750"
                height="1000"
                loading="{{ frame_loading }}"
                fetchpriority="{{ frame_fetch }}"
                decoding="async"
                class="product-card__image"
              >
            </span>
          {%- endfor -%}
        </div>
      {%- elsif image_src != blank -%}
        <div class="product-card__film">
          <span class="product-card__frame">
            <img
              src="{{ image_src }}"
              alt="{{ card_title | escape }}"
              width="750"
              height="1000"
              loading="{{ image_loading }}"
              fetchpriority="{{ image_fetch }}"
              decoding="async"
              class="product-card__image"
            >
          </span>
          {%- if has_secondary_image -%}
            <span class="product-card__frame">
              <img
                src="{{ secondary_image_src }}"
                alt="{{ card_title | escape }}"
                width="750"
                height="1000"
                loading="lazy"
                decoding="async"
                class="product-card__image"
              >
            </span>
          {%- endif -%}
        </div>
      {%- else -%}
        <div class="product-card__placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endif -%}
    </a>

    {%- if is_available == false or is_on_sale -%}
      <div class="product-card__badges">
        {%- unless is_available -%}
          <span class="product-card__badge product-card__badge--sold-out">Sold out</span>
        {%- elsif is_on_sale -%}
          <span class="product-card__badge product-card__badge--sale">
            <span class="product-card__badge-kicker">Sale</span>
            {%- if discount_pct > 0 -%}
              <span class="product-card__badge-pct">−{{ discount_pct }}%</span>
            {%- endif -%}
          </span>
        {%- endunless -%}
      </div>
    {%- endif -%}

    {%- if frame_count > 1 -%}
      <span class="product-card__counter" aria-hidden="true">
        <span data-frame-current>1</span><span>/</span><span>{{ frame_count }}</span>
      </span>
    {%- endif -%}

    {%- if is_available -%}
      {%- capture card_price_prop -%}{% render 'money', price: card_price %}{%- endcapture -%}
      {%- capture quick_props -%}
        <input type="hidden" name="quantity" value="1">
        <input type="hidden" name="properties[_adot_title]" value="{{ card_title | escape }}">
        <input type="hidden" name="properties[_adot_image]" value="{{ image_src }}">
        <input type="hidden" name="properties[_adot_price]" value="{{ card_price_prop | strip }}">
      {%- endcapture -%}
      {%- capture check_icon -%}
        <svg class="product-card__size-check" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M2.5 7.5l3 3 6-7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {%- endcapture -%}

      <!-- Touch: flush corner tab that opens the size sheet -->
      <button
        type="button"
        class="product-card__mobile-quick-btn"
        data-mobile-quick-trigger
        aria-haspopup="dialog"
        aria-label="Quick add {{ card_title | escape }}"
      >
        <svg class="product-card__quick-plus" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 1V13M1 7H13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
      </button>

      <!-- Fine pointer: size strip that rises from the bottom edge -->
      <div class="product-card__desktop-action-bar" role="group" aria-label="Quick add">
        <div class="product-card__quick-size-pills">
          {%- if product and has_sizes -%}
            {%- for variant in product.variants -%}
              <form method="post" action="{{ routes.cart_add_url }}" class="product-card__quick-form">
                <input type="hidden" name="id" value="{{ variant.id }}">
                {{ quick_props }}
                <button
                  type="submit"
                  class="product-card__size-pill{% unless variant.available %} product-card__size-pill--sold-out{% endunless %}"
                  {% unless variant.available %}disabled aria-disabled="true"{% endunless %}
                  data-variant-title="{{ variant.title | escape }}"
                  aria-label="{% if variant.available %}Add size {{ variant.title | escape }} to bag{% else %}Size {{ variant.title | escape }}, sold out{% endif %}"
                >
                  <span class="product-card__size-label">{{ variant.title }}</span>{{ check_icon }}
                </button>
              </form>
            {%- endfor -%}
          {%- elsif product -%}
            {%- assign base_variant = product.selected_or_first_available_variant -%}
            <form method="post" action="{{ routes.cart_add_url }}" class="product-card__quick-form">
              <input type="hidden" name="id" value="{{ base_variant.id }}">
              {{ quick_props }}
              <button
                type="submit"
                class="product-card__size-pill{% unless base_variant.available %} product-card__size-pill--sold-out{% endunless %}"
                {% unless base_variant.available %}disabled aria-disabled="true"{% endunless %}
                data-variant-title="Add"
                aria-label="Add {{ card_title | escape }} to bag"
              >
                <span class="product-card__size-label">Add to bag</span>{{ check_icon }}
              </button>
            </form>
          {%- elsif fallback_variant_id != blank -%}
            <form method="post" action="{{ routes.cart_add_url }}" class="product-card__quick-form">
              <input type="hidden" name="id" value="{{ fallback_variant_id }}">
              {{ quick_props }}
              <button
                type="submit"
                class="product-card__size-pill"
                data-variant-title="Add"
                aria-label="Add {{ card_title | escape }} to bag"
              >
                <span class="product-card__size-label">Add to bag</span>{{ check_icon }}
              </button>
            </form>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__content">
    <div class="product-card__heading">
      <h3 class="product-card__title">
        <a href="{{ card_url }}" class="product-card__title-link">{{ card_title }}</a>
      </h3>
      {%- if show_vendor and card_spec != blank -%}
        <div class="product-card__spec">{{ card_spec }}</div>
      {%- endif -%}
    </div>

    <div class="product-card__meta-row">
      <div class="product-card__price">
        {%- if product -%}
          {% render 'price', product: product, show_badges: false %}
        {%- else -%}
          <div class="price {% if is_on_sale %}price--on-sale{% endif %}">
            <div class="price__container">
              {%- if is_on_sale -%}
                <span class="price__item price__item--sale">{% render 'money', price: card_price %}</span>
                <s class="price__item price__item--regular">{% render 'money', price: card_compare_at %}</s>
              {%- else -%}
                <span class="price__item price__item--regular">{% render 'money', price: card_price %}</span>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  /* ==========================================================================
     Product card
     Flat and architectural: paper, ink and hairlines, square corners.
     Colours and fonts come from the theme tokens. Everything that moves is
     transform, opacity or clip-path.
     ========================================================================== */
  .product-card,
  .mobile-quick-sheet {
    --pc-ink: var(--color-text, #111111);
    --pc-paper: var(--color-background, #ffffff);
    --pc-wash: var(--color-surface, #f5f5f5);
    --pc-muted: var(--color-text-subtle, #6b6b6b);
    --pc-line: var(--color-border-subtle, rgba(17, 17, 17, 0.08));
    --pc-line-strong: rgba(17, 17, 17, 0.18);
    --pc-sale: var(--color-sale, #991b1b);
    --pc-ease: var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1));
    --pc-expo: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .product-card {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
    background: transparent;
    container: product-card / inline-size;
  }

  .product-card a:hover,
  .product-card a:focus-visible {
    opacity: 1;
  }

  .product-card :focus-visible {
    outline: 2px solid var(--pc-ink);
    outline-offset: 3px;
  }

  /* ---------- Image frame ---------- */
  .product-card__media-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    isolation: isolate;
    background: var(--pc-wash);
    -webkit-tap-highlight-color: transparent;
  }

  .product-card__media-link {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .product-card__film {
    position: absolute;
    inset: 0;
  }

  .product-card__frame {
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
  }

  .product-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-card__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: var(--pc-wash);
  }

  .product-card__placeholder svg {
    width: 40%;
    height: 40%;
    fill: var(--pc-muted);
    opacity: 0.3;
  }

  .product-card--sold-out .product-card__image {
    opacity: 0.68;
    filter: grayscale(0.4);
  }

  /* Views after the first wait below the frame and wipe up over it. */
  .product-card__frame:not(:first-child) {
    clip-path: inset(100% 0 0 0);
    transition: clip-path 800ms var(--pc-expo);
  }

  .product-card__frame:not(:first-child) .product-card__image {
    transform: scale(1.08);
    transition: transform 1200ms var(--pc-expo);
  }

  @media (hover: hover) and (pointer: fine) {
    .product-card__media-wrapper:hover .product-card__frame:nth-child(2) {
      clip-path: inset(0 0 0 0);
    }

    .product-card__media-wrapper:hover .product-card__frame:nth-child(2) .product-card__image {
      transform: scale(1);
    }

    /* A single view has nothing to wipe to, so the photograph itself leans in. */
    .product-card--single .product-card__image {
      transition: transform 1400ms var(--pc-expo);
    }

    .product-card--single .product-card__media-wrapper:hover .product-card__image {
      transform: scale(1.035);
    }
  }

  /* Set by the pointer scrub: view N is showing, so every view up to N is open. */
  .product-card__media-wrapper[data-frame='1'] .product-card__frame:nth-child(-n + 2),
  .product-card__media-wrapper[data-frame='2'] .product-card__frame:nth-child(-n + 3) {
    clip-path: inset(0 0 0 0);
  }

  .product-card__media-wrapper[data-frame='1'] .product-card__frame:nth-child(-n + 2) .product-card__image,
  .product-card__media-wrapper[data-frame='2'] .product-card__frame:nth-child(-n + 3) .product-card__image {
    transform: scale(1);
  }

  /* Keyboard focus anywhere in the card shows the second view too. */
  .product-card:has(:focus-visible) .product-card__frame:nth-child(2) {
    clip-path: inset(0 0 0 0);
  }

  .product-card:has(:focus-visible) .product-card__frame:nth-child(2) .product-card__image {
    transform: scale(1);
  }

  /* Touch: the frame gives a little under the finger. */
  @media (hover: none) {
    .product-card__media-wrapper {
      transition: transform 480ms var(--pc-expo);
    }

    .product-card__media-wrapper:active {
      transform: scale(0.985);
      transition-duration: 90ms;
    }
  }

  /* ---------- Tabs: badges and the view counter sit flush in the corners ---------- */
  .product-card__badges {
    position: absolute;
    top: 0;
    inset-inline-start: 0;
    z-index: 4;
    display: flex;
    pointer-events: none;
  }

  .product-card__badge,
  .product-card__counter {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    padding: 0.5rem 0.625rem 0.45rem;
    background: var(--pc-paper);
    color: var(--pc-ink);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.01em;
    font-variant-numeric: tabular-nums;
    user-select: none;
    -webkit-user-select: none;
  }

  .product-card__badge--sold-out {
    background: var(--pc-ink);
    color: var(--pc-paper);
  }

  .product-card__badge-pct {
    color: var(--pc-sale);
  }

  .product-card__counter {
    position: absolute;
    top: 0;
    inset-inline-end: 0;
    z-index: 4;
    display: none;
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .product-card__counter {
      display: inline-flex;
      opacity: 0;
      transition: opacity 240ms var(--pc-ease);
    }

    .product-card__media-wrapper:hover .product-card__counter {
      opacity: 1;
    }
  }

  /* ---------- Size buttons (shared by the strip and the sheet) ---------- */
  .product-card__quick-form {
    margin: 0;
    padding: 0;
  }

  .product-card__size-pill {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--pc-ink);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-appearance: none;
    appearance: none;
    -webkit-tap-highlight-color: transparent;
  }

  .product-card__size-label,
  .product-card__size-check {
    grid-area: 1 / 1;
  }

  .product-card__size-label {
    transition:
      opacity 160ms var(--pc-ease),
      transform 200ms var(--pc-ease);
  }

  .product-card__size-check {
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity 160ms var(--pc-ease),
      transform 280ms var(--pc-expo);
  }

  .product-card__size-pill[data-state='adding'] .product-card__size-label {
    opacity: 0.35;
  }

  .product-card__size-pill[data-state='added'] .product-card__size-label {
    opacity: 0;
  }

  .product-card__size-pill[data-state='added'] .product-card__size-check {
    opacity: 1;
    transform: scale(1);
  }

  .product-card__size-pill--sold-out,
  .product-card__size-pill:disabled {
    opacity: 0.32;
    text-decoration: line-through;
    cursor: not-allowed;
  }

  /* ---------- Fine pointer: the size strip ---------- */
  .product-card__desktop-action-bar {
    display: none;
  }

  @media (hover: hover) and (min-width: 750px) {
    .product-card__desktop-action-bar {
      display: block;
      position: absolute;
      inset: auto 0 0 0;
      z-index: 6;
      background: var(--pc-paper);
      transform: translateY(101%);
      transition: transform 420ms var(--pc-expo);
    }

    /* Hover intent: the strip waits a beat so sweeping across a row does not flicker. */
    .product-card__media-wrapper:hover .product-card__desktop-action-bar,
    .product-card:has(:focus-visible) .product-card__desktop-action-bar {
      transform: none;
      transition-delay: 90ms;
    }

    .product-card__quick-size-pills {
      display: flex;
    }

    .product-card__quick-form {
      flex: 1 1 0;
      min-width: 0;
    }

    .product-card__quick-form + .product-card__quick-form {
      border-inline-start: 1px solid var(--pc-line);
    }

    .product-card__desktop-action-bar .product-card__size-pill {
      height: 48px;
    }

    /* The hover state is a drawn underline, so nothing but transform moves. */
    .product-card__desktop-action-bar .product-card__size-pill::after {
      content: '';
      position: absolute;
      inset: auto 28% 12px 28%;
      height: 1px;
      background: currentColor;
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 320ms var(--pc-expo);
    }

    .product-card__desktop-action-bar .product-card__size-pill:hover:not(:disabled)::after,
    .product-card__desktop-action-bar .product-card__size-pill:focus-visible:not(:disabled)::after {
      transform: scaleX(1);
    }

    .product-card__desktop-action-bar .product-card__size-pill:active:not(:disabled) .product-card__size-label {
      transform: scale(0.9);
    }

    .product-card__desktop-action-bar .product-card__size-pill:focus-visible {
      outline: 2px solid var(--pc-ink);
      outline-offset: -4px;
    }
  }

  /* ---------- Touch: the corner tab ---------- */
  .product-card__mobile-quick-btn {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 5;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: var(--pc-paper);
    color: var(--pc-ink);
    cursor: pointer;
    touch-action: manipulation;
    transform-origin: 100% 100%;
    transition: transform 180ms var(--pc-ease);
    -webkit-tap-highlight-color: transparent;
  }

  .product-card__mobile-quick-btn:active {
    transform: scale(0.88);
  }

  .product-card__mobile-quick-btn:focus-visible {
    outline: 2px solid var(--pc-ink);
    outline-offset: -4px;
  }

  .product-card__quick-plus {
    transition: transform 360ms var(--pc-expo);
  }

  .product-card__mobile-quick-btn:active .product-card__quick-plus {
    transform: rotate(90deg);
  }

  /* Where the strip is available, the tab steps aside. */
  @media (hover: hover) and (min-width: 750px) {
    .product-card__mobile-quick-btn {
      display: none;
    }
  }

  /* ---------- Caption ---------- */
  .product-card__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 0.25rem;
    padding-top: 0.75rem;
    text-align: left;
  }

  .product-card__heading {
    min-width: 0;
  }

  .product-card__title {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.35;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .product-card__title-link {
    color: var(--pc-ink);
    text-decoration: none;
  }

  .product-card__spec {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    margin: 0.2rem 0 0;
    overflow: hidden;
    color: var(--pc-muted);
    font-size: 0.75rem;
    line-height: 1.4;
    letter-spacing: 0.005em;
  }

  .product-card__meta-row {
    display: flex;
    align-items: baseline;
    min-width: 0;
  }

  .product-card__price {
    min-width: 0;
    font-size: 0.875rem;
    line-height: 1.35;
    font-variant-numeric: tabular-nums;
  }

  .product-card__price .price {
    display: flex;
    align-items: baseline;
    gap: 0;
    font-size: inherit;
    line-height: inherit;
    letter-spacing: 0;
  }

  .product-card__price .price__container {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.5rem;
  }

  .product-card__price .price__item--regular,
  .product-card__price .price__item--sale {
    font-weight: 400;
    letter-spacing: 0;
  }

  .product-card__price .price__item--sale {
    color: var(--pc-sale);
  }

  .product-card__price .price s.price__item--regular {
    color: var(--pc-muted);
    font-size: 0.8125em;
    font-weight: 400;
    text-decoration-thickness: 1px;
    white-space: nowrap;
  }

  .product-card--sold-out .product-card__price .price__item--sale {
    color: var(--pc-ink);
  }

  /* From about 270px the price moves to the right edge, on the title's baseline. */
  @container product-card (min-width: 17rem) {
    .product-card__content {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 1.25rem;
      align-items: baseline;
      padding-top: 0.875rem;
    }

    .product-card__meta-row {
      grid-column: 2;
      grid-row: 1;
      justify-content: flex-end;
      text-align: right;
    }

    .product-card__price .price__container {
      justify-content: flex-end;
    }
  }

  /* Larger frames earn larger type. */
  @container product-card (min-width: 26rem) {
    .product-card__content {
      padding-top: 1rem;
    }

    .product-card__title,
    .product-card__price {
      font-size: 1rem;
    }

    .product-card__spec {
      font-size: 0.8125rem;
    }
  }

  /* Hidden status line for screen readers. */
  .product-card__live {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ==========================================================================
     Size sheet (touch)
     ========================================================================== */
  .mobile-quick-sheet {
    position: fixed;
    inset: 0;
    z-index: 1200;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0s linear 480ms;
  }

  .mobile-quick-sheet.is-active {
    pointer-events: auto;
    visibility: visible;
    transition-delay: 0s;
  }

  .mobile-quick-sheet__backdrop {
    position: fixed;
    inset: 0;
    background: rgba(17, 17, 17, 0.42);
    opacity: 0;
    transition: opacity 360ms var(--pc-ease);
  }

  .mobile-quick-sheet.is-active .mobile-quick-sheet__backdrop {
    opacity: 1;
  }

  .mobile-quick-sheet__container {
    position: relative;
    z-index: 2;
    box-sizing: border-box;
    width: 100%;
    max-width: 520px;
    margin: 0 auto;
    padding: 0 1.25rem max(1.5rem, env(safe-area-inset-bottom, 0px));
    background: var(--pc-paper);
    color: var(--pc-ink);
    transform: translateY(100%);
    transition: transform 480ms cubic-bezier(0.32, 0.72, 0, 1);
    outline: none;
  }

  .mobile-quick-sheet.is-active .mobile-quick-sheet__container {
    transform: translateY(0);
  }

  .mobile-quick-sheet__drag-handle-wrap {
    display: flex;
    justify-content: center;
    padding: 0.875rem 0 0.75rem;
    cursor: grab;
    touch-action: none;
  }

  .mobile-quick-sheet__drag-handle {
    width: 32px;
    height: 2px;
    background: var(--pc-line-strong);
  }

  .mobile-quick-sheet__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--pc-line);
    touch-action: none;
  }

  .mobile-quick-sheet__product {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    flex: 1;
    min-width: 0;
  }

  .mobile-quick-sheet__thumb-wrap {
    flex-shrink: 0;
    width: 54px;
    height: 72px;
    overflow: hidden;
    background: var(--pc-wash);
  }

  .mobile-quick-sheet__thumb {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .mobile-quick-sheet__info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }

  .mobile-quick-sheet__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    margin: 0;
    overflow: hidden;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.005em;
  }

  .mobile-quick-sheet__price {
    font-size: 0.875rem;
    line-height: 1.3;
    font-variant-numeric: tabular-nums;
  }

  .mobile-quick-sheet__price .price {
    font-size: inherit;
    gap: 0;
  }

  .mobile-quick-sheet__price .price__item--regular,
  .mobile-quick-sheet__price .price__item--sale {
    font-weight: 400;
    letter-spacing: 0;
  }

  .mobile-quick-sheet__price .price__item--sale {
    color: var(--pc-sale);
  }

  .mobile-quick-sheet__price .price s.price__item--regular {
    color: var(--pc-muted);
    font-size: 0.8125em;
    font-weight: 400;
  }

  .mobile-quick-sheet__spec {
    color: var(--pc-muted);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .mobile-quick-sheet__close {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    margin: -0.5rem -0.75rem 0 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: var(--pc-ink);
    cursor: pointer;
    touch-action: manipulation;
    transition: transform 160ms var(--pc-ease);
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-quick-sheet__close:active {
    transform: scale(0.88);
  }

  .mobile-quick-sheet :focus-visible {
    outline: 2px solid var(--pc-ink);
    outline-offset: 2px;
  }

  .mobile-quick-sheet__label-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 1.125rem 0 0.75rem;
  }

  .mobile-quick-sheet__label {
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .mobile-quick-sheet__hint {
    color: var(--pc-muted);
    font-size: 0.75rem;
  }

  .mobile-quick-sheet__sizes {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
  }

  .mobile-quick-sheet__sizes.is-single {
    grid-template-columns: minmax(0, 1fr);
  }

  .mobile-quick-sheet__sizes .product-card__size-pill {
    min-height: 52px;
    border: 1px solid var(--pc-line-strong);
    background: var(--pc-paper);
    font-size: 0.9375rem;
    transition: transform 180ms var(--pc-ease);
  }

  .mobile-quick-sheet__sizes.is-single .product-card__size-pill {
    font-size: 0.875rem;
  }

  /* The press state flips instantly; only the scale is animated. */
  .mobile-quick-sheet__sizes .product-card__size-pill:active:not(:disabled),
  .mobile-quick-sheet__sizes .product-card__size-pill[data-state='added'] {
    transform: scale(0.97);
    border-color: var(--pc-ink);
    background: var(--pc-ink);
    color: var(--pc-paper);
  }

  .mobile-quick-sheet__sizes .product-card__size-pill--sold-out,
  .mobile-quick-sheet__sizes .product-card__size-pill:disabled {
    border-style: dashed;
    background: transparent;
  }

  /* ---------- Reduced motion ---------- */
  @media (prefers-reduced-motion: reduce) {
    .product-card *,
    .product-card *::before,
    .product-card *::after,
    .mobile-quick-sheet,
    .mobile-quick-sheet *,
    .mobile-quick-sheet *::before,
    .mobile-quick-sheet *::after {
      transition-duration: 0.01ms !important;
      transition-delay: 0s !important;
      animation: none !important;
    }

    .product-card__media-wrapper:active {
      transform: none;
    }
  }
{% endstylesheet %}

{%- if include_script == nil or include_script -%}
<script>
  // One delegated script serves every card on the page. The flag keeps it from
  // binding twice when more than one card (or section) carries it.
  (function () {
    if (window._productCardScriptInitialized) return;
    window._productCardScriptInitialized = true;

    var doc = document;
    var fine = false;
    try {
      fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    } catch (err) {}

    /* ---------- Fine pointer: step through the views by moving across the image ---------- */
    if (fine) {
      var scrub = { media: null, x: 0, raf: 0 };

      var mediaOf = function (node) {
        return node && node.closest ? node.closest('.product-card__media-wrapper') : null;
      };

      var setFrame = function (media, index) {
        var current = media.getAttribute('data-frame') || '0';
        if (current === String(index)) return;
        if (index === 0) media.removeAttribute('data-frame');
        else media.setAttribute('data-frame', String(index));
        var label = media.querySelector('[data-frame-current]');
        if (label) label.textContent = String(index + 1);
      };

      var settle = function () {
        scrub.raf = 0;
        var media = scrub.media;
        if (!media) return;
        var count = parseInt(media.getAttribute('data-frames'), 10) || 1;
        if (count < 2) return;
        // Hovering always opens the second view; with a third, the pointer's side decides.
        var index = 1;
        if (count > 2) {
          var box = media.getBoundingClientRect();
          var ratio = box.width ? (scrub.x - box.left) / box.width : 0;
          index = 1 + Math.min(count - 2, Math.max(0, Math.floor(ratio * (count - 1))));
        }
        setFrame(media, index);
      };

      var follow = function (event) {
        if (event.pointerType && event.pointerType !== 'mouse' && event.pointerType !== 'pen') return;
        var media = mediaOf(event.target);
        if (!media) return;
        scrub.media = media;
        scrub.x = event.clientX;
        if (!scrub.raf) scrub.raf = window.requestAnimationFrame(settle);
      };

      doc.addEventListener('pointerover', follow, { passive: true });
      doc.addEventListener('pointermove', follow, { passive: true });
      doc.addEventListener('pointerout', function (event) {
        var media = mediaOf(event.target);
        if (!media || media === mediaOf(event.relatedTarget)) return;
        if (scrub.media === media) scrub.media = null;
        setFrame(media, 0);
      }, { passive: true });
    }

    /* ---------- Screen reader status ---------- */
    var live = null;
    var announce = function (message) {
      if (!live) {
        live = doc.createElement('div');
        live.className = 'product-card__live';
        live.setAttribute('role', 'status');
        live.setAttribute('aria-live', 'polite');
        doc.body.appendChild(live);
      }
      live.textContent = '';
      window.setTimeout(function () { live.textContent = message; }, 40);
    };

    /* ---------- Size sheet ---------- */
    var lastTrigger = null;

    var ensureSheet = function () {
      var sheet = doc.getElementById('MobileQuickAddSheet');
      if (sheet) return sheet;
      sheet = doc.createElement('div');
      sheet.id = 'MobileQuickAddSheet';
      sheet.className = 'mobile-quick-sheet';
      sheet.setAttribute('role', 'dialog');
      sheet.setAttribute('aria-modal', 'true');
      sheet.setAttribute('aria-labelledby', 'MobileQuickAddSheetTitle');
      sheet.setAttribute('aria-hidden', 'true');
      sheet.setAttribute('inert', '');
      sheet.innerHTML = [
        '<div class="mobile-quick-sheet__backdrop" data-quick-sheet-close></div>',
        '<div class="mobile-quick-sheet__container" tabindex="-1">',
        '  <div class="mobile-quick-sheet__drag-handle-wrap" data-quick-sheet-grip>',
        '    <div class="mobile-quick-sheet__drag-handle"></div>',
        '  </div>',
        '  <div class="mobile-quick-sheet__header" data-quick-sheet-grip>',
        '    <div class="mobile-quick-sheet__product">',
        '      <div class="mobile-quick-sheet__thumb-wrap">',
        '        <img class="mobile-quick-sheet__thumb" src="" alt="" width="54" height="72" decoding="async">',
        '      </div>',
        '      <div class="mobile-quick-sheet__info">',
        '        <h4 class="mobile-quick-sheet__title" id="MobileQuickAddSheetTitle"></h4>',
        '        <div class="mobile-quick-sheet__price"></div>',
        '        <div class="mobile-quick-sheet__spec"></div>',
        '      </div>',
        '    </div>',
        '    <button type="button" class="mobile-quick-sheet__close" data-quick-sheet-close aria-label="Close">',
        '      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">',
        '        <path d="M1 1L11 11M1 11L11 1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>',
        '      </svg>',
        '    </button>',
        '  </div>',
        '  <div class="mobile-quick-sheet__body">',
        '    <div class="mobile-quick-sheet__label-row">',
        '      <span class="mobile-quick-sheet__label" data-quick-sheet-label>Select size</span>',
        '      <span class="mobile-quick-sheet__hint">Tap to add</span>',
        '    </div>',
        '    <div class="mobile-quick-sheet__sizes" data-quick-sheet-sizes></div>',
        '  </div>',
        '</div>'
      ].join('\n');
      doc.body.appendChild(sheet);
      // Commit the closed state once, so the very first open still slides up.
      sheet.getBoundingClientRect();
      return sheet;
    };

    var sheetBox = function (sheet) {
      return sheet.querySelector('.mobile-quick-sheet__container');
    };

    var openSheet = function (card, trigger) {
      var sheet = ensureSheet();

      var titleEl = card.querySelector('.product-card__title-link') || card.querySelector('.product-card__title');
      var title = titleEl ? titleEl.textContent.trim() : '';
      var priceEl = card.querySelector('.product-card__price');
      var imgEl = card.querySelector('.product-card__image');
      var imgSrc = imgEl ? (imgEl.currentSrc || imgEl.src) : '';
      var specEl = card.querySelector('.product-card__spec');
      var specText = specEl ? specEl.textContent.trim() : '';
      var forms = card.querySelector('.product-card__quick-size-pills');

      sheet.querySelector('.mobile-quick-sheet__title').textContent = title;

      var sheetPrice = sheet.querySelector('.mobile-quick-sheet__price');
      if (priceEl) sheetPrice.innerHTML = priceEl.innerHTML;

      var thumb = sheet.querySelector('.mobile-quick-sheet__thumb');
      if (imgSrc) {
        thumb.src = imgSrc;
        thumb.alt = '';
      }

      var spec = sheet.querySelector('.mobile-quick-sheet__spec');
      spec.textContent = specText;
      spec.style.display = specText ? 'block' : 'none';

      var sizes = sheet.querySelector('[data-quick-sheet-sizes]');
      var label = sheet.querySelector('[data-quick-sheet-label]');
      if (forms) sizes.innerHTML = forms.innerHTML;
      Array.prototype.forEach.call(sizes.querySelectorAll('[data-state]'), function (node) {
        node.removeAttribute('data-state');
      });
      // A product with no size choice gets one plain "Add to bag" button.
      var single = !!sizes.querySelector('[data-variant-title="Add"]');
      sizes.classList.toggle('is-single', single);
      label.textContent = single ? 'Add to bag' : 'Select size';

      lastTrigger = trigger;
      var box = sheetBox(sheet);
      box.style.transition = '';
      box.style.transform = '';
      sheet.querySelector('.mobile-quick-sheet__backdrop').style.opacity = '';

      sheet.classList.add('is-active');
      sheet.removeAttribute('inert');
      sheet.setAttribute('aria-hidden', 'false');
      doc.body.style.overflow = 'hidden';

      window.requestAnimationFrame(function () {
        try { box.focus({ preventScroll: true }); } catch (err) { box.focus(); }
      });
    };

    var closeSheet = function () {
      var sheet = doc.getElementById('MobileQuickAddSheet');
      if (!sheet || !sheet.classList.contains('is-active')) return;
      sheet.classList.remove('is-active');
      sheet.setAttribute('aria-hidden', 'true');
      sheet.setAttribute('inert', '');
      doc.body.style.overflow = '';
      if (lastTrigger && doc.contains(lastTrigger)) {
        try { lastTrigger.focus({ preventScroll: true }); } catch (err) {}
      }
      lastTrigger = null;
    };

    doc.addEventListener('click', function (event) {
      var target = event.target;
      if (!target || !target.closest) return;

      var trigger = target.closest('[data-mobile-quick-trigger]');
      if (trigger) {
        event.preventDefault();
        event.stopPropagation();
        var card = trigger.closest('[data-product-card]');
        if (card) openSheet(card, trigger);
        return;
      }

      if (target.closest('[data-quick-sheet-close]')) {
        event.preventDefault();
        closeSheet();
      }
    });

    doc.addEventListener('keydown', function (event) {
      var sheet = doc.getElementById('MobileQuickAddSheet');
      if (!sheet || !sheet.classList.contains('is-active')) return;

      if (event.key === 'Escape') {
        closeSheet();
        return;
      }

      if (event.key === 'Tab') {
        var stops = sheet.querySelectorAll('button:not(:disabled)');
        if (!stops.length) {
          event.preventDefault();
          return;
        }
        var first = stops[0];
        var last = stops[stops.length - 1];
        var active = doc.activeElement;
        if (event.shiftKey && (active === first || active === sheetBox(sheet))) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && active === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    /* ---------- Drag the sheet down to dismiss ---------- */
    var drag = null;

    doc.addEventListener('pointerdown', function (event) {
      var target = event.target;
      if (!target || !target.closest) return;
      var grip = target.closest('[data-quick-sheet-grip]');
      if (!grip || target.closest('button')) return;
      var sheet = doc.getElementById('MobileQuickAddSheet');
      if (!sheet || !sheet.classList.contains('is-active')) return;

      var box = sheetBox(sheet);
      drag = {
        id: event.pointerId,
        grip: grip,
        box: box,
        backdrop: sheet.querySelector('.mobile-quick-sheet__backdrop'),
        startY: event.clientY,
        offset: 0,
        lastY: event.clientY,
        lastT: event.timeStamp,
        velocity: 0
      };
      box.style.transition = 'none';
      try { grip.setPointerCapture(event.pointerId); } catch (err) {}
    });

    doc.addEventListener('pointermove', function (event) {
      if (!drag || event.pointerId !== drag.id) return;
      var offset = Math.max(0, event.clientY - drag.startY);
      var dt = event.timeStamp - drag.lastT;
      if (dt > 0) drag.velocity = (event.clientY - drag.lastY) / dt;
      drag.lastY = event.clientY;
      drag.lastT = event.timeStamp;
      drag.offset = offset;
      drag.box.style.transform = 'translateY(' + offset + 'px)';
      var height = drag.box.offsetHeight || 1;
      drag.backdrop.style.opacity = String(Math.max(0, 1 - offset / height));
    });

    var endDrag = function (event) {
      if (!drag || event.pointerId !== drag.id) return;
      var current = drag;
      drag = null;
      try { current.grip.releasePointerCapture(event.pointerId); } catch (err) {}

      var dismiss = current.offset > 96 || current.velocity > 0.6;
      // Handing the transition back first lets the release glide from where the finger left it.
      current.box.style.transition = '';
      current.backdrop.style.opacity = '';
      current.box.style.transform = '';
      if (dismiss) closeSheet();
    };

    doc.addEventListener('pointerup', endDrag);
    doc.addEventListener('pointercancel', endDrag);

    /* ---------- Quick add ---------- */
    doc.addEventListener('submit', function (event) {
      var form = event.target && event.target.closest ? event.target.closest('.product-card__quick-form') : null;
      if (!form || event.defaultPrevented) return;

      event.preventDefault();
      var btn = form.querySelector('button[type="submit"]');
      if (!btn || btn.disabled || btn.getAttribute('data-state')) return;

      btn.setAttribute('data-state', 'adding');

      fetch(form.getAttribute('action') + '.js', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: new FormData(form)
      })
        .then(function (res) {
          if (!res.ok) throw new Error('Add to cart failed');
          return res.json();
        })
        .then(function () {
          btn.setAttribute('data-state', 'added');
          announce('Added to bag');
          window.dispatchEvent(new CustomEvent('cart:refresh'));

          window.setTimeout(function () {
            closeSheet();
            window.dispatchEvent(new CustomEvent('cart:open'));
          }, 380);

          window.setTimeout(function () {
            btn.removeAttribute('data-state');
          }, 1400);
        })
        .catch(function (err) {
          console.error('Quick add failed:', err);
          btn.removeAttribute('data-state');
          form.submit();
        });
    });
  })();
</script>
{%- endif -%}
