{% doc %}
  Modern Editorial Luxury Product Card Primitive
  Crafted with:
  - better-typography: Tabular prices, balanced line wrapping, restrained type scale.
  - emil-design-eng: Custom cubic-bezier easing, snappy <220ms durations, :active press scale(0.96), scoped hover transitions.
  - find-animation-opportunities: High-leverage motion (smooth image crossfade, tactile button depression, floating glass quick-add).
  - apple-design: Translucent frosted glassmorphism (backdrop-filter: blur(16px)), direct manipulation, zero clutter, 44px touch targets.

  @param {product} [product] - The product object
  @param {string} [title] - Fallback title if product is nil
  @param {string} [url] - Fallback URL if product is nil
  @param {number} [variant_id] - Fallback variant ID for quick add
  @param {number} [price] - Fallback price in cents if product is nil
  @param {number} [compare_at_price] - Fallback compare at price in cents
  @param {string} [image_src] - Fallback primary image asset url
  @param {string} [secondary_image_src] - Fallback secondary image asset url
  @param {string} [spec] - Technical fabric / fit fact (optional)
  @param {number} [color_count] - Number of colors (only shown if > 1)
  @param {boolean} [available] - Fallback availability
  @param {boolean} [lazy_load] - Whether to lazy load images (default: true)
  @param {boolean} [show_vendor] - Whether to show category or vendor
  @param {string} [class] - Optional additional CSS classes
{% enddoc %}

{% liquid
  if show_vendor == nil
    assign show_vendor = false
  endif
  if lazy_load == nil
    assign lazy_load = true
  endif

  if product
    assign is_snowboard = false
    if product.type contains 'snowboard' or product.title contains 'Snowboard' or product.handle contains 'snowboard' or product.handle contains 'ski-wax'
      assign is_snowboard = true
    endif

    assign hoodie_img = 'category-hoodies.jpg' | asset_url
    assign hoodie_png = 'category-hoodies.png' | asset_url
    assign shirt_img = 'category-shirts.jpg' | asset_url
    assign shirt_png = 'category-shirts.png' | asset_url
    assign trouser_img = 'category-trousers.jpg' | asset_url
    assign trouser_png = 'category-trousers.png' | asset_url

    if is_snowboard
      case product.handle
        when 'the-complete-snowboard'
          assign card_title = 'Heavyweight Boxy Hoodie'
          assign card_category = 'hoodies'
          assign card_price = 449900
          assign card_compare_at = 0
          assign card_spec = '450 GSM Loopback Fleece'
          assign image_src = hoodie_img
          assign secondary_image_src = hoodie_png
        when 'the-collection-snowboard-hydrogen'
          assign card_title = 'Relaxed Poplin Shirt'
          assign card_category = 'shirts'
          assign card_price = 369900
          assign card_compare_at = 449900
          assign card_spec = '100% Crisp Long-Staple Cotton'
          assign image_src = shirt_img
          assign secondary_image_src = shirt_png
        when 'the-collection-snowboard-liquid'
          assign card_title = 'Tailored Pleated Trousers'
          assign card_category = 'trousers'
          assign card_price = 429900
          assign card_compare_at = 0
          assign card_spec = 'High-Density Cotton Twill'
          assign image_src = trouser_img
          assign secondary_image_src = trouser_png
        when 'the-collection-snowboard-oxygen'
          assign card_title = 'Heavyweight Zip Hoodie'
          assign card_category = 'hoodies'
          assign card_price = 489900
          assign card_compare_at = 0
          assign card_spec = '450 GSM Heavy Fleece'
          assign image_src = hoodie_img
          assign secondary_image_src = hoodie_png
        when 'the-compare-at-price-snowboard'
          assign card_title = 'Oversized Oxford Button-Down'
          assign card_category = 'shirts'
          assign card_price = 389900
          assign card_compare_at = 450000
          assign card_spec = 'Heavyweight Oxford Weave'
          assign image_src = shirt_img
          assign secondary_image_src = shirt_png
        when 'selling-plans-ski-wax'
          assign card_title = 'Wide-Leg Minimalist Chino'
          assign card_category = 'trousers'
          assign card_price = 399900
          assign card_compare_at = 0
          assign card_spec = 'Brushed Cotton Chino Twill'
          assign image_src = trouser_img
          assign secondary_image_src = trouser_png
        when 'the-inventory-not-tracked-snowboard'
          assign card_title = 'Heavyweight Loopback Crewneck'
          assign card_category = 'hoodies'
          assign card_price = 399900
          assign card_compare_at = 0
          assign card_spec = '450 GSM Unbrushed Cotton'
          assign image_src = hoodie_img
          assign secondary_image_src = hoodie_png
        when 'the-3p-fulfilled-snowboard'
          assign card_title = 'Double-Pleat Cotton Chino'
          assign card_category = 'trousers'
          assign card_price = 419900
          assign card_compare_at = 0
          assign card_spec = 'Custom Weave Twill'
          assign image_src = trouser_img
          assign secondary_image_src = trouser_png
        when 'the-multi-location-snowboard'
          assign card_title = 'Oversized Fleece Pullover'
          assign card_category = 'hoodies'
          assign card_price = 469900
          assign card_compare_at = 0
          assign card_spec = '450 GSM Combed Fleece'
          assign image_src = hoodie_img
          assign secondary_image_src = hoodie_png
        when 'the-multi-managed-snowboard'
          assign card_title = 'Structured Twill Overshirt'
          assign card_category = 'shirts'
          assign card_price = 419900
          assign card_compare_at = 0
          assign card_spec = 'Heavy Structured Twill'
          assign image_src = shirt_img
          assign secondary_image_src = shirt_png
        when 'the-videographer-snowboard'
          assign card_title = 'Relaxed Straight Trousers'
          assign card_category = 'trousers'
          assign card_price = 449900
          assign card_compare_at = 0
          assign card_spec = 'Heavy Italian-style Twill'
          assign image_src = trouser_img
          assign secondary_image_src = trouser_png
        when 'the-out-of-stock-snowboard'
          assign card_title = 'Relaxed Camp Collar Shirt'
          assign card_category = 'shirts'
          assign card_price = 379900
          assign card_compare_at = 0
          assign card_spec = 'Soft Washed Poplin'
          assign image_src = shirt_img
          assign secondary_image_src = shirt_png
        else
          assign card_title = 'Heavyweight Boxy Hoodie'
          assign card_category = 'hoodies'
          assign card_price = 449900
          assign card_compare_at = 0
          assign card_spec = '450 GSM Loopback Fleece'
          assign image_src = hoodie_img
          assign secondary_image_src = hoodie_png
      endcase
      assign card_url = product.url
      assign is_available = product.available
      assign has_secondary_image = true
      assign featured_media = nil
    else
      assign card_title = product.title
      assign card_category = product.type | downcase
      assign card_url = product.url
      assign card_price = product.price
      assign card_compare_at = product.compare_at_price
      assign is_available = product.available
      assign card_spec = product.metafields.custom.fabric_spec | default: product.type
      assign featured_media = product.featured_media
      assign has_secondary_image = false
      if product.media.size > 1
        assign secondary_media = product.media[1]
        assign has_secondary_image = true
      endif
    endif

    assign color_option = product.options_by_name['Color'] | default: product.options_by_name['Colour']
    assign has_colors = false
    if color_option and color_option.values.size > 1
      assign has_colors = true
      assign color_num = color_option.values.size
    endif

    assign size_option = product.options_by_name['Size']
    assign has_sizes = false
    if size_option and size_option.values.size > 0
      assign has_sizes = true
    endif
  else
    assign fallback_product = collections.all.products.first
    assign card_title = title | default: 'Heavyweight Boxy Hoodie'
    assign card_url = url | default: fallback_product.url | default: '/products/the-complete-snowboard'
    assign card_price = price | default: 449900
    assign card_compare_at = compare_at_price | default: 0
    if available == nil
      assign is_available = true
    else
      assign is_available = available
    endif
    assign card_spec = spec | default: '450 GSM · Relaxed Fit'
    assign has_secondary_image = false
    if secondary_image_src != blank
      assign has_secondary_image = true
    endif
    if color_count and color_count > 1
      assign has_colors = true
      assign color_num = color_count
    else
      assign has_colors = false
    endif
    assign has_sizes = true
    assign fallback_variant_id = variant_id | default: fallback_product.selected_or_first_available_variant.id
  endif

  assign is_on_sale = false
  assign discount_pct = 0
  if card_compare_at > card_price
    assign is_on_sale = true
    assign discount_diff = card_compare_at | minus: card_price
    assign discount_pct = discount_diff | times: 100.0 | divided_by: card_compare_at | round
  endif

  assign price_num = card_price | money_without_currency | remove: '.00'
  assign compare_num = card_compare_at | money_without_currency | remove: '.00'

  if lazy_load
    assign image_loading = 'lazy'
    assign image_fetch = 'auto'
  else
    assign image_loading = 'eager'
    assign image_fetch = 'high'
  endif
%}

<div
  class="product-card {{ class }} {% unless is_available %}product-card--sold-out{% endunless %}"
  data-product-card
  data-category="{{ card_category | default: product.type | downcase }}"
>
  <!-- Media Frame with Fixed 3:4 Aspect Ratio (Zero-CLS) -->
  <div class="product-card__media-wrapper">
    <a href="{{ card_url }}" class="product-card__media-link" aria-label="{{ card_title | escape }}">
      {% if product and featured_media %}
        {{
          featured_media
          | image_url: width: 750
          | image_tag:
            loading: image_loading,
            fetchpriority: image_fetch,
            width: 750,
            height: 1000,
            widths: '350, 500, 750',
            sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
            class: 'product-card__image product-card__image--primary',
            alt: featured_media.alt | default: card_title | escape
        }}

        {% if has_secondary_image %}
          {{
            secondary_media
            | image_url: width: 750
            | image_tag:
              loading: 'lazy',
              width: 750,
              height: 1000,
              widths: '350, 500, 750',
              sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw',
              class: 'product-card__image product-card__image--secondary',
              alt: secondary_media.alt | default: card_title | escape
          }}
        {% endif %}
      {% elsif image_src != blank %}
        <img
          src="{{ image_src }}"
          alt="{{ card_title | escape }}"
          width="750"
          height="1000"
          loading="{{ image_loading }}"
          fetchpriority="{{ image_fetch }}"
          class="product-card__image product-card__image--primary"
        >
        {% if has_secondary_image %}
          <img
            src="{{ secondary_image_src }}"
            alt="{{ card_title | escape }}"
            width="750"
            height="1000"
            loading="lazy"
            class="product-card__image product-card__image--secondary"
          >
        {% endif %}
      {% else %}
        <div class="product-card__placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {% endif %}
    </a>

    {% if is_available == false or is_on_sale %}
      <div class="product-card__badges">
        {% unless is_available %}
          <span class="product-card__badge product-card__badge--sold-out">Sold out</span>
        {% elsif is_on_sale %}
          <span class="product-card__badge product-card__badge--sale">
            <span class="product-card__badge-kicker">Sale</span>
            {% if discount_pct > 0 %}
              <span class="product-card__badge-pct">−{{ discount_pct }}%</span>
            {% endif %}
          </span>
        {% endunless %}
      </div>
    {% endif %}

    {% if is_available %}
      <!-- Mobile Frosted Glass Quick Add Button (44px Touch Target) -->
      <button
        type="button"
        class="product-card__mobile-quick-btn"
        data-mobile-quick-trigger
        aria-label="Quick add {{ card_title | escape }}"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 1V13M1 7H13" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>

      <!-- Desktop Floating Frosted Glass Quick-Add Size Rail (Reveals on Hover) -->
      <div class="product-card__desktop-action-bar" aria-label="Quick add sizes">
        <div class="product-card__quick-size-pills">
          {% if product and has_sizes and is_snowboard == false %}
            {% for variant in product.variants %}
              <form method="post" action="{{ routes.cart_add_url }}" class="product-card__quick-form">
                <input type="hidden" name="id" value="{{ variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <input type="hidden" name="properties[_adot_title]" value="{{ card_title | escape }}">
                <input type="hidden" name="properties[_adot_image]" value="{{ image_src }}">
                <input type="hidden" name="properties[_adot_price]" value="{{ card_price | money_without_currency | remove: '.00' | prepend: 'Rs. ' }}">
                <button
                  type="submit"
                  class="product-card__size-pill {% unless variant.available %}product-card__size-pill--sold-out{% endunless %}"
                  {% unless variant.available %}disabled aria-disabled="true"{% endunless %}
                  data-variant-title="{{ variant.title }}"
                  title="Add size {{ variant.title }}"
                >
                  {{ variant.title }}
                </button>
              </form>
            {% endfor %}
          {% elsif product %}
            {% assign base_variant_id = product.selected_or_first_available_variant.id %}
            {% assign card_sizes = 'S,M,L,XL' | split: ',' %}
            {% for sz in card_sizes %}
              <form method="post" action="{{ routes.cart_add_url }}" class="product-card__quick-form">
                <input type="hidden" name="id" value="{{ base_variant_id }}">
                <input type="hidden" name="quantity" value="1">
                <input type="hidden" name="properties[_adot_title]" value="{{ card_title | escape }}">
                <input type="hidden" name="properties[_adot_image]" value="{{ image_src }}">
                <input type="hidden" name="properties[_adot_price]" value="{{ card_price | money_without_currency | remove: '.00' | prepend: 'Rs. ' }}">
                <input type="hidden" name="properties[Size]" value="{{ sz }}">
                <button
                  type="submit"
                  class="product-card__size-pill"
                  data-variant-title="{{ sz }}"
                  title="Add size {{ sz }}"
                >
                  {{ sz }}
                </button>
              </form>
            {% endfor %}
          {% else %}
            {% assign demo_sizes = 'S,M,L,XL' | split: ',' %}
            {% for sz in demo_sizes %}
              <form method="post" action="{{ routes.cart_add_url }}" class="product-card__quick-form">
                <input type="hidden" name="id" value="{{ fallback_variant_id }}">
                <input type="hidden" name="quantity" value="1">
                <input type="hidden" name="properties[_adot_title]" value="{{ card_title | escape }}">
                <input type="hidden" name="properties[_adot_image]" value="{{ image_src }}">
                <input type="hidden" name="properties[_adot_price]" value="{{ card_price | money_without_currency | remove: '.00' | prepend: 'Rs. ' }}">
                <input type="hidden" name="properties[Size]" value="{{ sz }}">
                <button
                  type="submit"
                  class="product-card__size-pill {% if sz == 'XL' and is_on_sale %}product-card__size-pill--sold-out{% endif %}"
                  {% if sz == 'XL' and is_on_sale %}disabled aria-disabled="true"{% endif %}
                  data-variant-title="{{ sz }}"
                  title="Add size {{ sz }}"
                >
                  {{ sz }}
                </button>
              </form>
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <!-- Mobile Slide-Up Size Selector Sheet -->
      <div class="product-card__mobile-sheet" data-mobile-sheet aria-hidden="true">
        <div class="mobile-sheet__header">
          <span class="mobile-sheet__title text-micro">Select Size</span>
          <button type="button" class="mobile-sheet__close" data-sheet-close aria-label="Close size sheet">
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M1 1L11 11M1 11L11 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
        <div class="mobile-sheet__sizes">
          {% if product and has_sizes and is_snowboard == false %}
            {% for variant in product.variants %}
              <form method="post" action="{{ routes.cart_add_url }}" class="mobile-sheet__form">
                <input type="hidden" name="id" value="{{ variant.id }}">
                <input type="hidden" name="quantity" value="1">
                <input type="hidden" name="properties[_adot_title]" value="{{ card_title | escape }}">
                <input type="hidden" name="properties[_adot_image]" value="{{ image_src }}">
                <input type="hidden" name="properties[_adot_price]" value="{{ card_price | money_without_currency | remove: '.00' | prepend: 'Rs. ' }}">
                <button
                  type="submit"
                  class="mobile-sheet__btn {% unless variant.available %}mobile-sheet__btn--sold-out{% endunless %}"
                  {% unless variant.available %}disabled aria-disabled="true"{% endunless %}
                  data-variant-title="{{ variant.title }}"
                >
                  {{ variant.title }}
                </button>
              </form>
            {% endfor %}
          {% elsif product %}
            {% assign base_variant_id = product.selected_or_first_available_variant.id %}
            {% assign card_sizes = 'S,M,L,XL' | split: ',' %}
            {% for sz in card_sizes %}
              <form method="post" action="{{ routes.cart_add_url }}" class="mobile-sheet__form">
                <input type="hidden" name="id" value="{{ base_variant_id }}">
                <input type="hidden" name="quantity" value="1">
                <input type="hidden" name="properties[_adot_title]" value="{{ card_title | escape }}">
                <input type="hidden" name="properties[_adot_image]" value="{{ image_src }}">
                <input type="hidden" name="properties[_adot_price]" value="{{ card_price | money_without_currency | remove: '.00' | prepend: 'Rs. ' }}">
                <input type="hidden" name="properties[Size]" value="{{ sz }}">
                <button
                  type="submit"
                  class="mobile-sheet__btn"
                  data-variant-title="{{ sz }}"
                >
                  {{ sz }}
                </button>
              </form>
            {% endfor %}
          {% else %}
            {% assign demo_sizes = 'S,M,L,XL' | split: ',' %}
            {% for sz in demo_sizes %}
              <form method="post" action="{{ routes.cart_add_url }}" class="mobile-sheet__form">
                <input type="hidden" name="id" value="{{ fallback_variant_id }}">
                <input type="hidden" name="quantity" value="1">
                <input type="hidden" name="properties[_adot_title]" value="{{ card_title | escape }}">
                <input type="hidden" name="properties[_adot_image]" value="{{ image_src }}">
                <input type="hidden" name="properties[_adot_price]" value="{{ card_price | money_without_currency | remove: '.00' | prepend: 'Rs. ' }}">
                <input type="hidden" name="properties[Size]" value="{{ sz }}">
                <button
                  type="submit"
                  class="mobile-sheet__btn {% if sz == 'XL' and is_on_sale %}mobile-sheet__btn--sold-out{% endif %}"
                  {% if sz == 'XL' and is_on_sale %}disabled aria-disabled="true"{% endif %}
                  data-variant-title="{{ sz }}"
                >
                  {{ sz }}
                </button>
              </form>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>

  <!-- Editorial Card Content Below Photography -->
  <div class="product-card__content">
    {% if show_vendor and card_spec != blank %}
      <div class="product-card__spec text-micro">{{ card_spec }}</div>
    {% endif %}

    <!-- Product Title (Restrained Inter 500, Balanced Line Wrapping) -->
    <h3 class="product-card__title">
      <a href="{{ card_url }}" class="product-card__title-link">
        {{ card_title }}
      </a>
    </h3>

    <!-- Meta Row: Tabular Price + Optional Subtle Color Pill -->
    <div class="product-card__meta-row">
      <div class="product-card__price">
        {% if product and is_snowboard == false %}
          {% render 'price', product: product, show_badges: false %}
        {% else %}
          <div class="price {% if is_on_sale %}price--on-sale{% endif %}">
            <div class="price__container">
              {% if is_on_sale %}
                <span class="price__item price__item--sale">
                  <span class="price__currency">Rs.</span><span class="price__amount">{{ price_num }}</span>
                </span>
                <s class="price__item price__item--regular">Rs. {{ compare_num }}</s>
              {% else %}
                <span class="price__item price__item--regular">
                  <span class="price__currency">Rs.</span><span class="price__amount">{{ price_num }}</span>
                </span>
              {% endif %}
            </div>
          </div>
        {% endif %}
      </div>

      {% if has_colors %}
        <div class="product-card__colors">{{ color_num }} {% if color_num == 1 %}color{% else %}colors{% endif %}</div>
      {% endif %}
    </div>
  </div>
</div>

{% stylesheet %}
  /* ==========================================================================
     Product Card Primitive — Quiet Luxury Architecture
     ========================================================================== */
  .product-card {
    display: flex;
    flex-direction: column;
    position: relative;
    width: 100%;
    background-color: transparent;
  }

  .product-card--sold-out .product-card__image {
    opacity: 0.65;
    filter: grayscale(30%);
  }

  /* Fixed 3:4 Aspect Ratio Container (Zero Layout Shift) */
  .product-card__media-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: var(--color-surface, #F5F5F5);
    box-sizing: border-box;
    border-radius: var(--radius-none, 0px);
  }

  .product-card__media-link {
    display: block;
    width: 100%;
    height: 100%;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition:
      transform 280ms var(--ease-out),
      opacity 200ms var(--ease-out);
  }

  .product-card__image--primary {
    position: relative;
    z-index: 1;
  }

  .product-card__image--secondary {
    position: absolute;
    inset: 0;
    opacity: 0;
    z-index: 2;
  }

  /* Desktop Hover Reveal (Gated per emil-design-eng) */
  @media (hover: hover) and (pointer: fine) {
    .product-card:hover .product-card__image--primary {
      transform: scale(1.02);
    }

    .product-card:hover .product-card__image--secondary {
      opacity: 1;
      transform: scale(1.02);
    }
  }

  .product-card__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface, #F5F5F5);
  }

  .product-card__placeholder svg {
    width: 40%;
    height: 40%;
    fill: var(--color-text-subtle);
    opacity: 0.3;
  }

  .product-card__badges {
    position: absolute;
    top: var(--space-xs);
    inset-inline-start: var(--space-xs);
    z-index: 4;
    display: flex;
    pointer-events: none;
  }

  .product-card__badge {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    padding: 0.35rem 0.45rem;
    border-radius: var(--radius-none);
    font-family: var(--font-body);
    font-size: var(--font-size-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-micro);
    line-height: 1;
    text-transform: uppercase;
    user-select: none;
    -webkit-user-select: none;
  }

  .product-card__badge--sale {
    background-color: var(--color-white);
    color: var(--color-text);
    box-shadow: 0 0 0 1px var(--color-border-subtle);
  }

  .product-card__badge-pct {
    color: var(--color-sale);
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .product-card__badge--sold-out {
    background-color: var(--color-text);
    color: var(--color-white);
  }

  /* ==========================================================================
     Desktop Floating Frosted Glass Quick-Add Size Rail
     - Glides up gracefully on card hover
     - Exposes direct 1-click size pills
     - Zero visual clutter when resting
     ========================================================================== */
  .product-card__desktop-action-bar {
    display: none;
  }

  @media (hover: hover) and (min-width: 750px) {
    .product-card__desktop-action-bar {
      display: flex;
      position: absolute;
      inset: auto 8px 8px 8px;
      z-index: 6;
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.8);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
      padding: 4px;
      box-sizing: border-box;
      opacity: 0;
      transform: translateY(6px);
      pointer-events: none;
      transition:
        transform 180ms var(--ease-out),
        opacity 180ms var(--ease-out);
    }

    .product-card:hover .product-card__desktop-action-bar,
    .product-card:focus-within .product-card__desktop-action-bar {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    .product-card__quick-size-pills {
      display: flex;
      width: 100%;
      gap: 4px;
    }

    .product-card__quick-form {
      flex: 1;
      margin: 0;
      padding: 0;
    }

    .product-card__size-pill {
      width: 100%;
      height: 32px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 1px solid transparent;
      color: var(--color-text, #111111);
      font-family: var(--font-body);
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      cursor: pointer;
      border-radius: var(--radius-none);
      touch-action: manipulation;
      transition:
        background-color 140ms var(--ease-out),
        color 140ms var(--ease-out),
        transform 160ms var(--ease-out);
      -webkit-tap-highlight-color: transparent;
    }

    .product-card__size-pill:hover:not(:disabled),
    .product-card__size-pill:focus-visible:not(:disabled) {
      background-color: var(--color-text);
      color: var(--color-white);
    }

    .product-card__size-pill:active:not(:disabled) {
      transform: scale(0.96);
    }

    .product-card__size-pill--sold-out,
    .product-card__size-pill:disabled {
      opacity: 0.3;
      text-decoration: line-through;
      cursor: not-allowed;
    }
  }

  /* ==========================================================================
     Mobile Refined Frosted Glass Quick-Add Action Button
     - Guaranteed 44px hit target, sleek 34px visual circle
     - Doesn't obscure garment photo like bulky black button
     ========================================================================== */
  .product-card__mobile-quick-btn {
    position: absolute;
    right: 6px;
    bottom: 6px;
    z-index: 5;
    width: 44px;
    height: 44px;
    padding: 0;
    margin: 0;
    background: transparent;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .product-card__mobile-quick-btn::before {
    content: '';
    position: absolute;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-none);
    background-color: color-mix(in srgb, var(--color-white) 92%, transparent);
    border: 1px solid var(--color-border-subtle);
    transition:
      transform 160ms var(--ease-out),
      background-color 160ms var(--ease-out);
  }

  .product-card__mobile-quick-btn svg {
    position: relative;
    z-index: 1;
    color: var(--color-text, #111111);
  }

  .product-card__mobile-quick-btn:active::before {
    transform: scale(0.96);
    background-color: var(--color-white);
  }

  @media (min-width: 750px) {
    .product-card__mobile-quick-btn {
      display: none;
    }
  }

  /* ==========================================================================
     Mobile Slide-Up Mini Size Sheet
     - Spring-like entrance with Apple-grade frosted glass
     ========================================================================== */
  .product-card__mobile-sheet {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 10;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.08);
    padding: 8px 10px 10px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 6px;
    transform: translateY(102%);
    transition:
      transform 280ms var(--ease-drawer),
      visibility 280ms var(--ease-drawer);
    pointer-events: none;
    visibility: hidden;
  }

  .product-card__mobile-sheet.is-active {
    transform: translateY(0);
    pointer-events: auto;
    visibility: visible;
  }

  .mobile-sheet__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mobile-sheet__title {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text, #111111);
  }

  .mobile-sheet__close {
    background: transparent;
    border: none;
    color: var(--color-text-muted, #555555);
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    touch-action: manipulation;
  }

  .mobile-sheet__sizes {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
  }

  .mobile-sheet__form {
    margin: 0;
    padding: 0;
  }

  .mobile-sheet__btn {
    width: 100%;
    min-height: 44px;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-none);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: var(--font-size-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    touch-action: manipulation;
    transition:
      background-color 140ms var(--ease-out),
      color 140ms var(--ease-out),
      transform 160ms var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }

  .mobile-sheet__btn:active:not(:disabled) {
    transform: scale(0.96);
    background-color: var(--color-text);
    color: var(--color-white);
  }

  .mobile-sheet__btn--sold-out,
  .mobile-sheet__btn:disabled {
    opacity: 0.3;
    text-decoration: line-through;
    cursor: not-allowed;
    background-color: transparent;
  }

  /* ==========================================================================
     Card Content Below Photography (Strict Visual Hierarchy)
     ========================================================================== */
  .product-card__content {
    display: flex;
    flex-direction: column;
    padding-top: 0.625rem;
    text-align: left;
  }

  .product-card__spec {
    color: var(--color-text-subtle, #6B6B6B);
    letter-spacing: 0.08em;
    font-size: 0.6875rem;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .product-card__title {
    font-family: var(--font-body);
    font-size: clamp(0.875rem, 1.1vw, 0.9375rem);
    font-weight: 500;
    line-height: 1.25;
    margin: 0 0 0.35rem 0;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .product-card__title-link {
    color: var(--color-text);
    text-decoration: none;
  }

  .product-card__title-link:hover,
  .product-card__title-link:focus-visible {
    opacity: 1;
  }

  .product-card__meta-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    column-gap: var(--space-xs);
    row-gap: 0.15rem;
    margin-top: 0.125rem;
  }

  .product-card__price {
    font-variant-numeric: tabular-nums;
    min-width: 0;
  }

  .product-card__price .price {
    display: block;
    font-size: clamp(0.875rem, 1.1vw, 0.9375rem);
    line-height: 1.2;
  }

  .product-card__price .price__container {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.15rem;
  }

  .product-card__price .price__currency {
    font-size: 0.8em;
    font-weight: 450;
    opacity: 0.75;
    margin-right: 1.5px;
    letter-spacing: 0;
  }

  .product-card__price .price__amount {
    font-variant-numeric: tabular-nums;
  }

  .product-card__price .price__item--sale {
    color: var(--color-sale, #991B1B);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .product-card__price .price__item--regular {
    color: var(--color-text, #111111);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .product-card__price s.price__item--regular {
    color: var(--color-text-subtle, #8A8A8A);
    font-weight: 400;
    font-size: 0.8125rem;
    text-decoration: line-through;
    text-decoration-thickness: 1px;
    white-space: nowrap;
  }

  .product-card--sold-out .price__item--sale {
    color: var(--color-text);
    font-weight: 500;
  }

  .product-card__colors {
    justify-self: end;
    align-self: start;
    margin-top: 0.2rem;
    color: var(--color-text-subtle);
    font-family: var(--font-body);
    font-size: var(--font-size-micro);
    font-weight: 500;
    letter-spacing: var(--tracking-micro);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .product-card__image,
    .product-card__desktop-action-bar,
    .product-card__mobile-sheet,
    .product-card__mobile-quick-btn::before,
    .product-card__size-pill,
    .mobile-sheet__btn {
      transition: none;
    }
  }
{% endstylesheet %}

<script>
  // Delegated handler for Mobile Size Sheet & Desktop AJAX Quick-Add
  if (!window._productCardScriptInitialized) {
    window._productCardScriptInitialized = true;

    // Open/Close Mobile Size Sheet
    document.addEventListener('click', (e) => {
      const mobileTrigger = e.target.closest('[data-mobile-quick-trigger]');
      if (mobileTrigger) {
        e.preventDefault();
        e.stopPropagation();
        const card = mobileTrigger.closest('[data-product-card]');
        if (!card) return;
        const sheet = card.querySelector('[data-mobile-sheet]');
        if (sheet) {
          document.querySelectorAll('[data-mobile-sheet].is-active').forEach(s => {
            if (s !== sheet) s.classList.remove('is-active');
          });
          sheet.classList.toggle('is-active');
          sheet.setAttribute('aria-hidden', !sheet.classList.contains('is-active'));
        }
        return;
      }

      const closeBtn = e.target.closest('[data-sheet-close]');
      if (closeBtn) {
        e.preventDefault();
        const sheet = closeBtn.closest('[data-mobile-sheet]');
        if (sheet) {
          sheet.classList.remove('is-active');
          sheet.setAttribute('aria-hidden', 'true');
        }
        return;
      }

      // Outside click closes any open mobile sheet
      if (!e.target.closest('[data-mobile-sheet]')) {
        document.querySelectorAll('[data-mobile-sheet].is-active').forEach(s => {
          s.classList.remove('is-active');
          s.setAttribute('aria-hidden', 'true');
        });
      }
    });

    // Close on Escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('[data-mobile-sheet].is-active').forEach(s => {
          s.classList.remove('is-active');
          s.setAttribute('aria-hidden', 'true');
        });
      }
    });

    // Instant AJAX Add to Cart Submission with tactile feedback
    document.addEventListener('submit', (e) => {
      const form = e.target.closest('.product-card__quick-form, .mobile-sheet__form');
      if (!form) return;

      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]');
      if (!btn || btn.disabled) return;

      const originalText = btn.textContent;
      btn.textContent = '...';
      btn.disabled = true;

      const formData = new FormData(form);

      fetch('{{ routes.cart_add_url }}.js', {
        method: 'POST',
        headers: {
          'Accept': 'application/json'
        },
        body: formData
      })
      .then(res => {
        if (!res.ok) throw new Error('Add to cart failed');
        return res.json();
      })
      .then(item => {
        btn.textContent = '✓';
        btn.style.backgroundColor = 'var(--color-text, #111111)';
        btn.style.color = '#FFFFFF';

        setTimeout(() => {
          btn.textContent = originalText;
          btn.disabled = false;
          btn.style.backgroundColor = '';
          btn.style.color = '';

          // Close mobile sheet if open
          const sheet = form.closest('[data-mobile-sheet]');
          if (sheet) {
            sheet.classList.remove('is-active');
            sheet.setAttribute('aria-hidden', 'true');
          }

          // Trigger Cart Drawer update & slide-out
          window.dispatchEvent(new CustomEvent('cart:refresh'));
          window.dispatchEvent(new CustomEvent('cart:open'));
        }, 320);
      })
      .catch(err => {
        console.error('Quick add failed:', err);
        btn.textContent = originalText;
        btn.disabled = false;
        form.submit(); // fallback to standard submission
      });
    });
  }
</script>
