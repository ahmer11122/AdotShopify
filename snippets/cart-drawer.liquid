{% comment %}
  Cart Drawer Component
  - Slide-out luxury drawer from right edge
  - Brand logo and minimalist title in header
  - Real-time quantity adjustment & deletion via Shopify AJAX API
  - Fluid spring entrance/exit motion
{% endcomment %}

<cart-drawer
  class="cart-drawer"
  id="CartDrawer"
  role="dialog"
  aria-modal="false"
  aria-hidden="true"
  inert
  aria-label="Shopping Bag"
  data-qty-root
  data-section-id="{{ section_id }}"
  data-cart-total="{{ cart.total_price }}"
  data-cart-count-value="{{ cart.item_count }}"
>
  <div class="cart-drawer__backdrop" data-cart-close></div>

  <div class="cart-drawer__panel">
    <!-- Header: Brand Logo, Title, Counter & Close Button -->
    <div class="cart-drawer__header">
      <div class="cart-drawer__header-left">
        <a href="{{ routes.root_url }}" class="cart-drawer__logo-link" aria-label="{{ shop.name }}">
          <img
            src="{{ 'logo.png' | asset_url }}"
            alt="{{ shop.name }}"
            class="cart-drawer__logo-img"
            width="36"
            height="39"
            loading="lazy"
          >
        </a>
        <div class="cart-drawer__title-wrap">
          <span class="cart-drawer__title text-micro">SHOPPING BAG</span>
          <span class="cart-drawer__counter text-micro" data-drawer-count>[{{ cart.item_count }}]</span>
        </div>
      </div>

      <button type="button" class="cart-drawer__close" data-cart-close aria-label="Close cart">
        <svg class="cart-drawer__close-icon" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <line x1="1" y1="1" x2="17" y2="17"></line>
          <line x1="17" y1="1" x2="1" y2="17"></line>
        </svg>
      </button>
    </div>

    <!-- Scrollable Body: Cart Items or Empty State -->
    <div class="cart-drawer__body">
      <!-- Items Container -->
      <div class="cart-drawer__items" data-cart-items>
        {% for item in cart.items %}
          {% assign item_title = item.properties._adot_title | default: item.product.title %}
          {% if item.properties._adot_image != blank %}
            {% assign item_image = item.properties._adot_image %}
          {% elsif item.image %}
            {% assign item_image = item.image | image_url: width: 240 %}
          {% else %}
            {% assign item_image = '' %}
          {% endif %}
          {% capture money_line %}{% render 'money', price: item.final_line_price %}{% endcapture %}
          {% assign item_price = item.properties._adot_price | default: money_line | strip %}
          {% assign item_size = item.properties.Size %}
          {% assign price_is_override = false %}
          {% if item.properties._adot_price != blank %}
            {% assign price_is_override = true %}
          {% endif %}

          {% capture qty_cap %}{% render 'cart-qty-cap', variant: item.variant %}{% endcapture %}
          {% assign qty_cap = qty_cap | strip %}
          <div
            class="cart-drawer__item"
            data-item-key="{{ item.key }}"
            data-variant-id="{{ item.variant.id }}"
            data-unit-price="{{ item.final_price }}"
            data-shown-qty="{{ item.quantity }}"
            {% if qty_cap != blank %}data-qty-max="{{ qty_cap }}"{% endif %}
          >
            <a href="{{ item.url }}" class="cart-drawer__item-media" tabindex="-1">
              {% if item_image != blank %}
                <img
                  src="{{ item_image }}"
                  alt="{{ item_title | escape }}"
                  class="cart-drawer__item-img"
                  width="80"
                  height="106"
                  loading="lazy"
                >
              {% endif %}
            </a>

            <div class="cart-drawer__item-info">
              <a href="{{ item.url }}" class="cart-drawer__item-title">{{ item_title | escape }}</a>
              {% if item_size != blank %}
                <p class="cart-drawer__item-variant text-micro">Size: {{ item_size }}</p>
              {% elsif item.product.has_only_default_variant == false %}
                <p class="cart-drawer__item-variant text-micro">{{ item.variant.title }}</p>
              {% endif %}
              <div class="cart-drawer__item-price text-micro"{% unless price_is_override %} data-line-price{% endunless %}>{{ item_price }}</div>

              <div class="cart-drawer__item-actions">
                <div class="cart-drawer__qty">
                  <button type="button" class="cart-drawer__qty-btn" data-qty-change="-1" data-qty-minus data-key="{{ item.key }}" aria-label="Decrease quantity">−</button>
                  <span class="cart-drawer__qty-num text-micro" data-qty-value>{{ item.quantity }}</span>
                  <button type="button" class="cart-drawer__qty-btn{% if qty_cap != blank and item.quantity >= qty_cap %} is-at-max{% endif %}" data-qty-change="1" data-qty-plus data-key="{{ item.key }}" aria-label="Increase quantity" {% if qty_cap != blank and item.quantity >= qty_cap %}aria-disabled="true"{% endif %}>+</button>
                </div>
                <button type="button" class="cart-drawer__remove text-micro" data-remove-item data-key="{{ item.key }}">Remove</button>
              </div>
              <p class="cart-qty-note text-micro" data-qty-note role="status" hidden></p>
            </div>
          </div>
        {% endfor %}
      </div>

      <!-- Empty Zero-State -->
      <div class="cart-drawer__empty" data-cart-empty {% if cart.item_count > 0 %}hidden{% endif %}>
        <div class="cart-drawer__empty-icon" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 8h12l1.5 13H4.5L6 8z"></path>
            <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
          </svg>
        </div>
        <h3 class="cart-drawer__empty-title text-micro">YOUR BAG IS EMPTY</h3>
        <p class="cart-drawer__empty-subtitle text-micro">Explore our latest seasonal collections and luxury essentials.</p>

        <div class="cart-drawer__empty-links">
          <a href="{{ routes.all_products_collection_url }}?category=hoodies" class="cart-drawer__empty-link text-micro" data-cart-close>Hoodies Collection</a>
          <a href="{{ routes.all_products_collection_url }}?category=shirts" class="cart-drawer__empty-link text-micro" data-cart-close>Shirts Collection</a>
          <a href="{{ routes.all_products_collection_url }}?category=trousers" class="cart-drawer__empty-link text-micro" data-cart-close>Trousers Collection</a>
          <a href="{{ routes.all_products_collection_url }}" class="cart-drawer__empty-link cart-drawer__empty-link--primary text-micro" data-cart-close>All Essentials →</a>
        </div>
      </div>
    </div>

    <!-- Pinned Footer: Subtotal & Checkout -->
    <div class="cart-drawer__footer" {% if cart.item_count == 0 %}hidden{% endif %}>
      <div class="cart-drawer__subtotal-row">
        <span class="cart-drawer__subtotal-label text-micro">SUBTOTAL</span>
        <span class="cart-drawer__subtotal-val" data-cart-subtotal>{% render 'money', price: cart.total_price %}</span>
      </div>
      <p class="cart-drawer__taxes text-micro">Taxes and shipping calculated at checkout.</p>

      <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__form">
        <button type="submit" name="checkout" class="cart-drawer__checkout-btn">
          <span>CHECKOUT</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="1" y1="7" x2="13" y2="7"></line>
            <polyline points="8 2 13 7 8 12"></polyline>
          </svg>
        </button>
      </form>

      <a href="{{ routes.cart_url }}" class="cart-drawer__view-cart text-micro">View Full Bag</a>
    </div>
  </div>
</cart-drawer>
