{% comment %}
  =============================================================================
  Cart Drawer (v2)
  Render with:
    {% render 'cart-drawer',
        section_id: section.id,
        free_threshold: section.settings.free_shipping_threshold,
        trust_text: section.settings.cart_trust_text,
        wa_number: wa_number %}

  Notes
  - The drawer is drawn here, by Liquid. JavaScript only swaps in new HTML.
  - Prices always come from Shopify (never from line item properties).
  - Every row has data-* values so the JavaScript can build a WhatsApp message.
  =============================================================================
{% endcomment %}

{% liquid
  assign threshold_cents = free_threshold | default: 0 | times: 100
  assign progress = 0
  assign remaining = 0
  if threshold_cents > 0
    assign remaining = threshold_cents | minus: cart.total_price
    if remaining < 0
      assign remaining = 0
    endif
    assign progress = cart.total_price | times: 100 | divided_by: threshold_cents
    if progress > 100
      assign progress = 100
    endif
  endif
%}

<cart-drawer
  class="cart-drawer"
  id="CartDrawer"
  role="dialog"
  aria-modal="false"
  aria-hidden="true"
  inert
  aria-label="Shopping Bag"
  data-section-id="{{ section_id }}"
  data-wa="{{ wa_number }}"
  data-cart-total="{{ cart.total_price }}"
  data-cart-count-value="{{ cart.item_count }}"
>
  <div class="cart-drawer__backdrop" data-cart-close></div>

  <div class="cart-drawer__panel">
    <div class="cart-drawer__header">
      <div class="cart-drawer__header-left">
        <a href="{{ routes.root_url }}" class="cart-drawer__logo-link" aria-label="{{ shop.name }}">
          <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" class="cart-drawer__logo-img" width="36" height="39" loading="lazy">
        </a>
        <div class="cart-drawer__title-wrap">
          <span class="cart-drawer__title text-micro">SHOPPING BAG</span>
          <span class="cart-drawer__counter text-micro" data-drawer-count>[{{ cart.item_count }}]</span>
        </div>
      </div>

      <button type="button" class="cart-drawer__close" data-cart-close aria-label="Close bag">
        <svg class="cart-drawer__close-icon" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <line x1="1" y1="1" x2="17" y2="17"></line>
          <line x1="17" y1="1" x2="1" y2="17"></line>
        </svg>
      </button>
    </div>

    {% if threshold_cents > 0 %}
      <div class="cart-drawer__progress{% if remaining == 0 and cart.item_count > 0 %} is-done{% endif %}" data-cart-progress {% if cart.item_count == 0 %}hidden{% endif %}>
        <p class="cart-drawer__progress-text text-micro" data-progress-text>
          {%- if remaining == 0 -%}
            You get free delivery
          {%- else -%}
            Add {{ remaining | money }} more for free delivery
          {%- endif -%}
        </p>
        <div class="cart-drawer__bar" aria-hidden="true">
          <span class="cart-drawer__bar-fill" data-progress-fill style="--p: {{ progress | divided_by: 100.0 }};"></span>
        </div>
      </div>
    {% endif %}

    <div class="cart-drawer__body">
      <div class="cart-drawer__items" data-cart-items>
        {% for item in cart.items %}
          {% assign item_title = item.product.title %}
          {% if item.properties._adot_title != blank %}
            {% assign item_title = item.properties._adot_title %}
          {% endif %}
          {% assign item_variant = '' %}
          {% if item.properties.Size != blank %}
            {% assign item_variant = item.properties.Size %}
          {% elsif item.product.has_only_default_variant == false %}
            {% assign item_variant = item.variant.title %}
          {% endif %}

          <div
            class="cart-drawer__item"
            data-item-key="{{ item.key }}"
            data-variant-id="{{ item.variant.id }}"
            data-qty="{{ item.quantity }}"
            data-title="{{ item_title | escape }}"
            data-variant="{{ item_variant | escape }}"
          >
            <a href="{{ item.url }}" class="cart-drawer__item-media" tabindex="-1">
              {% if item.image %}
                {{
                  item.image
                  | image_url: width: 240
                  | image_tag:
                    class: 'cart-drawer__item-img',
                    alt: item_title,
                    width: 80,
                    height: 106,
                    loading: 'lazy'
                }}
              {% endif %}
            </a>

            <div class="cart-drawer__item-info">
              <a href="{{ item.url }}" class="cart-drawer__item-title">{{ item_title }}</a>
              {% if item_variant != blank %}
                <p class="cart-drawer__item-variant text-micro">{% if item.properties.Size != blank %}Size: {% endif %}{{ item_variant }}</p>
              {% endif %}
              <div class="cart-drawer__item-price text-micro" data-line-price>
                {% if item.original_line_price > item.final_line_price %}
                  <s class="cart-drawer__was">{{ item.original_line_price | money }}</s>
                {% endif %}
                {{ item.final_line_price | money }}
              </div>

              <div class="cart-drawer__item-actions">
                <div class="cart-drawer__qty">
                  <button type="button" class="cart-drawer__qty-btn" data-qty-change="-1" data-key="{{ item.key }}" aria-label="Decrease quantity of {{ item_title | escape }}">−</button>
                  <span class="cart-drawer__qty-num text-micro" data-qty-value>{{ item.quantity }}</span>
                  <button type="button" class="cart-drawer__qty-btn" data-qty-change="1" data-key="{{ item.key }}" aria-label="Increase quantity of {{ item_title | escape }}">+</button>
                </div>
                <button type="button" class="cart-drawer__remove text-micro" data-remove-item data-key="{{ item.key }}">Remove</button>
              </div>
              <p class="cart-qty-note text-micro" data-qty-note role="status" hidden></p>
            </div>
          </div>
        {% endfor %}
      </div>

      <div class="cart-drawer__empty" data-cart-empty {% if cart.item_count > 0 %}hidden{% endif %}>
        <div class="cart-drawer__empty-icon" aria-hidden="true">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 8h12l1.5 13H4.5L6 8z"></path>
            <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
          </svg>
        </div>
        <h3 class="cart-drawer__empty-title text-micro">YOUR BAG IS EMPTY</h3>
        <p class="cart-drawer__empty-subtitle text-micro">Pick a piece and it will wait for you here.</p>

        <div class="cart-drawer__empty-links">
          <a href="{{ routes.collections_url }}/hoodies" class="cart-drawer__empty-link text-micro" data-cart-close>Hoodies</a>
          <a href="{{ routes.collections_url }}/sweatshirts" class="cart-drawer__empty-link text-micro" data-cart-close>Sweatshirts</a>
          <a href="{{ routes.collections_url }}/trousers" class="cart-drawer__empty-link text-micro" data-cart-close>Trousers</a>
          <a href="{{ routes.all_products_collection_url }}" class="cart-drawer__empty-link cart-drawer__empty-link--primary text-micro" data-cart-close>Shop All</a>
        </div>
      </div>
    </div>

    <div class="cart-drawer__toast" data-cart-toast role="status" hidden>
      <span data-toast-text></span>
      <button type="button" class="cart-drawer__toast-undo text-micro" data-toast-undo>Undo</button>
    </div>

    <div class="cart-drawer__footer" {% if cart.item_count == 0 %}hidden{% endif %}>
      <div class="cart-drawer__subtotal-wrap">
        <div class="cart-drawer__subtotal-row">
          <span class="cart-drawer__subtotal-label text-micro">SUBTOTAL</span>
          <span class="cart-drawer__subtotal-val" data-cart-subtotal>{{ cart.total_price | money }}</span>
        </div>
        <p class="cart-drawer__taxes text-micro">Delivery & taxes calculated at checkout</p>
      </div>

      {% assign trust_lines = trust_text | split: '|' %}
      {% if trust_lines.size > 0 and trust_text != blank %}
        <div class="cart-drawer__trust" role="note" aria-label="Order reassurance">
          {% for line in trust_lines %}
            {% assign trimmed = line | strip %}
            {% if trimmed != blank %}
              <span class="cart-drawer__trust-item text-micro">{{ trimmed | escape }}</span>
              {% unless forloop.last %}<span class="cart-drawer__trust-sep" aria-hidden="true">·</span>{% endunless %}
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}

      <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__form">
        <button type="submit" name="checkout" class="cart-drawer__checkout-btn">
          <span>CHECKOUT</span>
        </button>
      </form>

      {% if wa_number != blank %}
        <a href="https://wa.me/{{ wa_number }}" class="cart-drawer__wa text-micro" data-cart-wa target="_blank" rel="noopener" hidden>Order on WhatsApp</a>
      {% endif %}

      <a href="{{ routes.cart_url }}" class="cart-drawer__view-cart text-micro">View Full Bag</a>
    </div>
  </div>
</cart-drawer>
