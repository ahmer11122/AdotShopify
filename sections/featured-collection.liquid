{% comment %}
  New Arrivals

  A typographic header over an equal-weight product grid.
  - Desktop: four equal columns, same 3:4 image ratio. Images align at the top; captions hang
    below at whatever height they need. Editorial mode steps every second card down a beat.
  - Tablet: two equal columns, right-hand card stepped down.
  - Phone: one column (full width, then a narrower piece on alternating sides) or two columns
    with the right-hand column set lower. Follows the "Mobile Layout" setting.
  - "Editorial layout" off keeps the equal grid without the stepped drop.

  Entrance: when the header reaches the lower part of the screen its words rise out of a mask
  and the top rule draws; each image is then unveiled with a clip-path wipe, row by row.
  It plays once, never in the theme editor, and never with reduced motion.
  Hover, quick add and image views live on the product card.
{% endcomment %}

{%- liquid
  assign selected_collection = section.settings.collection
  if selected_collection != blank and selected_collection.products_count > 0
    assign grid_products = selected_collection.products
  else
    assign grid_products = collections.all.products
  endif

  assign mobile_cols = section.settings.mobile_columns | default: '2'
  assign editorial = section.settings.editorial_layout
  if editorial == nil
    assign editorial = true
  endif
-%}

<section
  class="featured-collection container{% if editorial %} featured-collection--editorial{% endif %}"
  data-section-id="{{ section.id }}"
>
  {% # theme-check-disable ParserBlockingScript %}
  <script>
    (function (el) {
      var reduce = false;
      try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      var design = !!(window.Shopify && Shopify.designMode);
      if (reduce || design || !('IntersectionObserver' in window)) return;
      el.setAttribute('data-reveal', 'pending');
    })(document.currentScript.parentElement);
  </script>
  {% # theme-check-enable ParserBlockingScript %}

  <div class="featured-collection__header">
    <div class="featured-collection__title-group">
      {%- if section.settings.heading != blank -%}
        <h2 class="featured-collection__heading">
          {%- assign heading_words = section.settings.heading | split: ' ' -%}
          {%- for word in heading_words -%}
            <span class="featured-collection__word" style="--w: {{ forloop.index0 }}"><span class="featured-collection__word-inner">{{ word | escape }}</span></span>
          {%- endfor -%}
        </h2>
      {%- endif -%}
    </div>

    {%- if section.settings.eyebrow != blank or section.settings.show_view_all -%}
      <div class="featured-collection__meta">
        {%- if section.settings.eyebrow != blank -%}
          <span class="featured-collection__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.show_view_all -%}
          <a
            href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}"
            class="featured-collection__view-all"
          >
            <span class="featured-collection__view-all-label">View all drops</span>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="featured-collection__grid featured-collection__grid--mobile-{{ mobile_cols }}{% if editorial %} featured-collection__grid--editorial{% endif %}">
    {%- if grid_products.size > 0 -%}
      {%- for product in grid_products limit: section.settings.products_to_show -%}
        {%- liquid
          # The first row loads straight away; everything below it waits.
          assign is_lazy = true
          if forloop.index <= 3
            assign is_lazy = false
          endif

          # Equal columns: desktop 4-up, tablet 2-up. Phone still steps when editorial + 1-col.
          assign slot_two = forloop.index0 | modulo: 2
          assign size_desktop = '25vw'
          assign size_tablet = '50vw'
          if mobile_cols == '2'
            assign size_phone = '50vw'
          elsif editorial and slot_two == 1
            assign size_phone = '78vw'
          else
            assign size_phone = '100vw'
          endif
          assign card_sizes = '(min-width: 990px) ' | append: size_desktop | append: ', (min-width: 750px) ' | append: size_tablet | append: ', ' | append: size_phone
        -%}
        <div class="featured-collection__item">
          {% render 'product-card',
            product: product,
            lazy_load: is_lazy,
            show_vendor: section.settings.show_vendor,
            sizes: card_sizes,
            include_script: forloop.first
          %}
        </div>
      {%- endfor -%}
    {%- else -%}
      <p class="featured-collection__empty">No products yet.</p>
    {%- endif -%}
  </div>

  {% # theme-check-disable ParserBlockingScript %}
  <script>
    (function (el) {
      if (!el || el.getAttribute('data-reveal') !== 'pending') return;
      try {
        var nodes = el.querySelectorAll('.featured-collection__header, .featured-collection__item');
        if (!nodes.length) {
          el.removeAttribute('data-reveal');
          return;
        }

        // Everything that arrives together is revealed in reading order, a beat apart.
        var reveal = function (batch) {
          batch.sort(function (a, b) {
            return a.compareDocumentPosition(b) & 4 ? -1 : 1;
          });
          batch.forEach(function (node, i) {
            node.style.setProperty('--reveal-delay', Math.min(i, 5) * 90 + 'ms');
            node.classList.add('is-in');
          });
        };

        var io = new IntersectionObserver(function (entries) {
          var batch = [];
          entries.forEach(function (entry) {
            // Anything already scrolled past (reload mid-page, anchor links) opens at once.
            var passed = entry.rootBounds && entry.boundingClientRect.bottom <= entry.rootBounds.top;
            if (!entry.isIntersecting && !passed) return;
            io.unobserve(entry.target);
            batch.push(entry.target);
          });
          if (batch.length) reveal(batch);
        }, { threshold: 0, rootMargin: '0px 0px -12% 0px' });

        nodes.forEach(function (node) { io.observe(node); });
      } catch (e) {
        el.removeAttribute('data-reveal');
      }
    })(document.currentScript.parentElement);
  </script>
  {% # theme-check-enable ParserBlockingScript %}
</section>

{% stylesheet %}
  .section-featured-collection {
    position: relative;
    z-index: 1;
    background-color: var(--color-background);
  }

  .featured-collection {
    --fc-gap: 1.25rem;
    --fc-ease: var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1));
    --fc-expo: cubic-bezier(0.16, 1, 0.3, 1);
    padding-top: clamp(3rem, 7vw, 7rem);
    padding-bottom: clamp(5rem, 9vw, 9rem);
  }

  .featured-collection a:hover,
  .featured-collection a:focus-visible {
    opacity: 1;
  }

  /* ---------- Header ---------- */
  .featured-collection__header {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    padding-top: 1rem;
    margin-bottom: clamp(2.5rem, 5vw, 5rem);
  }

  /* The rule is the section's one piece of furniture; it draws in with the heading. */
  .featured-collection__header::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 1px;
    background: var(--color-text);
    transform-origin: left center;
  }

  .featured-collection__title-group {
    min-width: 0;
  }

  .featured-collection__heading {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.22em;
    font-family: var(--font-display);
    font-size: clamp(3.25rem, 11.5vw, 9.5rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.03em;
    color: var(--color-text);
  }

  /* Phone: keep the display voice, but leave room for the first product above the fold. */
  @media (max-width: 749px) {
    .featured-collection__heading {
      font-size: clamp(2.5rem, 12vw, 3.25rem);
      line-height: 0.98;
      column-gap: 0.18em;
    }
  }

  /* Each word sits in its own window so it can rise into place. The clip extends
     past the box so descenders and tight tracking are never cut. */
  .featured-collection__word {
    display: inline-block;
    vertical-align: top;
    clip-path: inset(-0.1em -0.15em -0.22em -0.15em);
  }

  .featured-collection__word-inner {
    display: inline-block;
  }

  .featured-collection__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .featured-collection__eyebrow {
    color: var(--color-text-subtle);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  .featured-collection__view-all {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .featured-collection__view-all-label {
    position: relative;
    display: inline-block;
    padding-block: 0.25rem;
    transition: transform 180ms var(--fc-ease);
  }

  .featured-collection__view-all-label::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: currentColor;
    transform-origin: right center;
  }

  .featured-collection__view-all:active .featured-collection__view-all-label {
    transform: scale(0.96);
  }

  .featured-collection__view-all:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .featured-collection__view-all:hover .featured-collection__view-all-label::after {
      animation: fc-redraw 760ms var(--fc-expo);
    }
  }

  @media (min-width: 750px) {
    .featured-collection__header {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: 2rem;
    }

    .featured-collection__meta {
      flex-direction: column;
      align-items: flex-end;
      justify-content: flex-end;
      gap: 0.125rem;
      text-align: right;
    }
  }

  /* ---------- Grid: phone ---------- */
  .featured-collection__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: clamp(2.75rem, 9vw, 4rem);
  }

  .featured-collection__grid--mobile-2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 0.75rem;
    row-gap: 1.75rem;
  }

  .featured-collection__item {
    min-width: 0;
  }

  .featured-collection__item .product-card__media-wrapper {
    aspect-ratio: var(--fc-ratio, 3 / 4);
  }

  .featured-collection__empty {
    margin: 0;
    color: var(--color-text-subtle);
    font-size: 0.875rem;
  }

  @media (max-width: 749px) {
    /* One column: a full-width piece, then a narrower one stepped to alternating sides. */
    .featured-collection__grid--editorial.featured-collection__grid--mobile-1 .featured-collection__item {
      --fc-ratio: 4 / 5;
    }

    .featured-collection__grid--editorial.featured-collection__grid--mobile-1 .featured-collection__item:nth-child(even) {
      --fc-ratio: 3 / 4;
      width: 78%;
      justify-self: end;
    }

    .featured-collection__grid--editorial.featured-collection__grid--mobile-1 .featured-collection__item:nth-child(4n) {
      justify-self: start;
    }

    /* Two columns: equal weight, right-hand column steps down a beat. */
    .featured-collection__grid--editorial.featured-collection__grid--mobile-2 .featured-collection__item {
      --fc-ratio: 3 / 4;
    }

    .featured-collection__grid--editorial.featured-collection__grid--mobile-2 .featured-collection__item:nth-child(even) {
      margin-top: 1.75rem;
    }
  }

  /* ---------- Grid: tablet — two equal columns ---------- */
  @media (min-width: 750px) {
    .featured-collection__grid,
    .featured-collection__grid--mobile-2 {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--fc-gap);
      row-gap: clamp(3.5rem, 7vw, 7rem);
      /* Align image tops; captions may wrap to different heights. */
      align-items: start;
    }

    .featured-collection__item {
      grid-column: span 6;
      --fc-ratio: 3 / 4;
    }

    /* Editorial: right-hand column steps down. */
    .featured-collection__grid--editorial .featured-collection__item:nth-child(even) {
      margin-top: clamp(2.5rem, 5vw, 4.5rem);
    }
  }

  /* ---------- Grid: desktop — four equal columns ---------- */
  @media (min-width: 990px) {
    .featured-collection {
      --fc-gap: 1.5rem;
    }

    .featured-collection__item {
      grid-column: span 3;
      --fc-ratio: 3 / 4;
    }

    /* Editorial: 2nd and 4th in each row step down for rhythm. */
    .featured-collection__grid--editorial .featured-collection__item:nth-child(even) {
      margin-top: 0;
    }

    .featured-collection__grid--editorial .featured-collection__item:nth-child(4n + 2),
    .featured-collection__grid--editorial .featured-collection__item:nth-child(4n + 4) {
      margin-top: clamp(2.5rem, 4vw, 4.5rem);
    }
  }

  /* ---------- Motion ---------- */
  @keyframes fc-rise {
    from { transform: translateY(125%); }
    to { transform: translateY(0); }
  }

  @keyframes fc-rule {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @keyframes fc-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes fc-unveil {
    from { clip-path: inset(100% 0 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }

  @keyframes fc-settle {
    from { transform: scale(1.14); }
    to { transform: scale(1); }
  }

  /* The underline slides out to the right and draws back in from the left. */
  @keyframes fc-redraw {
    0% { transform-origin: right center; transform: scaleX(1); }
    45% { transform-origin: right center; transform: scaleX(0); }
    55% { transform-origin: left center; transform: scaleX(0); }
    100% { transform-origin: left center; transform: scaleX(1); }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* Before: everything waits where it will land. */
    .featured-collection[data-reveal='pending'] .featured-collection__header:not(.is-in)::before {
      transform: scaleX(0);
    }

    .featured-collection[data-reveal='pending'] .featured-collection__header:not(.is-in) .featured-collection__word-inner {
      transform: translateY(125%);
    }

    .featured-collection[data-reveal='pending'] .featured-collection__header:not(.is-in) .featured-collection__meta {
      opacity: 0;
    }

    .featured-collection[data-reveal='pending'] .featured-collection__item:not(.is-in) {
      pointer-events: none;
    }

    .featured-collection[data-reveal='pending'] .featured-collection__item:not(.is-in) .product-card__media-wrapper {
      clip-path: inset(100% 0 0 0);
    }

    .featured-collection[data-reveal='pending'] .featured-collection__item:not(.is-in) .product-card__frame:first-child .product-card__image {
      transform: scale(1.14);
    }

    .featured-collection[data-reveal='pending'] .featured-collection__item:not(.is-in) .product-card__content {
      opacity: 0;
    }

    /* After: each piece plays once and hands back to its natural style. */
    .featured-collection[data-reveal='pending'] .featured-collection__header.is-in::before {
      animation: fc-rule 1400ms var(--fc-expo) var(--reveal-delay, 0ms) backwards;
    }

    .featured-collection[data-reveal='pending'] .featured-collection__header.is-in .featured-collection__word-inner {
      animation: fc-rise 1100ms var(--fc-expo) calc(var(--w, 0) * 80ms + var(--reveal-delay, 0ms)) backwards;
    }

    .featured-collection[data-reveal='pending'] .featured-collection__header.is-in .featured-collection__meta {
      animation: fc-fade 800ms ease calc(var(--reveal-delay, 0ms) + 500ms) backwards;
    }

    .featured-collection[data-reveal='pending'] .featured-collection__item.is-in .product-card__media-wrapper {
      animation: fc-unveil 1200ms var(--fc-expo) var(--reveal-delay, 0ms) backwards;
    }

    .featured-collection[data-reveal='pending'] .featured-collection__item.is-in .product-card__frame:first-child .product-card__image {
      animation: fc-settle 1700ms var(--fc-expo) var(--reveal-delay, 0ms) backwards;
    }

    .featured-collection[data-reveal='pending'] .featured-collection__item.is-in .product-card__content {
      animation: fc-fade 900ms ease calc(var(--reveal-delay, 0ms) + 450ms) backwards;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-collection__view-all-label,
    .featured-collection__view-all-label::after {
      transition: none;
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "New Arrivals",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "AUTUMN / WINTER 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "checkbox",
      "id": "editorial_layout",
      "label": "Editorial layout",
      "info": "Equal card widths with a stepped drop on desktop and tablet, and a stepped rhythm on phones. Turn off for a flat, uniform grid.",
      "default": true
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile Layout",
      "options": [
        {
          "value": "1",
          "label": "1 Column (Full-Width Editorial)"
        },
        {
          "value": "2",
          "label": "2 Columns (Compact Grid)"
        }
      ],
      "default": "1"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 2,
      "label": "Products to Show",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Category / Vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "New Arrivals"
    }
  ]
}
{% endschema %}
