{% comment %}
  New Arrivals. Clean symmetrical editorial product grid with matching Category Tiles header typography.
  - Top header: Eyebrow with decorative line & counter (08) + Display Heading with word masks + View All
  - Desktop: 4 crisp, symmetrical columns
  - Tablet: 3 columns
  - Mobile: 2 compact columns (or 1 column via theme settings)
  - Card: 3:4 portrait, hover multi-image curtain / zoom, hover size selector
{% endcomment %}

{%- liquid
  assign limit_n = section.settings.products_to_show | default: 8
  assign selected_collection = section.settings.collection
  assign view_all_url = section.settings.collection.url | default: routes.all_products_collection_url

  if selected_collection != blank and selected_collection.products_count > 0
    assign grid_products = selected_collection.products
    assign total_products = selected_collection.products_count
  else
    assign grid_products = collections.all.products
    assign total_products = collections.all.products_count
  endif

  assign shown_count = total_products | at_most: limit_n
  assign mobile_cols = section.settings.mobile_columns | default: '2'

  if mobile_cols == '1'
    assign mobile_sizes = '94vw'
  else
    assign mobile_sizes = '48vw'
  endif
  assign card_sizes = '(min-width: 1440px) 320px, (min-width: 990px) 23vw, (min-width: 750px) 30vw, ' | append: mobile_sizes
-%}

<section
  class="featured-collection container"
  data-section-id="{{ section.id }}"
>
  {% # theme-check-disable ParserBlockingScript %}
  <script>
    (function (el) {
      var reduce = false;
      try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      var design = !!(window.Shopify && Shopify.designMode);
      if (reduce || design || !('IntersectionObserver' in window)) return;
      el.setAttribute('data-reveal', 'pending');
    })(document.currentScript.parentElement);
  </script>
  {% # theme-check-enable ParserBlockingScript %}

  <div class="featured-collection__header">
    <div class="featured-collection__title-group">
      {% if section.settings.eyebrow != blank %}
        <p class="featured-collection__eyebrow text-micro">
          <span>{{ section.settings.eyebrow }}</span>
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="featured-collection__heading">
          {%- assign heading_words = section.settings.heading | split: ' ' -%}
          {%- for word in heading_words -%}
            <span class="featured-collection__word"><span class="featured-collection__word-i" style="--i: {{ forloop.index0 }}">{{ word | escape }}</span></span>{% unless forloop.last %} {% endunless %}
          {%- endfor -%}
        </h2>
      {% endif %}
    </div>

    {% if section.settings.show_view_all %}
      <a href="{{ view_all_url }}" class="featured-collection__view-all">
        <span class="featured-collection__view-all-label">
          <span>View all drops</span>
          <svg class="featured-collection__view-all-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7H13M13 7L7.5 1.5M13 7L7.5 12.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    {% endif %}
  </div>

  <div class="featured-collection__grid featured-collection__grid--mobile-{{ mobile_cols }}">
    {% for product in grid_products limit: limit_n %}
      {%- liquid
        assign is_lazy = true
        if section.index <= 2 and forloop.index <= 4
          assign is_lazy = false
        endif
      -%}
      <div class="featured-collection__item">
        {% render 'product-card',
          product: product,
          lazy_load: is_lazy,
          show_vendor: section.settings.show_vendor,
          image_sizes: card_sizes
        %}
      </div>
    {% else %}
      <p class="featured-collection__empty">No products yet.</p>
    {% endfor %}
  </div>

  {% # theme-check-disable ParserBlockingScript %}
  <script>
    (function (el) {
      if (!el || el.getAttribute('data-reveal') !== 'pending') return;
      try {
        var nodes = el.querySelectorAll('.featured-collection__header, .featured-collection__item');
        if (!nodes.length) {
          el.removeAttribute('data-reveal');
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting && entry.boundingClientRect.top >= 0) return;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          });
        }, { threshold: 0, rootMargin: '0px 0px -12% 0px' });
        nodes.forEach(function (node) { io.observe(node); });
      } catch (e) {
        el.removeAttribute('data-reveal');
      }
    })(document.currentScript.parentElement);
  </script>
  {% # theme-check-enable ParserBlockingScript %}
</section>

{% stylesheet %}
  .section-featured-collection {
    position: relative;
    z-index: 1;
    background-color: var(--color-background);
    border-top: 1px solid var(--color-border);
  }

  .featured-collection {
    padding-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(3.5rem, 7vw, 6rem);
    margin-bottom: 0;
  }

  .featured-collection a:hover,
  .featured-collection a:focus-visible {
    opacity: 1;
  }

  /* ---------- Editorial Header (Matching Category Tiles) ---------- */
  .featured-collection__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-sm, 1rem);
    margin-bottom: clamp(2rem, 4.5vw, 4.5rem);
    text-align: left;
  }

  .featured-collection__title-group {
    min-width: 0;
  }

  .featured-collection__eyebrow {
    margin: 0 0 1rem;
    color: var(--color-text-muted);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .featured-collection__heading {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7.2vw, 6.5rem);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.04em;
    margin: 0;
    color: var(--color-text);
    text-wrap: balance;
  }

  .featured-collection__word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-block: 0.06em 0.14em;
    margin-block: -0.06em -0.14em;
  }

  .featured-collection__word-i {
    display: inline-block;
  }

  .featured-collection__view-all {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 200ms var(--ease-out, ease);
  }

  .featured-collection__view-all:active {
    transform: scale(0.97);
  }

  .featured-collection__view-all:focus-visible {
    outline: 2px solid var(--color-text);
    outline-offset: 4px;
  }

  .featured-collection__view-all-label {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.3rem;
  }

  .featured-collection__view-all-label::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background-color: currentColor;
    transform-origin: 0 50%;
  }

  .featured-collection__view-all-arrow {
    transition: transform 300ms var(--ease-out, ease);
  }

  @keyframes fc-underline-sweep {
    0%   { transform: scaleX(1); transform-origin: 100% 50%; }
    45%  { transform: scaleX(0); transform-origin: 100% 50%; }
    55%  { transform: scaleX(0); transform-origin: 0 50%; }
    100% { transform: scaleX(1); transform-origin: 0 50%; }
  }

  @media (hover: hover) and (pointer: fine) {
    .featured-collection__view-all:hover .featured-collection__view-all-label::after {
      animation: fc-underline-sweep 760ms cubic-bezier(0.6, 0, 0.2, 1);
    }

    .featured-collection__view-all:hover .featured-collection__view-all-arrow {
      transform: translateX(4px);
    }
  }

  /* ---------- Grid ---------- */
  .featured-collection__item {
    position: relative;
    min-width: 0;
  }

  /* Mobile default: clean 2-column grid */
  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(0.75rem, 2.5vw, 1.25rem);
    row-gap: clamp(2rem, 4vw, 2.75rem);
  }

  .featured-collection__grid--mobile-1 {
    grid-template-columns: minmax(0, 1fr);
    row-gap: 2.75rem;
  }

  .featured-collection__empty {
    margin: 0;
    color: var(--color-text-subtle);
    font-size: 0.875rem;
  }

  /* Tablet: 3 columns */
  @media (min-width: 750px) {
    .featured-collection__grid,
    .featured-collection__grid--mobile-1 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--space-md, 1.5rem);
      row-gap: 3.5rem;
    }
  }

  /* Desktop: 4 columns */
  @media (min-width: 990px) {
    .featured-collection__grid,
    .featured-collection__grid--mobile-1 {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: var(--space-md, 1.5rem);
      row-gap: 4rem;
    }
  }

  /* Reveal Delays */
  .featured-collection__item:nth-child(4n + 1) { --reveal-delay: 0ms; }
  .featured-collection__item:nth-child(4n + 2) { --reveal-delay: 60ms; }
  .featured-collection__item:nth-child(4n + 3) { --reveal-delay: 120ms; }
  .featured-collection__item:nth-child(4n + 4) { --reveal-delay: 180ms; }

  /* ---------- Entry Scroll Animation ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .featured-collection[data-reveal="pending"] .featured-collection__header:not(.is-in) .featured-collection__eyebrow,
    .featured-collection[data-reveal="pending"] .featured-collection__header:not(.is-in) .featured-collection__view-all-label {
      opacity: 0;
      transform: translateY(8px);
    }

    .featured-collection[data-reveal="pending"] .featured-collection__header:not(.is-in) .featured-collection__word-i {
      transform: translateY(115%);
    }

    .featured-collection[data-reveal="pending"] .featured-collection__header:not(.is-in) .featured-collection__view-all {
      pointer-events: none;
    }

    .featured-collection[data-reveal="pending"] .featured-collection__header.is-in .featured-collection__eyebrow,
    .featured-collection[data-reveal="pending"] .featured-collection__header.is-in .featured-collection__view-all-label {
      opacity: 1;
      transform: none;
      transition:
        opacity 560ms var(--ease-out, ease),
        transform 560ms var(--ease-out, ease);
    }

    .featured-collection[data-reveal="pending"] .featured-collection__header.is-in .featured-collection__word-i {
      transform: none;
      transition: transform 900ms cubic-bezier(0.16, 1, 0.3, 1) calc(var(--i, 0) * 80ms);
    }

    .featured-collection[data-reveal="pending"] .featured-collection__header.is-in .featured-collection__view-all {
      pointer-events: auto;
    }

    /* Product Cards Entrance */
    .featured-collection[data-reveal="pending"] .featured-collection__item:not(.is-in) {
      opacity: 0;
      transform: translateY(16px);
      pointer-events: none;
    }

    .featured-collection[data-reveal="pending"] .featured-collection__item.is-in {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
      transition:
        opacity 600ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms),
        transform 600ms cubic-bezier(0.16, 1, 0.3, 1) var(--reveal-delay, 0ms);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-collection__view-all,
    .featured-collection__view-all-arrow {
      transition: none;
    }

    .featured-collection__view-all:hover .featured-collection__view-all-label::after {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "New Arrivals",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "AUTUMN / WINTER 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile Layout",
      "options": [
        {
          "value": "2",
          "label": "2 Columns (Clean Balanced Grid)"
        },
        {
          "value": "1",
          "label": "1 Column (Full-Width)"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 2,
      "label": "Products to Show",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Category / Vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "New Arrivals"
    }
  ]
}
{% endschema %}
