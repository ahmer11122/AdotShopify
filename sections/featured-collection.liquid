{% comment %}
  New Arrivals. Two columns on a phone, three from 750px, four from 990px.
  The title leads and View All trails. The header wipes in once it has
  scrolled into the lower third; each product settles as its row arrives.
  Card hover and quick-add stay on the product card.
{% endcomment %}

<section class="featured-collection container" data-section-id="{{ section.id }}">
  {% # theme-check-disable ParserBlockingScript %}
  <script>
    (function (el) {
      var reduce = false;
      try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      var design = !!(window.Shopify && Shopify.designMode);
      if (reduce || design || !('IntersectionObserver' in window)) return;
      el.setAttribute('data-reveal', 'pending');
    })(document.currentScript.parentElement);
  </script>
  {% # theme-check-enable ParserBlockingScript %}
  <div class="featured-collection__header">
    <div class="featured-collection__title-group">
      {% if section.settings.eyebrow != blank %}
        <span class="featured-collection__eyebrow text-micro">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="featured-collection__heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    {% if section.settings.show_view_all %}
      <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="featured-collection__view-all text-micro">
        <span class="featured-collection__view-all-label">
          <span>View All Drops</span>
          <svg class="featured-collection__view-all-arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M1 7H13M13 7L7.5 1.5M13 7L7.5 12.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </a>
    {% endif %}
  </div>

  <div class="featured-collection__grid">
    {% assign selected_collection = section.settings.collection %}
    {% if selected_collection != blank and selected_collection.products_count > 0 %}
      {% for product in selected_collection.products limit: section.settings.products_to_show %}
        {% assign is_lazy = true %}
        {% if forloop.index <= 4 %}
          {% assign is_lazy = false %}
        {% endif %}
        <div class="featured-collection__item">
          {% render 'product-card', product: product, lazy_load: is_lazy, show_vendor: section.settings.show_vendor %}
        </div>
      {% endfor %}
    {% else %}
      <!-- Curated Apparel Demo Showcase with real product URLs and variant IDs -->
      {% assign all_prods = collections.all.products %}
      {% assign p_fallback = all_prods.first %}
      {% assign p1 = all_prods[7] | default: p_fallback %}
      {% assign p2 = all_prods[3] | default: p_fallback %}
      {% assign p3 = all_prods[4] | default: p_fallback %}
      {% assign p4 = all_prods[5] | default: p_fallback %}
      {% assign p5 = all_prods[6] | default: p_fallback %}
      {% assign p6 = all_prods[1] | default: p_fallback %}
      {% assign p7 = all_prods[8] | default: p_fallback %}
      {% assign p8 = all_prods[11] | default: p_fallback %}

      {% assign hoodie_img = 'category-hoodies.jpg' | asset_url %}
      {% assign hoodie_png = 'category-hoodies.png' | asset_url %}
      {% assign shirt_img = 'category-shirts.jpg' | asset_url %}
      {% assign shirt_png = 'category-shirts.png' | asset_url %}
      {% assign trouser_img = 'category-trousers.jpg' | asset_url %}
      {% assign trouser_png = 'category-trousers.png' | asset_url %}

      <div class="featured-collection__item">
        {% render 'product-card',
          title: 'Heavyweight Boxy Hoodie',
          url: p1.url,
          variant_id: p1.selected_or_first_available_variant.id,
          price: 449900,
          compare_at_price: 0,
          image_src: hoodie_img,
          secondary_image_src: hoodie_png,
          spec: '450 GSM Loopback Fleece · Relaxed Fit',
          color_count: 2,
          available: true,
          lazy_load: false
        %}
      </div>

      <div class="featured-collection__item">
        {% render 'product-card',
          title: 'Relaxed Poplin Shirt',
          url: p2.url,
          variant_id: p2.selected_or_first_available_variant.id,
          price: 369900,
          compare_at_price: 449900,
          image_src: shirt_img,
          secondary_image_src: shirt_png,
          spec: '100% Crisp Poplin Cotton · Casual Fit',
          color_count: 3,
          available: true,
          lazy_load: false
        %}
      </div>

      <div class="featured-collection__item">
        {% render 'product-card',
          title: 'Tailored Pleated Trousers',
          url: p3.url,
          variant_id: p3.selected_or_first_available_variant.id,
          price: 429900,
          compare_at_price: 0,
          image_src: trouser_img,
          secondary_image_src: trouser_png,
          spec: 'High-Density Cotton Twill · Wide Leg',
          color_count: 2,
          available: true,
          lazy_load: false
        %}
      </div>

      <div class="featured-collection__item">
        {% render 'product-card',
          title: 'Heavyweight Zip Hoodie',
          url: p4.url,
          variant_id: p4.selected_or_first_available_variant.id,
          price: 489900,
          compare_at_price: 0,
          image_src: hoodie_img,
          secondary_image_src: hoodie_png,
          spec: '450 GSM Heavy Fleece · Dual Metal Zip',
          color_count: 1,
          available: true,
          lazy_load: false
        %}
      </div>

      <div class="featured-collection__item">
        {% render 'product-card',
          title: 'Oversized Oxford Button-Down',
          url: p5.url,
          variant_id: p5.selected_or_first_available_variant.id,
          price: 389900,
          compare_at_price: 450000,
          image_src: shirt_img,
          secondary_image_src: shirt_png,
          spec: 'Heavyweight Oxford Weave · Dropped Shoulder',
          color_count: 2,
          available: true,
          lazy_load: true
        %}
      </div>

      <div class="featured-collection__item">
        {% render 'product-card',
          title: 'Wide-Leg Minimalist Chino',
          url: p6.url,
          variant_id: p6.selected_or_first_available_variant.id,
          price: 399900,
          compare_at_price: 0,
          image_src: trouser_img,
          secondary_image_src: trouser_png,
          spec: 'Brushed Cotton Chino Twill · Straight Hem',
          color_count: 3,
          available: true,
          lazy_load: true
        %}
      </div>

      <div class="featured-collection__item">
        {% render 'product-card',
          title: 'Heavyweight Loopback Crewneck',
          url: p7.url,
          variant_id: p7.selected_or_first_available_variant.id,
          price: 399900,
          compare_at_price: 0,
          image_src: hoodie_img,
          secondary_image_src: hoodie_png,
          spec: '450 GSM Unbrushed Cotton · Ribbed Collar',
          color_count: 2,
          available: true,
          lazy_load: true
        %}
      </div>

      <div class="featured-collection__item">
        {% render 'product-card',
          title: 'Relaxed Camp Collar Shirt',
          url: p8.url,
          variant_id: p8.selected_or_first_available_variant.id,
          price: 349900,
          compare_at_price: 420000,
          image_src: shirt_img,
          secondary_image_src: shirt_png,
          spec: 'Breathable Cotton Slub · Cuban Collar',
          color_count: 1,
          available: false,
          lazy_load: true
        %}
      </div>
    {% endif %}
  </div>
  {% # theme-check-disable ParserBlockingScript %}
  <script>
    (function (el) {
      if (!el || el.getAttribute('data-reveal') !== 'pending') return;
      try {
        var nodes = el.querySelectorAll('.featured-collection__header, .featured-collection__item');
        if (!nodes.length) {
          el.removeAttribute('data-reveal');
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          });
        }, { threshold: 0, rootMargin: '0px 0px -32% 0px' });
        nodes.forEach(function (node) { io.observe(node); });
      } catch (e) {
        el.removeAttribute('data-reveal');
      }
    })(document.currentScript.parentElement);
  </script>
  {% # theme-check-enable ParserBlockingScript %}
</section>

{% stylesheet %}
  .section-featured-collection {
    position: relative;
    z-index: 1;
    background-color: var(--color-background);
    border-top: 1px solid var(--color-border);
  }

  .featured-collection {
    padding-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: var(--space-xl);
    margin-bottom: 0;
  }

  .featured-collection a:hover,
  .featured-collection a:focus-visible {
    opacity: 1;
  }

  .featured-collection__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .featured-collection__eyebrow {
    color: var(--color-text-subtle);
    display: block;
    margin-bottom: var(--space-2xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured-collection__heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 400;
    line-height: var(--leading-tight);
    letter-spacing: -0.025em;
    margin: 0;
    color: var(--color-text);
  }

  .featured-collection__view-all {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 500;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 160ms var(--ease-out);
  }

  .featured-collection__view-all:active {
    transform: scale(0.96);
  }

  .featured-collection__view-all-label {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-bottom: 2px;
    border-bottom: 1px solid var(--color-text);
  }

  .featured-collection__view-all-arrow {
    transition: transform 160ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .featured-collection__view-all:hover .featured-collection__view-all-arrow {
      transform: translateX(4px);
    }
  }

  .featured-collection__item:nth-child(2n + 1) { --reveal-delay: 0ms; }
  .featured-collection__item:nth-child(2n) { --reveal-delay: 70ms; }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md) var(--space-sm);
  }

  @media (min-width: 750px) {
    .featured-collection__item:nth-child(3n + 1) { --reveal-delay: 0ms; }
    .featured-collection__item:nth-child(3n + 2) { --reveal-delay: 70ms; }
    .featured-collection__item:nth-child(3n + 3) { --reveal-delay: 140ms; }

    .featured-collection__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-md);
    }
  }

  @media (min-width: 990px) {
    .featured-collection__item:nth-child(4n + 1) { --reveal-delay: 0ms; }
    .featured-collection__item:nth-child(4n + 2) { --reveal-delay: 60ms; }
    .featured-collection__item:nth-child(4n + 3) { --reveal-delay: 120ms; }
    .featured-collection__item:nth-child(4n + 4) { --reveal-delay: 180ms; }

    .featured-collection__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-md);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .featured-collection[data-reveal="pending"] .featured-collection__header:not(.is-in) .featured-collection__eyebrow,
    .featured-collection[data-reveal="pending"] .featured-collection__header:not(.is-in) .featured-collection__view-all-label {
      opacity: 0;
      transform: translateY(6px);
    }

    .featured-collection[data-reveal="pending"] .featured-collection__header:not(.is-in) .featured-collection__heading {
      clip-path: inset(100% 0 0 0);
    }

    .featured-collection[data-reveal="pending"] .featured-collection__header:not(.is-in) .featured-collection__view-all {
      pointer-events: none;
    }

    .featured-collection[data-reveal="pending"] .featured-collection__header.is-in .featured-collection__eyebrow,
    .featured-collection[data-reveal="pending"] .featured-collection__header.is-in .featured-collection__view-all-label {
      opacity: 1;
      transform: none;
      transition:
        opacity 480ms var(--ease-out),
        transform 480ms var(--ease-out);
    }

    .featured-collection[data-reveal="pending"] .featured-collection__header.is-in .featured-collection__view-all-label {
      transition-delay: 80ms;
    }

    .featured-collection[data-reveal="pending"] .featured-collection__header.is-in .featured-collection__heading {
      clip-path: inset(0 0 0 0);
      transition: clip-path 780ms var(--ease-out);
    }

    .featured-collection[data-reveal="pending"] .featured-collection__header.is-in .featured-collection__view-all {
      pointer-events: auto;
    }

    .featured-collection[data-reveal="pending"] .featured-collection__item:not(.is-in) {
      opacity: 0;
      transform: translateY(8px);
      pointer-events: none;
    }

    .featured-collection[data-reveal="pending"] .featured-collection__item.is-in {
      opacity: 1;
      transform: none;
      pointer-events: auto;
      transition:
        opacity 520ms var(--ease-out),
        transform 520ms var(--ease-out);
      transition-delay: var(--reveal-delay, 0ms);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured-collection__view-all-arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "New Arrivals",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "AUTUMN / WINTER 2026"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 2,
      "label": "Products to Show",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Category / Vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' Link",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "New Arrivals"
    }
  ]
}
{% endschema %}
