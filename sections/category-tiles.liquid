{% comment %}
  Editorial category showcase. The sheet itself is the scroll over the hero.
  The heading wipes up once it has scrolled into the lower third, not
  while it is still a sliver over the hero. Each garment settles the
  same way, and on a phone each one waits until you reach it. Fine pointers get a
  short lift. Reduced motion shows everything immediately.
{% endcomment %}

<section class="category-tiles container" data-section-id="{{ section.id }}">
  {% # theme-check-disable ParserBlockingScript %}
  <script>
    (function (el) {
      var reduce = false;
      try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      var design = !!(window.Shopify && Shopify.designMode);
      if (reduce || design || !('IntersectionObserver' in window)) return;
      el.setAttribute('data-reveal', 'pending');
    })(document.currentScript.parentElement);
  </script>
  {% # theme-check-enable ParserBlockingScript %}
  {% if section.settings.heading != blank %}
    <div class="category-tiles__header">
      <h2 class="category-tiles__heading">{{ section.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="category-tiles__track" role="region" aria-label="{{ section.settings.heading | default: 'Shop by Category' }}">
    {% for block in section.blocks %}
      {%- assign fallback_png = 'category-' | append: block.settings.title | downcase | append: '.png' -%}
      <div class="category-tile" {{ block.shopify_attributes }}>
        <a
          href="{{ block.settings.link | default: routes.all_products_collection_url }}"
          class="category-tile__link"
          data-category-link
          aria-label="{{ block.settings.title | escape }} - Shop All"
        >
          <div class="category-tile__stage">
            <div class="category-tile__media-box">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1200',
                    sizes: '(min-width: 750px) 33vw, 100vw',
                    class: 'category-tile__image category-tile__image--transparent',
                    alt: block.settings.image.alt | default: block.settings.title | escape
                }}
              {% else %}
                <img
                  src="{{ fallback_png | asset_url }}"
                  alt="{{ block.settings.title | escape }}"
                  width="896"
                  height="1200"
                  loading="lazy"
                  class="category-tile__image category-tile__image--transparent"
                  onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
                >
                <div class="category-tile__placeholder" style="display: none;">
                  {% assign placeholder_index = forloop.index | modulo: 3 | plus: 1 %}
                  {{ 'collection-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
            </div>
          </div>

          <!-- Centered Metadata Block (Unified pure canvas blend on mobile & desktop) -->
          <div class="category-tile__meta">
            <h3 class="category-tile__title">{{ block.settings.title }}</h3>
            <div class="category-tile__action">
              <span class="category-tile__cta">
                <span>Shop All</span>
                <svg class="category-tile__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M1 7H13M13 7L7.5 1.5M13 7L7.5 12.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
  {% # theme-check-disable ParserBlockingScript %}
  <script>
    (function (el) {
      if (!el || el.getAttribute('data-reveal') !== 'pending') return;
      try {
        var nodes = el.querySelectorAll('.category-tiles__header, .category-tile');
        if (!nodes.length) {
          el.removeAttribute('data-reveal');
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          });
        }, { threshold: 0, rootMargin: '0px 0px -32% 0px' });
        nodes.forEach(function (node) { io.observe(node); });
      } catch (e) {
        el.removeAttribute('data-reveal');
      }
    })(document.currentScript.parentElement);
  </script>
  {% # theme-check-enable ParserBlockingScript %}
</section>

{% stylesheet %}
  .section-category-tiles {
    position: relative;
    z-index: 1;
    background-color: var(--color-background);
    box-shadow: 0 -20px 40px -10px rgba(0, 0, 0, 0.06);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: clamp(3rem, 5vw, 4.5rem);
  }

  .category-tiles {
    position: relative;
    padding-bottom: var(--space-xl);
    margin-bottom: 0;
    --tile-rise: 8px;
  }

  /* Editorial Header */
  .category-tiles__header {
    margin-bottom: clamp(1.75rem, 3.5vw, 3rem);
    text-align: left;
  }

  .category-tiles__heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.025em;
    margin: 0;
    color: var(--color-text);
  }

  /* Zero-Border Tile Pedestal */
  .category-tile {
    position: relative;
    background: transparent;
    border: none;
  }

  .category-tile__link {
    display: block;
    text-decoration: none;
    position: relative;
    width: 100%;
    height: 100%;
    color: inherit;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform 160ms var(--ease-out);
  }

  .category-tile__link:active {
    transform: scale(0.985);
  }

  .category-tile__link:hover,
  .category-tile__link:focus-visible {
    opacity: 1;
  }

  .category-tile__media-box {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    transform-origin: center bottom;
    filter: drop-shadow(0 16px 26px rgba(17, 17, 17, 0.07));
    transition: transform 280ms var(--ease-out);
  }

  .category-tile__image {
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    margin: auto;
    background: transparent;
  }

  .category-tile__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface);
  }

  .category-tile__placeholder svg {
    width: 40%;
    height: 40%;
    opacity: 0.3;
  }

  .category-tile__arrow {
    transition: transform 160ms var(--ease-out);
  }

  /* Shared Centered Editorial Typography Below Garment (Mobile & Desktop) */
  .category-tile__meta {
    margin-top: clamp(0.75rem, 2vw, 1.25rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.35rem;
    position: relative;
  }

  .category-tile__title {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 2.5vw, 1.25rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.04em;
    margin: 0;
    color: var(--color-text);
    text-transform: uppercase;
  }

  .category-tile__action {
    margin-top: 0.15rem;
  }

  .category-tile__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    position: relative;
    padding-bottom: 2px;
    min-height: 36px;
    transition: color var(--transition-fast);
  }

  .category-tile__cta::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-text);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 200ms var(--ease-out);
  }

  /* Heading wipes up once it has cleared the hero. Each garment settles
     as it arrives, so a phone does not play the lower cards off screen. */
  @media (prefers-reduced-motion: no-preference) {
    .category-tiles[data-reveal="pending"] .category-tiles__header:not(.is-in) .category-tiles__heading {
      clip-path: inset(100% 0 0 0);
    }

    .category-tiles[data-reveal="pending"] .category-tiles__header.is-in .category-tiles__heading {
      clip-path: inset(0 0 0 0);
      transition: clip-path 780ms var(--ease-out);
    }

    .category-tiles[data-reveal="pending"] .category-tile:not(.is-in) .category-tile__stage {
      opacity: 0;
      transform: translateY(var(--tile-rise, 8px));
    }

    .category-tiles[data-reveal="pending"] .category-tile:not(.is-in) .category-tile__meta {
      opacity: 0;
      transform: translateY(6px);
    }

    .category-tiles[data-reveal="pending"] .category-tile.is-in .category-tile__stage,
    .category-tiles[data-reveal="pending"] .category-tile.is-in .category-tile__meta {
      opacity: 1;
      transform: none;
      transition:
        opacity 560ms var(--ease-out),
        transform 560ms var(--ease-out);
    }

    .category-tiles[data-reveal="pending"] .category-tile.is-in .category-tile__meta {
      transition-duration: 480ms;
      transition-delay: 70ms;
    }
  }

  /* ==========================================================================
     Mobile Layout (max-width: 749px):
     - Pure canvas blend: NO background boxes, seamless #FFFFFF backdrop
     - 3 stacked vertical items (1st -> 2nd -> 3rd)
     - Compact 4:3 garment stage with centered typography below
     - Zero swipe friction, pure native vertical scroll
     ========================================================================== */
  @media (max-width: 749px) {
    .category-tiles__track {
      display: flex;
      flex-direction: column;
      gap: clamp(2.25rem, 6vw, 3.5rem);
      padding: 0;
      margin: 0;
    }

    .category-tile {
      width: 100%;
    }

    .category-tile__stage {
      position: relative;
      width: 100%;
      aspect-ratio: 4 / 3;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      padding: var(--space-xs);
      box-sizing: border-box;
      overflow: visible;
    }

    .category-tile__image {
      max-width: 82%;
      max-height: 82%;
    }
  }

  /* ==========================================================================
     Desktop Layout (min-width: 750px):
     - 3-column floating showcase
     - 3:4 pedestal with pure canvas blend
     - Centered title and Shop All link underneath
     - Tactile levitation micro-interaction
     ========================================================================== */
  @media (min-width: 750px) {
    .category-tiles {
      --tile-rise: 12px;
    }

    .category-tile:nth-child(1) { --reveal-delay: 80ms; }
    .category-tile:nth-child(2) { --reveal-delay: 160ms; }
    .category-tile:nth-child(3) { --reveal-delay: 240ms; }
    .category-tile:nth-child(4) { --reveal-delay: 320ms; }
    .category-tile:nth-child(5) { --reveal-delay: 400ms; }
    .category-tile:nth-child(6) { --reveal-delay: 480ms; }

    .category-tiles__track {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(2rem, 3.5vw, 4.5rem);
    }

    .category-tile__stage {
      position: relative;
      width: 100%;
      aspect-ratio: 3 / 4;
      display: flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      padding: var(--space-xs) var(--space-sm);
      box-sizing: border-box;
      overflow: visible;
    }

    .category-tile__image {
      max-width: 92%;
      max-height: 92%;
    }

    @media (hover: hover) and (pointer: fine) {
      .category-tile:hover .category-tile__media-box,
      .category-tile__link:focus-visible .category-tile__media-box {
        transform: translateY(-8px) scale(1.02);
      }

      .category-tile:hover .category-tile__arrow,
      .category-tile__link:focus-visible .category-tile__arrow {
        transform: translateX(5px);
        transition-delay: 40ms;
      }

      .category-tile:hover .category-tile__cta,
      .category-tile__link:focus-visible .category-tile__cta {
        color: var(--color-text);
      }

      .category-tile:hover .category-tile__cta::after,
      .category-tile__link:focus-visible .category-tile__cta::after {
        transform: scaleX(1);
      }
    }
  }

  @media (min-width: 750px) and (prefers-reduced-motion: no-preference) {
    .category-tiles[data-reveal="pending"] .category-tile.is-in .category-tile__stage {
      transition-delay: var(--reveal-delay, 0ms);
    }

    .category-tiles[data-reveal="pending"] .category-tile.is-in .category-tile__meta {
      transition-delay: calc(var(--reveal-delay, 0ms) + 70ms);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .category-tile:hover .category-tile__media-box,
    .category-tile:hover .category-tile__arrow {
      transform: none;
    }

    .category-tile:hover .category-tile__cta::after {
      transform: scaleX(0);
    }

    .category-tile__media-box,
    .category-tile__arrow,
    .category-tile__cta::after {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category Showcase",
  "tag": "section",
  "class": "section-category-tiles",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile Image (Cutout / Transparent)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Hoodies"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Showcase",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "title": "Hoodies"
          }
        },
        {
          "type": "tile",
          "settings": {
            "title": "Shirts"
          }
        },
        {
          "type": "tile",
          "settings": {
            "title": "Trousers"
          }
        }
      ]
    }
  ]
}
{% endschema %}
