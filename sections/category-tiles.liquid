{% comment %}
  Modern Editorial Category Tiles Showcase
  3 large editorial tiles providing direct category navigation (Hoodies / Shirts / Trousers).
{% endcomment %}

<section class="category-tiles container" data-section-id="{{ section.id }}">
  {% if section.settings.heading != blank or section.settings.eyebrow != blank %}
    <div class="category-tiles__header">
      {% if section.settings.eyebrow != blank %}
        <span class="category-tiles__eyebrow text-micro">{{ section.settings.eyebrow }}</span>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="category-tiles__heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>
  {% endif %}

  <div class="category-tiles__grid">
    {% for block in section.blocks %}
      <div class="category-tile" {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link | default: routes.all_products_collection_url }}" class="category-tile__link">
          <div class="category-tile__media">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1200',
                  sizes: '(min-width: 990px) 33vw, 100vw',
                  class: 'category-tile__image',
                  alt: block.settings.image.alt | default: block.settings.title | escape
              }}
            {% else %}
              <div class="category-tile__placeholder">
                {% assign placeholder_index = forloop.index | modulo: 3 | plus: 1 %}
                {{ 'collection-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {% endif %}
            <div class="category-tile__overlay"></div>
          </div>

          <div class="category-tile__content">
            {% if block.settings.subtitle != blank %}
              <span class="category-tile__subtitle text-micro">{{ block.settings.subtitle }}</span>
            {% endif %}
            <h3 class="category-tile__title">{{ block.settings.title }}</h3>
            <span class="category-tile__cta text-micro">
              {{ 'general.shop_now' | t | default: 'Shop Category' }} &rarr;
            </span>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .category-tiles {
    margin-bottom: var(--space-xl);
  }

  .category-tiles__header {
    margin-bottom: var(--space-md);
    text-align: left;
  }

  .category-tiles__eyebrow {
    color: var(--color-text-subtle);
    display: block;
    margin-bottom: var(--space-2xs);
  }

  .category-tiles__heading {
    font-family: var(--font-display);
    font-size: var(--font-size-h2);
    font-weight: 400;
    line-height: var(--leading-tight);
    margin: 0;
    color: var(--color-text);
  }

  .category-tiles__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 750px) {
    .category-tiles__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--grid-gap);
    }
  }

  .category-tile {
    position: relative;
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .category-tile__link {
    display: block;
    text-decoration: none;
    position: relative;
    width: 100%;
    height: 100%;
  }

  .category-tile__media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
  }

  .category-tile__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-base);
  }

  @media (hover: hover) {
    .category-tile:hover .category-tile__image {
      transform: scale(1.03);
    }
  }

  .category-tile__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface);
  }

  .category-tile__placeholder svg {
    width: 40%;
    height: 40%;
    opacity: 0.3;
  }

  .category-tile__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(21, 21, 21, 0.4) 0%,
      rgba(21, 21, 21, 0.05) 50%,
      transparent 100%
    );
    z-index: 1;
  }

  .category-tile__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: var(--space-md);
    z-index: 2;
    color: var(--color-white);
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .category-tile__subtitle {
    color: var(--color-white);
    opacity: 0.85;
  }

  .category-tile__title {
    font-family: var(--font-display);
    font-size: var(--font-size-h3);
    font-weight: 400;
    line-height: var(--leading-tight);
    margin: 0;
    color: var(--color-white);
  }

  .category-tile__cta {
    color: var(--color-white);
    margin-top: var(--space-2xs);
    opacity: 0.9;
    transition: opacity var(--transition-fast);
  }

  .category-tile:hover .category-tile__cta {
    opacity: 1;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category Showcase",
  "tag": "section",
  "class": "section-category-tiles",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "CATALOGUE / WARDROBE CORE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Curated Categories"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Hoodies"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Material",
          "default": "Heavyweight Fleece 450GSM"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Showcase",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "title": "Hoodies",
            "subtitle": "450GSM Heavyweight Loopback"
          }
        },
        {
          "type": "tile",
          "settings": {
            "title": "Shirts",
            "subtitle": "Relaxed Japanese Poplin"
          }
        },
        {
          "type": "tile",
          "settings": {
            "title": "Trousers",
            "subtitle": "Single-Pleat Tailored Chinos"
          }
        }
      ]
    }
  ]
}
{% endschema %}
