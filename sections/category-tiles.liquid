{% comment %}
  Modern Editorial Floating Category Showcase — Smart Solutions
  Pure canvas blend: zero boxy containers, borderless floating garments,
  natural contact drop shadows, tactile hover levitation, mobile touch-snap runway,
  and native smooth cross-document page transitions.
{% endcomment %}

<section class="category-tiles container" data-section-id="{{ section.id }}">
  {% if section.settings.heading != blank %}
    <div class="category-tiles__header">
      <h2 class="category-tiles__heading">{{ section.settings.heading }}</h2>
    </div>
  {% endif %}

  <div class="category-tiles__track" role="region" aria-label="{{ section.settings.heading | default: 'Shop by Category' }}">
    {% for block in section.blocks %}
      {%- assign fallback_png = 'category-' | append: block.settings.title | downcase | append: '.png' -%}
      <div class="category-tile" {{ block.shopify_attributes }}>
        <a
          href="{{ block.settings.link | default: routes.all_products_collection_url }}"
          class="category-tile__link"
          data-category-link
          aria-label="{{ block.settings.title | escape }} - Shop All"
        >
          <div class="category-tile__stage">
            <div class="category-tile__media-box">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '400, 600, 800, 1200',
                    sizes: '(min-width: 990px) 33vw, 82vw',
                    class: 'category-tile__image',
                    alt: block.settings.image.alt | default: block.settings.title | escape
                }}
              {% else %}
                <img
                  src="{{ fallback_png | asset_url }}"
                  alt="{{ block.settings.title | escape }}"
                  width="896"
                  height="1200"
                  loading="lazy"
                  class="category-tile__image category-tile__image--transparent"
                  onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
                >
                <div class="category-tile__placeholder" style="display: none;">
                  {% assign placeholder_index = forloop.index | modulo: 3 | plus: 1 %}
                  {{ 'collection-' | append: placeholder_index | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}
            </div>
          </div>

          <div class="category-tile__meta">
            <h3 class="category-tile__title">{{ block.settings.title }}</h3>
            <div class="category-tile__action">
              <span class="category-tile__cta">
                <span>Shop All</span>
                <svg class="category-tile__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M1 7H13M13 7L7.5 1.5M13 7L7.5 12.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </div>
          </div>
        </a>
      </div>
    {% endfor %}
  </div>

  <div class="category-tiles__mobile-indicator" aria-hidden="true">
    <div class="category-tiles__mobile-bar"></div>
  </div>
</section>

{% stylesheet %}
  .section-category-tiles {
    position: relative;
    z-index: 1;
    background-color: var(--color-background);
    box-shadow: 0 -20px 40px -10px rgba(0, 0, 0, 0.06);
    border-top: 1px solid var(--color-border-subtle);
    padding-top: clamp(3rem, 5vw, 4.5rem);
  }

  .category-tiles {
    position: relative;
    padding-bottom: var(--space-xl);
    margin-bottom: 0;
  }

  /* Editorial Header */
  .category-tiles__header {
    margin-bottom: clamp(2rem, 3.5vw, 3.5rem);
    text-align: left;
  }

  .category-tiles__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 2.75rem);
    font-weight: 400;
    line-height: 1.12;
    letter-spacing: -0.025em;
    margin: 0;
    color: var(--color-text);
  }

  /* Desktop Grid & Mobile Track */
  .category-tiles__track {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 750px) {
    .category-tiles__track {
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(2rem, 3.5vw, 4.5rem);
    }
  }

  /* Zero-Border Tile Pedestal */
  .category-tile {
    position: relative;
    background: transparent;
    border: none;
  }

  .category-tile__link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    position: relative;
    width: 100%;
    height: 100%;
    color: inherit;
    transition: transform var(--transition-fast);
  }

  .category-tile__link:active {
    transform: scale(0.985);
  }

  /* Floating Stage */
  .category-tile__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 3 / 4;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    padding: var(--space-xs) var(--space-sm);
    box-sizing: border-box;
    overflow: visible;
  }

  .category-tile__media-box {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    /* Soft physical contact drop-shadow under the floating garment */
    filter: drop-shadow(0 16px 26px rgba(17, 17, 17, 0.08));
    transition: transform 380ms cubic-bezier(0.23, 1, 0.32, 1), filter 380ms cubic-bezier(0.23, 1, 0.32, 1);
    will-change: transform, filter;
  }

  .category-tile__image {
    max-width: 92%;
    max-height: 92%;
    width: auto;
    height: auto;
    object-fit: contain;
    display: block;
    margin: auto;
    background: transparent;
  }

  /* Levitation micro-interaction on hover */
  @media (hover: hover) and (pointer: fine) {
    .category-tile:hover .category-tile__media-box {
      transform: translateY(-8px) scale(1.035);
      filter: drop-shadow(0 28px 40px rgba(17, 17, 17, 0.13));
    }

    .category-tile:hover .category-tile__arrow {
      transform: translateX(4px);
    }

    .category-tile:hover .category-tile__cta {
      color: var(--color-text);
    }

    .category-tile:hover .category-tile__cta::after {
      transform: scaleX(1);
    }
  }

  .category-tile__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-surface);
  }

  .category-tile__placeholder svg {
    width: 40%;
    height: 40%;
    opacity: 0.3;
  }

  /* Centered Editorial Typography Below Garment */
  .category-tile__meta {
    margin-top: var(--space-sm);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.35rem;
    position: relative;
  }

  .category-tile__title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.04em;
    margin: 0;
    color: var(--color-text);
    text-transform: uppercase;
  }

  .category-tile__action {
    margin-top: 0.15rem;
  }

  .category-tile__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    position: relative;
    padding-bottom: 2px;
    transition: color var(--transition-fast);
  }

  .category-tile__cta::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-text);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 250ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .category-tile__arrow {
    transition: transform 220ms ease-out;
  }

  /* Mobile Horizontal Snap Runway */
  @media (max-width: 749px) {
    .category-tiles__track {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      gap: var(--space-sm);
      padding: 0 var(--page-margin) var(--space-sm);
      margin: 0 calc(-1 * var(--page-margin));
      overscroll-behavior-x: contain;
    }

    .category-tiles__track::-webkit-scrollbar {
      display: none;
    }

    .category-tile {
      flex: 0 0 78vw;
      max-width: 320px;
      scroll-snap-align: center;
      scroll-snap-stop: normal;
    }

    .category-tile__stage {
      aspect-ratio: 3 / 4;
      padding: var(--space-xs);
    }

    .category-tiles__mobile-indicator {
      display: flex;
      justify-content: center;
      margin-top: var(--space-xs);
    }

    .category-tiles__mobile-bar {
      width: 48px;
      height: 2px;
      background: var(--color-border);
      border-radius: 1px;
      position: relative;
      overflow: hidden;
    }

    .category-tiles__mobile-bar::after {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 33.333%;
      background: var(--color-text);
      transition: transform 250ms ease;
    }
  }

  @media (min-width: 750px) {
    .category-tiles__mobile-indicator {
      display: none;
    }
  }

  /* Accessibility: Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .category-tile__media-box,
    .category-tile__link,
    .category-tile__arrow,
    .category-tile__cta::after {
      transition: none !important;
      transform: none !important;
      filter: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Category Showcase",
  "tag": "section",
  "class": "section-category-tiles",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Tile Image (Cutout / Transparent)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Hoodies"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Showcase",
      "blocks": [
        {
          "type": "tile",
          "settings": {
            "title": "Hoodies"
          }
        },
        {
          "type": "tile",
          "settings": {
            "title": "Shirts"
          }
        },
        {
          "type": "tile",
          "settings": {
            "title": "Trousers"
          }
        }
      ]
    }
  ]
}
{% endschema %}
