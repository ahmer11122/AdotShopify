{%- comment -%}
  Size Guide — Atelier Desk № 03
{%- endcomment -%}
{%- capture wa_href -%}{% render 'adot-wa-link', message: 'Hello ADOT, I need help choosing a size.' %}{%- endcapture -%}

{%- assign hero_headline = section.settings.headline | default: 'Find your *fit.*' -%}
{%- assign hero_intro = section.settings.intro | default: 'Official ADOT hoodies & sweatshirts measurements. Measure your favourite garment flat across a smooth surface to find your fit. Available sizes: M, L, XL, XXL.' -%}
<div class="adot-page">
  <div class="adot-wrap">
    {% render 'adot-hero',
      num: '03',
      label: 'Size guide',
      headline: hero_headline,
      intro: hero_intro
    %}

    <div class="adot-size" data-adot-size data-wa="{{ wa_href | escape }}">
      <div class="adot-size__controls">
        <div>
          <p class="adot-rail__title adot-size__cat">{{ section.settings.category_title | default: 'Hoodies & Sweatshirts' | escape }}</p>
          <span class="adot-chip is-active adot-chip--static">{{ section.settings.fit_label | default: 'Regular / Relaxed Fit' | escape }}</span>
        </div>
        <div class="adot-seg" data-unit-seg data-unit="cm" role="group" aria-label="Unit">
          <span class="adot-seg__thumb" aria-hidden="true"></span>
          <button type="button" class="adot-seg__btn is-on" data-u="cm">cm</button>
          <button type="button" class="adot-seg__btn" data-u="in">in</button>
        </div>
      </div>

      <div class="adot-find">
        <label class="adot-field__label" for="FindSize-{{ section.id }}">Find my size — chest width of your best-fitting hoodie, laid flat</label>
        <div class="adot-field adot-field--tight">
          <input
            id="FindSize-{{ section.id }}"
            class="adot-field__control"
            type="number"
            inputmode="decimal"
            step="0.1"
            min="40"
            max="80"
            placeholder="e.g. 58"
            data-find-size
          >
        </div>
        <p class="adot-find__status" role="status" data-find-status></p>
      </div>

      <p class="adot-size__scroll-hint" aria-hidden="true">Swipe chart left / right</p>
      <div class="adot-matrix-wrap" tabindex="0" role="region" aria-label="Size chart — scroll horizontally">
        <table class="adot-matrix">
          <caption class="visually-hidden">{{ section.settings.category_title | default: 'Hoodies & Sweatshirts' | escape }} size chart</caption>
          <thead>
            <tr>
              <th scope="col">Size</th>
              <th scope="col" data-col="a"><span class="badge">A</span>Chest</th>
              <th scope="col" data-col="b"><span class="badge">B</span>Length</th>
              <th scope="col" data-col="c"><span class="badge">C</span>Shoulder</th>
              <th scope="col" data-col="d"><span class="badge">D</span>Sleeve</th>
              <th scope="col" data-col="e"><span class="badge">E</span>Hem</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'size' -%}
                <tr
                  data-size-row
                  data-size="{{ block.settings.size | escape }}"
                  data-chest="{{ block.settings.chest }}"
                  data-length="{{ block.settings.length }}"
                  data-shoulder="{{ block.settings.shoulder }}"
                  data-sleeve="{{ block.settings.sleeve }}"
                  data-hem="{{ block.settings.hem }}"
                  {{ block.shopify_attributes }}
                >
                  <td>{{ block.settings.size | escape }}</td>
                  <td data-col="a"><span data-cm="{{ block.settings.chest }}">{{ block.settings.chest }}</span></td>
                  <td data-col="b"><span data-cm="{{ block.settings.length }}">{{ block.settings.length }}</span></td>
                  <td data-col="c"><span data-cm="{{ block.settings.shoulder }}">{{ block.settings.shoulder }}</span></td>
                  <td data-col="d"><span data-cm="{{ block.settings.sleeve }}">{{ block.settings.sleeve }}</span></td>
                  <td data-col="e"><span data-cm="{{ block.settings.hem }}">{{ block.settings.hem }}</span></td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      <p class="adot-size__note">{{ section.settings.note | default: 'Chest, shoulder, and hem are laid-flat half widths. Sleeve length is measured from center back.' | escape }}</p>

      <h2 class="adot-ledger__title adot-size__howto">How to measure</h2>
      <div class="adot-ledger" data-reveal-group>
        <div class="adot-ledger__row" data-reveal data-measure="a">
          <span class="adot-ledger__n">A</span>
          <h3 class="adot-ledger__title">Chest width</h3>
          <div class="adot-ledger__body">Measured straight from armpit to armpit flat across the front of the garment.</div>
        </div>
        <div class="adot-ledger__row" data-reveal data-measure="b">
          <span class="adot-ledger__n">B</span>
          <h3 class="adot-ledger__title">Length</h3>
          <div class="adot-ledger__body">Measured from the highest point of the shoulder down to the bottom edge of the hem.</div>
        </div>
        <div class="adot-ledger__row" data-reveal data-measure="c">
          <span class="adot-ledger__n">C</span>
          <h3 class="adot-ledger__title">Shoulder width</h3>
          <div class="adot-ledger__body">Measured from shoulder seam to shoulder seam straight across the upper back.</div>
        </div>
        <div class="adot-ledger__row" data-reveal data-measure="d">
          <span class="adot-ledger__n">D</span>
          <h3 class="adot-ledger__title">Sleeve length</h3>
          <div class="adot-ledger__body">Measured from the center back of the neck, across the shoulder, down to the end of the cuff.</div>
        </div>
        <div class="adot-ledger__row" data-reveal data-measure="e">
          <span class="adot-ledger__n">E</span>
          <h3 class="adot-ledger__title">Hem width</h3>
          <div class="adot-ledger__body">Measured flat across the bottom hem opening of the garment.</div>
        </div>
      </div>
    </div>

    {% render 'adot-help-card', message: 'Hello ADOT, I need help choosing a size.' %}
  </div>
  {% render 'adot-mobile-help', message: 'Hello ADOT, I need help choosing a size.' %}
</div>

{% schema %}
{
  "name": "Size Guide Page",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Find your *fit.*"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Official ADOT hoodies & sweatshirts measurements. Measure your favourite garment flat across a smooth surface to find your fit. Available sizes: M, L, XL, XXL."
    },
    {
      "type": "text",
      "id": "category_title",
      "label": "Category title",
      "default": "Hoodies & Sweatshirts"
    },
    {
      "type": "text",
      "id": "fit_label",
      "label": "Fit label",
      "default": "Regular / Relaxed Fit"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Measurement note",
      "default": "Chest, shoulder, and hem are laid-flat half widths. Sleeve length is measured from center back."
    }
  ],
  "blocks": [
    {
      "type": "size",
      "name": "Size row",
      "limit": 8,
      "settings": [
        { "type": "text", "id": "size", "label": "Size", "default": "M" },
        { "type": "number", "id": "chest", "label": "Chest (cm)", "default": 55 },
        { "type": "number", "id": "length", "label": "Length (cm)", "default": 68 },
        { "type": "number", "id": "shoulder", "label": "Shoulder (cm)", "default": 50 },
        { "type": "number", "id": "sleeve", "label": "Sleeve (cm)", "default": 87 },
        { "type": "number", "id": "hem", "label": "Hem (cm)", "default": 50 }
      ]
    }
  ]
}
{% endschema %}
