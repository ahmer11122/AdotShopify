<section class="size-guide-section section-padding">
  <div class="container container--narrow">
    <div class="size-guide-header text-center">
      <span class="size-guide-eyebrow text-eyebrow">Official Fit Matrix</span>
      <h1 class="size-guide-title h2">Apparel Size Guide</h1>
      <p class="size-guide-subtitle text-body">
        Official ADOT hoodies &amp; sweatshirts measurements in centimetres (cm). Measure your favourite garment flat across a smooth surface to find your fit. Available sizes: M, L, XL, XXL.
      </p>
    </div>

    <!-- Hoodies & Sweatshirts Size Table (same chart) -->
    <div class="size-guide-card">
      <div class="size-guide-card__header">
        <h2 class="size-guide-card__title h4">Hoodies &amp; Sweatshirts</h2>
        <span class="size-guide-badge">Regular / Relaxed Fit</span>
      </div>
      <div class="size-guide-table-wrapper">
        <table class="size-guide-table">
          <thead>
            <tr>
              <th>Size</th>
              <th>Chest Width</th>
              <th>Length</th>
              <th>Shoulder Width</th>
              <th>Sleeve Length</th>
              <th>Hem Width</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>M</strong></td>
              <td>55 cm</td>
              <td>68 cm</td>
              <td>50 cm</td>
              <td>87 cm</td>
              <td>50 cm</td>
            </tr>
            <tr>
              <td><strong>L</strong></td>
              <td>58 cm</td>
              <td>70 cm</td>
              <td>52 cm</td>
              <td>89 cm</td>
              <td>52 cm</td>
            </tr>
            <tr>
              <td><strong>XL</strong></td>
              <td>61 cm</td>
              <td>72 cm</td>
              <td>54 cm</td>
              <td>91 cm</td>
              <td>54 cm</td>
            </tr>
            <tr>
              <td><strong>XXL</strong></td>
              <td>64 cm</td>
              <td>74 cm</td>
              <td>56 cm</td>
              <td>93 cm</td>
              <td>56 cm</td>
            </tr>
          </tbody>
        </table>
      </div>
      <p class="size-guide-card__note">
        Chest, shoulder, and hem are laid-flat half widths. Sleeve length is measured from center back.
      </p>
    </div>

    <!-- Measurement Tips -->
    <div class="size-guide-tips">
      <h3 class="h5">How to Measure</h3>
      <div class="size-guide-tips__grid">
        <div class="size-guide-tip-item">
          <strong>Chest Width:</strong>
          <p>Measured straight from armpit to armpit flat across the front of the garment.</p>
        </div>
        <div class="size-guide-tip-item">
          <strong>Length:</strong>
          <p>Measured from the highest point of the shoulder down to the bottom edge of the hem.</p>
        </div>
        <div class="size-guide-tip-item">
          <strong>Shoulder Width:</strong>
          <p>Measured from shoulder seam to shoulder seam straight across the upper back.</p>
        </div>
        <div class="size-guide-tip-item">
          <strong>Sleeve Length:</strong>
          <p>Measured from the center back of the neck, across the shoulder, down to the end of the cuff.</p>
        </div>
        <div class="size-guide-tip-item">
          <strong>Hem Width:</strong>
          <p>Measured flat across the bottom hem opening of the garment.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .size-guide-section {
    padding: 60px 20px;
    background-color: var(--color-background, #fff);
  }
  .size-guide-header {
    margin-bottom: 40px;
  }
  .size-guide-eyebrow {
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-foreground-secondary, #666);
    display: block;
    margin-bottom: 8px;
  }
  .size-guide-title {
    margin-bottom: 12px;
  }
  .size-guide-subtitle {
    max-width: 600px;
    margin: 0 auto;
    color: var(--color-foreground-secondary, #666);
  }
  .size-guide-card {
    border: 1px solid var(--color-border, #e5e5e5);
    border-radius: 0;
    padding: 24px;
    margin-bottom: 32px;
    background: #fafafa;
  }
  .size-guide-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    flex-wrap: wrap;
    gap: 8px;
  }
  .size-guide-card__title {
    margin: 0;
  }
  .size-guide-card__note {
    margin: 16px 0 0;
    font-size: 0.85rem;
    color: #666;
    max-width: 56ch;
  }
  .size-guide-badge {
    background: #000;
    color: #fff;
    font-size: 0.75rem;
    padding: 4px 10px;
    border-radius: 0;
    font-weight: 600;
    text-transform: uppercase;
  }
  .size-guide-table-wrapper {
    overflow-x: auto;
  }
  .size-guide-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    background: #fff;
    overflow: hidden;
    font-variant-numeric: tabular-nums;
  }
  .size-guide-table th {
    background: #f0f0f0;
    padding: 12px 16px;
    font-weight: 600;
    font-size: 0.875rem;
    border-bottom: 2px solid #ddd;
  }
  .size-guide-table td {
    padding: 12px 16px;
    border-bottom: 1px solid #eee;
    font-size: 0.875rem;
  }
  .size-guide-tips {
    background: #fdfdfd;
    border: 1px solid #e0e0e0;
    border-radius: 0;
    padding: 24px;
  }
  .size-guide-tips__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-top: 16px;
  }
  .size-guide-tip-item strong {
    display: block;
    margin-bottom: 4px;
    color: #111;
  }
  .size-guide-tip-item p {
    margin: 0;
    font-size: 0.85rem;
    color: #666;
  }
</style>

{% schema %}
{
  "name": "Size Guide Page",
  "settings": []
}
{% endschema %}
