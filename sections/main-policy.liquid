{% # theme-check-disable UndefinedObject %}
{%- comment -%}
  Shopify /policies/* renderer (backup path)
{%- endcomment -%}
{%- assign page_label = policy.title -%}
{%- assign handle_l = policy.handle | default: '' | downcase -%}
{%- if handle_l contains 'refund' or policy.title contains 'Refund' or policy.title contains 'Exchange' -%}
  {%- assign page_label = 'Exchange policy' -%}
{%- elsif handle_l contains 'privacy' or policy.title contains 'Privacy' -%}
  {%- assign page_label = 'Privacy' -%}
{%- elsif handle_l contains 'shipping' -%}
  {%- assign page_label = 'Shipping policy' -%}
{%- endif -%}
{%- capture wa_msg -%}Hello ADOT, I have a question about {{ policy.title }}.{%- endcapture -%}

<div class="adot-page">
  <div class="adot-wrap">
    {% render 'adot-hero',
      label: page_label,
      headline: policy.title
    %}

    <div class="adot-body">
      <div class="adot-main">
        <article class="adot-policy rte">
          {{ policy.body }}
        </article>
      </div>
    </div>

    {% if section.settings.show_help_card %}
      {% render 'adot-help-card', message: wa_msg %}
    {% endif %}
  </div>
  {% render 'adot-mobile-help', message: wa_msg %}
</div>

{% schema %}
{
  "name": "Policy",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_help_card",
      "label": "Show help card at bottom",
      "default": true
    }
  ]
}
{% endschema %}
{% # theme-check-enable UndefinedObject %}
