{%- comment -%}
  Contact — Atelier Desk № 04
{%- endcomment -%}
{%- assign wa_msg_default = section.settings.whatsapp_message | default: 'Hello ADOT, I need help with an order.' -%}
{%- capture wa_href -%}{% render 'adot-wa-link', message: wa_msg_default %}{%- endcapture -%}
{%- assign wa_digits = settings.whatsapp_number | default: '923706735800' | remove: '+' | remove: ' ' | remove: '-' -%}
{%- assign wa_base = 'https://wa.me/' | append: wa_digits -%}
{%- assign support_email = settings.support_email | default: 'support@adotoffical.com' -%}

{%- assign hero_headline = section.settings.headline | default: "Let's *talk.*" -%}
{%- assign hero_intro = section.settings.intro | default: 'We are here to help. Message us on WhatsApp for the fastest reply, or send the form below.' -%}
<div class="adot-page adot-page--contact">
  {% render 'adot-service-index' %}
  <div class="adot-wrap">
    {% render 'adot-hero',
      num: '04',
      label: 'Contact',
      headline: hero_headline,
      intro: hero_intro
    %}

    <div class="adot-body">
      <aside class="adot-rail" aria-hidden="true"></aside>
      <div class="adot-main">
        <div class="adot-contact">
          <div class="adot-contact__form">
            {% form 'contact', id: 'ContactForm', class: 'adot-form' %}
              {% if form.posted_successfully? %}
                <div class="adot-alert adot-alert--ok" role="status">
                  <svg class="adot-alert__check" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12.5l5.5 5.5L20 6"/></svg>
                  <p>{{ section.settings.success_message | default: 'Thank you! Your message has been sent. We will get back to you shortly.' | escape }}</p>
                </div>
              {% endif %}

              {% if form.errors %}
                <div class="adot-alert" role="alert">
                  {{ form.errors | default_errors }}
                </div>
              {% endif %}

              <div class="adot-field">
                <label class="adot-field__label" for="ContactName-{{ section.id }}">Your name</label>
                <input
                  type="text"
                  name="contact[name]"
                  id="ContactName-{{ section.id }}"
                  class="adot-field__control"
                  value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}"
                  placeholder="Full name"
                  autocomplete="name"
                  required
                >
                <span class="adot-field__stitch" aria-hidden="true"></span>
              </div>

              <div class="adot-field">
                <label class="adot-field__label" for="ContactEmail-{{ section.id }}">Email address</label>
                <input
                  type="email"
                  name="contact[email]"
                  id="ContactEmail-{{ section.id }}"
                  class="adot-field__control"
                  value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}"
                  placeholder="name@example.com"
                  autocomplete="email"
                  required
                >
                <span class="adot-field__stitch" aria-hidden="true"></span>
              </div>

              <div class="adot-field">
                <label class="adot-field__label" for="ContactPhone-{{ section.id }}">Phone number (optional)</label>
                <input
                  type="tel"
                  name="contact[phone]"
                  id="ContactPhone-{{ section.id }}"
                  class="adot-field__control"
                  value="{% if form.phone %}{{ form.phone | escape }}{% elsif customer %}{{ customer.phone | escape }}{% endif %}"
                  placeholder="0300 1234567"
                  autocomplete="tel"
                  inputmode="tel"
                >
                <span class="adot-field__stitch" aria-hidden="true"></span>
              </div>

              <div class="adot-field">
                <label class="adot-field__label" for="ContactOrder-{{ section.id }}">Order number (optional)</label>
                <input
                  type="text"
                  name="contact[order_number]"
                  id="ContactOrder-{{ section.id }}"
                  class="adot-field__control"
                  placeholder="e.g. #1042"
                  autocomplete="off"
                >
                <span class="adot-field__stitch" aria-hidden="true"></span>
              </div>

              <input type="hidden" name="contact[topic]" value="">

              <div class="adot-field">
                <label class="adot-field__label" for="ContactMessage-{{ section.id }}">Message</label>
                <textarea
                  name="contact[body]"
                  id="ContactMessage-{{ section.id }}"
                  class="adot-field__control"
                  rows="5"
                  placeholder="Tell us about your order, size inquiry, or question…"
                  required
                  enterkeyhint="send"
                >{% if form.body %}{{ form.body | escape }}{% endif %}</textarea>
                <span class="adot-field__stitch" aria-hidden="true"></span>
              </div>

              {% render 'adot-btn', label: 'Send message', type: 'submit', variant: 'primary' %}
            {% endform %}
          </div>

          <aside class="adot-contact__aside" aria-label="Support details">
            <div class="adot-wa-patch">
              <span
                class="adot-live"
                data-adot-status
                data-open="{{ section.settings.open_hour | default: 10 }}"
                data-close="{{ section.settings.close_hour | default: 24 }}"
                data-days="{{ section.settings.open_days | default: '1,2,3,4,5,6' }}"
              >
                <span class="adot-live__dot" aria-hidden="true"></span>
                <span data-status-label>{{ section.settings.working_hours | default: 'Monday to Saturday, 10:00 AM to 12:00 AM (Pakistan time)' | escape }}</span>
              </span>
              <h2 class="adot-wa-patch__title">Message on WhatsApp</h2>
              <p class="adot-wa-patch__copy">For fastest help with orders, sizing, or exchanges.</p>
              <a
                href="{{ wa_href }}"
                class="adot-btn adot-btn--light"
                target="_blank"
                rel="noopener noreferrer"
                data-wa-dynamic
                data-base="{{ wa_base }}"
              >
                <span class="adot-live__dot" aria-hidden="true"></span>
                <span class="adot-btn__label">Open WhatsApp chat</span>
                <span class="adot-btn__arrow" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="1" y1="7" x2="13" y2="7"></line><polyline points="8 2 13 7 8 12"></polyline></svg>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="1" y1="7" x2="13" y2="7"></line><polyline points="8 2 13 7 8 12"></polyline></svg>
                </span>
              </a>
              <div class="adot-topics" role="group" aria-label="Message topic">
                <button type="button" class="adot-chip" data-topic="Order status">Order status</button>
                <button type="button" class="adot-chip" data-topic="Size help">Size help</button>
                <button type="button" class="adot-chip" data-topic="Exchange">Exchange</button>
                <button type="button" class="adot-chip" data-topic="Something else">Something else</button>
              </div>
            </div>

            <dl class="adot-dl">
              <div class="adot-dl__row">
                <dt class="adot-dl__dt">Response time</dt>
                <dd class="adot-dl__dd">{{ section.settings.response_time | default: 'Within 2 to 4 hours on business days.' | escape }}</dd>
              </div>
              <div class="adot-dl__row">
                <dt class="adot-dl__dt">Working hours</dt>
                <dd class="adot-dl__dd">{{ section.settings.working_hours | default: 'Monday to Saturday, 10:00 AM to 12:00 AM (Pakistan time)' | escape }}</dd>
              </div>
              {% if support_email != blank %}
                <div class="adot-dl__row">
                  <dt class="adot-dl__dt">Email</dt>
                  <dd class="adot-dl__dd"><a href="mailto:{{ support_email | escape }}">{{ support_email | escape }}</a></dd>
                </div>
              {% endif %}
              <div class="adot-dl__row">
                <dt class="adot-dl__dt">Delivery coverage</dt>
                <dd class="adot-dl__dd">{{ section.settings.coverage | default: 'Cash on Delivery available nationwide across Pakistan.' | escape }}</dd>
              </div>
            </dl>
          </aside>
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact Page",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Let's *talk.*"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "We are here to help. Message us on WhatsApp for the fastest reply, or send the form below."
    },
    {
      "type": "text",
      "id": "whatsapp_message",
      "label": "Default WhatsApp message",
      "default": "Hello ADOT, I need help with an order."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you! Your message has been sent. We will get back to you shortly."
    },
    {
      "type": "text",
      "id": "response_time",
      "label": "Response time note",
      "default": "Within 2 to 4 hours on business days."
    },
    {
      "type": "text",
      "id": "working_hours",
      "label": "Working hours",
      "default": "Monday to Saturday, 10:00 AM to 12:00 AM (Pakistan time)"
    },
    {
      "type": "text",
      "id": "coverage",
      "label": "Delivery coverage",
      "default": "Cash on Delivery available nationwide across Pakistan."
    },
    {
      "type": "number",
      "id": "open_hour",
      "label": "Open hour (PKT, 0–23)",
      "default": 10
    },
    {
      "type": "number",
      "id": "close_hour",
      "label": "Close hour (PKT, 0–24)",
      "default": 24
    },
    {
      "type": "text",
      "id": "open_days",
      "label": "Open days (Mon=1 … Sun=7)",
      "default": "1,2,3,4,5,6"
    }
  ]
}
{% endschema %}
