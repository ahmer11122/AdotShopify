{% comment %}
  Lookbook Flow
  Page-scroll interpretation of a three-column flow scroll.
  Each row rests in the focal plane, then gathers toward center as the next row steps forward.
  Scroll drives transform and opacity only. Copy stays in the theme editor, never in the image.
{% endcomment %}

{% liquid
  assign card_count = section.blocks.size
  if card_count == 0
    assign card_count = 6
  endif
  assign flow_rows = card_count | plus: 2 | divided_by: 3
  assign row_label = flow_rows
  if flow_rows < 10
    assign row_label = flow_rows | prepend: '0'
  endif
  assign card_count_label = card_count
  if card_count < 10
    assign card_count_label = card_count | prepend: '0'
  endif
%}

<section
  class="flow-look"
  data-section-id="{{ section.id }}"
  data-flow-rows="{{ flow_rows }}"
  style="--flow-bg: {{ section.settings.background_color }}; --flow-ink: {{ section.settings.text_color }}; --flow-rows: {{ flow_rows }};"
  aria-labelledby="FlowLookHeading-{{ section.id }}"
>
  <lookbook-flow class="flow-look__pin" data-rows="{{ flow_rows }}">
    <div class="flow-look__stage">
      <header class="flow-look__mast">
        <div class="flow-look__header-row">
          {% if section.settings.heading != blank %}
            <h2 id="FlowLookHeading-{{ section.id }}" class="flow-look__heading">{{ section.settings.heading }}</h2>
          {% endif %}
          <p class="text-micro flow-look__count" aria-hidden="true">
            <span data-flow-now>01</span>
            <span class="flow-look__count-rule"></span>
            <span class="flow-look__count-total flow-look__count-total--desktop">{{ row_label }}</span>
            <span class="flow-look__count-total flow-look__count-total--mobile">{{ card_count_label }}</span>
          </p>
        </div>

        {% if section.settings.eyebrow != blank %}
          <p class="text-micro flow-look__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}

        {% if section.settings.caption != blank %}
          <p class="flow-look__caption">{{ section.settings.caption }}</p>
        {% endif %}
      </header>

      <div class="flow-look__viewport" data-flow-viewport>
        <div class="flow-look__grid" data-flow-grid>
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              {% liquid
                assign card_img = block.settings.image
                assign card_title = block.settings.title | default: 'Look'
                assign card_subtitle = block.settings.subtitle
                assign card_link = block.settings.link | default: routes.all_products_collection_url
                assign card_alt = card_title
                if card_subtitle != blank
                  assign card_alt = card_title | append: ', ' | append: card_subtitle
                endif
                assign col = forloop.index0 | modulo: 3
                assign row = forloop.index0 | divided_by: 3
                assign piece = forloop.index
                assign piece_label = piece
                if piece < 10
                  assign piece_label = piece | prepend: '0'
                endif
              %}
              <a
                href="{{ card_link }}"
                class="flow-card"
                data-index="{{ forloop.index0 }}"
                data-row="{{ row }}"
                data-col="{{ col }}"
                {{ block.shopify_attributes }}
              >
                <span class="flow-card__frame">
                  {% if card_img != blank %}
                    {{
                      card_img
                      | image_url: width: 1400
                      | image_tag:
                        loading: 'lazy',
                        widths: '240, 360, 480, 720, 960, 1200, 1400',
                        sizes: '(min-width: 990px) 22vw, (min-width: 750px) 30vw, 78vw',
                        class: 'flow-card__img',
                        alt: card_alt
                    }}
                  {% else %}
                    {% assign fallback_slot = forloop.index0 | modulo: 3 %}
                    {% if fallback_slot == 0 %}
                      <img class="flow-card__img" src="{{ 'category-hoodies.jpg' | asset_url }}" alt="{{ card_alt | escape }}" width="800" height="1000" loading="lazy">
                    {% elsif fallback_slot == 1 %}
                      <img class="flow-card__img" src="{{ 'category-shirts.jpg' | asset_url }}" alt="{{ card_alt | escape }}" width="800" height="1000" loading="lazy">
                    {% else %}
                      <img class="flow-card__img" src="{{ 'category-trousers.jpg' | asset_url }}" alt="{{ card_alt | escape }}" width="800" height="1000" loading="lazy">
                    {% endif %}
                  {% endif %}
                </span>
                <span class="flow-card__meta">
                  <span class="flow-card__meta-tag">
                    <span class="flow-card__meta-title">{{ card_title }}</span>
                    <span class="flow-card__meta-index">{{ piece_label }}</span>
                  </span>
                  {% if card_subtitle != blank %}
                    <span class="flow-card__meta-sub">{{ card_subtitle }}</span>
                  {% endif %}
                </span>
              </a>
            {% endfor %}
          {% else %}
            {% assign fallback_titles = 'Heavyweight Hoodie|Poplin Shirt|Twill Trouser|Daily Overshirt|Boxy Sweatshirt|Casual Shirt' | split: '|' %}
            {% assign fallback_subs = 'Organic Cotton|Relaxed Fit|Straight Cut|Classic Layer|Heavy Fleece|100% Cotton' | split: '|' %}
            {% assign fallback_files = 'category-hoodies.jpg|category-shirts.jpg|category-trousers.jpg|hero-desktop.png|category-hoodies.jpg|category-shirts.jpg' | split: '|' %}
            {% assign fallback_queries = 'hoodies|shirts|trousers|all|hoodies|shirts' | split: '|' %}
            {% for title in fallback_titles %}
              {% liquid
                assign col = forloop.index0 | modulo: 3
                assign row = forloop.index0 | divided_by: 3
                assign piece = forloop.index
                assign piece_label = piece | prepend: '0'
                assign card_subtitle = fallback_subs[forloop.index0]
                assign card_file = fallback_files[forloop.index0]
                assign card_query = fallback_queries[forloop.index0]
                if card_query == 'all'
                  assign card_link = routes.all_products_collection_url
                else
                  assign card_link = routes.all_products_collection_url | append: '?category=' | append: card_query
                endif
              %}
              <a
                href="{{ card_link }}"
                class="flow-card"
                data-index="{{ forloop.index0 }}"
                data-row="{{ row }}"
                data-col="{{ col }}"
              >
                <span class="flow-card__frame">
                  <img class="flow-card__img" src="{{ card_file | asset_url }}" alt="{{ title | escape }}, {{ card_subtitle | escape }}" width="800" height="1000" loading="lazy">
                </span>
                <span class="flow-card__meta">
                  <span class="flow-card__meta-tag">
                    <span class="flow-card__meta-title">{{ title }}</span>
                    <span class="flow-card__meta-index">{{ piece_label }}</span>
                  </span>
                  {% if card_subtitle != blank %}
                    <span class="flow-card__meta-sub">{{ card_subtitle }}</span>
                  {% endif %}
                </span>
              </a>
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <div class="flow-look__foot">
        <div class="flow-look__progress" aria-hidden="true">
          <span data-flow-progress></span>
        </div>

        <div class="flow-rail__panels" data-flow-panels aria-hidden="true">
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              {% liquid
                assign col = forloop.index0 | modulo: 3
                assign row = forloop.index0 | divided_by: 3
                assign piece = forloop.index
                assign piece_label = piece
                if piece < 10
                  assign piece_label = piece | prepend: '0'
                endif
                assign card_title = block.settings.title | default: 'Look'
                assign card_subtitle = block.settings.subtitle
              %}
              {% if col == 0 %}
                <div class="flow-rail__panel{% if row == 0 %} is-on{% endif %}" data-flow-panel="{{ row }}">
                  <div class="flow-rail__line">
              {% endif %}
                    <div class="flow-rail__item{% if col != 1 %} flow-rail__item--side{% endif %}">
                      <span class="flow-rail__index">{{ piece_label }}</span>
                      <span class="flow-rail__name">{{ card_title }}</span>
                      {% if card_subtitle != blank %}
                        <span class="flow-rail__sub">{{ card_subtitle }}</span>
                      {% endif %}
                    </div>
              {% if col == 2 or forloop.last %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          {% else %}
            {% assign fallback_titles = 'Heavyweight Hoodie|Poplin Shirt|Twill Trouser|Daily Overshirt|Boxy Sweatshirt|Casual Shirt' | split: '|' %}
            {% assign fallback_subs = 'Organic Cotton|Relaxed Fit|Straight Cut|Classic Layer|Heavy Fleece|100% Cotton' | split: '|' %}
            {% for title in fallback_titles %}
              {% assign col = forloop.index0 | modulo: 3 %}
              {% assign row = forloop.index0 | divided_by: 3 %}
              {% assign piece_label = forloop.index | prepend: '0' %}
              {% if col == 0 %}
                <div class="flow-rail__panel{% if row == 0 %} is-on{% endif %}" data-flow-panel="{{ row }}">
                  <div class="flow-rail__line">
              {% endif %}
                    <div class="flow-rail__item{% if col != 1 %} flow-rail__item--side{% endif %}">
                      <span class="flow-rail__index">{{ piece_label }}</span>
                      <span class="flow-rail__name">{{ title }}</span>
                      <span class="flow-rail__sub">{{ fallback_subs[forloop.index0] }}</span>
                    </div>
              {% if col == 2 or forloop.last %}
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          {% endif %}
        </div>

        {% if section.settings.button_label != blank %}
          <a class="btn btn-outline flow-look__cta" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            <span>{{ section.settings.button_label }}</span>
            <svg class="flow-look__cta-icon" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M2.5 6H9.5M9.5 6L6.5 3M9.5 6L6.5 9" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}
      </div>
    </div>
  </lookbook-flow>
</section>

{% stylesheet %}
  .flow-look {
    --flow-gap: clamp(8px, 1.4vw, 18px);
    --flow-board: min(100%, 920px);
    position: relative;
    height: auto;
    background: var(--flow-bg, var(--color-background));
    color: var(--flow-ink, var(--color-text));
    border-top: 1px solid var(--color-border);
  }

  .flow-look.is-live {
    height: calc(100svh + (var(--flow-rows, 2) - 1) * 120svh);
  }

  .flow-look__pin {
    display: block;
  }

  .flow-look.is-live .flow-look__pin {
    height: 100%;
  }

  .flow-look__stage {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2vh, 22px);
    padding-top: calc(var(--header-height, 80px) + 1.25rem);
    padding-bottom: var(--space-lg);
    padding-inline: var(--space-sm);
    box-sizing: border-box;
  }

  .flow-look.is-live .flow-look__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    gap: clamp(8px, 1.4vh, 16px);
    padding-bottom: 1.15rem;
    overflow: hidden;
  }

  .flow-look__mast,
  .flow-look__foot {
    width: var(--flow-board);
    max-width: 100%;
    margin-inline: auto;
  }

  .flow-look__mast {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .flow-look__header-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .flow-look__eyebrow {
    margin: 0;
    color: var(--color-text-subtle);
  }

  .flow-look__count {
    display: none;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
    font-size: var(--font-size-micro);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    flex-shrink: 0;
  }

  .flow-look.is-live .flow-look__count {
    display: inline-flex;
  }

  .flow-look__count-rule {
    width: 1.25rem;
    height: 1px;
    background: currentColor;
    opacity: 0.45;
  }

  .flow-look__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.2vw, 2.75rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .flow-look__caption {
    margin: 0.25rem 0 0;
    max-width: 42ch;
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    line-height: var(--leading-normal);
    color: var(--color-text-muted);
  }

  .flow-look__viewport {
    position: relative;
  }

  .flow-look.is-live .flow-look__viewport {
    flex: 1 1 auto;
    min-height: 26svh;
    overflow: hidden;
  }

  .flow-look__grid {
    position: relative;
    width: var(--flow-board);
    max-width: 100%;
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--flow-gap);
    row-gap: clamp(18px, 3vh, 36px);
  }

  .flow-look.is-live .flow-look__grid {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    row-gap: clamp(22px, 4.5vh, 52px);
  }

  .flow-card {
    display: block;
    color: inherit;
    text-decoration: none;
    transform-origin: center center;
    transition: none;
    -webkit-tap-highlight-color: transparent;
  }

  .flow-card:hover {
    opacity: 1;
  }

  .flow-card:focus-visible {
    outline: none;
  }

  .flow-card:focus-visible .flow-card__frame {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .flow-card__frame {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--color-surface);
    transition: transform 120ms var(--ease-out);
  }

  .flow-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    transition: transform 400ms var(--ease-out);
  }

  .flow-card:active .flow-card__frame {
    transform: scale(0.98);
  }

  .flow-card__meta {
    display: none;
  }

  .flow-look__foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-md);
    row-gap: 0.85rem;
    align-items: end;
  }

  .flow-look__progress {
    display: none;
    grid-column: 1 / -1;
    height: 1px;
    background: var(--color-border);
  }

  .flow-look.is-live .flow-look__progress {
    display: block;
  }

  .flow-look__progress span {
    display: block;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0.06);
    transform-origin: left center;
  }

  .flow-rail__panels {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;
  }

  .flow-rail__panel {
    opacity: 1;
  }

  .flow-look.is-live .flow-rail__panels {
    display: grid;
    gap: 0;
  }

  .flow-look.is-live .flow-rail__panel {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 220ms var(--ease-out), transform 220ms var(--ease-out);
    pointer-events: none;
  }

  .flow-look.is-live .flow-rail__panel.is-on {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .flow-rail__line {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--flow-gap);
  }

  .flow-rail__item {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
  }

  .flow-rail__index {
    font-family: var(--font-body);
    font-size: var(--font-size-micro);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
  }

  .flow-rail__name {
    font-family: var(--font-display);
    font-size: var(--font-size-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    line-height: 1.25;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .flow-rail__sub {
    font-family: var(--font-body);
    font-size: var(--font-size-micro);
    line-height: 1.35;
    color: var(--color-text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .flow-look__cta.btn {
    gap: 0.5rem;
    width: fit-content;
    transition:
      transform 140ms var(--ease-out),
      background-color 150ms ease,
      color 150ms ease,
      border-color 150ms ease;
  }

  .flow-look__cta-icon {
    display: block;
    transition: transform 180ms var(--ease-out);
  }

  .flow-look__cta.btn:active {
    transform: scale(0.98);
  }

  @media (min-width: 750px) {
    .flow-look__stage {
      padding-inline: var(--space-md);
    }

    .flow-look__count-total--mobile {
      display: none;
    }

    .flow-look__count-total--desktop {
      display: inline;
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .flow-card:hover .flow-card__img {
      transform: scale(1.028);
    }

    .flow-look__cta.btn:hover {
      background: var(--color-text);
      color: var(--color-text-inverse);
      border-color: var(--color-text);
      opacity: 1;
    }

    .flow-look__cta.btn:hover .flow-look__cta-icon {
      transform: translateX(3px);
    }
  }

  @media (max-width: 749px) {
    .flow-look {
      --flow-mobile-gutter: clamp(1rem, 4.5vw, 1.25rem);
      padding-block: clamp(2.25rem, 5.5vw, 3.75rem);
      height: auto !important;
      overflow: hidden;
    }

    .flow-look__pin {
      display: block;
      height: auto !important;
    }

    .flow-look__stage {
      position: relative !important;
      height: auto !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      padding-inline: 0 !important;
      gap: 1.25rem;
      overflow: visible !important;
    }

    .flow-look__mast {
      width: 100%;
      padding-inline: var(--flow-mobile-gutter);
      box-sizing: border-box;
    }

    .flow-look__heading {
      max-width: 16ch;
    }

    .flow-look__count {
      display: inline-flex !important;
    }

    .flow-look__count-total--desktop {
      display: none;
    }

    .flow-look__count-total--mobile {
      display: inline;
    }

    .flow-look__viewport {
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--flow-mobile-gutter);
      -webkit-overflow-scrolling: touch;
      scroll-behavior: smooth;
      padding-inline: 0 !important;
      padding-block: 0.25rem 0.5rem;
      scrollbar-width: none;
      box-sizing: border-box;
      touch-action: pan-x pan-y;
    }

    .flow-look__viewport::-webkit-scrollbar {
      display: none;
    }

    .flow-look__grid {
      display: flex !important;
      width: max-content !important;
      gap: 14px !important;
      padding-inline-start: var(--flow-mobile-gutter) !important;
      padding-inline-end: 0 !important;
      position: relative !important;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      transform: none !important;
      margin: 0 !important;
    }

    .flow-look__grid::after {
      content: '';
      display: block;
      flex: 0 0 var(--flow-mobile-gutter);
      width: var(--flow-mobile-gutter);
      height: 1px;
      pointer-events: none;
    }

    .flow-card {
      flex: 0 0 78vw;
      max-width: 310px;
      scroll-snap-align: start;
      scroll-snap-stop: normal;
      display: flex;
      flex-direction: column;
      text-decoration: none;
      color: inherit;
      transform: none !important;
      opacity: 1 !important;
    }

    .flow-card:last-child {
      scroll-snap-align: end;
    }

    .flow-card__frame {
      width: 100%;
      aspect-ratio: 4 / 5;
      border-radius: var(--radius-sm, 2px);
      overflow: hidden;
      background: var(--color-surface);
    }

    .flow-card__meta {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      margin-top: 0.65rem;
    }

    .flow-card__meta-tag {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .flow-card__meta-index {
      font-family: var(--font-body);
      font-size: var(--font-size-micro);
      letter-spacing: var(--tracking-micro);
      text-transform: uppercase;
      color: var(--color-text-subtle);
      font-variant-numeric: tabular-nums;
    }

    .flow-card__meta-title {
      font-family: var(--font-display);
      font-size: var(--font-size-caption);
      font-weight: 500;
      letter-spacing: var(--tracking-tight);
      line-height: 1.25;
      color: var(--color-text);
    }

    .flow-card__meta-sub {
      font-family: var(--font-body);
      font-size: var(--font-size-micro);
      line-height: 1.35;
      color: var(--color-text-muted);
    }

    .flow-look__foot {
      width: 100%;
      padding-inline: var(--flow-mobile-gutter);
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      grid-template-columns: 1fr;
    }

    .flow-rail__panels {
      display: none !important;
    }

    .flow-look__progress {
      display: block !important;
      width: 100%;
      height: 1px;
      background: var(--color-border);
      position: relative;
    }

    .flow-look__progress span {
      display: block;
      width: 100%;
      height: 1px;
      background: currentColor;
      transform-origin: left center;
      transform: scaleX(0.16);
      transition: transform 100ms var(--ease-out);
    }

    .flow-look__cta.btn {
      width: 100%;
      justify-content: center;
      min-height: 48px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .flow-look,
    .flow-look.is-live {
      height: auto;
    }

    .flow-look__stage,
    .flow-look.is-live .flow-look__stage {
      position: relative;
      height: auto;
      min-height: 0;
      overflow: visible;
    }

    .flow-look__viewport,
    .flow-look.is-live .flow-look__viewport {
      overflow: visible;
      flex: none;
      min-height: 0;
      height: auto;
    }

    .flow-look__grid,
    .flow-look.is-live .flow-look__grid {
      position: relative;
      top: auto;
      left: auto;
      right: auto;
      width: var(--flow-board);
      max-width: 100%;
      margin: 0 auto;
      transform: none !important;
    }

    .flow-card {
      transform: none !important;
      opacity: 1 !important;
    }

    .flow-card__img,
    .flow-look__cta-icon,
    .flow-rail__panel,
    .flow-look__cta.btn {
      transition: none;
    }

    .flow-look__progress,
    .flow-look__count,
    .flow-look.is-live .flow-look__progress,
    .flow-look.is-live .flow-look__count {
      display: none;
    }

    .flow-rail__panels,
    .flow-look.is-live .flow-rail__panels {
      display: flex;
      flex-direction: column;
      gap: var(--space-sm);
    }

    .flow-rail__panel,
    .flow-look.is-live .flow-rail__panel {
      opacity: 1;
      transition: none;
    }

    .flow-rail__line:has(.flow-rail__item:nth-child(3)) .flow-rail__item--side {
      display: flex;
    }

    .flow-rail__line {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

<script>
  (function () {
    if (customElements.get('lookbook-flow')) return;

    class LookbookFlow extends HTMLElement {
      connectedCallback() {
        this.stage = this.querySelector('.flow-look__stage');
        this.viewport = this.querySelector('[data-flow-viewport]');
        this.grid = this.querySelector('[data-flow-grid]');
        this.sectionEl = this.closest('.flow-look');
        this.cards = Array.from(this.querySelectorAll('.flow-card'));
        this.panels = Array.from(this.querySelectorAll('[data-flow-panel]'));
        this.nowEl = this.querySelector('[data-flow-now]');
        this.progressEl = this.querySelector('[data-flow-progress]');
        this.totalRows = Math.max(1, Math.ceil(this.cards.length / 3));
        this.activeRow = -1;
        this.activeCardMobile = -1;
        this.lastProgress = -1;
        this.baseY = 0;
        this.stride = 1;
        this.raf = 0;
        this.visible = true;
        this.mq = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.desktopMq = window.matchMedia('(min-width: 750px)');

        this.onScroll = this.onScroll.bind(this);
        this.onMobileScroll = this.onMobileScroll.bind(this);
        this.onMotion = this.onMotion.bind(this);
        this.onBreakpoint = this.onBreakpoint.bind(this);
        this.onBlockSelect = this.onBlockSelect.bind(this);

        this.mq.addEventListener('change', this.onMotion);
        this.desktopMq.addEventListener('change', this.onBreakpoint);
        document.addEventListener('shopify:block:select', this.onBlockSelect);

        this.syncMode();
        this.attach();
      }

      syncMode() {
        if (!this.sectionEl) return;
        const isDesktop = this.desktopMq.matches;
        const allowMotion = !this.mq.matches;

        if (isDesktop && allowMotion && this.cards.length) {
          this.sectionEl.classList.add('is-live');
          requestAnimationFrame(() => {
            this.measure();
            this.render(true);
          });
        } else {
          this.sectionEl.classList.remove('is-live');
          this.rest();
          if (!isDesktop) {
            this.updateMobileProgress();
          }
        }
      }

      onBreakpoint() {
        this.syncMode();
      }

      attach() {
        if (this.attached) return;
        this.attached = true;

        this.resizeObserver = new ResizeObserver(() => {
          if (this.mq.matches || !this.desktopMq.matches) return;
          this.measure();
          this.render(true);
        });
        if (this.viewport) this.resizeObserver.observe(this.viewport);
        if (this.stage) this.resizeObserver.observe(this.stage);

        this.intersectionObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            this.visible = entry.isIntersecting;
            const hint = this.visible && !this.mq.matches && this.desktopMq.matches ? 'transform, opacity' : 'auto';
            this.cards.forEach((card) => {
              card.style.willChange = hint;
            });
            if (this.grid) this.grid.style.willChange = hint;
            if (this.visible && !this.mq.matches && this.desktopMq.matches) {
              this.render(true);
            }
          });
        }, { rootMargin: '120px 0px' });
        this.intersectionObserver.observe(this.sectionEl || this);

        window.addEventListener('scroll', this.onScroll, { passive: true });
        if (this.viewport) {
          this.viewport.addEventListener('scroll', this.onMobileScroll, { passive: true });
        }
      }

      disconnectedCallback() {
        if (this.raf) cancelAnimationFrame(this.raf);
        if (this.resizeObserver) this.resizeObserver.disconnect();
        if (this.intersectionObserver) this.intersectionObserver.disconnect();
        window.removeEventListener('scroll', this.onScroll);
        if (this.viewport) {
          this.viewport.removeEventListener('scroll', this.onMobileScroll);
        }
        if (this.mq) this.mq.removeEventListener('change', this.onMotion);
        if (this.desktopMq) this.desktopMq.removeEventListener('change', this.onBreakpoint);
        document.removeEventListener('shopify:block:select', this.onBlockSelect);
      }

      onMotion() {
        this.syncMode();
      }

      onMobileScroll() {
        if (this.desktopMq.matches || !this.viewport || !this.cards.length) return;
        const scrollLeft = this.viewport.scrollLeft;
        const firstCard = this.cards[0];
        const cardWidth = firstCard ? firstCard.offsetWidth : 1;
        const gap = 14;
        const stride = cardWidth + gap;
        const active = Math.max(0, Math.min(this.cards.length - 1, Math.round(scrollLeft / stride)));

        if (active !== this.activeCardMobile) {
          this.activeCardMobile = active;
          if (this.nowEl) {
            this.nowEl.textContent = String(active + 1).padStart(2, '0');
          }
        }

        const maxScroll = this.viewport.scrollWidth - this.viewport.clientWidth;
        if (this.progressEl && maxScroll > 0) {
          const ratio = Math.min(1, Math.max(0, scrollLeft / maxScroll));
          this.progressEl.style.transform = 'scaleX(' + (0.16 + ratio * 0.84).toFixed(4) + ')';
        }
      }

      updateMobileProgress() {
        if (this.desktopMq.matches || !this.cards.length) return;
        if (this.nowEl) {
          this.nowEl.textContent = '01';
        }
        if (this.progressEl) {
          this.progressEl.style.transform = 'scaleX(0.16)';
        }
      }

      rest() {
        if (this.grid) {
          this.grid.style.transform = '';
          this.grid.style.willChange = 'auto';
        }
        this.cards.forEach((card) => {
          card.style.transform = '';
          card.style.opacity = '';
          card.style.zIndex = '';
          card.style.willChange = 'auto';
        });
        this.lastProgress = -1;
      }

      onBlockSelect(event) {
        const card = event.target && event.target.closest ? event.target.closest('.flow-card') : null;
        if (!card || !this.contains(card)) return;
        if (this.desktopMq.matches && !this.mq.matches && this.totalRows >= 2) {
          const row = Number(card.dataset.row) || 0;
          const denom = this.totalRows - 1;
          const progress = row / denom;
          const top = this.sectionEl.getBoundingClientRect().top + window.scrollY;
          const distance = Math.max(0, this.sectionEl.offsetHeight - window.innerHeight);
          window.scrollTo({ top: top + progress * distance, behavior: 'auto' });
        } else if (!this.desktopMq.matches && this.viewport) {
          card.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
        }
      }

      onScroll() {
        if (!this.visible || this.mq.matches || !this.desktopMq.matches || this.raf) return;
        this.raf = requestAnimationFrame(() => {
          this.raf = 0;
          this.render(false);
        });
      }

      measure() {
        const first = this.cards[0];
        if (!first || !this.viewport) return;
        const next = this.cards[3];
        this.stride = next ? next.offsetTop - first.offsetTop : first.offsetHeight;
        if (this.stride < 1) this.stride = first.offsetHeight || 1;
        const viewH = this.viewport.clientHeight || 0;
        this.baseY = viewH / 2 - (first.offsetTop + first.offsetHeight / 2);
      }

      render(force) {
        if (!this.sectionEl || this.mq.matches || !this.desktopMq.matches) return;
        const rect = this.sectionEl.getBoundingClientRect();
        const distance = this.sectionEl.offsetHeight - window.innerHeight;
        let progress = 0;
        if (distance > 0) {
          progress = Math.min(1, Math.max(0, -rect.top / distance));
        }
        if (!force && Math.abs(progress - this.lastProgress) < 0.0006) return;
        this.lastProgress = progress;

        const rows = this.totalRows;
        const denom = Math.max(1, rows - 1);
        const span = rows === 1 ? 1 : 1 / denom;
        const hold = span * 0.18;
        const awayAt = span * 0.84;

        for (let i = 0; i < this.cards.length; i++) {
          const card = this.cards[i];
          const row = Number(card.dataset.row) || 0;
          const col = Number(card.dataset.col) || 0;

          if (rows === 1) {
            card.style.opacity = '1';
            card.style.transform = 'none';
            card.style.zIndex = '1';
            continue;
          }

          const dist = Math.abs(progress - row / denom);
          let t = 0;
          if (dist > hold) {
            t = dist >= awayAt ? 1 : (dist - hold) / (awayAt - hold);
          }

          const sign = col === 0 ? 1 : col === 2 ? -1 : 0;
          const x = sign * 28 * t;
          const rot = sign * -6.5 * t;
          const scale = 1 + ((col === 1 ? 0.94 : 0.88) - 1) * t;
          const opacity = 1 + ((col === 1 ? 0.5 : 0.34) - 1) * t;

          card.style.zIndex = String(Math.round((1 - t) * 30) + (col === 1 ? 4 : 0));
          card.style.opacity = opacity.toFixed(3);
          card.style.transform = 'translate3d(' + x.toFixed(2) + '%, 0, 0) scale(' + scale.toFixed(4) + ') rotate(' + rot.toFixed(2) + 'deg)';
        }

        const y = rows === 1 ? this.baseY : this.baseY - progress * denom * this.stride;
        this.grid.style.transform = 'translate3d(0, ' + y.toFixed(2) + 'px, 0)';

        const active = Math.max(0, Math.min(rows - 1, Math.round(progress * denom)));
        if (active !== this.activeRow) {
          this.activeRow = active;
          this.panels.forEach((panel, index) => {
            panel.classList.toggle('is-on', index === active);
          });
          if (this.nowEl) this.nowEl.textContent = String(active + 1).padStart(2, '0');
        }

        if (this.progressEl) {
          this.progressEl.style.transform = 'scaleX(' + (0.06 + progress * 0.94).toFixed(4) + ')';
        }
      }
    }

    customElements.define('lookbook-flow', LookbookFlow);
  })();
</script>

