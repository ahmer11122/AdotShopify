{% comment %}
  Editorial Lookbook Stage — Modern Editorial Minimalism
  Interactive lookbook gallery combining fluid mouse/touch momentum,
  optical scale focusing, anchored contextual plaques, and mobile-native snap reel.
  100% vanilla Web Component, zero heavy dependencies.
{% endcomment %}

{% liquid
  assign card_count = section.blocks.size
  if card_count == 0
    assign card_count = 6
  endif
  assign total_label = card_count
  if card_count < 10
    assign total_label = card_count | prepend: '0'
  endif
%}

<section
  class="editorial-lookbook-section"
  id="EditorialLookbook-{{ section.id }}"
  data-section-id="{{ section.id }}"
  style="
    --lookbook-bg: {{ section.settings.background_color | default: '#FFFFFF' }};
    --lookbook-ink: {{ section.settings.text_color | default: '#111111' }};
    --lookbook-total: {{ card_count }};
  "
  aria-labelledby="LookbookHeading-{{ section.id }}"
>
  <editorial-lookbook class="editorial-lookbook" data-total="{{ card_count }}">
    <div class="editorial-lookbook__container">
      
      <!-- Top Masthead Header -->
      <header class="editorial-lookbook__masthead">
        <div class="editorial-lookbook__masthead-left">
          {% if section.settings.eyebrow != blank %}
            <p class="text-micro editorial-lookbook__eyebrow">{{ section.settings.eyebrow }}</p>
          {% else %}
            <p class="text-micro editorial-lookbook__eyebrow">Curated Looks · Issue 01</p>
          {% endif %}
          
          <div class="editorial-lookbook__title-row">
            {% if section.settings.heading != blank %}
              <h2 id="LookbookHeading-{{ section.id }}" class="editorial-lookbook__heading">
                {{ section.settings.heading }}
              </h2>
            {% endif %}

            <div class="editorial-lookbook__counter" aria-hidden="true">
              <span class="editorial-lookbook__counter-current" data-current-index>01</span>
              <span class="editorial-lookbook__counter-sep">/</span>
              <span class="editorial-lookbook__counter-total">{{ total_label }}</span>
            </div>
          </div>

          {% if section.settings.caption != blank %}
            <p class="editorial-lookbook__caption">{{ section.settings.caption }}</p>
          {% endif %}
        </div>

        <!-- Desktop Controls -->
        <div class="editorial-lookbook__masthead-actions">
          {% if section.settings.button_label != blank %}
            <a
              href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
              class="editorial-lookbook__cta-link text-micro"
            >
              <span>{{ section.settings.button_label }}</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M2.5 6H9.5M9.5 6L6.5 3M9.5 6L6.5 9" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          {% endif %}

          <div class="editorial-lookbook__nav-group" aria-label="Lookbook navigation">
            <button
              type="button"
              class="editorial-lookbook__nav-btn"
              data-nav-prev
              aria-label="Previous look"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M8.5 3.5L5 7L8.5 10.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button
              type="button"
              class="editorial-lookbook__nav-btn"
              data-nav-next
              aria-label="Next look"
            >
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M5.5 3.5L9 7L5.5 10.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        </div>
      </header>

      <!-- Carousel Viewport & Track -->
      <div class="editorial-lookbook__viewport" data-viewport tabindex="0" role="region" aria-label="Looks gallery" aria-roledescription="carousel">
        <div class="editorial-lookbook__track" data-track>
          {% if section.blocks.size > 0 %}
            {% for block in section.blocks %}
              {% liquid
                assign card_img = block.settings.image
                assign card_title = block.settings.title | default: 'Editorial Look'
                assign card_subtitle = block.settings.subtitle
                assign card_link = block.settings.link | default: routes.all_products_collection_url
                assign card_idx = forloop.index
                assign idx_label = card_idx
                if card_idx < 10
                  assign idx_label = card_idx | prepend: '0'
                endif
                assign alt_text = card_title
                if card_subtitle != blank
                  assign alt_text = alt_text | append: ', ' | append: card_subtitle
                endif
              %}
              <article
                class="editorial-lookbook__card{% if forloop.first %} is-active{% endif %}"
                data-card
                data-index="{{ forloop.index0 }}"
                role="group"
                aria-roledescription="slide"
                aria-label="{{ forloop.index }} of {{ card_count }}"
                {{ block.shopify_attributes }}
              >
                <a href="{{ card_link }}" class="editorial-lookbook__card-link">
                  <div class="editorial-lookbook__card-media">
                    {% if card_img != blank %}
                      {{
                        card_img
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          widths: '360, 480, 720, 960, 1200',
                          sizes: '(min-width: 990px) 30vw, (min-width: 750px) 44vw, 84vw',
                          class: 'editorial-lookbook__card-img',
                          alt: alt_text
                      }}
                    {% else %}
                      {% assign fallback_slot = forloop.index0 | modulo: 6 %}
                      {% if fallback_slot == 0 %}
                        <img class="editorial-lookbook__card-img" src="{{ 'category-hoodies.jpg' | asset_url }}" alt="{{ alt_text | escape }}" width="800" height="1000" loading="lazy">
                      {% elsif fallback_slot == 1 %}
                        <img class="editorial-lookbook__card-img" src="{{ 'category-shirts.jpg' | asset_url }}" alt="{{ alt_text | escape }}" width="800" height="1000" loading="lazy">
                      {% elsif fallback_slot == 2 %}
                        <img class="editorial-lookbook__card-img" src="{{ 'category-trousers.jpg' | asset_url }}" alt="{{ alt_text | escape }}" width="800" height="1000" loading="lazy">
                      {% elsif fallback_slot == 3 %}
                        <img class="editorial-lookbook__card-img" src="{{ 'hero-desktop.jpg' | asset_url }}" alt="{{ alt_text | escape }}" width="800" height="1000" loading="lazy">
                      {% elsif fallback_slot == 4 %}
                        <img class="editorial-lookbook__card-img" src="{{ 'fabric-hoodie-portrait.jpg' | asset_url }}" alt="{{ alt_text | escape }}" width="800" height="1000" loading="lazy">
                      {% else %}
                        <img class="editorial-lookbook__card-img" src="{{ 'fabric-hoodie-studio.jpg' | asset_url }}" alt="{{ alt_text | escape }}" width="800" height="1000" loading="lazy">
                      {% endif %}
                    {% endif %}

                    <!-- Minimalist Index Stamp -->
                    <span class="editorial-lookbook__card-stamp text-micro" aria-hidden="true">
                      {{ idx_label }}
                    </span>

                    <!-- Hover Quick Peek Action Pill -->
                    <span class="editorial-lookbook__card-hover-pill text-micro" aria-hidden="true">
                      <span>View Look</span>
                      <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M2 5H8M8 5L5.5 2.5M8 5L5.5 7.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </div>

                  <!-- Anchored Contextual Editorial Plaque -->
                  <div class="editorial-lookbook__card-info">
                    <div class="editorial-lookbook__card-text">
                      <h3 class="editorial-lookbook__card-title">{{ card_title }}</h3>
                      {% if card_subtitle != blank %}
                        <p class="editorial-lookbook__card-subtitle">{{ card_subtitle }}</p>
                      {% endif %}
                    </div>
                    <span class="editorial-lookbook__card-arrow" aria-hidden="true">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M3 9L9 3M9 3H4.5M9 3V7.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </div>
                </a>
              </article>
            {% endfor %}
          {% else %}
            {% assign fallback_titles = 'Heavyweight Hoodie|Poplin Shirt|Twill Trouser|Daily Overshirt|Boxy Sweatshirt|Casual Shirt' | split: '|' %}
            {% assign fallback_subs = '450 GSM Organic Fleece|100% Crisp Cotton|Relaxed Straight Cut|Japanese Selvedge|Heavy Loopback|Garment Dyed Twill' | split: '|' %}
            {% assign fallback_files = 'category-hoodies.jpg|category-shirts.jpg|category-trousers.jpg|hero-desktop.jpg|fabric-hoodie-portrait.jpg|fabric-hoodie-studio.jpg' | split: '|' %}
            {% assign fallback_queries = 'hoodies|shirts|trousers|all|hoodies|shirts' | split: '|' %}
            
            {% for title in fallback_titles %}
              {% liquid
                assign idx_label = forloop.index
                if idx_label < 10
                  assign idx_label = idx_label | prepend: '0'
                endif
                assign card_sub = fallback_subs[forloop.index0]
                assign card_file = fallback_files[forloop.index0]
                assign card_query = fallback_queries[forloop.index0]
                if card_query == 'all'
                  assign card_link = routes.all_products_collection_url
                else
                  assign card_link = routes.all_products_collection_url | append: '?category=' | append: card_query
                endif
              %}
              <article
                class="editorial-lookbook__card{% if forloop.first %} is-active{% endif %}"
                data-card
                data-index="{{ forloop.index0 }}"
                role="group"
                aria-roledescription="slide"
                aria-label="{{ forloop.index }} of 6"
              >
                <a href="{{ card_link }}" class="editorial-lookbook__card-link">
                  <div class="editorial-lookbook__card-media">
                    <img
                      class="editorial-lookbook__card-img"
                      src="{{ card_file | asset_url }}"
                      alt="{{ title | escape }}, {{ card_sub | escape }}"
                      width="800"
                      height="1000"
                      loading="lazy"
                    >
                    <span class="editorial-lookbook__card-stamp text-micro" aria-hidden="true">
                      {{ idx_label }}
                    </span>
                    <span class="editorial-lookbook__card-hover-pill text-micro" aria-hidden="true">
                      <span>View Look</span>
                      <svg width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M2 5H8M8 5L5.5 2.5M8 5L5.5 7.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </div>
                  <div class="editorial-lookbook__card-info">
                    <div class="editorial-lookbook__card-text">
                      <h3 class="editorial-lookbook__card-title">{{ title }}</h3>
                      <p class="editorial-lookbook__card-subtitle">{{ card_sub }}</p>
                    </div>
                    <span class="editorial-lookbook__card-arrow" aria-hidden="true">
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M3 9L9 3M9 3H4.5M9 3V7.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </div>
                </a>
              </article>
            {% endfor %}
          {% endif %}
        </div>
      </div>

      <!-- Bottom Tactile Scrubber & Mobile Footer -->
      <footer class="editorial-lookbook__footer">
        <div class="editorial-lookbook__scrubber-wrap">
          <div class="editorial-lookbook__scrubber-track" data-scrubber>
            <span class="editorial-lookbook__scrubber-fill" data-scrubber-fill></span>
          </div>
          <div class="editorial-lookbook__scrubber-numbers text-micro" aria-hidden="true">
            <span>01</span>
            <span>{{ total_label }}</span>
          </div>
        </div>

        {% if section.settings.button_label != blank %}
          <div class="editorial-lookbook__mobile-action">
            <a
              href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
              class="btn btn-outline editorial-lookbook__mobile-btn"
            >
              <span>{{ section.settings.button_label }}</span>
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M2.5 6H9.5M9.5 6L6.5 3M9.5 6L6.5 9" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        {% endif %}
      </footer>

    </div>
  </editorial-lookbook>
</section>

{% stylesheet %}
  /* ==========================================================================
     Editorial Lookbook Styles — Modern Quiet Luxury Foundation
     ========================================================================== */

  .editorial-lookbook-section {
    position: relative;
    background: var(--lookbook-bg, var(--color-background));
    color: var(--lookbook-ink, var(--color-text));
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
    border-top: 1px solid var(--color-border);
    overflow: hidden;
  }

  .editorial-lookbook__container {
    max-width: var(--container-max, 1440px);
    margin-inline: auto;
    padding-inline: var(--space-md, 2rem);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 3.5vw, 3rem);
  }

  /* --------------------------------------------------------------------------
     1. Masthead Header
     -------------------------------------------------------------------------- */
  .editorial-lookbook__masthead {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md, 2rem);
  }

  .editorial-lookbook__masthead-left {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    max-width: 620px;
  }

  .editorial-lookbook__eyebrow {
    margin: 0;
    color: var(--color-text-subtle);
  }

  .editorial-lookbook__title-row {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .editorial-lookbook__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.4vw, 2.85rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-text);
  }

  .editorial-lookbook__counter {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-body);
    font-size: var(--font-size-micro, 0.75rem);
    letter-spacing: var(--tracking-micro, 0.08em);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-subtle);
    padding: 0.2rem 0.6rem;
    background: var(--color-surface, #F5F5F5);
    border: 1px solid var(--color-border, #E5E5E5);
    border-radius: var(--radius-none, 0);
  }

  .editorial-lookbook__counter-current {
    font-weight: 600;
    color: var(--color-text);
  }

  .editorial-lookbook__caption {
    margin: 0.25rem 0 0;
    font-family: var(--font-body);
    font-size: var(--font-size-caption, 0.875rem);
    line-height: var(--leading-normal, 1.6);
    color: var(--color-text-muted);
  }

  .editorial-lookbook__masthead-actions {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-shrink: 0;
  }

  .editorial-lookbook__cta-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid currentColor;
    transition: opacity 160ms var(--ease-out);
  }

  .editorial-lookbook__cta-link:hover {
    opacity: 0.7;
  }

  .editorial-lookbook__nav-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .editorial-lookbook__nav-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: var(--color-background);
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-none, 0);
    cursor: pointer;
    transition:
      background-color 160ms var(--ease-out),
      color 160ms var(--ease-out),
      border-color 160ms var(--ease-out),
      transform 120ms var(--ease-out);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  @media (hover: hover) and (pointer: fine) {
    .editorial-lookbook__nav-btn:hover:not(:disabled) {
      background: var(--color-text);
      color: var(--color-text-inverse);
      border-color: var(--color-text);
    }
  }

  .editorial-lookbook__nav-btn:active:not(:disabled) {
    transform: scale(0.94);
  }

  .editorial-lookbook__nav-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .editorial-lookbook__nav-btn:focus-visible {
    outline: 2px solid var(--color-focus, #111111);
    outline-offset: 2px;
  }

  /* --------------------------------------------------------------------------
     2. Viewport & Track
     -------------------------------------------------------------------------- */
  .editorial-lookbook__viewport {
    position: relative;
    width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
    touch-action: pan-x pan-y;
  }

  .editorial-lookbook__viewport::-webkit-scrollbar {
    display: none;
  }

  .editorial-lookbook__viewport.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }

  .editorial-lookbook__viewport:focus-visible {
    outline: 2px solid var(--color-focus, #111111);
    outline-offset: 4px;
  }

  .editorial-lookbook__track {
    display: flex;
    gap: clamp(16px, 2.2vw, 28px);
    width: max-content;
    padding-block: 0.5rem 1rem;
    box-sizing: border-box;
  }

  /* --------------------------------------------------------------------------
     3. Lookbook Card Anatomy
     -------------------------------------------------------------------------- */
  .editorial-lookbook__card {
    flex: 0 0 clamp(280px, 26vw, 360px);
    display: flex;
    flex-direction: column;
    scroll-snap-align: start;
    transition:
      transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .editorial-lookbook__card-link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    gap: 0.85rem;
    outline: none;
  }

  .editorial-lookbook__card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    background: var(--color-surface, #F5F5F5);
    overflow: hidden;
    border: 1px solid var(--color-border, #E5E5E5);
    border-radius: var(--radius-none, 0);
  }

  .editorial-lookbook__card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    user-select: none;
    -webkit-user-drag: none;
    transition: transform 380ms var(--ease-out, cubic-bezier(0.23, 1, 0.32, 1));
  }

  @media (hover: hover) and (pointer: fine) {
    .editorial-lookbook__card:hover .editorial-lookbook__card-img {
      transform: scale(1.035);
    }
  }

  .editorial-lookbook__card-stamp {
    position: absolute;
    top: 14px;
    left: 14px;
    padding: 3px 7px;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #111111;
    font-variant-numeric: tabular-nums;
    border: 1px solid rgba(17, 17, 17, 0.08);
    font-weight: 600;
    pointer-events: none;
  }

  .editorial-lookbook__card-hover-pill {
    position: absolute;
    bottom: 14px;
    right: 14px;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 6px 12px;
    background: #111111;
    color: #FFFFFF;
    font-weight: 500;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 220ms var(--ease-out),
      transform 220ms var(--ease-out);
    pointer-events: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .editorial-lookbook__card:hover .editorial-lookbook__card-hover-pill {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .editorial-lookbook__card-info {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .editorial-lookbook__card-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .editorial-lookbook__card-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: var(--tracking-tight, -0.01em);
    color: var(--color-text);
  }

  .editorial-lookbook__card-subtitle {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--font-size-caption, 0.875rem);
    color: var(--color-text-muted);
    line-height: 1.35;
  }

  .editorial-lookbook__card-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-subtle);
    padding-top: 2px;
    transition:
      color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
    flex-shrink: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .editorial-lookbook__card:hover .editorial-lookbook__card-arrow {
      color: var(--color-text);
      transform: translate(2px, -2px);
    }
  }

  .editorial-lookbook__card-link:focus-visible {
    outline: 2px solid var(--color-focus, #111111);
    outline-offset: 3px;
  }

  /* --------------------------------------------------------------------------
     4. Bottom Scrubber Track
     -------------------------------------------------------------------------- */
  .editorial-lookbook__footer {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .editorial-lookbook__scrubber-wrap {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
  }

  .editorial-lookbook__scrubber-track {
    position: relative;
    flex: 1;
    height: 2px;
    background: var(--color-border, #E5E5E5);
    overflow: hidden;
  }

  .editorial-lookbook__scrubber-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
    background: var(--color-text, #111111);
    transform-origin: left center;
    transform: scaleX(0.16);
    transition: transform 120ms linear;
  }

  .editorial-lookbook__scrubber-numbers {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--color-text-subtle);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    flex-shrink: 0;
  }

  .editorial-lookbook__mobile-action {
    display: none;
    width: 100%;
  }

  /* --------------------------------------------------------------------------
     5. Mobile Responsive Adaptations
     -------------------------------------------------------------------------- */
  @media (max-width: 749px) {
    .editorial-lookbook-section {
      padding-block: clamp(2.5rem, 6vw, 4rem);
    }

    .editorial-lookbook__container {
      padding-inline: 0;
      gap: 1.5rem;
    }

    .editorial-lookbook__masthead {
      padding-inline: var(--space-sm, 1rem);
    }

    .editorial-lookbook__masthead-actions {
      display: none;
    }

    .editorial-lookbook__viewport {
      scroll-snap-type: x mandatory;
      padding-inline: var(--space-sm, 1rem);
      box-sizing: border-box;
      cursor: default;
    }

    .editorial-lookbook__track {
      padding-inline-end: var(--space-sm, 1rem);
      gap: 14px;
    }

    .editorial-lookbook__card {
      flex: 0 0 84vw;
      max-width: 320px;
    }

    .editorial-lookbook__card:last-child {
      scroll-snap-align: end;
    }

    .editorial-lookbook__card:active {
      transform: scale(0.985);
    }

    .editorial-lookbook__footer {
      padding-inline: var(--space-sm, 1rem);
    }

    .editorial-lookbook__mobile-action {
      display: block;
    }

    .editorial-lookbook__mobile-btn {
      width: 100%;
      min-height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }
  }

  /* --------------------------------------------------------------------------
     6. Reduced Motion Compliance
     -------------------------------------------------------------------------- */
  @media (prefers-reduced-motion: reduce) {
    .editorial-lookbook__viewport {
      scroll-behavior: auto;
    }

    .editorial-lookbook__card,
    .editorial-lookbook__card-img,
    .editorial-lookbook__card-hover-pill,
    .editorial-lookbook__nav-btn,
    .editorial-lookbook__scrubber-fill {
      transition: none !important;
    }
  }
{% endstylesheet %}

<script>
  (function () {
    if (customElements.get('editorial-lookbook')) return;

    class EditorialLookbook extends HTMLElement {
      connectedCallback() {
        this.viewport = this.querySelector('[data-viewport]');
        this.track = this.querySelector('[data-track]');
        this.cards = Array.from(this.querySelectorAll('[data-card]'));
        this.prevBtn = this.querySelector('[data-nav-prev]');
        this.nextBtn = this.querySelector('[data-nav-next]');
        this.currentEl = this.querySelector('[data-current-index]');
        this.scrubberFill = this.querySelector('[data-scrubber-fill]');
        this.total = parseInt(this.dataset.total, 10) || this.cards.length || 1;

        this.activeIndex = 0;
        this.isDragging = false;
        this.startX = 0;
        this.scrollLeft = 0;
        this.raf = 0;

        this.bindEvents();
        this.updateState();
      }

      bindEvents() {
        if (this.prevBtn) this.prevBtn.addEventListener('click', () => this.step(-1));
        if (this.nextBtn) this.nextBtn.addEventListener('click', () => this.step(1));

        if (this.viewport) {
          this.viewport.addEventListener('scroll', () => this.onScroll(), { passive: true });
          this.viewport.addEventListener('keydown', (e) => this.onKeyDown(e));

          // Mouse Drag Momentum on Desktop
          this.viewport.addEventListener('mousedown', (e) => this.onMouseDown(e));
          window.addEventListener('mousemove', (e) => this.onMouseMove(e));
          window.addEventListener('mouseup', () => this.onMouseUp());
        }

        // Shopify Theme Editor Integration
        document.addEventListener('shopify:block:select', (e) => this.onBlockSelect(e));

        // ResizeObserver for accurate track stride
        this.resizeObserver = new ResizeObserver(() => this.updateState());
        if (this.viewport) this.resizeObserver.observe(this.viewport);
      }

      disconnectedCallback() {
        if (this.resizeObserver) this.resizeObserver.disconnect();
        if (this.raf) cancelAnimationFrame(this.raf);
      }

      onScroll() {
        if (this.raf) return;
        this.raf = requestAnimationFrame(() => {
          this.raf = 0;
          this.updateState();
        });
      }

      getStride() {
        if (!this.cards.length) return 300;
        const first = this.cards[0];
        const next = this.cards[1];
        if (next) {
          return next.offsetLeft - first.offsetLeft;
        }
        return first.offsetWidth + 20;
      }

      updateState() {
        if (!this.viewport || !this.cards.length) return;

        const scrollLeft = this.viewport.scrollLeft;
        const maxScroll = Math.max(1, this.viewport.scrollWidth - this.viewport.clientWidth);
        const stride = this.getStride();
        const index = Math.max(0, Math.min(this.cards.length - 1, Math.round(scrollLeft / stride)));

        if (index !== this.activeIndex) {
          this.activeIndex = index;
          this.cards.forEach((card, idx) => {
            card.classList.toggle('is-active', idx === index);
          });
          if (this.currentEl) {
            this.currentEl.textContent = String(index + 1).padStart(2, '0');
          }
        }

        // Update Scrubber Track
        if (this.scrubberFill) {
          const ratio = Math.min(1, Math.max(0, scrollLeft / maxScroll));
          const minScale = 1 / this.total;
          const scale = minScale + ratio * (1 - minScale);
          this.scrubberFill.style.transform = `scaleX(${scale.toFixed(4)})`;
        }

        // Update Prev / Next Buttons
        if (this.prevBtn) {
          this.prevBtn.disabled = scrollLeft <= 4;
        }
        if (this.nextBtn) {
          this.nextBtn.disabled = scrollLeft >= maxScroll - 4;
        }
      }

      step(direction) {
        if (!this.viewport) return;
        const stride = this.getStride();
        const targetScroll = this.viewport.scrollLeft + direction * stride;
        this.viewport.scrollTo({
          left: targetScroll,
          behavior: 'smooth'
        });
      }

      onKeyDown(e) {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          this.step(-1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          this.step(1);
        } else if (e.key === 'Home') {
          e.preventDefault();
          this.viewport.scrollTo({ left: 0, behavior: 'smooth' });
        } else if (e.key === 'End') {
          e.preventDefault();
          this.viewport.scrollTo({ left: this.viewport.scrollWidth, behavior: 'smooth' });
        }
      }

      onMouseDown(e) {
        if (window.innerWidth < 750 || (e.button !== undefined && e.button !== 0)) return;
        this.isDragging = true;
        this.viewport.classList.add('is-dragging');
        this.startX = e.pageX - this.viewport.offsetLeft;
        this.scrollLeft = this.viewport.scrollLeft;
      }

      onMouseMove(e) {
        if (!this.isDragging || !this.viewport) return;
        e.preventDefault();
        const x = e.pageX - this.viewport.offsetLeft;
        const walk = (x - this.startX) * 1.35;
        this.viewport.scrollLeft = this.scrollLeft - walk;
      }

      onMouseUp() {
        if (!this.isDragging) return;
        this.isDragging = false;
        if (this.viewport) {
          this.viewport.classList.remove('is-dragging');
          // Smooth snap to nearest
          const stride = this.getStride();
          const target = Math.round(this.viewport.scrollLeft / stride) * stride;
          this.viewport.scrollTo({ left: target, behavior: 'smooth' });
        }
      }

      onBlockSelect(e) {
        const card = e.target && e.target.closest ? e.target.closest('[data-card]') : null;
        if (!card || !this.contains(card) || !this.viewport) return;
        const idx = parseInt(card.dataset.index, 10) || 0;
        const stride = this.getStride();
        this.viewport.scrollTo({
          left: idx * stride,
          behavior: 'smooth'
        });
      }
    }

    customElements.define('editorial-lookbook', EditorialLookbook);
  })();
</script>

