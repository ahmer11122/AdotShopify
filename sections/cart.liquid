{% comment %}
  Modern Editorial Luxury Cart Page
  - 2-Column responsive editorial layout (Items Catalog + Sticky Order Summary)
  - Free shipping progress meter
  - Monolithic quantity controls and tactile checkout CTA
  - Minimalist zero-state with collection discovery
{% endcomment %}


<div class="cart-page section" data-section-id="{{ section.id }}">
  <div class="container cart-page__container">

    <!-- Page Header -->
    <header class="cart-page__header">
      <div class="cart-page__header-title-wrap">
        <h1 class="cart-page__title">{{ 'cart.title' | t | default: 'Shopping Bag' }}</h1>
        <span class="cart-page__count text-micro">[{{ cart.item_count }}]</span>
      </div>
      <a href="{{ routes.all_products_collection_url }}" class="cart-page__continue text-micro">Continue Shopping →</a>
    </header>

    {% if cart.item_count > 0 %}
      <div class="cart-page__layout">
        
        <!-- Left: Line Items List -->
        <div class="cart-page__items-col">
          <form action="{{ routes.cart_url }}" method="post" id="CartPageForm" class="cart-page__form">
            <div class="cart-page__items-header">
              <span class="text-micro cart-page__col-label">PRODUCT</span>
              <span class="text-micro cart-page__col-label cart-page__col-label--right">TOTAL</span>
            </div>

            <div class="cart-page__items-list">
              {% for item in cart.items %}
                <div class="cart-page__item" data-item-key="{{ item.key }}">
                  <!-- Media Thumbnail -->
                  <a href="{{ item.url }}" class="cart-page__item-media" tabindex="-1">
                    {% if item.image %}
                      <img
                        src="{{ item.image | image_url: width: 300 }}"
                        alt="{{ item.title | escape }}"
                        class="cart-page__item-img"
                        width="100"
                        height="133"
                        loading="lazy"
                      >
                    {% endif %}
                  </a>

                  <!-- Item Details -->
                  <div class="cart-page__item-details">
                    <div class="cart-page__item-header">
                      <a href="{{ item.url }}" class="cart-page__item-title">{{ item.product.title }}</a>
                      <div class="cart-page__item-price-mobile text-micro">{{ item.final_line_price | money }}</div>
                    </div>

                    {% unless item.product.has_only_default_variant %}
                      <p class="cart-page__item-variant text-micro">{{ item.variant.title }}</p>
                    {% endunless %}

                    <div class="cart-page__item-unit-price text-micro">
                      {{ item.final_price | money }} each
                    </div>

                    <!-- Quantity & Remove Controls -->
                    <div class="cart-page__item-controls">
                      <div class="cart-page__qty">
                        <a
                          href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity={{ item.quantity | minus: 1 }}"
                          class="cart-page__qty-btn"
                          aria-label="Decrease quantity"
                        >−</a>
                        <input
                          type="number"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          min="0"
                          class="cart-page__qty-input text-micro"
                          aria-label="Item quantity"
                        >
                        <a
                          href="{{ routes.cart_change_url }}?id={{ item.key }}&quantity={{ item.quantity | plus: 1 }}"
                          class="cart-page__qty-btn"
                          aria-label="Increase quantity"
                        >+</a>
                      </div>

                      <a
                        href="{{ item.url_to_remove }}"
                        class="cart-page__remove text-micro"
                        aria-label="Remove {{ item.title | escape }}"
                      >
                        Remove
                      </a>
                    </div>
                  </div>

                  <!-- Line Total (Desktop) -->
                  <div class="cart-page__item-total">
                    <span class="cart-page__item-total-price">{{ item.final_line_price | money }}</span>
                  </div>
                </div>
              {% endfor %}
            </div>

            <div class="cart-page__form-actions">
              <button type="submit" name="update" class="cart-page__update-btn text-micro">Update Bag</button>
            </div>
          </form>
        </div>

        <!-- Right: Sticky Order Summary Card -->
        <div class="cart-page__summary-col">
          <div class="cart-page__summary-card">
            

            <!-- Order Financials -->
            <div class="cart-page__summary-rows">
              <div class="cart-page__summary-row">
                <span class="text-micro cart-page__summary-label">SUBTOTAL</span>
                <span class="cart-page__summary-val">{{ cart.total_price | money }}</span>
              </div>
              <div class="cart-page__summary-row cart-page__summary-row--muted">
                <span class="text-micro">SHIPPING</span>
                <span class="text-micro">Calculated at checkout</span>
              </div>
              <div class="cart-page__summary-row cart-page__summary-row--muted">
                <span class="text-micro">TAXES</span>
                <span class="text-micro">Included / Calculated at checkout</span>
              </div>
            </div>

            <div class="cart-page__summary-divider"></div>

            <!-- Total -->
            <div class="cart-page__total-row">
              <span class="cart-page__total-label">ESTIMATED TOTAL</span>
              <span class="cart-page__total-val">{{ cart.total_price | money }}</span>
            </div>

            <!-- Checkout Action Form -->
            <form action="{{ routes.cart_url }}" method="post" class="cart-page__checkout-form">
              <button type="submit" name="checkout" class="cart-page__checkout-btn">
                <span>PROCEED TO CHECKOUT</span>
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="1" y1="7" x2="13" y2="7"></line>
                  <polyline points="8 2 13 7 8 12"></polyline>
                </svg>
              </button>
            </form>

            <div class="cart-page__badges">
              <div class="cart-page__badge text-micro">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                </svg>
                <span>End-to-end encrypted checkout</span>
              </div>
              <div class="cart-page__badge text-micro">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span>Complimentary returns within 30 days</span>
              </div>
            </div>

          </div>
        </div>

      </div>

    {% else %}
      
      <!-- Empty Bag Zero-State -->
      <div class="cart-page__empty">
        <div class="cart-page__empty-icon" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 8h12l1.5 13H4.5L6 8z"></path>
            <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
          </svg>
        </div>
        <h2 class="cart-page__empty-title">YOUR BAG IS EMPTY</h2>
        <p class="cart-page__empty-subtitle text-micro">Looks like you haven't added anything to your cart yet. Discover our latest seasonal essentials below.</p>

        <div class="cart-page__empty-actions">
          <a href="{{ routes.collections_url }}/hoodies" class="cart-page__empty-btn">Shop Hoodies</a>
          <a href="{{ routes.collections_url }}/shirts" class="cart-page__empty-btn">Shop Shirts</a>
          <a href="{{ routes.collections_url }}/trousers" class="cart-page__empty-btn">Shop Trousers</a>
          <a href="{{ routes.all_products_collection_url }}" class="cart-page__empty-btn cart-page__empty-btn--primary">All Essentials →</a>
        </div>
      </div>

    {% endif %}

  </div>
</div>

{% stylesheet %}
  .cart-page {
    padding-block: clamp(2rem, 5vw, 4rem);
    background-color: var(--color-background, #FFFFFF);
  }

  .cart-page__container {
    max-width: var(--container-max, 1200px);
    margin-inline: auto;
    padding-inline: var(--space-md);
  }

  @media (max-width: 749px) {
    .cart-page__container {
      padding-inline: var(--space-sm);
    }
  }

  /* Page Header */
  .cart-page__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-lg);
  }

  .cart-page__header-title-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .cart-page__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0;
  }

  .cart-page__count {
    color: var(--color-text-subtle);
    font-size: var(--font-size-caption);
    font-variant-numeric: tabular-nums;
  }

  .cart-page__continue {
    color: var(--color-text-muted);
    text-decoration: none;
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    font-weight: 500;
    transition: color 150ms ease;
  }

  .cart-page__continue:hover {
    color: var(--color-text);
  }

  /* 2-Column Layout */
  .cart-page__layout {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (max-width: 989px) {
    .cart-page__layout {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }
  }

  /* Items Table/List Header */
  .cart-page__items-header {
    display: flex;
    justify-content: space-between;
    padding-bottom: var(--space-xs);
    border-bottom: 1px solid var(--color-border-subtle);
    margin-bottom: var(--space-sm);
  }

  .cart-page__col-label {
    letter-spacing: var(--tracking-micro);
    color: var(--color-text-subtle);
    font-weight: 500;
  }

  .cart-page__col-label--right {
    display: none;
  }

  @media (min-width: 750px) {
    .cart-page__col-label--right {
      display: block;
    }
  }

  /* Individual Cart Item */
  .cart-page__item {
    display: grid;
    grid-template-columns: 100px 1fr auto;
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-border);
    align-items: center;
  }

  @media (max-width: 749px) {
    .cart-page__item {
      grid-template-columns: 84px 1fr;
      gap: var(--space-sm);
      align-items: start;
    }
  }

  .cart-page__item-media {
    position: relative;
    aspect-ratio: 3 / 4;
    background-color: var(--color-surface);
    overflow: hidden;
    outline: 1px solid rgba(0, 0, 0, 0.04);
  }

  .cart-page__item-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cart-page__item-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .cart-page__item-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .cart-page__item-title {
    font-size: var(--font-size-body);
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    line-height: 1.3;
    transition: opacity 150ms ease;
  }

  .cart-page__item-title:hover {
    opacity: 0.8;
  }

  .cart-page__item-price-mobile {
    font-weight: 600;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 750px) {
    .cart-page__item-price-mobile {
      display: none;
    }
  }

  .cart-page__item-variant {
    color: var(--color-text-subtle);
    margin: 0;
  }

  .cart-page__item-unit-price {
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .cart-page__item-controls {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    margin-top: var(--space-xs);
  }

  .cart-page__qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
  }

  .cart-page__qty-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    text-decoration: none;
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 500;
    transition: background-color 150ms ease;
  }

  .cart-page__qty-btn:hover {
    background-color: var(--color-border);
  }

  .cart-page__qty-input {
    width: 36px;
    height: 32px;
    text-align: center;
    border: none !important;
    background: transparent !important;
    font-weight: 600;
    color: var(--color-text);
    -moz-appearance: textfield;
    padding: 0;
  }

  .cart-page__qty-input::-webkit-outer-spin-button,
  .cart-page__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .cart-page__remove {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    transition: color 150ms ease;
  }

  .cart-page__remove:hover {
    color: var(--color-sale, #991B1B);
  }

  .cart-page__item-total {
    display: none;
    font-size: var(--font-size-body);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  @media (min-width: 750px) {
    .cart-page__item-total {
      display: block;
    }
  }

  .cart-page__form-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--space-md);
  }

  .cart-page__update-btn {
    background: transparent;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    padding: 0.5rem 1rem;
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 150ms ease, color 150ms ease;
  }

  .cart-page__update-btn:hover {
    background-color: var(--color-surface);
  }

  /* Right Column: Order Summary Card */
  .cart-page__summary-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: var(--space-md);
    position: sticky;
    top: 100px;
  }

  .cart-page__summary-rows {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-bottom: var(--space-md);
  }

  .cart-page__summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .cart-page__summary-label {
    letter-spacing: var(--tracking-micro);
    color: var(--color-text);
    font-weight: 600;
  }

  .cart-page__summary-val {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  .cart-page__summary-row--muted {
    color: var(--color-text-subtle);
  }

  .cart-page__summary-divider {
    height: 1px;
    background-color: var(--color-border);
    margin-bottom: var(--space-md);
  }

  .cart-page__total-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-md);
  }

  .cart-page__total-label {
    font-size: var(--font-size-caption);
    font-weight: 600;
    letter-spacing: var(--tracking-micro);
    color: var(--color-text);
  }

  .cart-page__total-val {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    color: var(--color-text);
  }

  .cart-page__checkout-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    background-color: var(--color-surface-dark, #111111);
    color: var(--color-white, #FFFFFF);
    border: none;
    border-radius: 0;
    padding: 1.15rem 1.5rem;
    font-size: var(--font-size-caption);
    font-weight: 600;
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    cursor: pointer;
    touch-action: manipulation;
    transition: background-color 160ms ease, transform 160ms var(--ease-out);
  }

  .cart-page__checkout-btn:hover {
    background-color: #333333;
  }

  .cart-page__checkout-btn:active {
    transform: scale(0.98);
  }

  .cart-page__badges {
    margin-top: var(--space-md);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cart-page__badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-subtle);
  }

  /* Empty State */
  .cart-page__empty {
    padding-block: var(--space-xl);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .cart-page__empty-icon {
    color: var(--color-text-subtle);
    margin-bottom: var(--space-md);
  }

  .cart-page__empty-title {
    font-family: var(--font-display);
    font-size: var(--font-size-h2);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text);
    margin: 0 0 0.5rem 0;
  }

  .cart-page__empty-subtitle {
    color: var(--color-text-muted);
    margin: 0 0 var(--space-lg) 0;
    max-width: 440px;
    line-height: 1.5;
  }

  .cart-page__empty-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }

  .cart-page__empty-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--color-border);
    background-color: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    font-size: var(--font-size-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    transition: background-color 160ms var(--ease-out), color 160ms var(--ease-out), border-color 160ms var(--ease-out);
  }

  .cart-page__empty-btn:hover {
    background-color: var(--color-text);
    color: var(--color-white);
    border-color: var(--color-text);
  }

  .cart-page__empty-btn--primary {
    background-color: var(--color-surface-dark, #111111);
    color: var(--color-white, #FFFFFF);
    border-color: var(--color-surface-dark, #111111);
  }

  .cart-page__empty-btn--primary:hover {
    background-color: #333333;
    border-color: #333333;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cart Page",
  "settings": []
}
{% endschema %}
