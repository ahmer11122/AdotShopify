{% comment %}
  Product Reviews Section (Judge.me integration)
  Positioned after product info, description & size guide, before cross-sells.
{% endcomment %}

<section
  class="section-product-reviews section-product-reviews--{{ section.id }}"
  id="ProductReviews-{{ section.id }}"
  data-section-id="{{ section.id }}"
  data-section-type="product-reviews"
  {% if section.settings.hide_if_empty %}
    data-hide-if-empty="true"
    {% assign r_count = product.metafields.reviews.rating_count | default: 0 | plus: 0 %}
    {% if r_count == 0 %}
      data-is-empty="true"
      style="display: none;"
    {% endif %}
  {% endif %}
>
  <div class="section-product-reviews__inner">
    {%- if section.settings.heading != blank -%}
      <div class="section-product-reviews__header">
        <h2 class="section-product-reviews__title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="section-product-reviews__content">
      {%- assign rendered_app_block = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          {%- assign rendered_app_block = true -%}
          <div class="product-reviews__app-block" {{ block.shopify_attributes }}>
            {% render block %}
          </div>
        {%- endif -%}
      {%- endfor -%}

      {%- unless rendered_app_block -%}
        <div style="clear:both"></div>
        <div
          id="judgeme_product_reviews"
          class="jdgm-widget jdgm-review-widget"
          data-product-title="{{ product.title | escape }}"
          data-id="{{ product.id }}"
        >{{ product.metafields.judgeme.widget }}</div>
      {%- endunless -%}
    </div>
  </div>
</section>

<style>
  .section-product-reviews {
    background-color: var(--color-background, #fff);
    padding-top: clamp(3rem, 6vw, 5.5rem);
    padding-bottom: clamp(3rem, 6vw, 5.5rem);
    border-top: 1px solid oklch(0 0 0 / 0.08);
  }

  .section-product-reviews__inner {
    max-width: var(--container-max, 1440px);
    margin: 0 auto;
    padding-inline: var(--page-margin, 1rem);
  }

  .section-product-reviews__title {
    font-family: var(--font-display, var(--font-body, system-ui, sans-serif));
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin: 0 0 clamp(1.5rem, 3vw, 2.5rem);
    color: var(--color-text, #111);
  }

  /* Hide empty review box when hide_if_empty is enabled */
  .section-product-reviews[data-hide-if-empty="true"][data-is-empty="true"] {
    display: none !important;
  }

  .section-product-reviews[data-hide-if-empty="true"] .jdgm-rev-widg[data-number-of-reviews='0'],
  .section-product-reviews[data-hide-if-empty="true"] .jdgm-review-widget[data-number-of-reviews='0'],
  .section-product-reviews[data-hide-if-empty="true"]:has([data-number-of-reviews='0']),
  .section-product-reviews[data-hide-if-empty="true"]:has(.jdgm-rev-widg[data-number-of-reviews='0']) {
    display: none !important;
  }

  /* Judge.me styling overrides to align with Atelier minimalism */
  .section-product-reviews .jdgm-rev-widg {
    padding: 0 !important;
    border: none !important;
  }

  .section-product-reviews .jdgm-widget-actions-wrapper {
    margin-bottom: 2rem !important;
  }

  @media (max-width: 749px) {
    .section-product-reviews {
      padding-top: 2.5rem;
      padding-bottom: 3.5rem;
    }
  }
</style>

<script>
  (function () {
    var section = document.querySelector('.section-product-reviews--{{ section.id }}');
    if (!section || section.getAttribute('data-hide-if-empty') !== 'true') return;

    function checkEmptyState() {
      var widget = section.querySelector('.jdgm-review-widget, .jdgm-rev-widg');
      if (!widget) return;

      var numReviews = widget.getAttribute('data-number-of-reviews');
      var revItems = section.querySelectorAll('.jdgm-rev');

      // If Judge.me reports 0 reviews or no review cards exist yet
      if (numReviews === '0' || (numReviews !== null && parseInt(numReviews, 10) === 0)) {
        section.setAttribute('data-is-empty', 'true');
        section.style.display = 'none';
      } else if (revItems.length > 0 || (numReviews && parseInt(numReviews, 10) > 0)) {
        section.removeAttribute('data-is-empty');
        section.style.display = '';
      }
    }

    checkEmptyState();
    document.addEventListener('DOMContentLoaded', checkEmptyState);
    document.addEventListener('jdgm.doneSetup', checkEmptyState);
    window.addEventListener('load', checkEmptyState);

    if (window.MutationObserver) {
      var observer = new MutationObserver(checkEmptyState);
      observer.observe(section, {
        attributes: true,
        subtree: true,
        attributeFilter: ['data-number-of-reviews', 'class']
      });
    }
  })();
</script>

{% schema %}
{
  "name": "Product Reviews",
  "tag": "section",
  "class": "section-product-reviews-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Customer Reviews"
    },
    {
      "type": "checkbox",
      "id": "hide_if_empty",
      "label": "Hide until product has reviews",
      "default": true,
      "info": "Prevents displaying an empty review box before any reviews have been published."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Product Reviews"
    }
  ]
}
{% endschema %}
