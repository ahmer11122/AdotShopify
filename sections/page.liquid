{%- comment -%}
  Generic editorial page
{%- endcomment -%}
{%- assign page_label = page.title -%}
{%- assign handle_l = page.handle | downcase -%}
{%- if handle_l contains 'refund' or handle_l contains 'exchange' -%}
  {%- assign page_label = 'Exchange policy' -%}
{%- elsif handle_l contains 'privacy' -%}
  {%- assign page_label = 'Privacy' -%}
{%- endif -%}
{%- capture wa_msg -%}Hello ADOT, I have a question about {{ page.title }}.{%- endcapture -%}

<div class="adot-page">
  <div class="adot-wrap">
    {% render 'adot-hero',
      label: page_label,
      headline: page.title
    %}

    <div class="adot-body">
      <div class="adot-main">
        <article class="adot-policy rte">
          {{ page.content }}
        </article>
      </div>
    </div>

    {% if section.settings.show_help_card %}
      {% render 'adot-help-card', message: wa_msg %}
    {% endif %}
  </div>
  {% render 'adot-mobile-help', message: wa_msg %}
</div>

{% schema %}
{
  "name": "t:general.page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_help_card",
      "label": "Show help card at bottom",
      "default": true
    }
  ]
}
{% endschema %}
