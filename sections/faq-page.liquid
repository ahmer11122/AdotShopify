{%- comment -%}
  FAQ — quiet editorial
{%- endcomment -%}

{%- assign hero_headline = section.settings.headline | default: 'Questions, *answered.*' -%}
{%- assign hero_intro = section.settings.intro | default: 'Find quick answers regarding delivery, Cash on Delivery, sizing, and exchanges.' -%}
{%- assign c_all = section.blocks.size -%}
{%- assign c_delivery = 0 -%}
{%- assign c_payments = 0 -%}
{%- assign c_sizing = 0 -%}
{%- assign c_exchanges = 0 -%}
{%- for block in section.blocks -%}
  {%- case block.settings.category -%}
    {%- when 'Delivery' -%}{%- assign c_delivery = c_delivery | plus: 1 -%}
    {%- when 'Payments' -%}{%- assign c_payments = c_payments | plus: 1 -%}
    {%- when 'Sizing' -%}{%- assign c_sizing = c_sizing | plus: 1 -%}
    {%- when 'Exchanges' -%}{%- assign c_exchanges = c_exchanges | plus: 1 -%}
  {%- endcase -%}
{%- endfor -%}

<div class="adot-page" data-adot-faq data-cat="all">
  <div class="adot-wrap">
    {% render 'adot-hero',
      label: 'FAQ',
      headline: hero_headline,
      intro: hero_intro
    %}

    <div class="adot-body">
      <div class="adot-main">
        <div class="adot-filters" role="toolbar" aria-label="FAQ categories">
          <button type="button" class="adot-chip is-active" data-faq-cat="all">All {{ c_all }}</button>
          <button type="button" class="adot-chip" data-faq-cat="Delivery">Delivery {{ c_delivery }}</button>
          <button type="button" class="adot-chip" data-faq-cat="Payments">Payments {{ c_payments }}</button>
          <button type="button" class="adot-chip" data-faq-cat="Sizing">Sizing {{ c_sizing }}</button>
          <button type="button" class="adot-chip" data-faq-cat="Exchanges">Exchanges {{ c_exchanges }}</button>
        </div>

        <div class="adot-search">
          <svg class="adot-search__icon" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="7" cy="7" r="5"></circle><line x1="11" y1="11" x2="14.5" y2="14.5"></line></svg>
          <label class="visually-hidden" for="FaqSearch-{{ section.id }}">Search questions</label>
          <input
            id="FaqSearch-{{ section.id }}"
            class="adot-search__input"
            type="search"
            data-faq-search
            placeholder="Search questions…"
            autocomplete="off"
            enterkeyhint="search"
          >
        </div>
        <p class="adot-search__status" role="status" data-faq-status>{{ section.blocks.size }} questions</p>

        <div class="adot-empty" data-faq-empty>
          <p>No match for “<span data-q></span>”. Ask us directly →</p>
          {%- assign wa_digits = settings.whatsapp_number | default: '923706735800' | remove: '+' | remove: ' ' | remove: '-' -%}
          {%- assign wa_base = 'https://wa.me/' | append: wa_digits -%}
          {%- capture empty_wa -%}{% render 'adot-wa-link', message: 'Hello ADOT, I have a question about my order.' %}{%- endcapture -%}
          <a
            href="{{ empty_wa }}"
            class="adot-btn adot-btn--primary"
            target="_blank"
            rel="noopener noreferrer"
            data-empty-wa
            data-base="{{ wa_base }}"
          >
            <span class="adot-btn__label">Chat on WhatsApp</span>
            <span class="adot-btn__arrow" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="1" y1="7" x2="13" y2="7"></line><polyline points="8 2 13 7 8 12"></polyline></svg>
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="1" y1="7" x2="13" y2="7"></line><polyline points="8 2 13 7 8 12"></polyline></svg>
            </span>
          </a>
        </div>

        <div data-reveal-group>
          {%- for block in section.blocks -%}
            {%- assign cat = block.settings.category | default: 'Other' -%}
            {%- assign n = forloop.index | prepend: '00' | slice: -2, 2 -%}
            <details
              class="adot-q"
              id="q-{{ block.id }}"
              data-reveal
              data-cat="{{ cat | escape }}"
              data-q="{{ block.settings.question | escape }}"
              data-a="{{ block.settings.answer | strip_html | escape }}"
              {{ block.shopify_attributes }}
            >
              <summary class="adot-q__sum">
                <span class="adot-q__n">{{ n }}</span>
                <span class="adot-q__q">{{ block.settings.question | escape }}</span>
                <span class="adot-q__icon" aria-hidden="true"><span></span><span></span></span>
              </summary>
              <div class="adot-q__a">
                <div class="adot-q__a-inner rte">
                  {{ block.settings.answer }}
                </div>
              </div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>

    {% render 'adot-help-card', message: 'Hello ADOT, I have a question about my order.' %}
  </div>
  {% render 'adot-mobile-help', message: 'Hello ADOT, I have a question about my order.' %}
</div>

{% schema %}
{
  "name": "FAQ Page",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Questions, *answered.*",
      "info": "Wrap one accent word in *asterisks*."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Find quick answers regarding delivery, Cash on Delivery, sizing, and exchanges."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "FAQ Item",
      "settings": [
        {
          "type": "select",
          "id": "category",
          "label": "Category",
          "options": [
            { "value": "Delivery", "label": "Delivery" },
            { "value": "Payments", "label": "Payments" },
            { "value": "Sizing", "label": "Sizing" },
            { "value": "Exchanges", "label": "Exchanges" },
            { "value": "Other", "label": "Other" }
          ],
          "default": "Other"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does shipping work?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We process orders within 24 hours. Delivery takes 3 to 4 working days (Monday to Friday).</p>"
        }
      ]
    }
  ]
}
{% endschema %}
