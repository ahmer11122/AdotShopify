{% comment %}
  Related Items Section (PDP Cross-Selling)
  - Shows 4 distinct items excluding the currently viewed product
  - Single clean heading: "Related Items" (no tags, no subheadings, no explanations)
  - 4-column desktop / 2-column mobile quiet luxury product cards
  - Generous bottom padding to clear the mobile pinned quick-add bar
{% endcomment %}

<section
  class="related-items container"
  data-section-id="{{ section.id }}"
  data-section-type="related-items"
  aria-label="{{ section.settings.heading | default: 'Related Items' }}"
>
  <div class="related-items__header">
    <h2 class="related-items__heading">{{ section.settings.heading | default: 'Related Items' }}</h2>
  </div>

  <div class="related-items__grid">
    {% assign current_handle = product.handle %}
    {% assign rendered_count = 0 %}

    {% for prod_item in collections.all.products %}
      {% if prod_item.handle == current_handle or prod_item.handle contains 'gift-card' or prod_item.type contains 'Gift' %}
        {% continue %}
      {% endif %}

      <div class="related-items__item">
        {% render 'product-card', product: prod_item, lazy_load: false %}
      </div>

      {% assign rendered_count = rendered_count | plus: 1 %}
      {% if rendered_count == 4 %}
        {% break %}
      {% endif %}
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .section-complete-the-look {
    background-color: var(--color-background, #FFFFFF);
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    padding-top: clamp(2.5rem, 4vw, 4rem);
    padding-bottom: clamp(5rem, 8vw, 7.5rem); /* Extra bottom room to ensure cards clear mobile sticky bar */
  }

  .related-items {
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .related-items__header {
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .related-items__heading {
    font-family: var(--font-display, inherit);
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--color-text, #111111);
    margin: 0;
  }

  /* 2-Column mobile grid / 4-Column desktop grid */
  .related-items__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(12px, 2.5vw, 20px) clamp(10px, 2vw, 16px);
  }

  @media (min-width: 990px) {
    .related-items__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2rem 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Related Items",
  "tag": "section",
  "class": "section-complete-the-look",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related Items"
    }
  ],
  "presets": [
    {
      "name": "Related Items"
    }
  ]
}
{% endschema %}
