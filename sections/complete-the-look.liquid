{% comment %}
  Related Items Section (PDP cross-sell)
  - Four pieces, drawn first from the same collection as the current product, then from the whole catalogue
  - Header carries a way out: a link to the full catalogue
  - Cards rise in on scroll (CSS scroll-driven, progressive enhancement; always visible without it)
  - 4 columns on desktop, 2 on mobile; bottom padding clears the mobile quick-add bar
{% endcomment %}

{%- liquid
  assign current_handle = product.handle
  assign rendered_count = 0
  assign shown = ','
  assign primary_collection = product.collections | first
-%}

<section
  class="related-items container"
  data-section-id="{{ section.id }}"
  data-section-type="related-items"
  aria-labelledby="RelatedHeading-{{ section.id }}"
>
  <div class="related-items__header">
    <h2 class="related-items__heading" id="RelatedHeading-{{ section.id }}">{{ section.settings.heading | default: 'You may also like' }}</h2>
    <a class="related-items__all" href="{{ routes.all_products_collection_url }}">
      <span>Shop all</span>
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M1.5 8h13M14.5 8L9 2.5M14.5 8L9 13.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>

  <div class="related-items__grid">
    {%- for pass in (1..2) -%}
      {%- if rendered_count >= 4 -%}{%- break -%}{%- endif -%}
      {%- if pass == 1 and primary_collection != blank -%}
        {%- assign pool = primary_collection.products -%}
      {%- elsif pass == 2 -%}
        {%- assign pool = collections.all.products -%}
      {%- else -%}
        {%- continue -%}
      {%- endif -%}

      {%- for prod_item in pool -%}
        {%- assign marker = prod_item.handle | prepend: ',' | append: ',' -%}
        {%- if prod_item.handle == current_handle or prod_item.handle contains 'gift-card' or prod_item.type contains 'Gift' or shown contains marker -%}
          {%- continue -%}
        {%- endif -%}

        <div class="related-items__item" style="--n:{{ rendered_count }}">
          {% render 'product-card', product: prod_item, lazy_load: true %}
        </div>

        {%- assign shown = shown | append: prod_item.handle | append: ',' -%}
        {%- assign rendered_count = rendered_count | plus: 1 -%}
        {%- if rendered_count == 4 -%}{%- break -%}{%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .section-complete-the-look {
    background-color: var(--color-background, #FFFFFF);
    padding-top: clamp(3rem, 6vw, 6rem);
    padding-bottom: clamp(5.5rem, 8vw, 8rem); /* clears the mobile sticky bar */
  }

  .related-items {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .related-items__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
    border-top: 1px solid oklch(0 0 0 / 0.1);
  }

  .related-items__heading {
    margin: 0;
    font-family: var(--font-display, inherit);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--color-text, #111111);
    text-wrap: balance;
  }

  .related-items__all {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text, #111111);
    white-space: nowrap;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }

  .related-items__all svg {
    transition: transform 240ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .related-items__all:hover {
      opacity: 1;
    }

    .related-items__all:hover svg {
      transform: translateX(4px);
    }
  }

  .related-items__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 0.75rem;
    touch-action: manipulation;
  }

  @media (min-width: 990px) {
    .related-items__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 2.5rem 1.5rem;
    }
  }

  /* Cards rise as they enter the viewport; the stagger comes from the grid column. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .related-items__item {
        animation: related-rise linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 45%;
      }

      @media (min-width: 990px) {
        .related-items__item:nth-child(2) { animation-range: entry 4% entry 52%; }
        .related-items__item:nth-child(3) { animation-range: entry 8% entry 59%; }
        .related-items__item:nth-child(4) { animation-range: entry 12% entry 66%; }
      }
    }
  }

  @keyframes related-rise {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Related Items",
  "tag": "section",
  "class": "section-complete-the-look",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    }
  ],
  "presets": [
    {
      "name": "Related Items"
    }
  ]
}
{% endschema %}
