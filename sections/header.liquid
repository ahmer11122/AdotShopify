{% comment %}
  =============================================================================
  ADOT STUDIO — Luxury Header, Navigation, Predictive Search & Cart Drawer
  Shopify Online Store 2.0 Section
  JS: assets/adot-header-system.js  |  CSS: assets/header-v2.css
  =============================================================================
{% endcomment %}

{{ 'header-v2.css' | asset_url | stylesheet_tag }}

{% liquid
  assign wa_number = section.settings.whatsapp_number | default: '923131707080' | strip | remove: '+' | remove: ' ' | remove: '-'
%}

<!-- Settings for the JavaScript: shop money format (so prices never show a wrong "$") -->
<script>
  window.AdotUI = window.AdotUI || {};
  window.AdotUI.root = {{ routes.root_url | json }};
  window.AdotUI.moneyFormat = {{ shop.money_format | strip_html | json }};
</script>
<p class="visually-hidden" role="status" aria-live="polite" data-adot-live></p>

<!-- Accessible Mobile Navigation Drawer -->
<header-drawer class="header-drawer" id="HeaderDrawer">
  <div class="header-drawer__backdrop" data-drawer-close></div>
  <div class="header-drawer__panel" role="dialog" aria-modal="true" aria-label="Navigation Menu">
    <div class="header-drawer__header">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 200 | image_tag: class: 'header-drawer__logo-img', alt: shop.name, loading: 'lazy' }}
        {% else %}
          <img
            src="{{ 'logo.png' | asset_url }}"
            alt="{{ shop.name }}"
            class="header-drawer__logo-img"
            width="44"
            height="47"
            loading="lazy"
          >
        {% endif %}
      </a>
      <button type="button" class="header-drawer__close" data-drawer-close aria-label="Close menu">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <line x1="1" y1="1" x2="17" y2="17"></line>
          <line x1="17" y1="1" x2="1" y2="17"></line>
        </svg>
      </button>
    </div>

    <nav class="header-drawer__nav" aria-label="Mobile Navigation">
      <ul class="header-drawer__primary-links">
        {% if section.settings.direct_categories %}
          <li><a href="{{ routes.collections_url }}/hoodies" class="header-drawer__primary-link">Hoodies</a></li>
          <li><a href="{{ routes.collections_url }}/sweatshirts" class="header-drawer__primary-link">Sweatshirts</a></li>
          <li><a href="{{ routes.collections_url }}/trousers" class="header-drawer__primary-link">Trousers</a></li>
          <li><a href="{{ routes.collections_url }}/shop-all" class="header-drawer__primary-link">Shop All</a></li>
        {% else %}
          {% for link in section.settings.menu.links %}
            <li>
              <a href="{{ link.url }}" class="header-drawer__primary-link">
                {{ link.title }}
              </a>
            </li>
          {% else %}
            <li><a href="{{ routes.collections_url }}/hoodies" class="header-drawer__primary-link">Hoodies</a></li>
            <li><a href="{{ routes.collections_url }}/sweatshirts" class="header-drawer__primary-link">Sweatshirts</a></li>
            <li><a href="{{ routes.collections_url }}/trousers" class="header-drawer__primary-link">Trousers</a></li>
            <li><a href="{{ routes.collections_url }}/shop-all" class="header-drawer__primary-link">Shop All</a></li>
          {% endfor %}
        {% endif %}
      </ul>

      <div class="header-drawer__divider"></div>

      <ul class="header-drawer__secondary-links">
        <li>
          <a href="{{ routes.search_url }}" class="header-drawer__secondary-link text-micro" data-search-trigger>
            Search
          </a>
        </li>
        {% if shop.customer_accounts_enabled %}
          <li>
            <a href="{{ routes.account_url }}" class="header-drawer__secondary-link text-micro">
              {% if customer %}
                Account
              {% else %}
                Sign In
              {% endif %}
            </a>
          </li>
        {% endif %}
        <li>
          <a href="{{ routes.root_url }}pages/size-guide" class="header-drawer__secondary-link text-micro">
            Size Guide
          </a>
        </li>
        <li>
          <a href="{{ routes.root_url }}pages/shipping-delivery" class="header-drawer__secondary-link text-micro">
            Shipping &amp; Exchanges
          </a>
        </li>
      </ul>
    </nav>

    <div class="header-drawer__footer">
      <p class="text-micro header-drawer__meta">{{ section.settings.drawer_meta_text | default: 'ADOT STUDIO' }}</p>
    </div>
  </div>
</header-drawer>

<!-- Accessible Full-Screen Search Overlay & Live Predictive Search -->
<search-modal class="search-modal" id="SearchModal" role="dialog" aria-modal="false" aria-hidden="true" inert aria-label="Search Store" data-wa="{{ wa_number }}">
  <div class="search-modal__backdrop" data-search-close></div>
  <div class="search-modal__content">
    
    <!-- Top Header Bar with Brand Logo and Close Button -->
    <div class="search-modal__topbar">
      <div class="container search-modal__topbar-inner">
        <a href="{{ routes.root_url }}" class="search-modal__logo-link" aria-label="{{ shop.name }}">
          {% if section.settings.logo != blank %}
            {{ section.settings.logo | image_url: width: 200 | image_tag: class: 'search-modal__logo-img', alt: shop.name, loading: 'lazy' }}
          {% else %}
            <img
              src="{{ 'logo.png' | asset_url }}"
              alt="{{ shop.name }}"
              class="search-modal__logo-img"
              width="44"
              height="47"
              loading="lazy"
            >
          {% endif %}
        </a>
        <button type="button" class="search-modal__close" data-search-close aria-label="Close search">
          <span class="search-modal__close-key text-micro" aria-hidden="true">ESC</span>
          <svg class="search-modal__close-icon" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <line x1="1" y1="1" x2="17" y2="17"></line>
            <line x1="17" y1="1" x2="1" y2="17"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Main Discovery Body (Scrollable Full-Canvas) -->
    <div class="search-modal__body">
      <div class="container search-modal__container">

        <!-- Main Search Form -->
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-modal__form">
          <div class="search-modal__input-wrapper">
            <svg class="search-modal__search-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7.5"></circle>
              <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
            </svg>
            <input
              type="search"
              name="q"
              class="search-modal__input"
              placeholder="{{ section.settings.search_placeholder | default: 'Search hoodies, sweatshirts, trousers' }}"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="none"
              spellcheck="false"
              enterkeyhint="search"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="SearchResults"
              aria-haspopup="listbox"
              data-search-input
            >
            <button type="button" class="search-modal__clear" data-search-clear aria-label="Clear search text" hidden>
              <svg width="14" height="14" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <line x1="1" y1="1" x2="17" y2="17"></line>
                <line x1="17" y1="1" x2="1" y2="17"></line>
              </svg>
            </button>
          </div>
        </form>

        <!-- Recent searches (filled by JavaScript) -->
        <div class="search-modal__recent" data-search-recent hidden></div>

        <!-- Zero-State: Trending Suggestions & Curated Quick Exploration -->
        <div class="search-modal__suggestions" data-search-suggestions>
          <div class="search-modal__suggestions-group">
            <p class="text-micro search-modal__suggestions-title">POPULAR SEARCHES</p>
            <div class="search-modal__tags">
              {% assign search_tag_blocks = section.blocks | where: 'type', 'search_tag' %}
              {% if search_tag_blocks.size > 0 %}
                {% for block in search_tag_blocks %}
                  {% if block.settings.label != blank %}
                    <button
                      type="button"
                      class="search-modal__tag"
                      data-tag-search="{{ block.settings.query | default: block.settings.label | escape }}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.label }}
                    </button>
                  {% endif %}
                {% endfor %}
              {% else %}
                <button type="button" class="search-modal__tag" data-tag-search="Hoodie">Hoodies</button>
                <button type="button" class="search-modal__tag" data-tag-search="Sweatshirt">Sweatshirts</button>
                <button type="button" class="search-modal__tag" data-tag-search="Trouser">Trousers</button>
                <button type="button" class="search-modal__tag" data-tag-search="Winter">Winter</button>
              {% endif %}
            </div>
          </div>

          <div class="search-modal__quick-group">
            <p class="text-micro search-modal__suggestions-title">DISCOVER COLLECTIONS</p>
            <div class="search-modal__quick-links">
              <a href="{{ routes.all_products_collection_url }}" class="search-modal__quick-link">
                <span>Shop All</span>
                <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="1" y1="7" x2="13" y2="7"></line>
                  <polyline points="8 2 13 7 8 12"></polyline>
                </svg>
              </a>
              <a href="{{ routes.collections_url }}/hoodies" class="search-modal__quick-link">
                <span>Hoodies Collection</span>
                <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="1" y1="7" x2="13" y2="7"></line>
                  <polyline points="8 2 13 7 8 12"></polyline>
                </svg>
              </a>
              <a href="{{ routes.collections_url }}/sweatshirts" class="search-modal__quick-link">
                <span>Sweatshirts Collection</span>
                <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="1" y1="7" x2="13" y2="7"></line>
                  <polyline points="8 2 13 7 8 12"></polyline>
                </svg>
              </a>
              <a href="{{ routes.collections_url }}/trousers" class="search-modal__quick-link">
                <span>Trousers Collection</span>
                <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="1" y1="7" x2="13" y2="7"></line>
                  <polyline points="8 2 13 7 8 12"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Live Predictive Results Container -->
        <div class="search-modal__results" id="SearchResults" role="listbox" data-search-results hidden></div>
        <div class="visually-hidden" data-search-status role="status" aria-live="polite"></div>

      </div>
    </div>
  </div>
</search-modal>

<!-- Accessible Slide-Out Luxury Cart Drawer -->
{% render 'cart-drawer',
  section_id: section.id,
  free_threshold: section.settings.free_shipping_threshold,
  trust_text: section.settings.cart_trust_text,
  wa_number: wa_number
%}

<!-- Main Header Bar -->
<header class="header {% if section.settings.sticky %}header--sticky{% endif %} header--overlay full-width" data-section-id="{{ section.id }}" data-smart-hide="{{ section.settings.smart_hide }}">
  <div class="header__main">
    <div class="container header__container">
      
      <!-- Mobile: Left Hamburger Button -->
      <div class="header__mobile-left">
        <button
          type="button"
          class="header__hamburger"
          aria-expanded="false"
          aria-controls="HeaderDrawer"
          aria-label="Open navigation menu"
          data-drawer-trigger
        >
          <span class="header__hamburger-line header__hamburger-line--top"></span>
          <span class="header__hamburger-line header__hamburger-line--bottom"></span>
        </button>
      </div>

      <!-- Desktop: Left Capsule Navigation -->
      <nav class="header__nav-left" aria-label="Desktop Navigation">
        <div class="header__categories">
          {% if section.settings.direct_categories %}
            <a href="{{ routes.collections_url }}/hoodies" class="header__nav-link text-micro">
              <span>Hoodies</span>
            </a>
            <a href="{{ routes.collections_url }}/sweatshirts" class="header__nav-link text-micro">
              <span>Sweatshirts</span>
            </a>
            <a href="{{ routes.collections_url }}/trousers" class="header__nav-link text-micro">
              <span>Trousers</span>
            </a>
            <a href="{{ routes.collections_url }}/shop-all" class="header__nav-link text-micro">
              <span>Shop All</span>
            </a>
          {% else %}
            {% for link in section.settings.menu.links %}
              <a href="{{ link.url }}" class="header__nav-link text-micro">
                <span>{{ link.title }}</span>
              </a>
            {% else %}
              <a href="{{ routes.collections_url }}/hoodies" class="header__nav-link text-micro">
                <span>Hoodies</span>
              </a>
              <a href="{{ routes.collections_url }}/sweatshirts" class="header__nav-link text-micro">
                <span>Sweatshirts</span>
              </a>
              <a href="{{ routes.collections_url }}/trousers" class="header__nav-link text-micro">
                <span>Trousers</span>
              </a>
              <a href="{{ routes.collections_url }}/shop-all" class="header__nav-link text-micro">
                <span>Shop All</span>
              </a>
            {% endfor %}
          {% endif %}
        </div>
      </nav>

      <!-- Center: Mathematically & Optically Centered Brand Wordmark -->
      <div class="header__brand-center">
        <a href="{{ routes.root_url }}" class="header__logo-link" aria-label="{{ shop.name }}">
          {% if section.settings.logo != blank %}
            {{ section.settings.logo | image_url: width: 220 | image_tag: class: 'header__logo-img', alt: shop.name, loading: 'eager' }}
          {% else %}
            <img
              src="{{ 'logo.png' | asset_url }}"
              alt="{{ shop.name }}"
              class="header__logo-img"
              width="44"
              height="47"
              loading="eager"
            >
          {% endif %}
        </a>
      </div>

      <!-- Right: Minimalist Utility Icons (Desktop & Mobile) -->
      <div class="header__utilities-right">
        <!-- Search Icon Trigger -->
        <a href="{{ routes.search_url }}" class="header__icon-btn header__icon-btn--search" aria-label="Search" data-search-trigger>
          <svg class="header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7.5"></circle>
            <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
          </svg>
        </a>

        <!-- Customer Account Icon (Desktop Only — in drawer on mobile) -->
        {% if shop.customer_accounts_enabled %}
          <a href="{{ routes.account_url }}" class="header__icon-btn header__icon-btn--account" aria-label="{% if customer %}Account{% else %}Sign In{% endif %}">
            <svg class="header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-1.5a4.5 4.5 0 0 0-4.5-4.5h-7A4.5 4.5 0 0 0 4 19.5V21"></path>
              <circle cx="12" cy="7.5" r="4"></circle>
            </svg>
          </a>
        {% endif %}

        <!-- Shopping Bag Icon + Typographic Counter -->
        <a href="{{ routes.cart_url }}" class="header__icon-btn header__cart-btn" aria-label="Shopping Bag, {{ cart.item_count }} items" data-cart-trigger data-tl-bag>
          <svg class="header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 8h12l1.5 13H4.5L6 8z"></path>
            <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
          </svg>
          <span class="header__cart-count text-micro" data-cart-count data-tl-badge>[{{ cart.item_count }}]</span>
        </a>
      </div>

    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Custom Brand Logo"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "direct_categories",
      "label": "Display Direct Capsule Categories (Hoodies, Sweatshirts, Trousers)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Enable Sticky Glassmorphism Header",
      "default": true
    },
    {
      "type": "text",
      "id": "drawer_meta_text",
      "label": "Drawer meta text",
      "default": "ADOT STUDIO"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search hoodies, sweatshirts, trousers"
    },
    {
      "type": "header",
      "content": "Header behaviour"
    },
    {
      "type": "checkbox",
      "id": "smart_hide",
      "label": "Hide header when scrolling down",
      "default": false
    },
    {
      "type": "header",
      "content": "Bag"
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free delivery from (amount)",
      "info": "Shows a progress bar in the bag. Use 0 to hide it.",
      "default": 10000
    },
    {
      "type": "text",
      "id": "cart_trust_text",
      "label": "Trust points under the total",
      "info": "Separate points with a | sign.",
      "default": "Cash on delivery|7-day exchange|Delivery in 2-4 days"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp number",
      "info": "Country code, numbers only. Example: 923001234567. Shows an Order on WhatsApp button in the bag and in search.",
      "default": "923131707080"
    }
  ],
  "blocks": [
    {
      "type": "search_tag",
      "name": "Search tag",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Hoodies"
        },
        {
          "type": "text",
          "id": "query",
          "label": "Search query",
          "default": "Hoodie",
          "info": "Value submitted when the tag is clicked."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        {
          "type": "search_tag",
          "settings": {
            "label": "Hoodies",
            "query": "Hoodie"
          }
        },
        {
          "type": "search_tag",
          "settings": {
            "label": "Sweatshirts",
            "query": "Sweatshirt"
          }
        },
        {
          "type": "search_tag",
          "settings": {
            "label": "Trousers",
            "query": "Trouser"
          }
        },
        {
          "type": "search_tag",
          "settings": {
            "label": "Winter",
            "query": "Winter"
          }
        }
      ]
    }
  ]
}
{% endschema %}
