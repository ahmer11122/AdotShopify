{% endstylesheet %}

<script>
  class HeaderDrawer extends HTMLElement {
    constructor() {
      super();
      this.isOpen = false;
      this.triggerButtons = document.querySelectorAll('[data-drawer-trigger]');
      this.closeButtons = this.querySelectorAll('[data-drawer-close]');
      this.lastFocusedElement = null;

      this.init();
    }

    init() {
      this.triggerButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          if (this.isOpen) {
            this.close();
          } else {
            this.lastFocusedElement = e.currentTarget;
            this.open();
          }
        });
      });

      this.closeButtons.forEach((btn) => {
        btn.addEventListener('click', () => this.close());
      });

      // Auto close when navigating via drawer link
      this.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => this.close());
      });

      // Escape key listener & Tab focus trap
      document.addEventListener('keydown', (e) => {
        if (!this.isOpen) return;

        if (e.key === 'Escape') {
          this.close();
          return;
        }

        if (e.key === 'Tab') {
          const focusable = this.querySelectorAll(
            'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
          );
          if (focusable.length === 0) return;

          const first = focusable[0];
          const last = focusable[focusable.length - 1];

          if (e.shiftKey) {
            if (document.activeElement === first) {
              e.preventDefault();
              last.focus();
            }
          } else {
            if (document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        }
      });
    }

    open() {
      this.isOpen = true;
      this.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      const header = document.querySelector('.header');
      if (header) {
        header.classList.add('header--drawer-open');
      }
      this.triggerButtons.forEach((btn) => {
        btn.setAttribute('aria-expanded', 'true');
        btn.setAttribute('aria-label', 'Close navigation menu');
        btn.classList.add('is-active');
      });

      // Move focus inside
      const firstFocusable = this.querySelector('button, [href]');
      if (firstFocusable) {
        setTimeout(() => firstFocusable.focus(), 60);
      }
    }

    close() {
      this.isOpen = false;
      this.classList.remove('is-open');
      document.body.style.overflow = '';
      const header = document.querySelector('.header');
      if (header) {
        header.classList.remove('header--drawer-open');
      }
      this.triggerButtons.forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Open navigation menu');
        btn.classList.remove('is-active');
      });

      // Restore focus to opener
      if (this.lastFocusedElement) {
        this.lastFocusedElement.focus();
      }
    }
  }

  if (!customElements.get('header-drawer')) {
    customElements.define('header-drawer', HeaderDrawer);
  }

  class SearchModal extends HTMLElement {
    constructor() {
      super();
      this.isOpen = false;
      this.triggerButtons = document.querySelectorAll('[data-search-trigger]');
      this.closeButtons = this.querySelectorAll('[data-search-close]');
      this.input = this.querySelector('[data-search-input]');
      this.clearButton = this.querySelector('[data-search-clear]');
      this.suggestions = this.querySelector('[data-search-suggestions]');
      this.resultsContainer = this.querySelector('[data-search-results]');
      this.form = this.querySelector('form');
      this.lastFocusedElement = null;
      this.debounceTimeout = null;
      this.activeAbortController = null;
      this.cachedResults = {};
      this.activeOption = -1;

      this.init();
    }

    init() {
      this.triggerButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          this.lastFocusedElement = e.currentTarget;

          // If mobile drawer is currently open, close it first
          const drawer = document.querySelector('header-drawer');
          if (drawer && drawer.isOpen) {
            drawer.close();
          }

          this.open();
        });
      });

      this.closeButtons.forEach((btn) => {
        btn.addEventListener('click', () => this.close());
      });

      if (this.clearButton && this.input) {
        this.clearButton.addEventListener('click', () => {
          this.input.value = '';
          this.input.focus();
          this.clearButton.hidden = true;
          this.resetResults();
        });
      }

      if (this.input) {
        this.input.addEventListener('input', (e) => {
          const query = e.target.value.trim();
          if (this.clearButton) {
            this.clearButton.hidden = query.length === 0;
          }

          if (query.length === 0) {
            this.resetResults();
            return;
          }

          clearTimeout(this.debounceTimeout);
          this.debounceTimeout = setTimeout(() => {
            this.fetchResults(query);
          }, 300);
        });
      }

      // Quick Tag Search Buttons
      this.querySelectorAll('[data-tag-search]').forEach((tagBtn) => {
        tagBtn.addEventListener('click', (e) => {
          const term = e.currentTarget.getAttribute('data-tag-search');
          if (this.input) {
            this.input.value = term;
            if (this.clearButton) this.clearButton.hidden = false;
            this.input.focus();
            this.fetchResults(term);
          }
        });
      });

      // Escape key to close
      document.addEventListener('keydown', (e) => {
        if (!this.isOpen) return;

        if (e.key === 'Escape') {
          this.close();
          return;
        }

        if ((e.key === 'ArrowDown' || e.key === 'ArrowUp') && this.input && document.activeElement === this.input) {
          const options = [...this.querySelectorAll('[data-search-option]')];
          if (!options.length) return;
          e.preventDefault();
          const current = options.findIndex((el) => el.getAttribute('aria-selected') === 'true');
          let next = e.key === 'ArrowDown' ? current + 1 : current - 1;
          if (next < 0) next = options.length - 1;
          if (next >= options.length) next = 0;
          this.selectOption(options, next);
          return;
        }

        if (e.key === 'Enter' && this.input && document.activeElement === this.input) {
          const selected = this.querySelector('[data-search-option][aria-selected="true"]');
          if (selected) {
            e.preventDefault();
            selected.click();
          }
          return;
        }

        // Tab trapping
        if (e.key === 'Tab') {
          const focusable = this.querySelectorAll(
            'button:not([hidden]), [href], input:not([hidden]), [tabindex]:not([tabindex="-1"])'
          );
          if (focusable.length === 0) return;

          const first = focusable[0];
          const last = focusable[focusable.length - 1];

          if (e.shiftKey) {
            if (document.activeElement === first) {
              e.preventDefault();
              last.focus();
            }
          } else {
            if (document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        }
      });
    }

    open() {
      this.isOpen = true;
      this.classList.add('is-open');
      this.removeAttribute('aria-hidden');
      this.removeAttribute('inert');
      this.setAttribute('aria-modal', 'true');
      if (this.input) this.input.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';

      setTimeout(() => {
        if (this.input) {
          this.input.focus();
        }
      }, 50);
    }

    close() {
      this.isOpen = false;
      this.classList.remove('is-open');
      this.setAttribute('aria-hidden', 'true');
      this.setAttribute('inert', '');
      this.setAttribute('aria-modal', 'false');
      if (this.input) {
        this.input.setAttribute('aria-expanded', 'false');
        this.input.removeAttribute('aria-activedescendant');
      }
      this.clearOption();
      document.body.style.overflow = '';

      if (this.lastFocusedElement) {
        this.lastFocusedElement.focus();
      }
    }

    selectOption(options, index) {
      options.forEach((el) => el.setAttribute('aria-selected', 'false'));
      const active = options[index];
      if (!active) return;
      if (!active.id) active.id = `SearchOption-${index}`;
      active.setAttribute('aria-selected', 'true');
      this.activeOption = index;
      if (this.input) this.input.setAttribute('aria-activedescendant', active.id);
      active.scrollIntoView({ block: 'nearest' });
    }

    clearOption() {
      this.activeOption = -1;
      this.querySelectorAll('[data-search-option][aria-selected="true"]').forEach((el) => {
        el.setAttribute('aria-selected', 'false');
      });
    }

    resetResults() {
      if (this.resultsContainer) {
        this.resultsContainer.hidden = true;
        this.resultsContainer.innerHTML = '';
      }
      if (this.suggestions) {
        this.suggestions.hidden = false;
      }
    }

    formatPrice(amount) {
      if (amount == null || amount === '') return '';
      const numeric = String(amount).replace(/rs\.?/ig, '').replace(/[$€£]/g, '').replace(/,/g, '').trim();
      const num = parseFloat(numeric);
      if (!Number.isFinite(num)) return '';
      const cents = Math.round(Math.abs(num) * 100);
      const whole = Math.floor(cents / 100).toLocaleString('en-PK');
      const frac = cents % 100;
      const amountText = frac === 0 ? whole : `${whole}.${String(frac).padStart(2, '0')}`;
      return `Rs. ${amountText}`;
    }

    highlight(text, query) {
      const safe = this.escapeHtml(text);
      const term = String(query || '').trim();
      if (!term) return safe;
      const pattern = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
      return safe.replace(new RegExp(`(${pattern})`, 'ig'), '<mark class="search-modal__mark">$1</mark>');
    }

    escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    async fetchResults(query) {
      const queryKey = query.toLowerCase();
      if (this.cachedResults[queryKey]) {
        this.renderProducts(this.cachedResults[queryKey], query);
        return;
      }

      if (this.activeAbortController) {
        this.activeAbortController.abort();
      }
      this.activeAbortController = new AbortController();
      const status = this.querySelector('[data-search-status]');
      if (status) status.textContent = 'Searching';

      if (this.suggestions) {
        this.suggestions.hidden = true;
      }
      if (this.resultsContainer) {
        this.resultsContainer.hidden = false;
        this.resultsContainer.innerHTML = `
          <div class="search-modal__loading">
            <p class="text-micro">SEARCHING STORE...</p>
          </div>
        `;
      }

      try {
        const response = await fetch(
          `/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=6`,
          { signal: this.activeAbortController.signal }
        );

        if (!response.ok) throw new Error('Search failed');

        const data = await response.json();
        const products = data.resources?.results?.products || [];
        this.cachedResults[queryKey] = products;

        this.renderProducts(products, query);
        if (status) {
          status.textContent = products.length === 0
            ? `No products found for ${query}`
            : `${products.length} products found for ${query}`;
        }
      } catch (err) {
        if (err.name === 'AbortError') return;
        if (this.resultsContainer) {
          this.resultsContainer.innerHTML = `
            <div class="search-modal__empty">
              <p>Unable to load results. Press enter to perform full search.</p>
            </div>
          `;
        }
      }
    }

    renderProducts(products, query) {
      if (!this.resultsContainer) return;
      this.clearOption();

      if (products.length === 0) {
        this.resultsContainer.innerHTML = `
          <div class="search-modal__empty">
            <p>No products found matching "<strong>${this.escapeHtml(query)}</strong>"</p>
          </div>
        `;
        return;
      }

      const productsHtml = products
        .map((product, index) => {
          const imgUrl = product.image || product.featured_image?.url || '';
          const title = this.highlight(product.title, query);
          const alt = this.escapeHtml(product.title);
          const url = this.escapeHtml(product.url);
          const price = this.formatPrice(product.price);

          return `
            <a href="${url}" class="search-modal__card" id="SearchOption-${index}" data-search-option role="option" aria-selected="false">
              <div class="search-modal__card-media">
                ${imgUrl ? `<img src="${imgUrl}" alt="${alt}" class="search-modal__card-img" width="300" height="300" loading="lazy">` : ''}
              </div>
              <div class="search-modal__card-info">
                <span class="search-modal__card-title">${title}</span>
                <span class="search-modal__card-price text-micro">${price}</span>
              </div>
            </a>
          `;
        })
        .join('');

      const viewAllUrl = `/search?q=${encodeURIComponent(query)}`;

      this.resultsContainer.innerHTML = `
        <div class="search-modal__results-header">
          <span class="text-micro search-modal__results-title">MATCHING PRODUCTS (${products.length})</span>
        </div>
        <div class="search-modal__grid">
          ${productsHtml}
        </div>
        <a href="${viewAllUrl}" class="search-modal__view-all">
          <span>View all results for "${this.escapeHtml(query)}"</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="1" y1="7" x2="13" y2="7"></line>
            <polyline points="8 2 13 7 8 12"></polyline>
          </svg>
        </a>
      `;
    }
  }

  if (!customElements.get('search-modal')) {
    customElements.define('search-modal', SearchModal);
  }

  class CartDrawer extends HTMLElement {
    constructor() {
      super();
      this.isOpen = false;
      this.currencySymbol = this.dataset.currency || '$';
      this.lastFocusedElement = null;
      this.init();
    }

    init() {
      document.querySelectorAll('[data-cart-trigger], .header__cart-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          this.lastFocusedElement = e.currentTarget;
          this.open();
        });
      });

      this.querySelectorAll('[data-cart-close]').forEach((btn) => {
        btn.addEventListener('click', () => this.close());
      });

      window.addEventListener('cart:open', () => this.open());
      window.addEventListener('cart:refresh', () => this.fetchCart());

      this.addEventListener('click', (e) => {
        const qtyBtn = e.target.closest('[data-qty-change]');
        const removeBtn = e.target.closest('[data-remove-item]');
        if ((qtyBtn || removeBtn) && window.AdotCart) return;

        if (qtyBtn) {
          const delta = parseInt(qtyBtn.getAttribute('data-qty-change'), 10);
          const key = qtyBtn.getAttribute('data-key');
          this.changeQuantity(key, delta);
          return;
        }

        if (removeBtn) {
          const key = removeBtn.getAttribute('data-key');
          this.removeItem(key);
          return;
        }
      });

      const bindQty = () => {
        if (!window.AdotCart) return;
        window.AdotCart.bind(this, {});
        window.AdotCart.syncButtons(this);
      };
      if (window.AdotCart) bindQty();
      else window.addEventListener('adot:cart-ready', bindQty, { once: true });

      document.addEventListener('keydown', (e) => {
        if (!this.isOpen) return;

        if (e.key === 'Escape') {
          this.close();
          return;
        }

        if (e.key === 'Tab') {
          const focusable = this.querySelectorAll(
            'button:not([hidden]):not([disabled]), [href], input:not([hidden]):not([disabled]), [tabindex]:not([tabindex="-1"])'
          );
          if (focusable.length === 0) return;
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.shiftKey) {
            if (document.activeElement === first) {
              e.preventDefault();
              last.focus();
            }
          } else {
            if (document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        }
      });
    }

    open() {
      this.isOpen = true;
      this.classList.add('is-open');
      this.removeAttribute('aria-hidden');
      this.removeAttribute('inert');
      this.setAttribute('aria-modal', 'true');
      document.body.style.overflow = 'hidden';

      const searchModal = document.querySelector('search-modal');
      if (searchModal && searchModal.isOpen) searchModal.close();

      const headerDrawer = document.querySelector('header-drawer');
      if (headerDrawer && headerDrawer.isOpen) headerDrawer.close();

      const items = this.querySelector('[data-cart-items]');
      const rows = this.querySelectorAll('[data-item-key]').length;
      const shownCount = Number(String(this.querySelector('[data-drawer-count]')?.textContent || '').replace(/\D/g, '')) || 0;
      if (items && rows > 0) items.hidden = false;
      if (shownCount > 0 && rows === 0) this.fetchCart();

      const closeBtn = this.querySelector('.cart-drawer__close');
      if (closeBtn) closeBtn.focus();
    }

    close() {
      this.isOpen = false;
      this.classList.remove('is-open');
      this.setAttribute('aria-hidden', 'true');
      this.setAttribute('inert', '');
      this.setAttribute('aria-modal', 'false');
      document.body.style.overflow = '';

      if (this.lastFocusedElement) {
        this.lastFocusedElement.focus();
      }
    }

    formatMoney(cents) {
      const value = Math.round(Number(cents));
      const negative = value < 0;
      const abs = Math.abs(value);
      const whole = Math.floor(abs / 100).toLocaleString('en-PK');
      const frac = abs % 100;
      const amount = frac === 0 ? whole : `${whole}.${String(frac).padStart(2, '0')}`;
      return `${negative ? '-' : ''}Rs. ${amount}`;
    }

    async fetchCart() {
      if (window.AdotCart && window.AdotCart.hasPending()) {
        this.dataset.refreshQueued = 'true';
        return;
      }
      delete this.dataset.refreshQueued;

      const sectionId = this.dataset.sectionId;
      if (sectionId) {
        try {
          const url = new URL(window.location.href);
          url.searchParams.set('section_id', sectionId);
          url.hash = '';
          const res = await fetch(url.toString(), { cache: 'no-store' });
          if (!res.ok) throw new Error('Section render failed');
          const html = await res.text();
          const doc = new DOMParser().parseFromString(html, 'text/html');
          const next = doc.querySelector('cart-drawer');
          if (!next) throw new Error('Cart drawer missing from section');

          const items = this.querySelector('[data-cart-items]');
          const nextItems = next.querySelector('[data-cart-items]');
          const nextHasLines = Boolean(nextItems && nextItems.querySelector('[data-item-key]'));
          const renderedCount = Number(next.dataset.cartCountValue || 0);
          if (!nextHasLines && renderedCount > 0) throw new Error('Section cart omitted line items');
          if (items && nextItems) {
            items.innerHTML = nextItems.innerHTML;
            items.hidden = false;
          }

          const empty = this.querySelector('[data-cart-empty]');
          const nextEmpty = next.querySelector('[data-cart-empty]');
          if (empty && nextEmpty) empty.hidden = nextEmpty.hidden;

          const footer = this.querySelector('.cart-drawer__footer');
          const nextFooter = next.querySelector('.cart-drawer__footer');
          if (footer && nextFooter) {
            footer.hidden = nextFooter.hidden;
            const subtotal = footer.querySelector('[data-cart-subtotal]');
            const nextSubtotal = nextFooter.querySelector('[data-cart-subtotal]');
            if (subtotal && nextSubtotal) subtotal.textContent = nextSubtotal.textContent;
          }

          const count = this.querySelector('[data-drawer-count]');
          const nextCount = next.querySelector('[data-drawer-count]');
          if (count && nextCount) count.textContent = nextCount.textContent;

          if (next.dataset.cartTotal) this.dataset.cartTotal = next.dataset.cartTotal;
          if (next.dataset.cartCountValue) this.dataset.cartCountValue = next.dataset.cartCountValue;

          doc.querySelectorAll('[data-cart-count]').forEach((source) => {
            document.querySelectorAll('[data-cart-count]').forEach((el) => {
              el.textContent = source.textContent;
              el.setAttribute('data-cart-count', source.getAttribute('data-cart-count') || source.textContent.replace(/\D/g, ''));
            });
          });

          if (window.AdotCart) window.AdotCart.syncButtons(this);
          return;
        } catch (err) {
          console.error('Error rendering cart section:', err);
        }
      }

      try {
        const res = await fetch('/cart.js');
        const cart = await res.json();
        this.updateUI(cart);
      } catch (err) {
        console.error('Error fetching cart:', err);
      }
    }

    async updateQuantity(key, quantity, itemEl) {
      if (!itemEl) itemEl = this.querySelector(`[data-item-key="${key}"]`);
      if (itemEl) itemEl.classList.add('is-updating');
      try {
        const res = await fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: key, quantity })
        });
        if (!res.ok) throw new Error('Cart update failed');
        const cart = await res.json();
        this.updateUI(cart);
      } catch (err) {
        console.error('Error updating cart:', err);
        if (itemEl) itemEl.classList.remove('is-updating');
      }
    }

    async removeItem(key, itemEl) {
      if (!itemEl) itemEl = this.querySelector(`[data-item-key="${key}"]`);
      if (itemEl) itemEl.classList.add('is-updating');
      try {
        const res = await fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ id: key, quantity: 0 })
        });
        if (!res.ok) throw new Error('Cart remove failed');
        const cart = await res.json();
        this.updateUI(cart);
      } catch (err) {
        console.error('Error removing item:', err);
        if (itemEl) itemEl.classList.remove('is-updating');
      }
    }

    async changeQuantity(key, delta) {
      const itemEl = this.querySelector(`[data-item-key="${key}"]`);
      const qtyEl = itemEl ? itemEl.querySelector('.cart-drawer__qty-num') : null;
      const currentQty = qtyEl ? parseInt(qtyEl.textContent, 10) : 1;
      const newQty = Math.max(0, currentQty + delta);
      await this.updateQuantity(key, newQty, itemEl);
    }

    updateUI(cart) {
      document.querySelectorAll('[data-cart-count]').forEach((el) => {
        el.textContent = `[${cart.item_count}]`;
        el.setAttribute('data-cart-count', cart.item_count);
      });

      const drawerCount = this.querySelector('[data-drawer-count]');
      if (drawerCount) drawerCount.textContent = `[${cart.item_count}]`;

      window.dispatchEvent(new CustomEvent('cart:updated', { detail: { cart } }));

      const subtotalEl = this.querySelector('[data-cart-subtotal]');
      if (subtotalEl) {
        subtotalEl.textContent = this.formatMoney(cart.total_price);
      }
      this.dataset.cartTotal = String(cart.total_price);
      this.dataset.cartCountValue = String(cart.item_count);

      const itemsContainer = this.querySelector('[data-cart-items]');
      const maxByVariant = {};
      this.querySelectorAll('[data-variant-id]').forEach((row) => {
        if (row.dataset.qtyMax) maxByVariant[row.dataset.variantId] = row.dataset.qtyMax;
      });
      const emptyContainer = this.querySelector('[data-cart-empty]');
      const footer = this.querySelector('.cart-drawer__footer');

      if (cart.item_count === 0) {
        if (itemsContainer) itemsContainer.innerHTML = '';
        if (emptyContainer) emptyContainer.hidden = false;
        if (footer) footer.hidden = true;
        return;
      }

      if (emptyContainer) emptyContainer.hidden = true;
      if (footer) footer.hidden = false;
      if (itemsContainer) itemsContainer.hidden = false;

      if (itemsContainer) {
        const adotFallbackMap = {
          'the-complete-snowboard': { title: 'Heavyweight Boxy Hoodie', img: '{{ "category-hoodies.jpg" | asset_url }}', price: 'Rs. 4,499' },
          'the-collection-snowboard-hydrogen': { title: 'Relaxed Poplin Shirt', img: '{{ "category-shirts.jpg" | asset_url }}', price: 'Rs. 3,699' },
          'the-collection-snowboard-liquid': { title: 'Tailored Pleated Trousers', img: '{{ "category-trousers.jpg" | asset_url }}', price: 'Rs. 4,299' },
          'the-collection-snowboard-oxygen': { title: 'Heavyweight Zip Hoodie', img: '{{ "category-hoodies.jpg" | asset_url }}', price: 'Rs. 4,899' },
          'the-compare-at-price-snowboard': { title: 'Oversized Oxford Button-Down', img: '{{ "category-shirts.jpg" | asset_url }}', price: 'Rs. 3,899' },
          'selling-plans-ski-wax': { title: 'Wide-Leg Minimalist Chino', img: '{{ "category-trousers.jpg" | asset_url }}', price: 'Rs. 3,999' },
          'the-inventory-not-tracked-snowboard': { title: 'Heavyweight Loopback Crewneck', img: '{{ "category-hoodies.jpg" | asset_url }}', price: 'Rs. 3,999' },
          'the-3p-fulfilled-snowboard': { title: 'Double-Pleat Cotton Chino', img: '{{ "category-trousers.jpg" | asset_url }}', price: 'Rs. 4,199' },
          'the-multi-location-snowboard': { title: 'Oversized Fleece Pullover', img: '{{ "category-hoodies.jpg" | asset_url }}', price: 'Rs. 4,699' },
          'the-multi-managed-snowboard': { title: 'Structured Twill Overshirt', img: '{{ "category-shirts.jpg" | asset_url }}', price: 'Rs. 4,199' },
          'the-videographer-snowboard': { title: 'Relaxed Straight Trousers', img: '{{ "category-trousers.jpg" | asset_url }}', price: 'Rs. 4,499' },
          'the-out-of-stock-snowboard': { title: 'Relaxed Camp Collar Shirt', img: '{{ "category-shirts.jpg" | asset_url }}', price: 'Rs. 3,799' }
        };

        itemsContainer.innerHTML = cart.items
          .map((item) => {
            const fallback = adotFallbackMap[item.handle] || {};
            const itemTitle = item.properties?._adot_title || fallback.title || item.product_title || item.title;
            const imgUrl = item.properties?._adot_image || fallback.img || item.image || item.featured_image?.url || '';
            const sizeText = item.properties?.Size ? `Size: ${item.properties.Size}` : '';
            const isDummySnowboard = item.handle && (item.handle.includes('snowboard') || item.handle.includes('ski-wax'));
            const variant = sizeText || (item.variant_title && item.variant_title !== 'Default Title' && !isDummySnowboard ? item.variant_title : '');
            const priceFormatted = item.properties?._adot_price || fallback.price || this.formatMoney(item.final_line_price);
            const qtyMax = maxByVariant[String(item.variant_id)] || '';
            const atMax = qtyMax !== '' && item.quantity >= Number(qtyMax);

            return `
              <div class="cart-drawer__item" data-item-key="${item.key}" data-variant-id="${item.variant_id}" data-unit-price="${item.final_price}" data-shown-qty="${item.quantity}"${qtyMax !== '' ? ` data-qty-max="${qtyMax}"` : ''}>
                <a href="${item.url}" class="cart-drawer__item-media">
                  ${imgUrl ? `<img src="${imgUrl}" alt="${this.escapeHtml(itemTitle)}" class="cart-drawer__item-img" width="80" height="106" loading="lazy">` : ''}
                </a>
                <div class="cart-drawer__item-info">
                  <a href="${item.url}" class="cart-drawer__item-title">${this.escapeHtml(itemTitle)}</a>
                  ${variant ? `<p class="cart-drawer__item-variant text-micro">${this.escapeHtml(variant)}</p>` : ''}
                  <div class="cart-drawer__item-price text-micro">${priceFormatted}</div>
                  <div class="cart-drawer__item-actions">
                    <div class="cart-drawer__qty">
                      <button type="button" class="cart-drawer__qty-btn" data-qty-change="-1" data-qty-minus data-key="${item.key}" aria-label="Decrease quantity">−</button>
                      <span class="cart-drawer__qty-num text-micro" data-qty-value>${item.quantity}</span>
                      <button type="button" class="cart-drawer__qty-btn${atMax ? ' is-at-max' : ''}" data-qty-change="1" data-qty-plus data-key="${item.key}" aria-label="Increase quantity"${atMax ? ' aria-disabled="true"' : ''}>+</button>
                    </div>
                    <button type="button" class="cart-drawer__remove text-micro" data-remove-item data-key="${item.key}">Remove</button>
                  </div>
                  <p class="cart-qty-note text-micro" data-qty-note role="status" hidden></p>
                </div>
              </div>
            `;
          })
          .join('');
        if (window.AdotCart) window.AdotCart.syncButtons(this);
      }
    }

    escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }
  }

  if (!customElements.get('cart-drawer')) {
    customElements.define('cart-drawer', CartDrawer);
  }

  // Dynamic Scroll State for Sticky Frosted Glass Header
  function initStickyHeader() {
    const header = document.querySelector('.header');
    if (!header) return;

    const hero = document.querySelector('.hero');
    const curtain = document.querySelector('.shopify-section:has(.hero) ~ .shopify-section, .section-category-tiles');

    // On pages with the sticky hero curtain reveal
    if (hero && curtain && 'IntersectionObserver' in window) {
      const getHeaderHeight = () => header.offsetHeight || 80;

      const updateCurtainState = () => {
        const headerHeight = getHeaderHeight();
        const curtainRect = curtain.getBoundingClientRect();
        if (curtainRect.top <= headerHeight) {
          header.classList.add('header--scrolled');
        } else {
          header.classList.remove('header--scrolled');
        }
        hero.inert = curtainRect.top <= 0;
      };

      const observer = new IntersectionObserver(
        () => {
          updateCurtainState();
        },
        {
          threshold: [0, 0.05, 0.1, 0.25, 0.5, 0.75, 1.0],
        }
      );

      observer.observe(curtain);

      // Lightweight passive scroll listener as fallback for rapid velocity scrolling
      let ticking = false;
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            window.requestAnimationFrame(() => {
              updateCurtainState();
              ticking = false;
            });
            ticking = true;
          }
        },
        { passive: true }
      );

      updateCurtainState();
      return;
    }

    // Default fallback for pages without hero curtain
    let ticking = false;
    const updateHeaderState = () => {
      if (window.scrollY > 20) {
        header.classList.add('header--scrolled');
      } else {
        header.classList.remove('header--scrolled');
      }
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateHeaderState);
          ticking = true;
        }
      },
      { passive: true }
    );

    updateHeaderState();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStickyHeader);
  } else {
    initStickyHeader();
  }
</script>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "direct_categories",
      "label": "Display Direct Capsule Categories (Hoodies, Shirts, Trousers)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Enable Sticky Glassmorphism Header",
      "default": true
    }
  ]
}
{% endschema %}
