      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "direct_categories",
      "label": "Display Direct Capsule Categories (Hoodies, Shirts, Trousers)",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Enable Sticky Glassmorphism Header",
      "default": true
    }
  ]
}
