{% javascript %}
  class HeaderDrawer extends HTMLElement {
    constructor() {
      super();
      this.isOpen = false;
      this.triggerButtons = document.querySelectorAll('[data-drawer-trigger]');
      this.closeButtons = this.querySelectorAll('[data-drawer-close]');
      this.lastFocusedElement = null;

      this.init();
    }

    init() {
      this.triggerButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          if (this.isOpen) {
            this.close();
          } else {
            this.lastFocusedElement = e.currentTarget;
            this.open();
          }
        });
      });

      this.closeButtons.forEach((btn) => {
        btn.addEventListener('click', () => this.close());
      });

      // Auto close when navigating via drawer link
      this.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => this.close());
      });

      // Escape key listener & Tab focus trap
      document.addEventListener('keydown', (e) => {
        if (!this.isOpen) return;

        if (e.key === 'Escape') {
          this.close();
          return;
        }

        if (e.key === 'Tab') {
          const focusable = this.querySelectorAll(
            'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
          );
          if (focusable.length === 0) return;

          const first = focusable[0];
          const last = focusable[focusable.length - 1];

          if (e.shiftKey) {
            if (document.activeElement === first) {
              e.preventDefault();
              last.focus();
            }
          } else {
            if (document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        }
      });
    }

    open() {
      this.isOpen = true;
      this.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      const header = document.querySelector('.header');
      if (header) {
        header.classList.add('header--drawer-open');
      }
      this.triggerButtons.forEach((btn) => {
        btn.setAttribute('aria-expanded', 'true');
        btn.setAttribute('aria-label', 'Close navigation menu');
        btn.classList.add('is-active');
      });

      // Move focus inside
      const firstFocusable = this.querySelector('button, [href]');
      if (firstFocusable) {
        setTimeout(() => firstFocusable.focus(), 60);
      }
    }

    close() {
      this.isOpen = false;
      this.classList.remove('is-open');
      document.body.style.overflow = '';
      const header = document.querySelector('.header');
      if (header) {
        header.classList.remove('header--drawer-open');
      }
      this.triggerButtons.forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Open navigation menu');
        btn.classList.remove('is-active');
      });

      // Restore focus to opener
      if (this.lastFocusedElement) {
        this.lastFocusedElement.focus();
      }
    }
  }

  if (!customElements.get('header-drawer')) {
    customElements.define('header-drawer', HeaderDrawer);
  }

  class SearchModal extends HTMLElement {
    constructor() {
      super();
      this.isOpen = false;
      this.triggerButtons = document.querySelectorAll('[data-search-trigger]');
      this.closeButtons = this.querySelectorAll('[data-search-close]');
      this.input = this.querySelector('[data-search-input]');
      this.clearButton = this.querySelector('[data-search-clear]');
      this.suggestions = this.querySelector('[data-search-suggestions]');
      this.resultsContainer = this.querySelector('[data-search-results]');
      this.form = this.querySelector('form');
      this.currencySymbol = this.dataset.currency || '$';
      this.lastFocusedElement = null;
      this.debounceTimeout = null;
      this.activeAbortController = null;

      this.init();
    }

    init() {
      this.triggerButtons.forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          this.lastFocusedElement = e.currentTarget;

          // If mobile drawer is currently open, close it first
          const drawer = document.querySelector('header-drawer');
          if (drawer && drawer.isOpen) {
            drawer.close();
          }

          this.open();
        });
      });

      this.closeButtons.forEach((btn) => {
        btn.addEventListener('click', () => this.close());
      });

      if (this.clearButton && this.input) {
        this.clearButton.addEventListener('click', () => {
          this.input.value = '';
          this.input.focus();
          this.clearButton.hidden = true;
          this.resetResults();
        });
      }

      if (this.input) {
        this.input.addEventListener('input', (e) => {
          const query = e.target.value.trim();
          if (this.clearButton) {
            this.clearButton.hidden = query.length === 0;
          }

          if (query.length === 0) {
            this.resetResults();
            return;
          }

          clearTimeout(this.debounceTimeout);
          this.debounceTimeout = setTimeout(() => {
            this.fetchResults(query);
          }, 220);
        });
      }

      // Quick Tag Search Buttons
      this.querySelectorAll('[data-tag-search]').forEach((tagBtn) => {
        tagBtn.addEventListener('click', (e) => {
          const term = e.currentTarget.getAttribute('data-tag-search');
          if (this.input) {
            this.input.value = term;
            if (this.clearButton) this.clearButton.hidden = false;
            this.input.focus();
            this.fetchResults(term);
          }
        });
      });

      // Escape key to close
      document.addEventListener('keydown', (e) => {
        if (!this.isOpen) return;

        if (e.key === 'Escape') {
          this.close();
          return;
        }

        // Tab trapping
        if (e.key === 'Tab') {
          const focusable = this.querySelectorAll(
            'button:not([hidden]), [href], input:not([hidden]), [tabindex]:not([tabindex="-1"])'
          );
          if (focusable.length === 0) return;

          const first = focusable[0];
          const last = focusable[focusable.length - 1];

          if (e.shiftKey) {
            if (document.activeElement === first) {
              e.preventDefault();
              last.focus();
            }
          } else {
            if (document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        }
      });
    }

    open() {
      this.isOpen = true;
      this.classList.add('is-open');
      document.body.style.overflow = 'hidden';

      setTimeout(() => {
        if (this.input) {
          this.input.focus();
        }
      }, 50);
    }

    close() {
      this.isOpen = false;
      this.classList.remove('is-open');
      document.body.style.overflow = '';

      if (this.lastFocusedElement) {
        this.lastFocusedElement.focus();
      }
    }

    resetResults() {
      if (this.resultsContainer) {
        this.resultsContainer.hidden = true;
        this.resultsContainer.innerHTML = '';
      }
      if (this.suggestions) {
        this.suggestions.hidden = false;
      }
    }

    formatPrice(amount) {
      if (!amount) return '';
      const num = parseFloat(amount);
      if (isNaN(num)) return amount;
      return this.currencySymbol + num.toFixed(2);
    }

    escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    async fetchResults(query) {
      if (this.activeAbortController) {
        this.activeAbortController.abort();
      }
      this.activeAbortController = new AbortController();

      if (this.suggestions) {
        this.suggestions.hidden = true;
      }
      if (this.resultsContainer) {
        this.resultsContainer.hidden = false;
        this.resultsContainer.innerHTML = `
          <div class="search-modal__loading">
            <p class="text-micro">SEARCHING STORE...</p>
          </div>
        `;
      }

      try {
        const response = await fetch(
          `/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=6`,
          { signal: this.activeAbortController.signal }
        );

        if (!response.ok) throw new Error('Search failed');

        const data = await response.json();
        const products = data.resources?.results?.products || [];

        this.renderProducts(products, query);
      } catch (err) {
        if (err.name === 'AbortError') return;
        if (this.resultsContainer) {
          this.resultsContainer.innerHTML = `
            <div class="search-modal__empty">
              <p>Unable to load results. Press enter to perform full search.</p>
            </div>
          `;
        }
      }
    }

    renderProducts(products, query) {
      if (!this.resultsContainer) return;

      if (products.length === 0) {
        this.resultsContainer.innerHTML = `
          <div class="search-modal__empty">
            <p>No products found matching "<strong>${this.escapeHtml(query)}</strong>"</p>
          </div>
        `;
        return;
      }

      const productsHtml = products
        .map((product) => {
          const imgUrl = product.image || product.featured_image?.url || '';
          const title = this.escapeHtml(product.title);
          const url = this.escapeHtml(product.url);
          const price = this.formatPrice(product.price);

          return `
            <a href="${url}" class="search-modal__card">
              <div class="search-modal__card-media">
                ${imgUrl ? `<img src="${imgUrl}" alt="${title}" class="search-modal__card-img" width="300" height="300" loading="lazy">` : ''}
              </div>
              <div class="search-modal__card-info">
                <span class="search-modal__card-title">${title}</span>
                <span class="search-modal__card-price text-micro">${price}</span>
              </div>
            </a>
          `;
        })
        .join('');

      const viewAllUrl = `/search?q=${encodeURIComponent(query)}`;

      this.resultsContainer.innerHTML = `
        <div class="search-modal__results-header">
          <span class="text-micro search-modal__results-title">MATCHING PRODUCTS (${products.length})</span>
        </div>
        <div class="search-modal__grid">
          ${productsHtml}
        </div>
        <a href="${viewAllUrl}" class="search-modal__view-all">
          <span>View all results for "${this.escapeHtml(query)}"</span>
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="1" y1="7" x2="13" y2="7"></line>
            <polyline points="8 2 13 7 8 12"></polyline>
          </svg>
        </a>
      `;
    }
  }

  if (!customElements.get('search-modal')) {
    customElements.define('search-modal', SearchModal);
  }

  // Dynamic Scroll State for Sticky Frosted Glass Header
  function initStickyHeader() {
    const header = document.querySelector('.header');
    if (!header) return;

    let ticking = false;
    const updateHeaderState = () => {
      if (window.scrollY > 20) {
        header.classList.add('header--scrolled');
      } else {
        header.classList.remove('header--scrolled');
      }
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateHeaderState);
          ticking = true;
        }
      },
      { passive: true }
    );

    updateHeaderState();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStickyHeader);
  } else {
    initStickyHeader();
  }
{% endjavascript %}

