{% comment %}
  Modern Editorial Luxury Header
  Features sticky glassmorphism bar, flat category navigation, centered display brand,
  minimalist search & cart counters, and accessible mobile navigation drawer.
{% endcomment %}

<header-drawer class="header-drawer" id="HeaderDrawer">
  <div class="header-drawer__backdrop" data-drawer-close></div>
  <div class="header-drawer__panel" role="dialog" aria-modal="true" aria-label="Navigation Menu">
    <div class="header-drawer__header">
      <span class="header-drawer__logo">{{ shop.name }}</span>
      <button type="button" class="header-drawer__close" data-drawer-close aria-label="Close menu">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <line x1="1" y1="1" x2="17" y2="17"></line>
          <line x1="17" y1="1" x2="1" y2="17"></line>
        </svg>
      </button>
    </div>

    <nav class="header-drawer__nav" aria-label="Mobile Navigation">
      <ul class="header-drawer__primary-links">
        {% for link in section.settings.menu.links %}
          <li>
            <a href="{{ link.url }}" class="header-drawer__primary-link">
              {{ link.title }}
            </a>
          </li>
        {% else %}
          <li><a href="{{ routes.collections_url }}/hoodies" class="header-drawer__primary-link">Hoodies</a></li>
          <li><a href="{{ routes.collections_url }}/shirts" class="header-drawer__primary-link">Shirts</a></li>
          <li><a href="{{ routes.collections_url }}/trousers" class="header-drawer__primary-link">Trousers</a></li>
          <li><a href="{{ routes.all_products_collection_url }}" class="header-drawer__primary-link">New Arrivals</a></li>
        {% endfor %}
      </ul>

      <div class="header-drawer__divider"></div>

      <ul class="header-drawer__secondary-links">
        <li>
          <a href="{{ routes.search_url }}" class="header-drawer__secondary-link text-micro">
            {{ 'search.title' | t | default: 'Search' }}
          </a>
        </li>
        {% if shop.customer_accounts_enabled %}
          <li>
            <a href="{{ routes.account_url }}" class="header-drawer__secondary-link text-micro">
              {% if customer %}
                {{ 'customers.account.title' | t | default: 'My Account' }}
              {% else %}
                {{ 'customers.login.title' | t | default: 'Sign In' }}
              {% endif %}
            </a>
          </li>
        {% endif %}
        <li>
          <a href="{{ routes.root_url }}pages/size-guide" class="header-drawer__secondary-link text-micro">
            Size Guide
          </a>
        </li>
      </ul>
    </nav>

    <div class="header-drawer__footer">
      <p class="text-micro header-drawer__meta">ADOT STUDIO · AUTUMN / WINTER 2026</p>
    </div>
  </div>
</header-drawer>

<header class="header {% if section.settings.sticky %}header--sticky{% endif %} full-width" data-section-id="{{ section.id }}">
  {% if section.settings.show_announcement and section.settings.announcement_text != blank %}
    <div class="header__announcement">
      <div class="container header__announcement-inner">
        <span class="text-micro">{{ section.settings.announcement_text }}</span>
      </div>
    </div>
  {% endif %}

  <div class="header__main">
    <div class="container header__container">
      <!-- Mobile Hamburger Trigger -->
      <div class="header__left-mobile">
        <button
          type="button"
          class="header__hamburger"
          aria-expanded="false"
          aria-controls="HeaderDrawer"
          aria-label="Open navigation menu"
          data-drawer-trigger
        >
          <span class="header__hamburger-line"></span>
          <span class="header__hamburger-line"></span>
        </button>
      </div>

      <!-- Desktop Primary Navigation -->
      <nav class="header__nav-desktop" aria-label="Desktop Navigation">
        {% for link in section.settings.menu.links %}
          <a href="{{ link.url }}" class="header__nav-link text-micro">
            {{ link.title }}
          </a>
        {% else %}
          <a href="{{ routes.collections_url }}/hoodies" class="header__nav-link text-micro">Hoodies</a>
          <a href="{{ routes.collections_url }}/shirts" class="header__nav-link text-micro">Shirts</a>
          <a href="{{ routes.collections_url }}/trousers" class="header__nav-link text-micro">Trousers</a>
          <a href="{{ routes.all_products_collection_url }}" class="header__nav-link text-micro">Collection</a>
        {% endfor %}
      </nav>

      <!-- Brand Logo / Wordmark -->
      <div class="header__brand">
        <a href="{{ routes.root_url }}" class="header__logo-link">
          {{ shop.name }}
        </a>
      </div>

      <!-- Header Utilities (Search, Account, Cart) -->
      <div class="header__utilities">
        <a href="{{ routes.search_url }}" class="header__util-link header__search-btn" aria-label="Search">
          <svg class="header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <span class="header__util-text text-micro">Search</span>
        </a>

        {% if shop.customer_accounts_enabled %}
          <a href="{{ routes.account_url }}" class="header__util-link header__account-btn" aria-label="Account">
            <svg class="header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </a>
        {% endif %}

        <a href="{{ routes.cart_url }}" class="header__util-link header__cart-btn" aria-label="Shopping Bag">
          <span class="header__cart-label text-micro">BAG</span>
          <span class="header__cart-count" data-cart-count>{{ cart.item_count }}</span>
        </a>
      </div>
    </div>
  </div>
</header>

{% stylesheet %}
  /* Announcement Strip */
  .header__announcement {
    background-color: var(--color-dark);
    color: var(--color-text-inverse);
    padding-block: 0.4rem;
    text-align: center;
    border-bottom: 1px solid var(--color-border-dark);
  }

  .header__announcement-inner {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  /* Main Header Container */
  .header {
    width: 100%;
    z-index: 100;
    background-color: var(--color-background);
    transition: background-color var(--transition-base), border-color var(--transition-base);
  }

  .header--sticky {
    position: sticky;
    top: 0;
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    background-color: rgba(245, 242, 236, 0.92);
  }

  .header__main {
    border-bottom: 1px solid var(--color-border);
    width: 100%;
  }

  .header__container {
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
  }

  /* Left Desktop Nav */
  .header__nav-desktop {
    display: none;
    align-items: center;
    gap: var(--space-md);
    flex: 1;
  }

  @media (min-width: 990px) {
    .header__nav-desktop {
      display: flex;
    }
  }

  .header__nav-link {
    color: var(--color-text);
    text-decoration: none;
    transition: opacity var(--transition-fast);
    position: relative;
    padding-block: var(--space-2xs);
  }

  .header__nav-link:hover {
    opacity: 0.65;
  }

  /* Center Brand Wordmark */
  .header__brand {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  @media (min-width: 990px) {
    .header__brand {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }
  }

  .header__logo-link {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.5vw, 2rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
    text-transform: uppercase;
  }

  /* Right Utilities */
  .header__utilities {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    justify-content: flex-end;
    flex: 1;
  }

  .header__util-link {
    color: var(--color-text);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem;
    transition: opacity var(--transition-fast);
    min-height: 44px;
  }

  .header__util-link:hover {
    opacity: 0.65;
  }

  .header__search-btn .header__util-text {
    display: none;
  }

  @media (min-width: 990px) {
    .header__search-btn .header__util-text {
      display: inline-block;
    }
  }

  .header__cart-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .header__cart-count {
    font-family: var(--font-body);
    font-size: var(--font-size-micro);
    font-weight: 600;
    background-color: var(--color-text);
    color: var(--color-background);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-none);
    line-height: 1.2;
  }

  /* Mobile Hamburger Trigger */
  .header__left-mobile {
    display: flex;
    align-items: center;
    flex: 1;
  }

  @media (min-width: 990px) {
    .header__left-mobile {
      display: none;
    }
  }

  .header__hamburger {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 36px;
    height: 36px;
    justify-content: center;
    align-items: flex-start;
  }

  .header__hamburger-line {
    display: block;
    width: 20px;
    height: 1.5px;
    background-color: var(--color-text);
    transition: transform var(--transition-fast), width var(--transition-fast);
  }

  .header__hamburger-line:nth-child(2) {
    width: 14px;
  }

  .header__hamburger:hover .header__hamburger-line:nth-child(2) {
    width: 20px;
  }

  /* ==========================================================================
     Header Drawer (Mobile Navigation Sheet)
     ========================================================================== */
  .header-drawer {
    position: fixed;
    inset: 0;
    z-index: 999;
    visibility: hidden;
    pointer-events: none;
    transition: visibility 0s linear 300ms;
  }

  .header-drawer.is-open {
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .header-drawer__backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(21, 21, 21, 0.4);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .header-drawer.is-open .header-drawer__backdrop {
    opacity: 1;
  }

  .header-drawer__panel {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(85vw, 420px);
    background-color: var(--color-background);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transform: translateX(-100%);
    transition: transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: var(--shadow-drawer);
    overflow-y: auto;
  }

  .header-drawer.is-open .header-drawer__panel {
    transform: translateX(0);
  }

  .header-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--color-border);
  }

  .header-drawer__logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--color-text);
  }

  .header-drawer__close {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .header-drawer__primary-links {
    list-style: none;
    padding: 0;
    margin: var(--space-md) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .header-drawer__primary-link {
    font-family: var(--font-display);
    font-size: 1.85rem;
    font-weight: 400;
    color: var(--color-text);
    text-decoration: none;
    display: block;
    line-height: 1.2;
    transition: transform var(--transition-fast);
  }

  .header-drawer__primary-link:hover {
    transform: translateX(6px);
  }

  .header-drawer__divider {
    height: 1px;
    background-color: var(--color-border);
    margin-block: var(--space-md);
  }

  .header-drawer__secondary-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .header-drawer__secondary-link {
    color: var(--color-text-muted);
    text-decoration: none;
    display: block;
    padding-block: 0.25rem;
    transition: color var(--transition-fast);
  }

  .header-drawer__secondary-link:hover {
    color: var(--color-text);
  }

  .header-drawer__meta {
    color: var(--color-text-subtle);
    margin-top: var(--space-md);
  }
{% endstylesheet %}

{% javascript %}
  class HeaderDrawer extends HTMLElement {
    constructor() {
      super();
      this.isOpen = false;
      this.triggerButtons = document.querySelectorAll('[data-drawer-trigger]');
      this.closeButtons = this.querySelectorAll('[data-drawer-close]');
      this.panel = this.querySelector('.header-drawer__panel');

      this.triggerButtons.forEach((btn) => {
        btn.addEventListener('click', () => this.open());
      });

      this.closeButtons.forEach((btn) => {
        btn.addEventListener('click', () => this.close());
      });

      // Escape key listener
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.isOpen) {
          this.close();
        }
      });
    }

    open() {
      this.isOpen = true;
      this.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      this.triggerButtons.forEach((btn) => btn.setAttribute('aria-expanded', 'true'));
    }

    close() {
      this.isOpen = false;
      this.classList.remove('is-open');
      document.body.style.overflow = '';
      this.triggerButtons.forEach((btn) => btn.setAttribute('aria-expanded', 'false'));
    }
  }

  if (!customElements.get('header-drawer')) {
    customElements.define('header-drawer', HeaderDrawer);
  }
{% endjavascript %}

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "section-header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Enable Sticky Glassmorphism Header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Announcement Text",
      "default": "COMPLIMENTARY WORLDWIDE DISPATCH ON ORDERS OVER $250"
    }
  ]
}
{% endschema %}
