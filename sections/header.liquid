{% comment %}
  Modern Editorial Luxury Header — Centered Wordmark & Glassmorphism
  Features:
  - Natural hero blend with frosted glassmorphism (backdrop-filter blur)
  - Left: Flat capsule categories (Hoodies, Shirts, Trousers) with GPU-accelerated underline glide
  - Center: Mathematically & optically centered ADOT display serif wordmark
  - Right: Minimalist 1.5px hairline icons (Search, Account, Bag) with tactile micro-interactions
  - Emil Kowalski & Jakub Krehel design engineering interaction standards
{% endcomment %}

<!-- Accessible Mobile Navigation Drawer -->
<header-drawer class="header-drawer" id="HeaderDrawer">
  <div class="header-drawer__backdrop" data-drawer-close></div>
  <div class="header-drawer__panel" role="dialog" aria-modal="true" aria-label="Navigation Menu">
    <div class="header-drawer__header">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name }}">
        <img
          src="{{ 'logo.png' | asset_url }}"
          alt="{{ shop.name }}"
          class="header-drawer__logo-img"
          width="44"
          height="47"
          loading="lazy"
        >
      </a>
      <button type="button" class="header-drawer__close" data-drawer-close aria-label="Close menu">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <line x1="1" y1="1" x2="17" y2="17"></line>
          <line x1="17" y1="1" x2="1" y2="17"></line>
        </svg>
      </button>
    </div>

    <nav class="header-drawer__nav" aria-label="Mobile Navigation">
      <ul class="header-drawer__primary-links">
        {% if section.settings.direct_categories %}
          <li><a href="{{ routes.all_products_collection_url }}?category=hoodies" class="header-drawer__primary-link">Hoodies</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?category=shirts" class="header-drawer__primary-link">Shirts</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?category=trousers" class="header-drawer__primary-link">Trousers</a></li>
          <li><a href="{{ routes.all_products_collection_url }}" class="header-drawer__primary-link">All Essentials</a></li>
        {% else %}
          {% for link in section.settings.menu.links %}
            <li>
              <a href="{{ link.url }}" class="header-drawer__primary-link">
                {{ link.title }}
              </a>
            </li>
          {% else %}
            <li><a href="{{ routes.all_products_collection_url }}?category=hoodies" class="header-drawer__primary-link">Hoodies</a></li>
            <li><a href="{{ routes.all_products_collection_url }}?category=shirts" class="header-drawer__primary-link">Shirts</a></li>
            <li><a href="{{ routes.all_products_collection_url }}?category=trousers" class="header-drawer__primary-link">Trousers</a></li>
            <li><a href="{{ routes.all_products_collection_url }}" class="header-drawer__primary-link">All Essentials</a></li>
          {% endfor %}
        {% endif %}
      </ul>

      <div class="header-drawer__divider"></div>

      <ul class="header-drawer__secondary-links">
        <li>
          <a href="{{ routes.search_url }}" class="header-drawer__secondary-link text-micro" data-search-trigger>
            Search
          </a>
        </li>
        {% if shop.customer_accounts_enabled %}
          <li>
            <a href="{{ routes.account_url }}" class="header-drawer__secondary-link text-micro">
              {% if customer %}
                Account
              {% else %}
                Sign In
              {% endif %}
            </a>
          </li>
        {% endif %}
        <li>
          <a href="{{ routes.root_url }}pages/size-guide" class="header-drawer__secondary-link text-micro">
            Size Guide
          </a>
        </li>
      </ul>
    </nav>

    <div class="header-drawer__footer">
      <p class="text-micro header-drawer__meta">ADOT STUDIO · AUTUMN / WINTER 2026</p>
    </div>
  </div>
</header-drawer>

<!-- Accessible Modern Search Overlay & Live Predictive Search -->
<search-modal class="search-modal" id="SearchModal" role="dialog" aria-modal="false" aria-hidden="true" inert aria-label="Search Store">
  <div class="search-modal__backdrop" data-search-close></div>
  <div class="search-modal__content">
    
    <!-- Top Header Bar with Brand Logo and Close Button -->
    <div class="search-modal__topbar">
      <div class="container search-modal__topbar-inner">
        <a href="{{ routes.root_url }}" class="search-modal__logo-link" aria-label="{{ shop.name }}">
          <img
            src="{{ 'logo.png' | asset_url }}"
            alt="{{ shop.name }}"
            class="search-modal__logo-img"
            width="44"
            height="47"
            loading="lazy"
          >
        </a>
        <button type="button" class="search-modal__close" data-search-close aria-label="Close search">
          <span class="search-modal__close-key text-micro" aria-hidden="true">ESC</span>
          <svg class="search-modal__close-icon" width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <line x1="1" y1="1" x2="17" y2="17"></line>
            <line x1="17" y1="1" x2="1" y2="17"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Main Discovery Body (Scrollable Full-Canvas) -->
    <div class="search-modal__body">
      <div class="container search-modal__container">

        <!-- Main Search Form -->
        <form action="{{ routes.search_url }}" method="get" role="search" class="search-modal__form">
          <div class="search-modal__input-wrapper">
            <svg class="search-modal__search-icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7.5"></circle>
              <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
            </svg>
            <input
              type="search"
              name="q"
              class="search-modal__input"
              placeholder="Search essentials, styles, collections..."
              autocomplete="off"
              autocorrect="off"
              autocapitalize="none"
              spellcheck="false"
              enterkeyhint="search"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="SearchResults"
              aria-haspopup="listbox"
              data-search-input
            >
            <button type="button" class="search-modal__clear" data-search-clear aria-label="Clear search text" hidden>
              <svg width="14" height="14" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <line x1="1" y1="1" x2="17" y2="17"></line>
                <line x1="17" y1="1" x2="1" y2="17"></line>
              </svg>
            </button>
          </div>
        </form>

        <!-- Zero-State: Trending Suggestions & Curated Quick Exploration -->
        <div class="search-modal__suggestions" data-search-suggestions>
          <div class="search-modal__suggestions-group">
            <p class="text-micro search-modal__suggestions-title">POPULAR SEARCHES</p>
            <div class="search-modal__tags">
              <button type="button" class="search-modal__tag" data-tag-search="Hoodie">Hoodies</button>
              <button type="button" class="search-modal__tag" data-tag-search="Shirt">Shirts</button>
              <button type="button" class="search-modal__tag" data-tag-search="Trouser">Trousers</button>
              <button type="button" class="search-modal__tag" data-tag-search="Winter">Winter</button>
            </div>
          </div>

          <div class="search-modal__quick-group">
            <p class="text-micro search-modal__suggestions-title">DISCOVER COLLECTIONS</p>
            <div class="search-modal__quick-links">
              <a href="{{ routes.all_products_collection_url }}" class="search-modal__quick-link">
                <span>All Essentials</span>
                <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="1" y1="7" x2="13" y2="7"></line>
                  <polyline points="8 2 13 7 8 12"></polyline>
                </svg>
              </a>
              <a href="{{ routes.collections_url }}/hoodies" class="search-modal__quick-link">
                <span>Hoodies Collection</span>
                <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="1" y1="7" x2="13" y2="7"></line>
                  <polyline points="8 2 13 7 8 12"></polyline>
                </svg>
              </a>
              <a href="{{ routes.collections_url }}/shirts" class="search-modal__quick-link">
                <span>Shirts Collection</span>
                <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="1" y1="7" x2="13" y2="7"></line>
                  <polyline points="8 2 13 7 8 12"></polyline>
                </svg>
              </a>
              <a href="{{ routes.collections_url }}/trousers" class="search-modal__quick-link">
                <span>Trousers Collection</span>
                <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="1" y1="7" x2="13" y2="7"></line>
                  <polyline points="8 2 13 7 8 12"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Live Predictive Results -->
        <div class="search-modal__results" id="SearchResults" role="listbox" data-search-results hidden></div>
        <div class="visually-hidden" data-search-status role="status" aria-live="polite"></div>

      </div>
    </div>
  </div>
</search-modal>

<!-- Accessible Slide-Out Luxury Cart Drawer -->
{% render 'cart-drawer', section_id: section.id %}

<!-- Main Header Bar -->
<header class="header {% if section.settings.sticky %}header--sticky{% endif %} header--overlay full-width" data-section-id="{{ section.id }}">
  <div class="header__main">
    <div class="container header__container">
      
      <!-- Mobile: Left Hamburger Button -->
      <div class="header__mobile-left">
        <button
          type="button"
          class="header__hamburger"
          aria-expanded="false"
          aria-controls="HeaderDrawer"
          aria-label="Open navigation menu"
          data-drawer-trigger
        >
          <span class="header__hamburger-line header__hamburger-line--top"></span>
          <span class="header__hamburger-line header__hamburger-line--bottom"></span>
        </button>
      </div>

      <!-- Desktop: Left Capsule Navigation -->
      <nav class="header__nav-left" aria-label="Desktop Navigation">
        <div class="header__categories">
          {% if section.settings.direct_categories %}
            <a href="{{ routes.all_products_collection_url }}?category=hoodies" class="header__nav-link text-micro">
              <span>Hoodies</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?category=shirts" class="header__nav-link text-micro">
              <span>Shirts</span>
            </a>
            <a href="{{ routes.all_products_collection_url }}?category=trousers" class="header__nav-link text-micro">
              <span>Trousers</span>
            </a>
          {% else %}
            {% for link in section.settings.menu.links %}
              <a href="{{ link.url }}" class="header__nav-link text-micro">
                <span>{{ link.title }}</span>
              </a>
            {% else %}
              <a href="{{ routes.all_products_collection_url }}?category=hoodies" class="header__nav-link text-micro">
                <span>Hoodies</span>
              </a>
              <a href="{{ routes.all_products_collection_url }}?category=shirts" class="header__nav-link text-micro">
                <span>Shirts</span>
              </a>
              <a href="{{ routes.all_products_collection_url }}?category=trousers" class="header__nav-link text-micro">
                <span>Trousers</span>
              </a>
            {% endfor %}
          {% endif %}
        </div>
      </nav>

      <!-- Center: Mathematically & Optically Centered Brand Wordmark -->
      <div class="header__brand-center">
        <a href="{{ routes.root_url }}" class="header__logo-link" aria-label="{{ shop.name }}">
          <img
            src="{{ 'logo.png' | asset_url }}"
            alt="{{ shop.name }}"
            class="header__logo-img"
            width="44"
            height="47"
            loading="eager"
          >
        </a>
      </div>

      <!-- Right: Minimalist Utility Icons (Desktop & Mobile) -->
      <div class="header__utilities-right">
        <!-- Search Icon Trigger -->
        <a href="{{ routes.search_url }}" class="header__icon-btn header__icon-btn--search" aria-label="Search" data-search-trigger>
          <svg class="header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7.5"></circle>
            <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
          </svg>
        </a>

        <!-- Customer Account Icon (Desktop Only — on mobile available in drawer) -->
        {% if shop.customer_accounts_enabled %}
          <a href="{{ routes.account_url }}" class="header__icon-btn header__icon-btn--account" aria-label="{% if customer %}Account{% else %}Sign In{% endif %}">
            <svg class="header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 21v-1.5a4.5 4.5 0 0 0-4.5-4.5h-7A4.5 4.5 0 0 0 4 19.5V21"></path>
              <circle cx="12" cy="7.5" r="4"></circle>
            </svg>
          </a>
        {% endif %}

        <!-- Shopping Bag Icon + Typographic Counter -->
        <a href="{{ routes.cart_url }}" class="header__icon-btn header__cart-btn" aria-label="Shopping Bag, {{ cart.item_count }} items" data-cart-trigger>
          <svg class="header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M6 8h12l1.5 13H4.5L6 8z"></path>
            <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
          </svg>
          <span class="header__cart-count text-micro" data-cart-count>[{{ cart.item_count }}]</span>
        </a>
      </div>

    </div>
  </div>
</header>

{% stylesheet %}
  /* ==========================================================================
     Header Architecture & Frosted Glassmorphism (Hero Overlay & Natural Blend)
     ========================================================================== */
  :root {
    --header-height: 80px;
  }

  @media (max-width: 749px) {
    :root {
      --header-height: 60px;
    }
  }

  .section-header {
    position: relative;
    z-index: 1000;
  }

  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    /* Clean transparent hero blend initially */
    background-color: transparent;
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    transition: background-color 280ms var(--ease-out),
                border-color 280ms var(--ease-out),
                backdrop-filter 280ms var(--ease-out),
                -webkit-backdrop-filter 280ms var(--ease-out),
                box-shadow 280ms var(--ease-out);
  }

  /* When scrolled down: solid white background and dark text */
  .header.header--scrolled {
    background-color: var(--color-background, #FFFFFF);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  /* When mobile drawer is open: solid white header seamlessly connecting to drawer */
  .header.header--drawer-open {
    background-color: var(--color-background, #FFFFFF) !important;
    backdrop-filter: blur(20px) saturate(160%) !important;
    -webkit-backdrop-filter: blur(20px) saturate(160%) !important;
    border-bottom: 1px solid var(--color-border) !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04) !important;
  }

  .header.header--drawer-open .header__logo-img {
    filter: none !important;
  }

  .header.header--drawer-open .header__hamburger-line {
    background-color: var(--color-text, #111111) !important;
  }

  .header.header--drawer-open .header__icon-btn {
    color: var(--color-text, #111111) !important;
  }

  .header.header--drawer-open .header__cart-count {
    color: var(--color-text-muted, #555555) !important;
  }

  /* Unscrolled state over dark hero on homepage: crisp white text & icons with subtle top gradient, zero dividing line */
  body.template-index .header:not(.header--scrolled):not(.header--drawer-open) {
    background: linear-gradient(to bottom, rgba(18, 18, 18, 0.45) 0%, rgba(18, 18, 18, 0.1) 60%, transparent 100%);
    border-bottom: none;
  }

  body.template-index .header:not(.header--scrolled):not(.header--drawer-open) .header__logo-link {
    color: var(--color-white);
  }

  body.template-index .header:not(.header--scrolled):not(.header--drawer-open) .header__logo-img {
    filter: brightness(0) invert(1);
  }

  body.template-index .header:not(.header--scrolled):not(.header--drawer-open) .header__nav-link {
    color: rgba(255, 255, 255, 0.9);
  }

  body.template-index .header:not(.header--scrolled):not(.header--drawer-open) .header__nav-link::after {
    background-color: var(--color-white);
  }

  body.template-index .header:not(.header--scrolled):not(.header--drawer-open) .header__nav-link:hover {
    color: var(--color-white);
  }

  body.template-index .header:not(.header--scrolled):not(.header--drawer-open) .header__icon-btn {
    color: var(--color-white);
  }

  body.template-index .header:not(.header--scrolled):not(.header--drawer-open) .header__cart-count {
    color: rgba(255, 255, 255, 0.85);
  }

  body.template-index .header:not(.header--scrolled):not(.header--drawer-open) .header__hamburger-line {
    background-color: var(--color-white);
  }

  /* Fallback for sub-pages without a hero banner: reserve space and show glass */
  body:not(.template-index) #MainContent {
    padding-top: var(--header-height);
  }

  body:not(.template-index) .header:not(.header--scrolled):not(.header--drawer-open) {
    background-color: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border-bottom: 1px solid var(--color-border);
  }

  .header__main {
    width: 100%;
  }

  .header__container {
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    padding-inline: var(--space-md);
  }

  @media (max-width: 749px) {
    .header__container {
      padding-inline: var(--space-sm);
    }
  }

  /* ==========================================================================
     Center: Mathematically & Optically Centered Brand Wordmark
     ========================================================================== */
  .header__brand-center {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    pointer-events: auto;
    z-index: 2;
  }

  @media (max-width: 749px) {
    .header__brand-center {
      max-width: calc(100% - 180px);
    }
  }

  .header__logo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    line-height: 1;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: transform 160ms var(--ease-out), opacity var(--transition-fast) var(--ease-out);
    will-change: transform;
  }

  .header__logo-link:active {
    transform: scale(0.96);
  }

  @media (hover: hover) and (pointer: fine) {
    .header__logo-link:hover {
      opacity: 0.75;
    }
  }

  .header__logo-img {
    display: block;
    height: clamp(34px, 4.5vw, 42px);
    width: auto;
    object-fit: contain;
    transition: filter 280ms var(--ease-out), transform 160ms var(--ease-out);
  }

  @media (max-width: 749px) {
    .header__logo-img {
      height: clamp(26px, 5.5vw, 32px);
      max-width: 100%;
    }
  }

  .header.header--scrolled .header__logo-img,
  body:not(.template-index) .header__logo-img {
    filter: none;
  }

  /* ==========================================================================
     Left: Flat Capsule Navigation (Desktop)
     ========================================================================== */
  .header__nav-left {
    display: none;
    align-items: center;
    flex: 1;
    z-index: 2;
  }

  @media (min-width: 990px) {
    .header__nav-left {
      display: flex;
    }
  }

  .header__categories {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .header__nav-link {
    position: relative;
    color: var(--color-text);
    text-decoration: none;
    padding-block: var(--space-2xs);
    display: inline-flex;
    align-items: center;
    font-weight: 500;
    letter-spacing: var(--tracking-micro);
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
    transition: color 280ms var(--ease-out), transform 160ms var(--ease-out);
    will-change: transform;
  }

  /* Directional GPU-accelerated underline glide */
  .header__nav-link::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 1px;
    background-color: var(--color-text);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 220ms var(--ease-out), background-color 280ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .header__nav-link:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  .header__nav-link:active {
    transform: scale(0.97);
  }

  /* ==========================================================================
     Left: Mobile Controls (Minimalist Morphing Hairline Hamburger)
     ========================================================================== */
  .header__mobile-left {
    display: flex;
    align-items: center;
    flex: 1;
    z-index: 3;
  }

  @media (min-width: 990px) {
    .header__mobile-left {
      display: none;
    }
  }

  @media (max-width: 749px) {
    .header__mobile-left {
      flex: 0 0 88px;
      justify-content: flex-start;
    }
  }

  .header__hamburger {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    width: 44px;
    height: 44px;
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
    position: relative;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    user-select: none;
    -webkit-user-select: none;
    transition: transform 160ms var(--ease-out);
    will-change: transform;
  }

  .header__hamburger:active {
    transform: scale(0.92);
  }

  .header__hamburger-line {
    display: block;
    width: 20px;
    height: 1.5px;
    background-color: var(--color-text);
    border-radius: 0;
    transform-origin: center;
    transition: transform 260ms cubic-bezier(0.23, 1, 0.32, 1),
                width 220ms var(--ease-out),
                margin 220ms var(--ease-out),
                background-color 280ms var(--ease-out);
    will-change: transform;
  }

  .header__hamburger-line--bottom {
    width: 14px;
    align-self: center;
    margin-right: 6px;
  }

  @media (hover: hover) and (pointer: fine) {
