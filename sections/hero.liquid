{% comment %}
  Editorial hero. Every load: the photograph eases into place, then the
  headline wipes up and the supporting type staggers in. As the next
  section curtains over the pinned photo, the type fades with the scroll.
  Reduced motion and the theme editor show the finished frame.
  Copy stays in settings.
{% endcomment %}

<editorial-hero
  class="hero hero--full hero--height-{{ section.settings.hero_height | default: '100svh' }} hero--align-{{ section.settings.text_alignment | default: 'left' }}"
  data-section-id="{{ section.id }}"
  data-state="{% if section.settings.cinematic_reveal == false %}static{% else %}assemble{% endif %}"
  style="--hero-overlay-opacity: {{ section.settings.overlay_opacity | default: 45 | divided_by: 100.0 }}; --hero-image-position-desktop: {{ section.settings.desktop_image_position | default: 'top' }};"
>
  {% if section.settings.cinematic_reveal %}
    {% # theme-check-disable ParserBlockingScript %}
    <script>
      (function (el) {
        var reduce = false;
        try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
        var design = !!(window.Shopify && Shopify.designMode);
        if (reduce || design) el.setAttribute('data-state', 'static');
      })(document.currentScript.parentElement);
    </script>
    {% # theme-check-enable ParserBlockingScript %}
  {% endif %}
  <div class="hero__inner">
    <!-- ==========================================================================
         1. Background Media Layer (Desktop, Mobile, Video, Placeholder)
         ========================================================================== -->
    <div class="hero__media">
      {% if section.settings.video_url != blank %}
        <video
          class="hero__video"
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          {% if section.settings.image != blank %}poster="{{ section.settings.image | image_url: width: 1920 }}"{% endif %}
        >
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {% elsif section.settings.image != blank or section.settings.image_mobile != blank %}
        <picture class="hero__picture">
          {% if section.settings.image_mobile != blank %}
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
              sizes="100vw"
            >
          {% else %}
            <source
              media="(max-width: 749px)"
              srcset="{{ 'hero-mobile.png' | asset_url }}"
            >
          {% endif %}
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 2400
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '750, 1100, 1500, 1920, 2400',
                sizes: '100vw',
                class: 'hero__image',
                alt: section.settings.image.alt | default: section.settings.heading | escape
            }}
          {% else %}
            <img
              src="{{ 'hero-desktop.png' | asset_url }}"
              alt="{{ section.settings.image.alt | default: 'Man wearing a black polo shirt with white trim and grey trousers' | escape }}"
              class="hero__image"
              loading="eager"
              fetchpriority="high"
              width="2560"
              height="1440"
            >
          {% endif %}
        </picture>
      {% else %}
        <!-- Responsive Dual Photography (Mobile: hero-mobile.png, Desktop: hero-desktop.png) -->
        <picture class="hero__picture">
          <source
            media="(max-width: 749px)"
            srcset="{{ 'hero-mobile.png' | asset_url }}"
          >
          <source
            media="(min-width: 750px)"
            srcset="{{ 'hero-desktop.png' | asset_url }}"
          >
          <img
            src="{{ 'hero-desktop.png' | asset_url }}"
            alt="{{ section.settings.image.alt | default: 'Man wearing a black polo shirt with white trim and grey trousers' | escape }}"
            class="hero__image"
            loading="eager"
            fetchpriority="high"
            width="2560"
            height="1440"
          >
        </picture>
      {% endif %}

      <!-- Layered Progressive Vignette & Atmosphere Overlays -->
      <div class="hero__overlay hero__overlay--vignette" aria-hidden="true"></div>
      <div class="hero__overlay hero__overlay--tint" aria-hidden="true"></div>
    </div>

    <!-- ==========================================================================
         2. Type layer. Scroll-linked fade lives on this wrapper so the
         headline, button, and meta leave together as the next section covers them.
         ========================================================================== -->
    <div class="hero__copy">
    <div class="hero__content-wrapper container">
      <div class="hero__content">
        
        <!-- Season Eyebrow & Drop Info (Clean Luxury Fashion Typography) -->
        {% if section.settings.badge_label != blank or section.settings.eyebrow != blank %}
          <div class="hero__eyebrow-wrapper">
            <span class="hero__eyebrow text-micro">
              {{ section.settings.badge_label | default: section.settings.eyebrow }}
            </span>
            {% if section.settings.edition_tag != blank %}
              <span class="hero__eyebrow-sep" aria-hidden="true">&middot;</span>
              <span class="hero__edition-tag text-micro">{{ section.settings.edition_tag }}</span>
            {% endif %}
          </div>
        {% endif %}

        <!-- Inter Tight Display Headline -->
        {% if section.settings.heading != blank %}
          <h1 class="hero__heading hero-title">
            {{ section.settings.heading }}
          </h1>
        {% endif %}

        <!-- Editorial Subheading & Narrative -->
        {% if section.settings.subheading != blank %}
          <p class="hero__subheading">
            {{ section.settings.subheading }}
          </p>
        {% endif %}

        <!-- Dual Monolithic & Frosted Glass Action Cluster -->
        {% if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank %}
          <div class="hero__actions">
            {% if section.settings.primary_button_label != blank %}
              <a
                href="{{ section.settings.primary_button_link | default: routes.all_products_collection_url }}"
                class="btn btn-hero-primary"
              >
                <span>{{ section.settings.primary_button_label }}</span>
                <svg class="btn-hero__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="1" y1="7" x2="13" y2="7"></line>
                  <polyline points="8 2 13 7 8 12"></polyline>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.secondary_button_label != blank %}
              <a
                href="{{ section.settings.secondary_button_link | default: routes.collections_url }}"
                class="btn btn-hero-secondary"
              >
                <span>{{ section.settings.secondary_button_label }}</span>
              </a>
            {% endif %}
          </div>
        {% endif %}

      </div>
    </div>

    <!-- ==========================================================================
         3. Floating Bottom Editorial HUD & Category Quick Access
         ========================================================================== -->
    {% if section.settings.show_category_bar or section.settings.show_scroll_indicator or section.settings.footer_metadata != blank %}
      <div class="hero__bottom-bar">
        <div class="container hero__bottom-container">
          
          <!-- Category Quick Access (Desktop bar / Mobile swipeable rail) -->
          {% if section.settings.show_category_bar %}
            <div class="hero__categories-hud" role="navigation" aria-label="Hero Category Shortcuts">
              <span class="hero__hud-label text-micro">Capsule Direct:</span>
              <a href="{{ routes.collections_url }}/hoodies" class="hero__hud-link text-micro">
                <span class="hero__hud-index">01</span>
                <span class="hero__hud-title">Hoodies</span>
              </a>
              <span class="hero__hud-sep" aria-hidden="true">/</span>
              <a href="{{ routes.collections_url }}/shirts" class="hero__hud-link text-micro">
                <span class="hero__hud-index">02</span>
                <span class="hero__hud-title">Shirts</span>
              </a>
              <span class="hero__hud-sep" aria-hidden="true">/</span>
              <a href="{{ routes.collections_url }}/trousers" class="hero__hud-link text-micro">
                <span class="hero__hud-index">03</span>
                <span class="hero__hud-title">Trousers</span>
              </a>
              <span class="hero__hud-sep" aria-hidden="true">/</span>
              <a href="{{ routes.all_products_collection_url }}" class="hero__hud-link text-micro">
                <span class="hero__hud-index">04</span>
                <span class="hero__hud-title">All Essentials</span>
              </a>
            </div>
          {% endif %}

          <!-- Interactive Smooth Scroll Prompt -->
          {% if section.settings.show_scroll_indicator %}
            <a href="#MainContent" class="hero__scroll-indicator" aria-label="Scroll to browse catalogue">
              <span class="text-micro hero__scroll-text">Discover</span>
              <svg class="hero__scroll-arrow" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="6" y1="1" x2="6" y2="11"></line>
                <polyline points="2 7 6 11 10 7"></polyline>
              </svg>
            </a>
          {% endif %}

          <!-- Edition Metadata / Timestamp -->
          {% if section.settings.footer_metadata != blank %}
            <div class="hero__meta-stamp text-micro">
              <span>{{ section.settings.footer_metadata }}</span>
            </div>
          {% endif %}

        </div>
      </div>
    {% endif %}
    </div>

  </div>
</editorial-hero>

{% stylesheet %}
  /* ==========================================================================
     Hero Architecture & Full-Bleed 100svh Canvas
     ========================================================================== */
  .hero {
    display: block;
    position: relative;
    width: 100%;
    margin-bottom: 0;
    --hero-settle-from: 1.032;
    --hero-recede: -8px;
  }

  .hero--full {
    width: 100%;
    max-width: 100%;
    margin-inline: 0;
  }

  .hero__inner {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    background-color: var(--color-surface-dark);
  }

  /* Height variants */
  .hero--height-100svh .hero__inner {
    min-height: 100svh;
  }

  .hero--height-85svh .hero__inner {
    min-height: 85svh;
  }

  .hero--height-75svh .hero__inner {
    min-height: 75svh;
  }

  /* ==========================================================================
     Media Layer: Video, Picture, Placeholders & Layered Vignette
     ========================================================================== */
  .hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .hero__picture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero__image,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    transform-origin: center center;
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero[data-state="assemble"] .hero__image,
    .hero[data-state="assemble"] .hero__video {
      animation: heroSettle 2000ms var(--ease-in-out) both;
    }
  }

  @media (min-width: 750px) {
    .hero {
      --hero-settle-from: 1.058;
      --hero-recede: -12px;
    }

    .hero__image,
    .hero__video {
      object-position: center var(--hero-image-position-desktop, top);
      transform-origin: center var(--hero-image-position-desktop, top);
    }
  }

  @media (min-width: 750px) and (prefers-reduced-motion: no-preference) {
    .hero[data-state="assemble"] .hero__image,
    .hero[data-state="assemble"] .hero__video {
      animation-duration: 2600ms;
    }
  }

  @media (max-width: 749px) {
    .hero__image {
      object-position: center center;
    }
  }

  /* Dual Layer Progressive Vignette */
  .hero__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__overlay--vignette {
    z-index: 2;
    background: linear-gradient(
      to top,
      rgba(18, 18, 18, 0.6) 0%,
      rgba(18, 18, 18, 0) 50%,
      rgba(18, 18, 18, 0.3) 100%
    );
  }

  .hero__overlay--tint {
    z-index: 3;
    background-color: rgba(21, 21, 21, var(--hero-overlay-opacity, 0.2));
  }

  /* ==========================================================================
     Content Layer & Typographic Hierarchy (better-typography & better-layout)
     ========================================================================== */
  .hero__copy {
    position: relative;
    z-index: 4;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  .hero__content-wrapper {
    position: relative;
    z-index: 4;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--header-height) + var(--space-lg));
    padding-bottom: var(--space-md);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-width: 820px;
  }

  /* Alignment variations */
  .hero--align-left .hero__content {
    align-items: flex-start;
    text-align: left;
  }

  .hero--align-center .hero__content-wrapper {
    align-items: center;
  }

  .hero--align-center .hero__content {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }

  .hero--align-split .hero__content-wrapper {
    justify-content: flex-end;
  }

  /* Eyebrow / Season Tag (Pure Typographic, No AI Pill or Radar Dot) */
  .hero__eyebrow-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: var(--space-xs);
  }

  .hero__eyebrow {
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
  }

  .hero__eyebrow-sep {
    color: rgba(255, 255, 255, 0.35);
    user-select: none;
  }

  .hero__edition-tag {
    color: rgba(255, 255, 255, 0.65);
    font-variant-numeric: tabular-nums;
  }

  /* Display Headline */
  .hero__heading {
    color: var(--color-white);
    margin: 0;
    max-width: 20ch;
    text-wrap: balance;
    font-size: clamp(2.5rem, 6.2vw, 5.5rem);
    line-height: 1.04;
    letter-spacing: var(--tracking-tight);
    font-weight: 600;
  }



  /* Subheading */
  .hero__subheading {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 1.25vw, 1.125rem);
    line-height: var(--leading-normal);
    max-width: 50ch;
    color: rgba(255, 255, 255, 0.88);
    margin: 0 0 var(--space-xs);
    text-wrap: pretty;
  }

  /* Action Cluster & Tactile Buttons (better-ui & emil-design-eng) */
  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-2xs);
  }

  .btn-hero-primary {
    background-color: var(--color-white);
    color: var(--color-text);
    border: 1px solid var(--color-white);
    padding: 0.95rem 2rem;
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    border-radius: var(--radius-none);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: background-color var(--transition-fast),
                color var(--transition-fast),
                border-color var(--transition-fast),
                transform 160ms var(--ease-out);
    min-height: 48px;
  }

  .btn-hero-primary:active {
    transform: scale(0.96);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-hero-primary:hover {
      background-color: var(--color-surface);
      color: var(--color-text);
      border-color: var(--color-surface);
      opacity: 1;
    }
    .btn-hero-primary:hover .btn-hero__arrow {
      transform: translateX(4px);
    }
  }

  .btn-hero__arrow {
    transition: transform 160ms var(--ease-out);
  }

  .btn-hero-secondary {
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--color-white);
    border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 0.95rem 1.85rem;
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-none);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                color var(--transition-fast),
                transform 160ms var(--ease-out);
    min-height: 48px;
  }

  .btn-hero-secondary:active {
    transform: scale(0.96);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-hero-secondary:hover {
      background-color: rgba(255, 255, 255, 0.18);
      border-color: rgba(255, 255, 255, 0.6);
      color: var(--color-white);
      opacity: 1;
    }
  }

  /* ==========================================================================
     Floating Bottom Category HUD (Desktop & Mobile Adaptive)
     ========================================================================== */
  .hero__bottom-bar {
    position: relative;
    z-index: 5;
    width: 100%;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    background: linear-gradient(to top, rgba(18, 18, 18, 0.6) 0%, rgba(18, 18, 18, 0.15) 100%);
    backdrop-filter: blur(20px) saturate(140%);
    -webkit-backdrop-filter: blur(20px) saturate(140%);
    padding-block: 0.85rem;
    padding-bottom: max(0.85rem, env(safe-area-inset-bottom, 0px));
  }

  .hero__bottom-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    color: rgba(255, 255, 255, 0.85);
  }

  .hero__categories-hud {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hero__hud-label {
    color: rgba(255, 255, 255, 0.5);
    margin-right: 0.25rem;
  }

  .hero__hud-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    position: relative;
    font-variant-numeric: tabular-nums;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--transition-fast);
  }

  .hero__hud-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__hud-link:hover {
      color: var(--color-white);
      opacity: 1;
    }
    .hero__hud-link:hover::after {
      transform: scaleX(1);
    }
  }

  .hero__hud-link:active {
    transform: scale(0.97);
  }

  .hero__hud-index {
    opacity: 0.55;
  }

  .hero__hud-sep {
    opacity: 0.25;
    user-select: none;
  }

  .hero__scroll-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
    user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--transition-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__scroll-indicator:hover {
      color: var(--color-white);
      opacity: 1;
    }
  }

  .hero__scroll-indicator:active {
    transform: scale(0.97);
  }

  .hero__scroll-arrow {
    animation: heroCue 2.6s var(--ease-in-out) infinite;
  }

  .hero__meta-stamp {
    color: rgba(255, 255, 255, 0.65);
    font-variant-numeric: tabular-nums;
    margin-inline-start: auto;
  }

  /* Every load: photo settles, headline wipes up, supporting type staggers. */
  @media (prefers-reduced-motion: no-preference) {
    .hero[data-state="assemble"] .hero__eyebrow-wrapper,
    .hero[data-state="assemble"] .hero__subheading,
    .hero[data-state="assemble"] .hero__actions,
    .hero[data-state="assemble"] .hero__bottom-bar {
      animation: heroFadeInUp 640ms var(--ease-out) both;
    }

    .hero[data-state="assemble"] .hero__heading {
      animation: heroMask 1100ms var(--ease-out) both;
    }

    .hero[data-state="assemble"] .hero__eyebrow-wrapper { animation-delay: 480ms; }
    .hero[data-state="assemble"] .hero__heading { animation-delay: 560ms; }
    .hero[data-state="assemble"] .hero__subheading { animation-delay: 640ms; }
    .hero[data-state="assemble"] .hero__actions { animation-delay: 720ms; }
    .hero[data-state="assemble"] .hero__bottom-bar { animation-delay: 800ms; }
  }

  /* Type yields as the next section curtains over the pinned photograph.
     Linear because the scroll position is the timeline. */
  @supports (animation-timeline: scroll()) {
    .hero__copy {
      animation: heroRecedeFade linear both;
      animation-timeline: scroll(root);
      animation-range: 5vh 16vh;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: scroll()) {
      .hero__copy {
        animation-name: heroRecede;
      }
    }
  }

  @keyframes heroSettle {
    from { transform: scale(var(--hero-settle-from, 1.028)); }
    to { transform: scale(1); }
  }

  @keyframes heroFadeInUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroMask {
    from { clip-path: inset(100% 0 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }

  @keyframes heroRecedeFade {
    0% { opacity: 1; visibility: visible; }
    99% { visibility: visible; }
    100% { opacity: 0; visibility: hidden; }
  }

  @keyframes heroRecede {
    0% {
      opacity: 1;
      transform: translateY(0);
      visibility: visible;
    }
    99% { visibility: visible; }
    100% {
      opacity: 0;
      transform: translateY(var(--hero-recede, -8px));
      visibility: hidden;
    }
  }

  @keyframes heroCue {
    0%, 100% {
      opacity: 0.5;
      transform: translateY(0);
    }
    50% {
      opacity: 1;
      transform: translateY(3px);
    }
  }

  /* ==========================================================================
     Mobile & Tablet Responsive Optimizations (mobile-native skill)
     ========================================================================== */
  @media (max-width: 749px) {
    .hero__overlay--vignette {
      background: linear-gradient(
        to top,
        rgba(10, 10, 10, 0.78) 0%,
        rgba(10, 10, 10, 0.42) 36%,
        rgba(10, 10, 10, 0) 65%,
        rgba(10, 10, 10, 0.2) 100%
      );
    }

    .hero__content-wrapper {
      padding-top: calc(var(--header-height) + var(--space-md));
      padding-bottom: max(var(--space-lg), calc(env(safe-area-inset-bottom, 0px) + var(--space-md)));
    }

    .hero__content {
      gap: 1.25rem;
    }

    .hero__eyebrow-wrapper,
    .hero__subheading {
      display: none !important;
    }

    .hero__heading {
      font-size: clamp(2.15rem, 9.8vw, 3rem);
      line-height: 1.05;
      max-width: 14ch;
      letter-spacing: var(--tracking-tight, -0.02em);
    }

    .hero__actions {
      flex-direction: column;
      width: 100%;
      align-items: stretch;
      gap: 0.625rem;
      margin-top: 0.25rem;
    }

    .btn-hero-primary,
    .btn-hero-secondary {
      width: 100%;
      text-align: center;
      padding-block: 0.875rem;
    }

    .hero__bottom-bar {
      padding-block: 0.65rem;
      padding-bottom: max(0.65rem, env(safe-area-inset-bottom, 0px));
    }

    .hero__bottom-container {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }

    .hero__hud-label,
    .hero__hud-sep,
    .hero__scroll-indicator {
      display: none;
    }

    .hero__meta-stamp {
      display: block;
      width: 100%;
      text-align: right;
    }

    /* Swipeable category pill rail for mobile */
    .hero__categories-hud {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      width: 100%;
      gap: 0.5rem;
      padding-block: 0.125rem;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-x;
    }

    .hero__categories-hud::-webkit-scrollbar {
      display: none;
    }

    .hero__hud-link {
      padding: 0.35rem 0.75rem;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: var(--radius-none, 0px);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .hero__hud-link::after {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__image,
    .hero__video,
    .hero__eyebrow-wrapper,
    .hero__heading,
    .hero__subheading,
    .hero__actions,
    .hero__bottom-bar,
    .hero__scroll-arrow {
      animation: none;
      clip-path: none;
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    if (!customElements.get('editorial-hero')) {
      customElements.define(
        'editorial-hero',
        class extends HTMLElement {
          connectedCallback() {
            if (this.getAttribute('data-state') !== 'assemble') return;
            this.addEventListener('animationend', (event) => {
              if (event.animationName === 'heroSettle') this.setAttribute('data-state', 'settled');
            });
          }
        }
      );
    }
  })();
{% endjavascript %}

