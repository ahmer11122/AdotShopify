{% comment %}
  Editorial hero. Every load: the photograph opens like a camera aperture
  while it settles, the headline rises word by word out of a mask, then the
  supporting type staggers in.

  Scrolling is the transition: the pinned photo pushes in and dims, the type
  defocuses and drifts up, and the next section rises over it as a curved
  curtain that flattens as it lands (see category-tiles.liquid).

  Fine pointers get a slow photographic drift and a magnetic primary button.
  Reduced motion and the theme editor show the finished frame.
  Copy stays in settings.
{% endcomment %}

<editorial-hero
  class="hero hero--full hero--height-{{ section.settings.hero_height | default: '100svh' }} hero--align-{{ section.settings.text_alignment | default: 'left' }}"
  data-section-id="{{ section.id }}"
  data-state="{% if section.settings.cinematic_reveal == false %}static{% else %}assemble{% endif %}"
  style="--hero-overlay-opacity: {{ section.settings.overlay_opacity | default: 45 | divided_by: 100.0 }}; --hero-image-position-desktop: {{ section.settings.desktop_image_position | default: 'top' }};"
>
  {% if section.settings.cinematic_reveal %}
    {% # theme-check-disable ParserBlockingScript %}
    <script>
      (function (el) {
        var reduce = false;
        try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
        var design = !!(window.Shopify && Shopify.designMode);
        if (reduce || design) el.setAttribute('data-state', 'static');
      })(document.currentScript.parentElement);
    </script>
    {% # theme-check-enable ParserBlockingScript %}
  {% endif %}
  <div class="hero__inner">
    <!-- ==========================================================================
         1. Background Media Layer (Desktop, Mobile, Video, Placeholder)
         ========================================================================== -->
    <div class="hero__media">
      {% if section.settings.video_url != blank %}
        <video
          class="hero__video"
          autoplay
          loop
          muted
          playsinline
          preload="auto"
          {% if section.settings.image != blank %}poster="{{ section.settings.image | image_url: width: 1920 }}"{% endif %}
        >
          <source src="{{ section.settings.video_url }}" type="video/mp4">
        </video>
      {% elsif section.settings.image != blank or section.settings.image_mobile != blank %}
        <picture class="hero__picture">
          {% if section.settings.image_mobile != blank %}
            <source
              media="(max-width: 749px)"
              srcset="{{ section.settings.image_mobile | image_url: width: 750 }} 750w, {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w"
              sizes="100vw"
            >
          {% else %}
            <source
              media="(max-width: 749px)"
              srcset="{{ 'hero-mobile.jpg' | asset_url }}"
            >
          {% endif %}
          {% if section.settings.image != blank %}
            {{
              section.settings.image
              | image_url: width: 2400
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '750, 1100, 1500, 1920, 2400',
                sizes: '100vw',
                class: 'hero__image',
                alt: section.settings.image.alt | default: section.settings.heading | escape
            }}
          {% else %}
            <img
              src="{{ 'hero-desktop.jpg' | asset_url }}"
              alt="{{ section.settings.image.alt | default: 'Man wearing a black polo shirt with white trim and grey trousers' | escape }}"
              class="hero__image"
              loading="eager"
              fetchpriority="high"
              width="2560"
              height="1440"
            >
          {% endif %}
        </picture>
      {% else %}
        <!-- Responsive Dual Photography (Mobile: hero-mobile.jpg, Desktop: hero-desktop.jpg) -->
        <picture class="hero__picture">
          <source
            media="(max-width: 749px)"
            srcset="{{ 'hero-mobile.jpg' | asset_url }}"
          >
          <source
            media="(min-width: 750px)"
            srcset="{{ 'hero-desktop.jpg' | asset_url }}"
          >
          <img
            src="{{ 'hero-desktop.jpg' | asset_url }}"
            alt="{{ section.settings.image.alt | default: 'Man wearing a black polo shirt with white trim and grey trousers' | escape }}"
            class="hero__image"
            loading="eager"
            fetchpriority="high"
            width="2560"
            height="1440"
          >
        </picture>
      {% endif %}

      <!-- Layered Progressive Vignette & Atmosphere Overlays -->
      <div class="hero__overlay hero__overlay--vignette" aria-hidden="true"></div>
      <div class="hero__overlay hero__overlay--tint" aria-hidden="true"></div>
      <div class="hero__overlay hero__overlay--shade" aria-hidden="true"></div>
    </div>

    <!-- ==========================================================================
         2. Type layer. Scroll-linked defocus lives on this wrapper so the
         headline, button, and meta leave together as the next section covers them.
         ========================================================================== -->
    <div class="hero__copy">
    <div class="hero__content-wrapper container">
      <div class="hero__content">

        <!-- Season Eyebrow & Drop Info (Clean Luxury Fashion Typography) -->
        {% if section.settings.badge_label != blank or section.settings.eyebrow != blank %}
          <div class="hero__eyebrow-wrapper">
            <span class="hero__eyebrow text-micro">
              {{ section.settings.badge_label | default: section.settings.eyebrow }}
            </span>
            {% if section.settings.edition_tag != blank %}
              <span class="hero__eyebrow-sep" aria-hidden="true">&middot;</span>
              <span class="hero__edition-tag text-micro">{{ section.settings.edition_tag }}</span>
            {% endif %}
          </div>
        {% endif %}

        <!-- Inter Tight Display Headline: every word rises out of its own mask -->
        {% if section.settings.heading != blank %}
          <h1 class="hero__heading hero-title">
            {%- assign hero_words = section.settings.heading | split: ' ' -%}
            {%- for word in hero_words -%}
              <span class="hero__word"><span class="hero__word-i" style="--i: {{ forloop.index0 }}">{{ word | escape }}</span></span>{% unless forloop.last %} {% endunless %}
            {%- endfor -%}
          </h1>
        {% endif %}

        <!-- Editorial Subheading & Narrative -->
        {% if section.settings.subheading != blank %}
          <p class="hero__subheading">
            {{ section.settings.subheading }}
          </p>
        {% endif %}

        <!-- Dual Monolithic & Frosted Glass Action Cluster -->
        {% if section.settings.primary_button_label != blank or section.settings.secondary_button_label != blank %}
          <div class="hero__actions">
            {% if section.settings.primary_button_label != blank %}
              <a
                href="{{ section.settings.primary_button_link | default: routes.all_products_collection_url }}"
                class="btn btn-hero-primary"
              >
                <span class="btn-hero__label">{{ section.settings.primary_button_label }}</span>
                <svg class="btn-hero__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="1" y1="7" x2="13" y2="7"></line>
                  <polyline points="8 2 13 7 8 12"></polyline>
                </svg>
              </a>
            {% endif %}

            {% if section.settings.secondary_button_label != blank %}
              <a
                href="{{ section.settings.secondary_button_link | default: routes.collections_url }}"
                class="btn btn-hero-secondary"
              >
                <span>{{ section.settings.secondary_button_label }}</span>
              </a>
            {% endif %}
          </div>
        {% endif %}

      </div>
    </div>

    <!-- ==========================================================================
         3. Floating Bottom Editorial HUD & Category Quick Access
         ========================================================================== -->
    {% if section.settings.show_category_bar or section.settings.show_scroll_indicator or section.settings.footer_metadata != blank %}
      <div class="hero__bottom-bar">
        <div class="container hero__bottom-container">

          <!-- Category Quick Access (Desktop bar / Mobile swipeable rail) -->
          {% if section.settings.show_category_bar %}
            <div class="hero__categories-hud" role="navigation" aria-label="Hero Category Shortcuts">
              <span class="hero__hud-label text-micro">Capsule Direct:</span>
              <a href="{{ routes.collections_url }}/hoodies" class="hero__hud-link text-micro">
                <span class="hero__hud-index">01</span>
                <span class="hero__hud-title">Hoodies</span>
              </a>
              <span class="hero__hud-sep" aria-hidden="true">/</span>
              <a href="{{ routes.collections_url }}/shirts" class="hero__hud-link text-micro">
                <span class="hero__hud-index">02</span>
                <span class="hero__hud-title">Shirts</span>
              </a>
              <span class="hero__hud-sep" aria-hidden="true">/</span>
              <a href="{{ routes.collections_url }}/trousers" class="hero__hud-link text-micro">
                <span class="hero__hud-index">03</span>
                <span class="hero__hud-title">Trousers</span>
              </a>
              <span class="hero__hud-sep" aria-hidden="true">/</span>
              <a href="{{ routes.all_products_collection_url }}" class="hero__hud-link text-micro">
                <span class="hero__hud-index">04</span>
                <span class="hero__hud-title">All Essentials</span>
              </a>
            </div>
          {% endif %}

          <!-- Scroll cue: a hairline with a light that travels down it -->
          {% if section.settings.show_scroll_indicator %}
            <a href="#MainContent" class="hero__scroll-indicator" data-hero-scroll aria-label="Scroll to browse catalogue">
              <span class="hero__scroll-line" aria-hidden="true"></span>
              <span class="text-micro hero__scroll-text">Scroll</span>
            </a>
          {% endif %}

          <!-- Edition Metadata / Timestamp -->
          {% if section.settings.footer_metadata != blank %}
            <div class="hero__meta-stamp text-micro">
              <span>{{ section.settings.footer_metadata }}</span>
            </div>
          {% endif %}

        </div>
      </div>
    {% endif %}
    </div>

  </div>
</editorial-hero>

{% stylesheet %}
  /* ==========================================================================
     Hero Architecture & Full-Bleed 100svh Canvas
     ========================================================================== */
  .hero {
    display: block;
    position: relative;
    width: 100%;
    margin-bottom: 0;
    /* The photo opens from a framed aperture while zooming out to its resting scale. */
    --hero-aperture: 7svh 6vw;
    --hero-settle-from: 1.16;
    --hero-rest-scale: 1;
    --hero-push: 1.14;
  }

  .hero--full {
    width: 100%;
    max-width: 100%;
    margin-inline: 0;
  }

  .hero__inner {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    background-color: var(--color-surface-dark);
  }

  /* Height variants */
  .hero--height-100svh .hero__inner {
    min-height: 100svh;
  }

  .hero--height-85svh .hero__inner {
    min-height: 85svh;
  }

  .hero--height-75svh .hero__inner {
    min-height: 75svh;
  }

  /* ==========================================================================
     Media Layer: Video, Picture, Placeholders & Layered Vignette
     ========================================================================== */
  .hero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    overflow: hidden;
  }

  .hero__picture {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .hero__image,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    transform-origin: center center;
    scale: var(--hero-rest-scale, 1);
    display: block;
  }

  @media (min-width: 750px) {
    .hero {
      --hero-aperture: 12svh 22vw;
      --hero-settle-from: 1.24;
    }

    .hero__image,
    .hero__video {
      object-position: center var(--hero-image-position-desktop, top);
      transform-origin: center var(--hero-image-position-desktop, top);
    }
  }

  @media (max-width: 749px) {
    .hero__image {
      object-position: center center;
    }
  }

  /* Fine pointers get a slow photographic drift, so the photo rests slightly
     oversized and never shows an edge while it moves. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .hero {
      --hero-rest-scale: 1.05;
    }

    .hero__picture {
      transition: translate 1400ms var(--ease-out);
    }
  }

  /* Dual Layer Progressive Vignette */
  .hero__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__overlay--vignette {
    z-index: 2;
    background: linear-gradient(
      to top,
      rgba(18, 18, 18, 0.6) 0%,
      rgba(18, 18, 18, 0) 50%,
      rgba(18, 18, 18, 0.3) 100%
    );
  }

  .hero__overlay--tint {
    z-index: 3;
    background-color: rgba(21, 21, 21, var(--hero-overlay-opacity, 0.2));
  }

  /* Dims the photograph as the next section rises over it. Scroll-driven only. */
  .hero__overlay--shade {
    z-index: 3;
    background-color: var(--color-surface-dark);
    opacity: 0;
  }

  /* ==========================================================================
     Content Layer & Typographic Hierarchy
     ========================================================================== */
  .hero__copy {
    position: relative;
    z-index: 4;
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    width: 100%;
    min-height: 0;
  }

  .hero__content-wrapper {
    position: relative;
    z-index: 4;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--header-height) + var(--space-lg));
    padding-bottom: var(--space-md);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    max-width: 820px;
  }

  /* Alignment variations */
  .hero--align-left .hero__content {
    align-items: flex-start;
    text-align: left;
  }

  .hero--align-center .hero__content-wrapper {
    align-items: center;
  }

  .hero--align-center .hero__content {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }

  .hero--align-split .hero__content-wrapper {
    justify-content: flex-end;
  }

  /* Eyebrow / Season Tag (Pure Typographic, No AI Pill or Radar Dot) */
  .hero__eyebrow-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: var(--space-xs);
  }

  .hero__eyebrow {
    color: rgba(255, 255, 255, 0.85);
    font-weight: 500;
  }

  .hero__eyebrow-sep {
    color: rgba(255, 255, 255, 0.35);
    user-select: none;
  }

  .hero__edition-tag {
    color: rgba(255, 255, 255, 0.65);
    font-variant-numeric: tabular-nums;
  }

  /* Display Headline */
  .hero__heading {
    color: var(--color-white);
    margin: 0;
    max-width: 20ch;
    text-wrap: balance;
    font-size: clamp(2.5rem, 6.2vw, 5.5rem);
    line-height: 1.04;
    letter-spacing: var(--tracking-tight);
    font-weight: 600;
  }

  /* Each word owns a mask. The padding gives descenders and tall caps room so
     the clip never shaves a glyph, and the negative margin hands it back. */
  .hero__word {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    padding-block: 0.08em 0.14em;
    margin-block: -0.08em -0.14em;
  }

  .hero__word-i {
    display: inline-block;
    transform-origin: 0 100%;
  }

  /* Subheading */
  .hero__subheading {
    font-family: var(--font-body);
    font-size: clamp(0.9375rem, 1.25vw, 1.125rem);
    line-height: var(--leading-normal);
    max-width: 50ch;
    color: rgba(255, 255, 255, 0.88);
    margin: 0 0 var(--space-xs);
    text-wrap: pretty;
  }

  /* Action Cluster & Tactile Buttons */
  .hero__actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    margin-top: var(--space-2xs);
  }

  .btn-hero-primary {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background-color: var(--color-white);
    color: var(--color-text);
    border: 1px solid var(--color-white);
    padding: 0.95rem 2rem;
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    border-radius: var(--radius-none);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color 220ms ease,
                transform 160ms var(--ease-out),
                translate 420ms var(--ease-out);
    min-height: 48px;
  }

  /* Ink fill: a dark panel wipes up behind the label. */
  .btn-hero-primary::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-color: var(--color-surface-dark);
    clip-path: inset(100% 0 0 0);
    transition: clip-path 420ms var(--ease-out);
  }

  .btn-hero-primary:active {
    transform: scale(0.96);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-hero-primary:hover {
      color: var(--color-white);
      opacity: 1;
    }
    .btn-hero-primary:hover::before {
      clip-path: inset(0 0 0 0);
    }
    .btn-hero-primary:hover .btn-hero__arrow {
      transform: translateX(4px);
    }
  }

  .btn-hero__arrow {
    transition: transform 200ms var(--ease-out);
  }

  .btn-hero-secondary {
    background-color: rgba(255, 255, 255, 0.08);
    color: var(--color-white);
    border: 1px solid rgba(255, 255, 255, 0.28);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    padding: 0.95rem 1.85rem;
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-none);
    cursor: pointer;
    user-select: none;
    -webkit-user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: background-color var(--transition-fast),
                border-color var(--transition-fast),
                color var(--transition-fast),
                transform 160ms var(--ease-out);
    min-height: 48px;
  }

  .btn-hero-secondary:active {
    transform: scale(0.96);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-hero-secondary:hover {
      background-color: rgba(255, 255, 255, 0.18);
      border-color: rgba(255, 255, 255, 0.6);
      color: var(--color-white);
      opacity: 1;
    }
  }

  /* ==========================================================================
     Floating Bottom HUD (Desktop & Mobile Adaptive)
     ========================================================================== */
  .hero__bottom-bar {
    position: relative;
    z-index: 5;
    width: 100%;
    padding-block: 1rem;
    padding-bottom: max(1rem, env(safe-area-inset-bottom, 0px));
  }

  /* Hairline that fades out at both ends instead of a boxed glass strip. */
  .hero__bottom-bar::before {
    content: '';
    position: absolute;
    top: 0;
    left: var(--space-sm);
    right: var(--space-sm);
    height: 1px;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0.34),
      rgba(255, 255, 255, 0.1) 60%,
      rgba(255, 255, 255, 0)
    );
    transform-origin: left center;
  }

  @media (min-width: 750px) {
    .hero__bottom-bar::before {
      left: var(--space-md);
      right: var(--space-md);
    }
  }

  .hero__bottom-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    color: rgba(255, 255, 255, 0.85);
  }

  .hero__categories-hud {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hero__hud-label {
    color: rgba(255, 255, 255, 0.5);
    margin-right: 0.25rem;
  }

  .hero__hud-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: rgba(255, 255, 255, 0.85);
    text-decoration: none;
    position: relative;
    font-variant-numeric: tabular-nums;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--transition-fast);
  }

  .hero__hud-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__hud-link:hover {
      color: var(--color-white);
      opacity: 1;
    }
    .hero__hud-link:hover::after {
      transform: scaleX(1);
    }
  }

  .hero__hud-link:active {
    transform: scale(0.97);
  }

  .hero__hud-index {
    opacity: 0.55;
  }

  .hero__hud-sep {
    opacity: 0.25;
    user-select: none;
  }

  .hero__scroll-indicator {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    user-select: none;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--transition-fast), transform 160ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__scroll-indicator:hover {
      color: var(--color-white);
      opacity: 1;
    }
  }

  .hero__scroll-indicator:active {
    transform: scale(0.97);
  }

  .hero__scroll-line {
    position: relative;
    display: block;
    width: 1px;
    height: 36px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.26);
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-white);
    transform: translateY(-100%);
    animation: heroLine 2.4s var(--ease-in-out) infinite;
  }

  .hero__meta-stamp {
    color: rgba(255, 255, 255, 0.7);
    font-variant-numeric: tabular-nums;
    margin-inline-start: auto;
    text-align: right;
  }

  /* ==========================================================================
     Load sequence: aperture opens, photo settles, headline rises word by word,
     then the supporting type and HUD stagger in. Base styles stay finished, so
     when the animations are gone the frame is already correct.
     ========================================================================== */
  @media (prefers-reduced-motion: no-preference) {
    .hero[data-state="assemble"] .hero__media {
      animation: heroAperture 1500ms var(--ease-in-out) both;
    }

    .hero[data-state="assemble"] .hero__image,
    .hero[data-state="assemble"] .hero__video {
      animation: heroSettle 1900ms var(--ease-out) both;
    }

    .hero[data-state="assemble"] .hero__word-i {
      animation: heroWord 1000ms var(--ease-out) both;
      animation-delay: calc(620ms + var(--i, 0) * 70ms);
    }

    .hero[data-state="assemble"] .hero__eyebrow-wrapper,
    .hero[data-state="assemble"] .hero__subheading,
    .hero[data-state="assemble"] .hero__actions,
    .hero[data-state="assemble"] .hero__bottom-container {
      animation: heroFadeInUp 720ms var(--ease-out) both;
    }

    .hero[data-state="assemble"] .hero__bottom-bar::before {
      animation: heroHairline 1400ms var(--ease-out) 900ms both;
    }

    .hero[data-state="assemble"] .hero__eyebrow-wrapper { animation-delay: 520ms; }
    .hero[data-state="assemble"] .hero__subheading { animation-delay: 1000ms; }
    .hero[data-state="assemble"] .hero__actions { animation-delay: 1120ms; }
    .hero[data-state="assemble"] .hero__bottom-container { animation-delay: 1300ms; }
  }

  /* ==========================================================================
     Scroll is the transition. The next section curtains up over the pinned
     photograph, so the hero answers: photo pushes in and dims, type defocuses
     and drifts away. Linear, because the scroll position is the timeline.
     ========================================================================== */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .hero__picture {
        animation: heroPush linear both;
        animation-timeline: scroll(root);
        animation-range: 0px 100svh;
      }

      .hero__overlay--shade {
        animation: heroShade linear both;
        animation-timeline: scroll(root);
        animation-range: 0px 100svh;
      }

      .hero__copy {
        animation: heroRecede linear both;
        animation-timeline: scroll(root);
        animation-range: 0px 58svh;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .hero__copy {
        animation: heroRecedeFade linear both;
        animation-timeline: scroll(root);
        animation-range: 5svh 16svh;
      }
    }
  }

  @keyframes heroAperture {
    from { clip-path: inset(var(--hero-aperture)); }
    to { clip-path: inset(0 0 0 0); }
  }

  @keyframes heroSettle {
    from { scale: var(--hero-settle-from, 1.16); }
    to { scale: var(--hero-rest-scale, 1); }
  }

  @keyframes heroWord {
    from {
      transform: translateY(112%) rotate(4deg);
    }
    to {
      transform: translateY(0) rotate(0deg);
    }
  }

  @keyframes heroFadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes heroHairline {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @keyframes heroPush {
    to { scale: var(--hero-push, 1.14); }
  }

  @keyframes heroShade {
    to { opacity: 0.62; }
  }

  @keyframes heroRecede {
    0% {
      opacity: 1;
      transform: translateY(0);
      filter: blur(0);
      visibility: visible;
    }
    99% { visibility: visible; }
    100% {
      opacity: 0;
      transform: translateY(-7svh);
      filter: blur(8px);
      visibility: hidden;
    }
  }

  @keyframes heroRecedeFade {
    0% { opacity: 1; visibility: visible; }
    99% { visibility: visible; }
    100% { opacity: 0; visibility: hidden; }
  }

  @keyframes heroLine {
    0% { transform: translateY(-100%); }
    55% { transform: translateY(0); }
    100% { transform: translateY(100%); }
  }

  /* ==========================================================================
     Mobile & Tablet Responsive Optimizations
     ========================================================================== */
  @media (max-width: 749px) {
    .hero__overlay--vignette {
      background: linear-gradient(
        to top,
        rgba(10, 10, 10, 0.78) 0%,
        rgba(10, 10, 10, 0.42) 36%,
        rgba(10, 10, 10, 0) 65%,
        rgba(10, 10, 10, 0.2) 100%
      );
    }

    .hero__content-wrapper {
      padding-top: calc(var(--header-height) + var(--space-md));
      padding-bottom: var(--space-md);
    }

    .hero__content {
      gap: 1.25rem;
    }

    .hero__eyebrow-wrapper,
    .hero__subheading {
      display: none !important;
    }

    .hero__heading {
      font-size: clamp(2.15rem, 9.8vw, 3rem);
      line-height: 1.05;
      max-width: 14ch;
      letter-spacing: var(--tracking-tight, -0.02em);
    }

    .hero__actions {
      flex-direction: column;
      width: 100%;
      align-items: stretch;
      gap: 0.625rem;
      margin-top: 0.25rem;
    }

    .btn-hero-primary,
    .btn-hero-secondary {
      width: 100%;
      justify-content: center;
      text-align: center;
      padding-block: 0.875rem;
    }

    .hero__bottom-bar {
      padding-block: 0.25rem;
      padding-bottom: max(0.25rem, env(safe-area-inset-bottom, 0px));
    }

    .hero__bottom-container {
      gap: var(--space-sm);
    }

    .hero__hud-label,
    .hero__hud-sep {
      display: none;
    }

    .hero__scroll-line {
      height: 28px;
    }

    .hero__meta-stamp {
      display: block;
      font-size: 0.6875rem;
    }

    /* Swipeable category pill rail for mobile */
    .hero__categories-hud {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      width: 100%;
      gap: 0.5rem;
      padding-block: 0.125rem;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
      touch-action: pan-x;
    }

    .hero__categories-hud::-webkit-scrollbar {
      display: none;
    }

    .hero__hud-link {
      padding: 0.35rem 0.75rem;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: var(--radius-none, 0px);
      white-space: nowrap;
      flex-shrink: 0;
    }

    .hero__hud-link::after {
      display: none;
    }
  }

  /* Reduced motion keeps the finished frame, and drops every transform. */
  @media (prefers-reduced-motion: reduce) {
    .hero__media,
    .hero__image,
    .hero__video,
    .hero__word-i,
    .hero__eyebrow-wrapper,
    .hero__subheading,
    .hero__actions,
    .hero__bottom-container,
    .hero__bottom-bar::before,
    .hero__scroll-line::after {
      animation: none;
      clip-path: none;
      transform: none;
    }

    .hero__scroll-line::after {
      transform: translateY(0);
      opacity: 0.6;
    }

    .btn-hero-primary::before {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    if (customElements.get('editorial-hero')) return;

    customElements.define(
      'editorial-hero',
      class extends HTMLElement {
        connectedCallback() {
          this.onScrollCue = this.onScrollCue.bind(this);
          this.onMove = this.onMove.bind(this);
          this.onLeave = this.onLeave.bind(this);
          this.onButtonMove = this.onButtonMove.bind(this);
          this.onButtonLeave = this.onButtonLeave.bind(this);

          // The scroll cue always works, motion or not: it jumps to the next section.
          this.cue = this.querySelector('[data-hero-scroll]');
          if (this.cue) this.cue.addEventListener('click', this.onScrollCue);

          const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const design = !!(window.Shopify && window.Shopify.designMode);
          if (!fine || reduce || design) return;

          // Slow photographic drift. Decorative, so it springs rather than tracks.
          this.picture = this.querySelector('.hero__picture');
          if (this.picture) {
            this.addEventListener('pointermove', this.onMove, { passive: true });
            this.addEventListener('pointerleave', this.onLeave, { passive: true });
          }

          // Magnetic primary button: it leans toward the pointer, a few pixels only.
          this.button = this.querySelector('.btn-hero-primary');
          if (this.button) {
            this.button.addEventListener('pointermove', this.onButtonMove, { passive: true });
            this.button.addEventListener('pointerleave', this.onButtonLeave, { passive: true });
          }
        }

        disconnectedCallback() {
          if (this.cue) this.cue.removeEventListener('click', this.onScrollCue);
          this.removeEventListener('pointermove', this.onMove);
          this.removeEventListener('pointerleave', this.onLeave);
          if (this.button) {
            this.button.removeEventListener('pointermove', this.onButtonMove);
            this.button.removeEventListener('pointerleave', this.onButtonLeave);
          }
        }

        onScrollCue(event) {
          const wrapper = this.closest('.shopify-section');
          const next = wrapper && wrapper.nextElementSibling;
          if (!next) return;
          event.preventDefault();
          next.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        onMove(event) {
          const x = (event.clientX / window.innerWidth - 0.5) * 2;
          const y = (event.clientY / window.innerHeight - 0.5) * 2;
          this.picture.style.translate = (x * -14).toFixed(1) + 'px ' + (y * -8).toFixed(1) + 'px';
        }

        onLeave() {
          this.picture.style.translate = '';
        }

        onButtonMove(event) {
          const rect = this.button.getBoundingClientRect();
          const dx = event.clientX - (rect.left + rect.width / 2);
          const dy = event.clientY - (rect.top + rect.height / 2);
          const clamp = (v) => Math.max(-6, Math.min(6, v));
          this.button.style.translate = clamp(dx * 0.14).toFixed(1) + 'px ' + clamp(dy * 0.2).toFixed(1) + 'px';
        }

        onButtonLeave() {
          this.button.style.translate = '';
        }
      }
    );
  })();
{% endjavascript %}

