{% comment %}
  Service Ledger
  One markup for every breakpoint: a hairline-ruled ledger of four guarantees.
  Mobile: 2 x 2 grid. Desktop: 4 columns with oversized type. Continues the
  Brand Marquee above it (shared hairline, shared surface) — no second ticker.
{% endcomment %}

{% liquid
  assign p1_title = section.settings.pillar_1_title | default: 'Cash on delivery'
  assign p1_desc = section.settings.pillar_1_desc | default: 'Pay when it arrives'
  assign p2_title = section.settings.pillar_2_title | default: '7-day exchange'
  assign p2_desc = section.settings.pillar_2_desc | default: 'Size or fit, replaced'
  assign p3_title = section.settings.pillar_3_title | default: '2–4 day delivery'
  assign p3_desc = section.settings.pillar_3_desc | default: 'Across Pakistan'
  assign p4_title = section.settings.pillar_4_title | default: 'WhatsApp'
  assign p4_desc = section.settings.pillar_4_desc | default: 'Order in a chat'
  assign wa_num = section.settings.whatsapp_number | default: '923131707080' | remove: '+' | remove: ' ' | remove: '-'
  assign wa_msg = 'Hello ADOT, I would like to place an order.' | url_encode
  assign wa_url = 'https://wa.me/' | append: wa_num | append: '?text=' | append: wa_msg
  assign scheme = section.settings.color_scheme | default: 'dark'
%}

<section
  class="trust-strip trust-strip--{{ scheme }}"
  data-section-id="{{ section.id }}"
  aria-labelledby="TrustStripHeading-{{ section.id }}"
>
  <div class="container">
    <h2 class="visually-hidden" id="TrustStripHeading-{{ section.id }}">Ordering and delivery guarantees</h2>

    <ul class="trust-strip__list" role="list">
      <li class="trust-strip__item">
        <div class="trust-strip__card">
          <span class="trust-strip__index" aria-hidden="true">01</span>
          <h3 class="trust-strip__title">{{ p1_title }}</h3>
          <p class="trust-strip__desc">{{ p1_desc }}</p>
        </div>
      </li>

      <li class="trust-strip__item">
        <div class="trust-strip__card">
          <span class="trust-strip__index" aria-hidden="true">02</span>
          <h3 class="trust-strip__title">{{ p2_title }}</h3>
          <p class="trust-strip__desc">{{ p2_desc }}</p>
        </div>
      </li>

      <li class="trust-strip__item">
        <div class="trust-strip__card">
          <span class="trust-strip__index" aria-hidden="true">03</span>
          <h3 class="trust-strip__title">{{ p3_title }}</h3>
          <p class="trust-strip__desc">{{ p3_desc }}</p>
        </div>
      </li>

      <li class="trust-strip__item">
        {% if wa_num != blank %}
          <a
            class="trust-strip__card trust-strip__card--link"
            href="{{ wa_url }}"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="{{ p4_title }} - {{ p4_desc }} (opens WhatsApp chat)"
          >
            <span class="trust-strip__index" aria-hidden="true">
              04
              <span class="trust-strip__live" aria-hidden="true">
                <span class="trust-strip__live-dot"></span>
                Live
              </span>
            </span>
            <span class="trust-strip__title">{{ p4_title }}</span>
            <span class="trust-strip__desc">
              {{ p4_desc }}
              <svg class="trust-strip__arrow" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true" focusable="false"><path d="M2.5 11.5l9-9M5 2.5h6.5V9" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
            </span>
          </a>
        {% else %}
          <div class="trust-strip__card">
            <span class="trust-strip__index" aria-hidden="true">04</span>
            <h3 class="trust-strip__title">{{ p4_title }}</h3>
            <p class="trust-strip__desc">{{ p4_desc }}</p>
          </div>
        {% endif %}
      </li>
    </ul>
  </div>
</section>

{% stylesheet %}
  .section-trust-strip {
    position: relative;
    z-index: 2;
  }

  .trust-strip {
    display: block;
    position: relative;
    padding-block: 0 clamp(2.5rem, 6vw, 5rem);
  }

  .trust-strip--dark {
    --ts-bg: var(--color-surface-dark, #111111);
    --ts-text: var(--color-text-inverse, #FFFFFF);
    --ts-sub: color-mix(in srgb, var(--color-white) 64%, transparent);
    --ts-index: color-mix(in srgb, var(--color-white) 48%, transparent);
    --ts-line: rgba(255, 255, 255, 0.14);
  }

  .trust-strip--light {
    --ts-bg: var(--color-background, #FFFFFF);
    --ts-text: var(--color-text, #111111);
    --ts-sub: var(--color-text-muted, #555555);
    --ts-index: var(--color-text-subtle, #6B6B6B);
    --ts-line: var(--color-border, #E5E5E5);
  }

  .trust-strip--dark,
  .trust-strip--light {
    background-color: var(--ts-bg);
    color: var(--ts-text);
  }

  .trust-strip--light {
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }

  /* Mobile: 2 x 2 ledger */
  .trust-strip__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--ts-line);
  }

  .trust-strip__item {
    min-width: 0;
    border-bottom: 1px solid var(--ts-line);
  }

  .trust-strip__item:nth-child(even) {
    border-inline-start: 1px solid var(--ts-line);
  }

  .trust-strip__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    height: 100%;
    box-sizing: border-box;
    padding: 1.25rem 1rem 1.5rem 0;
    color: inherit;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .trust-strip__item:nth-child(even) .trust-strip__card {
    padding-inline-start: 1rem;
    padding-inline-end: 0;
  }

  .trust-strip__index {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: clamp(1.25rem, 4vw, 3rem);
    font-family: var(--font-body);
    font-size: var(--font-size-micro, 0.75rem);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
    line-height: 1;
    color: var(--ts-index);
  }

  .trust-strip__title {
    display: block;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 4.6vw, 1.5rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--ts-text);
    text-wrap: balance;
  }

  .trust-strip__desc {
    display: block;
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.45;
    color: var(--ts-sub);
    text-wrap: balance;
  }

  .trust-strip__arrow {
    display: inline-block;
    vertical-align: -1px;
    margin-inline-start: 0.2rem;
    transition: transform 250ms var(--ease-out);
  }

  /* WhatsApp live pill */
  .trust-strip__live {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.5rem;
    background: rgba(37, 211, 102, 0.12);
    border: 1px solid rgba(37, 211, 102, 0.3);
    border-radius: 9999px;
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #25D366;
  }

  .trust-strip--light .trust-strip__live {
    color: #166534;
    background: rgba(22, 101, 52, 0.08);
    border-color: rgba(22, 101, 52, 0.28);
  }

  .trust-strip__live-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    animation: trust-pulse 2.4s ease-in-out infinite;
  }

  @keyframes trust-pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(0.75);
    }
  }

  .trust-strip__card:focus-visible {
    outline: 2px solid var(--ts-text);
    outline-offset: -2px;
  }

  /* Desktop: 4 columns, oversized type */
  @media (min-width: 750px) {
    .trust-strip__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .trust-strip__item {
      border-bottom: 0;
      border-inline-start: 1px solid var(--ts-line);
    }

    .trust-strip__item:first-child {
      border-inline-start: 0;
    }

    .trust-strip__card,
    .trust-strip__item:nth-child(even) .trust-strip__card {
      gap: 0.5rem;
      padding: 1.5rem 1.5rem 0.5rem;
    }

    .trust-strip__item:first-child .trust-strip__card {
      padding-inline-start: 0;
    }

    .trust-strip__item:last-child .trust-strip__card {
      padding-inline-end: 0;
    }

    .trust-strip__title {
      font-size: clamp(1.375rem, 2.3vw, 2.125rem);
      letter-spacing: -0.035em;
    }

    .trust-strip__desc {
      font-size: 0.9375rem;
    }

    /* Hairline that draws across the top of a card on hover */
    .trust-strip__card::before {
      content: '';
      position: absolute;
      inset-inline: 0;
      top: -1px;
      height: 1px;
      background: var(--ts-text);
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 500ms var(--ease-out);
    }

    .trust-strip__item:first-child .trust-strip__card::before {
      inset-inline-start: 0;
    }
  }

  @media (hover: hover) and (pointer: fine) and (min-width: 750px) {
    .trust-strip__card:hover::before {
      transform: scaleX(1);
    }

    .trust-strip__card:hover .trust-strip__desc {
      color: var(--ts-text);
    }

    .trust-strip__card--link:hover .trust-strip__arrow {
      transform: translate(3px, -3px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trust-strip__live-dot {
      animation: none;
    }

    .trust-strip__card::before,
    .trust-strip__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust Strip",
  "tag": "section",
  "class": "section-trust-strip",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "dark", "label": "Inky Dark (Match Brand Marquee)" },
        { "value": "light", "label": "Art Paper Light" }
      ],
      "default": "dark"
    },
    {
      "type": "text",
      "id": "pillar_1_title",
      "label": "Pillar 1 Title",
      "default": "Cash on delivery"
    },
    {
      "type": "text",
      "id": "pillar_1_desc",
      "label": "Pillar 1 Description",
      "default": "Pay when it arrives"
    },
    {
      "type": "text",
      "id": "pillar_2_title",
      "label": "Pillar 2 Title",
      "default": "7-day exchange"
    },
    {
      "type": "text",
      "id": "pillar_2_desc",
      "label": "Pillar 2 Description",
      "default": "Size or fit, replaced"
    },
    {
      "type": "text",
      "id": "pillar_3_title",
      "label": "Pillar 3 Title",
      "default": "2–4 day delivery"
    },
    {
      "type": "text",
      "id": "pillar_3_desc",
      "label": "Pillar 3 Description",
      "default": "Across Pakistan"
    },
    {
      "type": "text",
      "id": "pillar_4_title",
      "label": "Pillar 4 Title",
      "default": "WhatsApp"
    },
    {
      "type": "text",
      "id": "pillar_4_desc",
      "label": "Pillar 4 Description",
      "default": "Order in a chat"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "WhatsApp Phone Number (e.g. 923131707080)",
      "default": "923131707080"
    }
  ],
  "presets": [
    {
      "name": "Trust Strip"
    }
  ]
}
{% endschema %}
