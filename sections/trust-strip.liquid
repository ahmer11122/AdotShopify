{% comment %}
  Editorial service ledger under the campaign film.
  Four facts, index numbers, one hairline. WhatsApp is the only link.
{% endcomment %}

<section class="trust-strip container" data-section-id="{{ section.id }}">
  <ul class="trust-strip__list" aria-label="Order guarantees">
    <li class="trust-strip__item">
      <div class="trust-strip__body">
        <span class="trust-strip__index" aria-hidden="true">01</span>
        <div class="trust-strip__copy">
          <p class="trust-strip__title">{{ section.settings.pillar_1_title | default: 'Cash on delivery' }}</p>
          <p class="trust-strip__desc">{{ section.settings.pillar_1_desc | default: 'Pay when it arrives' }}</p>
        </div>
      </div>
    </li>

    <li class="trust-strip__item">
      <div class="trust-strip__body">
        <span class="trust-strip__index" aria-hidden="true">02</span>
        <div class="trust-strip__copy">
          <p class="trust-strip__title">{{ section.settings.pillar_2_title | default: '7-day exchange' }}</p>
          <p class="trust-strip__desc">{{ section.settings.pillar_2_desc | default: 'Size or fit, replaced' }}</p>
        </div>
      </div>
    </li>

    <li class="trust-strip__item">
      <div class="trust-strip__body">
        <span class="trust-strip__index" aria-hidden="true">03</span>
        <div class="trust-strip__copy">
          <p class="trust-strip__title">{{ section.settings.pillar_3_title | default: '2–4 day delivery' }}</p>
          <p class="trust-strip__desc">{{ section.settings.pillar_3_desc | default: 'Across Pakistan' }}</p>
        </div>
      </div>
    </li>

    <li class="trust-strip__item">
      {% if section.settings.whatsapp_number != blank %}
        <a
          class="trust-strip__link"
          href="https://wa.me/{{ section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' }}?text={{ 'Hello ADOT, I would like to place an order.' | url_encode }}"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="trust-strip__index" aria-hidden="true">04</span>
          <span class="trust-strip__copy">
            <span class="trust-strip__title">{{ section.settings.pillar_4_title | default: 'WhatsApp' }}</span>
            <span class="trust-strip__desc">
              {{ section.settings.pillar_4_desc | default: 'Order in a chat' }}
              <span class="trust-strip__arrow" aria-hidden="true">→</span>
            </span>
          </span>
        </a>
      {% else %}
        <div class="trust-strip__body">
          <span class="trust-strip__index" aria-hidden="true">04</span>
          <div class="trust-strip__copy">
            <p class="trust-strip__title">{{ section.settings.pillar_4_title | default: 'WhatsApp' }}</p>
            <p class="trust-strip__desc">{{ section.settings.pillar_4_desc | default: 'Order in a chat' }}</p>
          </div>
        </div>
      {% endif %}
    </li>
  </ul>
</section>

{% stylesheet %}
  .section-trust-strip {
    position: relative;
    z-index: 1;
    background-color: var(--color-background, #FFFFFF);
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 749px) {
    .section-trust-strip {
      display: none;
    }
  }

  .trust-strip {
    padding-block: 0;
  }

  .trust-strip__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
  }

  .trust-strip__item {
    min-width: 0;
    border-top: 1px solid var(--color-border);
  }

  .trust-strip__item:first-child {
    border-top: 0;
  }

  .trust-strip__body,
  .trust-strip__link {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    column-gap: 0.75rem;
    align-items: start;
    padding-block: 1.125rem;
    color: inherit;
    text-decoration: none;
  }

  .trust-strip__link {
    min-height: 44px;
    opacity: 1;
  }

  .trust-strip__link:hover,
  .trust-strip__link:focus-visible {
    opacity: 1;
  }

  .trust-strip__link:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .trust-strip__index {
    padding-top: 0.2rem;
    font-family: var(--font-body);
    font-size: var(--font-size-micro);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.14em;
    line-height: 1.2;
    color: var(--color-text-subtle);
  }

  .trust-strip__copy {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .trust-strip__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    line-height: 1.2;
    color: var(--color-text);
  }

  .trust-strip__desc {
    margin: 0;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-text-muted);
  }

  .trust-strip__arrow {
    display: inline-block;
    margin-inline-start: 0.2rem;
    transition: transform 200ms var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .trust-strip__link:hover .trust-strip__title {
      text-decoration: underline;
      text-underline-offset: 0.18em;
    }

    .trust-strip__link:hover .trust-strip__arrow {
      transform: translateX(4px);
    }
  }

  @media (min-width: 750px) {
    .trust-strip__list {
      grid-template-columns: 1fr 1fr;
    }

    .trust-strip__item,
    .trust-strip__item:first-child {
      border-top: 0;
    }

    .trust-strip__item:nth-child(odd) {
      border-inline-end: 1px solid var(--color-border);
    }

    .trust-strip__item:nth-child(n + 3) {
      border-top: 1px solid var(--color-border);
    }

    .trust-strip__body,
    .trust-strip__link {
      height: 100%;
      padding: 1.5rem 1.5rem 1.5rem 0;
    }

    .trust-strip__item:nth-child(even) .trust-strip__body,
    .trust-strip__item:nth-child(even) .trust-strip__link {
      padding-inline-start: 1.5rem;
    }
  }

  @media (min-width: 990px) {
    .trust-strip__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .trust-strip__item,
    .trust-strip__item:nth-child(odd),
    .trust-strip__item:nth-child(n + 3) {
      border-top: 0;
      border-inline-end: 0;
      border-inline-start: 1px solid var(--color-border);
    }

    .trust-strip__item:first-child {
      border-inline-start: 0;
    }

    .trust-strip__body,
    .trust-strip__link,
    .trust-strip__item:nth-child(even) .trust-strip__body,
    .trust-strip__item:nth-child(even) .trust-strip__link {
      padding: 1.75rem 1.5rem;
    }

    .trust-strip__item:first-child .trust-strip__body,
    .trust-strip__item:first-child .trust-strip__link {
      padding-inline-start: 0;
    }

    .trust-strip__item:last-child .trust-strip__body,
    .trust-strip__item:last-child .trust-strip__link {
      padding-inline-end: 0;
    }

    .trust-strip__title {
      font-size: 1.125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .trust-strip__arrow {
      transition: none;
    }
  }
{% endstylesheet %}

