{% comment %}
  Cinematic Architectural Footer — ADOT Monolithic Editorial Foundation
  Features:
  - Fixed curtain reveal on desktop (≥990px) with dynamic height calculation & safe viewport fallback
  - Tier 1: Continuous brand philosophy marquee ticker with hairline framing
  - Tier 2: 4-Column balanced architectural grid (Newsletter / Collections / Support / Contact on WhatsApp)
            Optimized for mobile with 2-column compact layout (Collections & Support side-by-side)
  - Tier 3: Monolithic ADOT horizon wordmark nestled lower to ground the layout with perfect visual balance
  - Tier 4: Minimalist baseline bar without dividing border (Copyright 2025 & Tactile Back to Top)
  - Mobile-native optimizations: 16px inputs (no iOS zoom), 44px tap targets, safe-area insets
{% endcomment %}

<div class="footer-reveal" id="FooterReveal">
  {% # theme-check-disable ParserBlockingScript %}
  <script>
    (function (el) {
      var reduce = false;
      try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      var design = !!(window.Shopify && Shopify.designMode);
      if (reduce || design) el.setAttribute('data-static', '');
    })(document.currentScript.parentElement);
  </script>
  {% # theme-check-enable ParserBlockingScript %}

  <footer class="footer" data-section-id="{{ section.id }}" role="contentinfo">
    
    <!-- TIER 1: Marquee Brand Philosophy Ticker -->
    <div class="footer__marquee" aria-hidden="true">
      <div class="footer__marquee-track">
        {%- assign marquee = section.settings.marquee_text | default: 'Heavyweight essentials · Cash on delivery · Easy exchange · Made to last' -%}
        {%- assign marquee_parts = marquee | split: '·' -%}
        {%- for pass in (1..2) -%}
          <span class="footer__marquee-group">
            {%- for part in marquee_parts -%}
              <span class="footer__marquee-word">{{ part | strip }}</span>
              <span class="footer__dot"></span>
            {%- endfor -%}
          </span>
        {%- endfor -%}
      </div>
    </div>

    <!-- TIER 2: Main 4-Column Editorial Grid (Mobile: 2-Column Responsive) -->
    <div class="footer__body">
      
      <!-- Column 1: Newsletter -->
      <section class="footer__col footer__col--newsletter" aria-labelledby="FooterDispatchHeading-{{ section.id }}">
        <p class="footer__eyebrow text-micro">{{ section.settings.eyebrow | default: 'Newsletter' }}</p>
        <h2 id="FooterDispatchHeading-{{ section.id }}" class="footer__heading">
          {{ section.settings.heading | default: 'Stay updated.' }}
        </h2>
        <p class="footer__tagline">
          {{ section.settings.tagline | default: 'New drops and private releases.' }}
        </p>

        {% form 'customer', class: 'footer__form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="FooterEmail-{{ section.id }}">Email address</label>
          <div class="footer__input-group">
            <input
              type="email"
              name="contact[email]"
              id="FooterEmail-{{ section.id }}"
              class="footer__input"
              placeholder="{{ 'general.newsletter.placeholder' | t | default: 'Email address' }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="footer__submit" aria-label="Subscribe">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M1 7H13M13 7L7.5 1.5M13 7L7.5 12.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          {% if form.posted_successfully? %}
            <p class="footer__success text-micro" role="status">{{ 'general.newsletter.success' | t | default: 'Subscribed.' }}</p>
          {% endif %}
        {% endform %}
      </section>

      <!-- Column 2: Collections Navigation -->
      <nav class="footer__col footer__col--collections" aria-label="Collections">
        <p class="footer__col-label text-micro">Collections</p>
        <ul class="footer__links">
          <li><a href="{{ routes.all_products_collection_url }}?category=hoodies" class="footer__link">Hoodies</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?category=shirts" class="footer__link">Shirts</a></li>
          <li><a href="{{ routes.all_products_collection_url }}?category=trousers" class="footer__link">Trousers</a></li>
          <li><a href="{{ routes.all_products_collection_url }}" class="footer__link">All Essentials</a></li>
        </ul>
      </nav>

      <!-- Column 3: Support Navigation -->
      <nav class="footer__col footer__col--support" aria-label="Support">
        <p class="footer__col-label text-micro">Support</p>
        <ul class="footer__links">
          {% if section.settings.menu != blank and section.settings.menu.links.size > 0 %}
            {% for link in section.settings.menu.links %}
              <li><a href="{{ link.url }}" class="footer__link">{{ link.title }}</a></li>
            {% endfor %}
          {% else %}
            <li><a href="{{ routes.root_url }}pages/size-guide" class="footer__link">Size Guide</a></li>
            <li><a href="{{ routes.root_url }}pages/shipping" class="footer__link">Shipping</a></li>
            <li><a href="{{ routes.root_url }}pages/returns" class="footer__link">Exchanges</a></li>
            <li><a href="{{ routes.search_url }}" class="footer__link">Search</a></li>
          {% endif %}
        </ul>
      </nav>

      <!-- Column 4: Contact on WhatsApp (Clean & Minimal) -->
      <div class="footer__col footer__col--contact">
        <p class="footer__col-label text-micro">Contact</p>
        
        {%- assign wa_raw = section.settings.whatsapp_number | default: '923131707080' | replace: '+', '' | replace: ' ', '' | replace: '-', '' -%}
        {%- assign wa_mid = wa_raw | slice: 2, 3 -%}
        {%- assign wa_end = wa_raw | slice: 5, 7 -%}
        {%- if wa_raw.size == 12 -%}
          {%- assign wa_display = '+92 ' | append: wa_mid | append: ' ' | append: wa_end -%}
        {%- else -%}
          {%- assign wa_display = '+' | append: wa_raw -%}
        {%- endif -%}

        <ul class="footer__links">
          <li>
            <a
              href="https://wa.me/{{ wa_raw }}?text={{ 'Hello ADOT, I would like assistance with an order.' | url_encode }}"
              class="footer__whatsapp-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Contact us on WhatsApp at {{ wa_display }}"
            >
              <span class="footer__dot footer__dot--live" aria-hidden="true"></span>
              <span>Contact on WhatsApp</span>
            </a>
          </li>
          <li>
            <a
              href="https://wa.me/{{ wa_raw }}"
              class="footer__whatsapp-number-link"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="WhatsApp phone number {{ wa_display }}"
            >
              {{ wa_display }}
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- TIER 3: Monolithic ADOT Horizon Wordmark Tier (Nestled Lower for Balance) -->
    <div class="footer__horizon" aria-hidden="true">
      <div class="footer__horizon-meta">
        <span class="text-micro footer__horizon-badge">ARCHITECTURAL ESSENTIALS</span>
        <span class="text-micro footer__horizon-badge">SARGODHA</span>
      </div>
      <p class="footer__wordmark">{{ section.settings.wordmark_text | default: shop.name | default: 'ADOT' }}</p>
    </div>

    <!-- TIER 4: Baseline Utility Bar (No Separating Border Line) -->
    <div class="footer__bottom">
      <p class="footer__copyright text-micro">
        &copy; 2025 {{ shop.name }}. All rights reserved.
      </p>

      <button type="button" class="footer__top" data-footer-top aria-label="Scroll back to top">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
          <path d="M7 13V1M7 1L1.5 6.5M7 1L12.5 6.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="visually-hidden">Back to top</span>
      </button>
    </div>

  </footer>
</div>

{% stylesheet %}
  /* ==========================================================================
     Curtain Reveal Structural Physics
     ========================================================================== */
  #MainContent {
    position: relative;
    z-index: 2;
    background-color: var(--color-background);
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.35);
  }

  .footer-reveal {
    position: relative;
    width: 100%;
    background-color: var(--color-surface-dark);
    box-sizing: border-box;
  }

  .footer-reveal .footer {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: var(--space-md);
    background-color: var(--color-surface-dark);
    color: var(--color-text-inverse);
    padding: var(--space-md) var(--page-margin) max(var(--space-md), env(safe-area-inset-bottom));
    overflow: hidden;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }

  /* Desktop Viewport Cinematic Curtain Reveal */
  @media (min-width: 990px) and (min-height: 700px) {
    .footer-reveal:not([data-static]) {
      min-height: 100svh;
      clip-path: inset(0);
    }

    .footer-reveal:not([data-static]) .footer {
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      min-height: 100svh;
      z-index: 1;
    }
  }

  /* ==========================================================================
     Tier 1: Marquee Brand Philosophy Ticker
     ========================================================================== */
  .footer__marquee {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border-block: 1px solid var(--color-border-dark);
    padding-block: 0.875rem;
    margin-inline: calc(var(--page-margin) * -1);
    background: color-mix(in srgb, var(--color-white) 1.5%, transparent);
  }

  .footer__marquee-track {
    display: flex;
    width: max-content;
    animation: footer-marquee 36s linear infinite;
  }

  .footer__marquee-group {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-inline: var(--space-md);
  }

  .footer__marquee-word {
    font-family: var(--font-body);
    font-size: var(--font-size-micro);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    white-space: nowrap;
    color: color-mix(in srgb, var(--color-text-inverse) 65%, transparent);
  }

  .footer__dot {
    width: 4px;
    height: 4px;
    flex-shrink: 0;
    border-radius: 50%;
    background-color: var(--color-text-inverse);
    opacity: 0.35;
  }

  /* ==========================================================================
     Tier 2: 4-Column Balanced Architectural Grid (Mobile: 2-Column Responsive)
     ========================================================================== */
  .footer__body {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md) var(--space-sm);
    align-items: start;
    padding-top: var(--space-xs);
  }

  .footer__col--newsletter {
    grid-column: 1 / -1;
    max-width: 32rem;
  }

  .footer__col--contact {
    grid-column: 1 / -1;
  }

  @media (min-width: 990px) {
    .footer__body {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.9fr) minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: var(--space-md) var(--space-lg);
      align-items: start;
      padding-top: clamp(4rem, 10vh, 7.5rem);
    }

    .footer__col--newsletter,
    .footer__col--contact {
      grid-column: auto;
    }
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .footer__eyebrow {
    margin: 0 0 0.5rem;
    color: color-mix(in srgb, var(--color-text-inverse) 55%, transparent);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .footer__heading {
    margin: 0 0 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
    color: var(--color-text-inverse);
    text-wrap: balance;
  }

  .footer__tagline {
    margin: 0 0 1.25rem;
    max-width: 34ch;
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-text-inverse) 65%, transparent);
    text-wrap: pretty;
  }

  .footer__form {
    width: 100%;
    max-width: 25rem;
  }

  .footer__input-group {
    display: flex;
    border: 1px solid var(--color-border-dark);
    background-color: color-mix(in srgb, var(--color-white) 3%, transparent);
    transition: border-color 160ms var(--ease-out), background-color 160ms var(--ease-out);
  }

  .footer__input-group:focus-within {
    border-color: color-mix(in srgb, var(--color-text-inverse) 45%, transparent);
    background-color: color-mix(in srgb, var(--color-white) 6%, transparent);
  }

  .footer__input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    padding: 0 1rem;
    border: 0;
    background: transparent;
    color: var(--color-text-inverse);
    font-family: var(--font-body);
    font-size: 1rem; /* 16px minimum prevents iOS Safari auto-zoom */
    outline: none;
  }

  .footer__input::placeholder {
    color: color-mix(in srgb, var(--color-text-inverse) 40%, transparent);
  }

  .footer__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 48px;
    min-height: 48px;
    padding: 0 1rem;
    border: 0;
    border-radius: var(--radius-none);
    background-color: var(--color-white);
    color: var(--color-surface-dark);
    cursor: pointer;
    touch-action: manipulation;
    transition: transform 160ms var(--ease-out), background-color 160ms var(--ease-out);
  }

  .footer__submit svg {
    transition: transform 160ms var(--ease-out);
  }

  .footer__submit:active {
    transform: scale(0.96);
  }

  .footer__success {
    margin: 0.5rem 0 0;
    color: var(--color-text-inverse);
  }

  .footer__col-label {
    margin: 0 0 0.875rem;
    color: color-mix(in srgb, var(--color-text-inverse) 50%, transparent);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .footer__links {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 42px; /* Apple 44px friendly touch target */
    color: color-mix(in srgb, var(--color-text-inverse) 75%, transparent);
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    font-weight: 450;
    letter-spacing: 0.02em;
    text-decoration: none;
    touch-action: manipulation;
    transition: color 160ms var(--ease-out);
  }

  .footer__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 6px;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 200ms var(--ease-out);
  }

  /* Clean Minimalist WhatsApp Link */
  .footer__whatsapp-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 42px;
    color: var(--color-text-inverse);
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    font-weight: 450;
    letter-spacing: 0.02em;
    text-decoration: none;
    touch-action: manipulation;
    transition: color 160ms var(--ease-out);
  }

  .footer__whatsapp-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 6px;
    width: 100%;
    height: 1px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 200ms var(--ease-out);
  }

  .footer__whatsapp-number-link {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    color: color-mix(in srgb, var(--color-text-inverse) 60%, transparent);
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    letter-spacing: 0.02em;
    touch-action: manipulation;
    transition: color 160ms var(--ease-out);
  }

  .footer__dot--live {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    border-radius: 50%;
    background-color: #22c55e;
    opacity: 1;
    box-shadow: 0 0 6px rgba(34, 197, 94, 0.6);
  }

  /* ==========================================================================
     Tier 3: Monolithic ADOT Horizon Wordmark Tier (Nestled Lower for Balance)
     ========================================================================== */
  .footer__horizon {
    position: relative;
    z-index: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    margin-top: auto; /* Pushes ADOT down to ground the layout */
    padding-top: clamp(1.5rem, 4vh, 3rem);
    padding-bottom: 0;
    user-select: none;
  }

  @media (max-width: 989px) {
    .footer__horizon {
      margin-top: var(--space-lg);
      padding-top: 0;
    }
  }

  .footer__horizon-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 0.35rem;
    color: color-mix(in srgb, var(--color-text-inverse) 38%, transparent);
    font-size: clamp(0.625rem, 2.2vw, 0.75rem);
  }

  .footer__horizon-badge {
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .footer__wordmark {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3.75rem, 20vw, 15rem);
    font-weight: 700;
    line-height: 0.78; /* Tight baseline grounds the letters */
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-align: center;
    white-space: nowrap;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.035) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    pointer-events: none;
    transition: opacity 250ms var(--ease-out);
  }

  /* ==========================================================================
     Tier 4: Baseline Utility Bar (No Separating Border Line)
     ========================================================================== */
  .footer__bottom {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    padding-top: var(--space-xs);
    padding-bottom: 0;
    border-top: 0; /* Clean borderless flow beneath ADOT */
  }

  .footer__copyright {
    margin: 0;
    color: color-mix(in srgb, var(--color-text-inverse) 50%, transparent);
  }

  .footer__top {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-none);
    background: transparent;
    color: var(--color-text-inverse);
    cursor: pointer;
    touch-action: manipulation;
    transition:
      background-color 160ms var(--ease-out),
      color 160ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .footer__top svg {
    transition: transform 160ms var(--ease-out);
  }

  .footer__top:active {
    transform: scale(0.96);
  }

  /* ==========================================================================
     Hover & Interaction Physics (Fine Pointer Devices)
     ========================================================================== */
  @media (hover: hover) and (pointer: fine) {
    .footer__marquee:hover .footer__marquee-track {
      animation-play-state: paused;
    }

    .footer__submit:hover svg {
      transform: translateX(3px);
    }

    .footer__link:hover,
    .footer__whatsapp-link:hover,
    .footer__whatsapp-number-link:hover {
      color: var(--color-text-inverse);
    }

    .footer__link:hover::after,
    .footer__link:focus-visible::after,
    .footer__whatsapp-link:hover::after,
    .footer__whatsapp-link:focus-visible::after {
      transform: scaleX(1);
    }

    .footer__top:hover {
      background-color: var(--color-white);
      color: var(--color-surface-dark);
    }

    .footer__top:hover svg {
      transform: translateY(-3px);
    }
  }

  /* ==========================================================================
     Reduced Motion Fallbacks
     ========================================================================== */
  @media (prefers-reduced-motion: reduce) {
    .footer__marquee-track {
      animation: none;
      flex-wrap: wrap;
      width: auto;
      justify-content: center;
    }
  }

  @keyframes footer-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    // Back to top smooth scroll
    if (!window.__adotFooterTop) {
      window.__adotFooterTop = true;
      document.addEventListener('click', function (event) {
        var button = event.target.closest('[data-footer-top]');
        if (!button) return;
        var reduce = false;
        try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });
    }

    // Curtain reveal height synchronization to prevent short screen clipping
    function syncCurtainHeight() {
      var reveal = document.getElementById('FooterReveal');
      if (!reveal) return;
      var footer = reveal.querySelector('.footer');
      if (!footer) return;

      var reduce = false;
      try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      var isDesktop = window.innerWidth >= 990;
      var isTallEnough = window.innerHeight >= 700;

      if (isDesktop && isTallEnough && !reduce && !reveal.hasAttribute('data-static')) {
        reveal.style.height = footer.offsetHeight + 'px';
      } else {
        reveal.style.height = 'auto';
      }
    }

    window.addEventListener('resize', syncCurtainHeight);
    window.addEventListener('DOMContentLoaded', syncCurtainHeight);
    setTimeout(syncCurtainHeight, 200);
  })();
{% endjavascript %}

