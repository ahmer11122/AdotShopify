{% comment %}
  Editorial 404 Not Found Page
  - Simple, clean error message
  - Inline search bar
  - Direct shopping links
  - Product recommendations so customers don't leave
  - Removed JavaScript redirect hack
{% endcomment %}

<div class="error-page container">
  <div class="error-page__hero">
    <span class="error-page__code text-micro">ERROR 404</span>
    <h1 class="error-page__title">Page Not Found</h1>
    <p class="error-page__text">
      The page you are looking for does not exist or has been moved.
    </p>

    <!-- Search Bar -->
    <form action="{{ routes.search_url }}" method="get" role="search" class="error-page__search-form">
      <div class="error-page__search-wrap">
        <label for="ErrorPageSearchInput" class="visually-hidden">Search store</label>
        <svg class="error-page__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7.5"></circle>
          <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
        </svg>
        <input
          type="search"
          name="q"
          id="ErrorPageSearchInput"
          placeholder="Search our store..."
          class="error-page__search-input"
          autocomplete="off"
          aria-label="Search store products"
        >
        <button type="submit" class="error-page__search-submit">Search</button>
      </div>
    </form>

    <!-- Action Buttons -->
    <div class="error-page__actions">
      <a href="{{ routes.root_url }}" class="error-page__btn error-page__btn--primary">Back to Home</a>
      <a href="{{ routes.all_products_collection_url }}" class="error-page__btn error-page__btn--outline">Shop All Products</a>
    </div>
  </div>

  <!-- Recommended Products -->
  {% if collections.all.products.size > 0 %}
    <section class="error-page__discovery">
      <div class="error-page__discovery-header">
        <span class="text-micro">POPULAR PIECES</span>
        <h2 class="error-page__discovery-title">You Might Like</h2>
      </div>

      <div class="error-page__grid">
        {% for product in collections.all.products limit: 4 %}
          <div class="error-page__item">
            {% render 'product-card', product: product %}
          </div>
        {% endfor %}
      </div>
    </section>
  {% endif %}
</div>

{% stylesheet %}
  .error-page {
    padding-top: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .error-page__hero {
    max-width: 580px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-bottom: clamp(3rem, 6vw, 5rem);
    border-bottom: 1px solid var(--color-border);
  }

  .error-page__code {
    display: inline-block;
    color: var(--color-text-subtle);
    letter-spacing: 0.15em;
    margin-bottom: 0.75rem;
  }

  .error-page__title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    color: var(--color-text);
    margin: 0 0 1rem 0;
    text-wrap: balance;
  }

  .error-page__text {
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin: 0 0 2rem 0;
    max-width: 440px;
    text-wrap: pretty;
  }

  /* Search Form */
  .error-page__search-form {
    width: 100%;
    max-width: 420px;
    margin-bottom: 1.5rem;
  }

  .error-page__search-wrap {
    display: flex;
    align-items: stretch;
    height: 52px;
    border: 1px solid var(--color-border-strong, #111111);
    background: var(--color-background, #FFFFFF);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .error-page__search-wrap:focus-within {
    border-color: var(--color-text, #111111);
  }

  .error-page__search-icon {
    flex-shrink: 0;
    align-self: center;
    margin-left: 1.15rem;
    color: var(--color-text-muted);
  }

  .error-page__search-input {
    flex: 1 1 0%;
    min-width: 0;
    height: 100%;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    padding: 0 1rem;
    font-size: 16px;
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    background: transparent !important;
    color: var(--color-text, #111111);
    -webkit-appearance: none;
    appearance: none;
  }

  .error-page__search-input::-webkit-search-decoration,
  .error-page__search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
    display: none;
  }

  .error-page__search-submit {
    flex-shrink: 0;
    height: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-text, #111111);
    color: var(--color-white, #FFFFFF);
    border: none !important;
    border-radius: 0;
    padding: 0 1.5rem;
    margin: 0;
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    font-size: var(--font-size-micro, 11px);
    font-weight: 600;
    letter-spacing: var(--tracking-micro, 0.08em);
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  .error-page__search-submit:hover {
    background-color: #333333;
  }

  @media (max-width: 480px) {
    .error-page__search-wrap {
      height: 48px;
    }
    .error-page__search-icon {
      margin-left: 0.85rem;
    }
    .error-page__search-input {
      padding: 0 0.65rem;
    }
    .error-page__search-submit {
      padding: 0 1.15rem;
    }
  }

  /* Actions */
  .error-page__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    max-width: 360px;
  }

  @media (min-width: 480px) {
    .error-page__actions {
      flex-direction: row;
      max-width: none;
      justify-content: center;
    }
  }

  .error-page__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.75rem;
    font-size: var(--font-size-micro);
    font-weight: 600;
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-none);
    transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
    min-height: 44px;
    touch-action: manipulation;
  }

  .error-page__btn:active { transform: scale(0.98); }

  .error-page__btn--primary {
    background: var(--color-text);
    color: var(--color-white);
    border: 1px solid var(--color-text);
  }

  .error-page__btn--primary:hover { background: #333333; }

  .error-page__btn--outline {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border-strong);
  }

  .error-page__btn--outline:hover { border-color: var(--color-text); }

  /* Discovery */
  .error-page__discovery {
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .error-page__discovery-header {
    margin-bottom: var(--space-md);
  }

  .error-page__discovery-header .text-micro {
    color: var(--color-text-subtle);
  }

  .error-page__discovery-title {
    font-family: var(--font-display);
    font-size: var(--font-size-h2);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    margin: 0.25rem 0 0 0;
  }

  .error-page__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(16px, 2.5vw, 24px) clamp(12px, 2vw, 20px);
  }

  @media (min-width: 750px) {
    .error-page__grid { grid-template-columns: repeat(4, 1fr); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "settings": []
}
{% endschema %}
