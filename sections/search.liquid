{% comment %}
  Modern Editorial Search Page
  - Clean search bar with clear button
  - Popular search tags
  - 4-column product grid with product cards
  - Empty state with recommended items
{% endcomment %}

<div class="search-page container" data-search-page>
  <!-- Search Header -->
  <header class="search-page__header">
    <div class="search-page__header-inner">
      <span class="search-page__eyebrow text-micro">CATALOG & JOURNAL</span>
      <h1 class="search-page__title">Search</h1>

      <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
        <div class="search-page__input-bar">
          <label for="SearchPageInput" class="visually-hidden">Search products</label>
          <svg class="search-page__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7.5"></circle>
            <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
          </svg>
          <input
            type="search"
            name="q"
            id="SearchPageInput"
            value="{{ search.terms | escape }}"
            placeholder="Search for hoodies, shirts, trousers..."
            class="search-page__input"
            autocomplete="off"
            autocorrect="off"
            autocapitalize="none"
            aria-label="Search store products"
          >
          {% if search.terms != blank %}
            <a href="{{ routes.search_url }}" class="search-page__clear" aria-label="Clear search">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="1" y1="1" x2="13" y2="13"></line>
                <line x1="1" y1="13" x2="13" y2="1"></line>
              </svg>
            </a>
          {% endif %}
          <button type="submit" class="search-page__submit">Search</button>
        </div>
      </form>

      <!-- Popular Tags -->
      <div class="search-page__tags">
        <span class="text-micro search-page__tags-label">POPULAR:</span>
        <div class="search-page__tags-rail">
          <a href="{{ routes.search_url }}?q=Hoodie" class="search-page__tag-pill">Hoodie</a>
          <a href="{{ routes.search_url }}?q=Shirt" class="search-page__tag-pill">Shirt</a>
          <a href="{{ routes.search_url }}?q=Trouser" class="search-page__tag-pill">Trouser</a>
          <a href="{{ routes.search_url }}?q=Oversized" class="search-page__tag-pill">Oversized</a>
          <a href="{{ routes.search_url }}?q=Black" class="search-page__tag-pill">Black</a>
        </div>
      </div>
    </div>
  </header>

  {% if search.performed %}
    {% if search.results_count == 0 %}
      <!-- Empty Results State -->
      <div class="search-page__empty">
        <div class="search-page__empty-inner">
          <span class="search-page__empty-code text-micro">0 RESULTS</span>
          <h2 class="search-page__empty-title">No items found for “{{ search.terms }}”</h2>
          <p class="search-page__empty-text">Please check your spelling, or try searching for another product category.</p>
          <div class="search-page__empty-actions">
            <a href="{{ routes.all_products_collection_url }}" class="search-page__btn search-page__btn--primary">View All Products</a>
            <a href="{{ routes.all_products_collection_url }}?category=hoodies" class="search-page__btn search-page__btn--outline">Hoodies</a>
            <a href="{{ routes.all_products_collection_url }}?category=shirts" class="search-page__btn search-page__btn--outline">Shirts</a>
          </div>
        </div>

        <!-- Recommended Products -->
        {% if collections.all.products.size > 0 %}
          <div class="search-page__fallback">
            <div class="search-page__fallback-header">
              <span class="text-micro">POPULAR PIECES</span>
              <h3 class="search-page__fallback-title">Recommended for You</h3>
            </div>
            <div class="search-page__grid">
              {% for product in collections.all.products limit: 4 %}
                <div class="search-page__item">
                  {% render 'product-card', product: product %}
                </div>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </div>

    {% else %}
      <!-- Results Grid -->
      <div class="search-page__results">
        <div class="search-page__results-bar">
          <p class="search-page__count text-micro">
            SHOWING {{ search.results_count }} {{ search.results_count | pluralize: 'RESULT', 'RESULTS' }} FOR “{{ search.terms }}”
          </p>
        </div>

        {% paginate search.results by 24 %}
          <div class="search-page__grid">
            {% for result in search.results %}
              {% if result.object_type == 'product' %}
                <div class="search-page__item search-page__item--product">
                  {% render 'product-card', product: result %}
                </div>
              {% else %}
                <div class="search-page__item search-page__item--editorial">
                  <a href="{{ result.url }}" class="search-page__content-card">
                    {% assign result_image = result.featured_image | default: result.image %}
                    <div class="search-page__content-media">
                      {% if result_image %}
                        <img
                          src="{{ result_image | image_url: width: 600 }}"
                          alt="{{ result.title | escape }}"
                          width="600"
                          height="400"
                          loading="lazy"
                          class="search-page__content-img"
                        >
                      {% else %}
                        <div class="search-page__content-placeholder">
                          <span class="text-micro">{{ result.object_type | upcase }}</span>
                        </div>
                      {% endif %}
                      <span class="search-page__content-badge text-micro">{{ result.object_type | upcase }}</span>
                    </div>
                    <div class="search-page__content-info">
                      <h3 class="search-page__content-title">{{ result.title }}</h3>
                      {% if result.content != blank %}
                        <p class="search-page__content-excerpt">{{ result.content | strip_html | truncatewords: 16 }}</p>
                      {% endif %}
                      <span class="search-page__content-link text-micro">Read More →</span>
                    </div>
                  </a>
                </div>
              {% endif %}
            {% endfor %}
          </div>

          {% if paginate.pages > 1 %}
            <div class="search-page__pagination">
              {{ paginate | default_pagination }}
            </div>
          {% endif %}
        {% endpaginate %}
      </div>
    {% endif %}
  {% else %}
    <!-- Initial Landing State -->
    <div class="search-page__landing">
      <div class="search-page__landing-categories">
        <span class="text-micro search-page__landing-eyebrow">BROWSE CATEGORIES</span>
        <div class="search-page__category-grid">
          <a href="{{ routes.all_products_collection_url }}?category=hoodies" class="search-page__category-card">
            <span class="search-page__category-title">Hoodies</span>
            <span class="text-micro search-page__category-cta">Shop Now →</span>
          </a>
          <a href="{{ routes.all_products_collection_url }}?category=shirts" class="search-page__category-card">
            <span class="search-page__category-title">Shirts</span>
            <span class="text-micro search-page__category-cta">Shop Now →</span>
          </a>
          <a href="{{ routes.all_products_collection_url }}?category=trousers" class="search-page__category-card">
            <span class="search-page__category-title">Trousers</span>
            <span class="text-micro search-page__category-cta">Shop Now →</span>
          </a>
        </div>
      </div>
    </div>
  {% endif %}
</div>

{% stylesheet %}
  .search-page {
    padding-top: clamp(2rem, 4vw, 3.5rem);
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .search-page__header {
    margin-bottom: clamp(2.5rem, 4vw, 3.5rem);
    padding-bottom: clamp(1.75rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--color-border);
  }

  .search-page__header-inner {
    max-width: 680px;
  }

  .search-page__eyebrow {
    display: block;
    color: var(--color-text-subtle);
    margin-bottom: 0.75rem;
  }

  .search-page__title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin: 0 0 1.5rem 0;
  }

  /* Form */
  .search-page__form {
    width: 100%;
    margin-bottom: 1.25rem;
  }

  .search-page__input-bar {
    display: flex;
    align-items: stretch;
    height: 52px;
    border: 1px solid var(--color-border-strong, #111111);
    background: var(--color-background, #FFFFFF);
    position: relative;
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .search-page__input-bar:focus-within {
    border-color: var(--color-text, #111111);
  }

  .search-page__icon {
    flex-shrink: 0;
    align-self: center;
    margin-left: 1.25rem;
    color: var(--color-text-muted);
  }

  .search-page__input {
    flex: 1 1 0%;
    min-width: 0;
    height: 100%;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    padding: 0 1rem;
    font-size: 16px;
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    background: transparent !important;
    color: var(--color-text, #111111);
    -webkit-appearance: none;
    appearance: none;
  }

  .search-page__input::-webkit-search-decoration,
  .search-page__input::-webkit-search-cancel-button,
  .search-page__input::-webkit-search-results-button,
  .search-page__input::-webkit-search-results-decoration {
    -webkit-appearance: none;
    display: none;
  }

  .search-page__clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 100%;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .search-page__clear:hover {
    color: var(--color-text);
  }

  .search-page__submit {
    flex-shrink: 0;
    height: 100%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-text, #111111);
    color: var(--color-white, #FFFFFF);
    border: none !important;
    border-radius: 0;
    padding: 0 1.75rem;
    margin: 0;
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    font-size: var(--font-size-micro, 11px);
    font-weight: 600;
    letter-spacing: var(--tracking-micro, 0.08em);
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .search-page__submit:hover {
    background-color: #333333;
  }

  @media (max-width: 480px) {
    .search-page__input-bar {
      height: 48px;
    }
    .search-page__icon {
      margin-left: 0.85rem;
    }
    .search-page__input {
      padding: 0 0.65rem;
    }
    .search-page__submit {
      padding: 0 1.15rem;
    }
  }

  /* Tags */
  .search-page__tags {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }

  .search-page__tags-label {
    color: var(--color-text-subtle);
    margin-right: 0.25rem;
  }

  .search-page__tags-rail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .search-page__tag-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.75rem;
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--font-size-caption);
    text-decoration: none;
    border: 1px solid transparent;
    transition: border-color var(--transition-fast), background-color var(--transition-fast);
  }

  .search-page__tag-pill:hover {
    border-color: var(--color-border-strong);
    background: var(--color-background);
  }

  /* Results Bar */
  .search-page__results-bar {
    margin-bottom: var(--space-md);
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .search-page__count {
    color: var(--color-text-subtle);
    margin: 0;
  }

  /* Grid Layout (4-col desktop, 2-col mobile) */
  .search-page__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(16px, 2.5vw, 24px) clamp(12px, 2vw, 20px);
  }

  @media (min-width: 750px) {
    .search-page__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 990px) {
    .search-page__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 2.5rem 1.75rem;
    }
  }

  /* Editorial Content Cards */
  .search-page__content-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    transition: transform var(--transition-base), box-shadow var(--transition-base);
  }

  .search-page__content-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-subtle);
  }

  .search-page__content-card:active {
    transform: scale(0.98);
  }

  .search-page__content-media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #EAE6DF;
  }

  .search-page__content-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-slow);
  }

  .search-page__content-card:hover .search-page__content-img {
    transform: scale(1.04);
  }

  .search-page__content-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-subtle);
  }

  .search-page__content-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    background: var(--color-surface-dark);
    color: var(--color-white);
    padding: 0.25rem 0.5rem;
  }

  .search-page__content-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .search-page__content-title {
    font-family: var(--font-display);
    font-size: var(--font-size-h4);
    font-weight: 600;
    line-height: var(--leading-snug);
    margin: 0 0 0.5rem 0;
  }

  .search-page__content-excerpt {
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin: 0 0 1rem 0;
    flex: 1;
  }

  .search-page__content-link {
    color: var(--color-text);
    font-weight: 600;
    text-transform: uppercase;
    margin-top: auto;
  }

  /* Empty State */
  .search-page__empty {
    padding-top: var(--space-md);
  }

  .search-page__empty-inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
    padding: clamp(2rem, 5vw, 4rem) 0;
  }

  .search-page__empty-code {
    display: block;
    color: var(--color-text-subtle);
    margin-bottom: 0.5rem;
  }

  .search-page__empty-title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin: 0 0 1rem 0;
  }

  .search-page__empty-text {
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin: 0 0 2rem 0;
  }

  .search-page__empty-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .search-page__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.85rem 1.75rem;
    font-size: var(--font-size-micro);
    font-weight: 600;
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    text-decoration: none;
    border-radius: var(--radius-none);
    transition: background-color var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
    min-height: 44px;
    touch-action: manipulation;
  }

  .search-page__btn:active { transform: scale(0.98); }

  .search-page__btn--primary {
    background: var(--color-text);
    color: var(--color-white);
    border: 1px solid var(--color-text);
  }

  .search-page__btn--primary:hover { background: #333333; }

  .search-page__btn--outline {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border-strong);
  }

  .search-page__btn--outline:hover { border-color: var(--color-text); }

  /* Recommendations section */
  .search-page__fallback {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-top: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--color-border);
  }

  .search-page__fallback-header {
    margin-bottom: var(--space-md);
  }

  .search-page__fallback-header .text-micro {
    color: var(--color-text-subtle);
  }

  .search-page__fallback-title {
    font-family: var(--font-display);
    font-size: var(--font-size-h2);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    margin: 0.25rem 0 0 0;
  }

  /* Landing Category Cards */
  .search-page__landing-eyebrow {
    color: var(--color-text-subtle);
    display: block;
    margin-bottom: var(--space-sm);
  }

  .search-page__category-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  @media (min-width: 750px) {
    .search-page__category-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .search-page__category-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    min-height: 150px;
    text-decoration: none;
    color: var(--color-text);
    transition: transform var(--transition-base), border-color var(--transition-fast);
  }

  .search-page__category-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-strong);
  }

  .search-page__category-title {
    font-family: var(--font-display);
    font-size: var(--font-size-h3);
    font-weight: 500;
    line-height: var(--leading-snug);
  }

  .search-page__category-cta {
    color: var(--color-text-subtle);
    font-weight: 600;
  }

  .search-page__pagination {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding-top: var(--space-lg);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
