{% comment %}
  Clean Editorial Password Page
  - Store logo and coming soon message
  - Email notification signup form
  - Easy password toggle for store owner and invited guests
{% endcomment %}

<div class="password-screen">
  <div class="password-screen__container">
    <!-- Brand Header -->
    <header class="password-screen__brand">
      <a href="{{ routes.root_url }}" class="password-screen__logo-link">
        <img
          src="{{ 'logo.png' | asset_url }}"
          alt="{{ shop.name }}"
          width="70"
          height="75"
          loading="eager"
          class="password-screen__logo"
        >
      </a>
      <span class="password-screen__status-tag text-micro">COMING SOON</span>
    </header>

    <!-- Main Message -->
    <main class="password-screen__main">
      <h1 class="password-screen__heading">{{ 'password.title' | t | default: 'Opening Soon' }}</h1>
      <p class="password-screen__description">
        {{ shop.password_message | default: 'We are preparing our next drop of daily essentials. Enter your email to get early access.' }}
      </p>

      <!-- Email Signup -->
      {% form 'customer', class: 'password-screen__email-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter, coming-soon">
        <div class="password-screen__input-wrap">
          <label for="PasswordCustomerEmail" class="visually-hidden">Email address</label>
          <input
            type="email"
            name="contact[email]"
            id="PasswordCustomerEmail"
            placeholder="Enter your email for early access..."
            class="password-screen__input"
            autocomplete="email"
            required
          >
          <button type="submit" class="password-screen__btn password-screen__btn--submit">
            Notify Me
          </button>
        </div>

        {% if form.posted_successfully? %}
          <p class="password-screen__feedback password-screen__feedback--success text-micro" role="status">
            Thank you! You are on our list. We will email you when we open.
          </p>
        {% endif %}

        {% if form.errors %}
          <p class="password-screen__feedback password-screen__feedback--error text-micro" role="alert">
            {{ form.errors | default_errors }}
          </p>
        {% endif %}
      {% endform %}
    </main>

    <!-- Password Access -->
    <footer class="password-screen__footer">
      <details class="password-screen__details" id="PasswordAccessDetails">
        <summary class="password-screen__summary text-micro">
          <span>Enter Store with Password</span>
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M1 3.5L5 7.5L9 3.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>

        <div class="password-screen__drawer">
          {% form 'storefront_password', class: 'password-screen__login-form' %}
            <label for="StorefrontPasswordInput" class="visually-hidden">{{ 'password.password' | t | default: 'Password' }}</label>
            <div class="password-screen__input-wrap">
              <input
                type="password"
                name="password"
                id="StorefrontPasswordInput"
                class="password-screen__input"
                placeholder="Enter password..."
                autocomplete="current-password"
                required
              >
              <button type="submit" class="password-screen__btn password-screen__btn--enter">
                {{ 'password.enter' | t | default: 'Enter' }}
              </button>
            </div>

            {% if form.errors %}
              <p class="password-screen__feedback password-screen__feedback--error text-micro">
                Incorrect password. Please try again.
              </p>
            {% endif %}
          {% endform %}
        </div>
      </details>

      <div class="password-screen__copyright text-micro">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
      </div>
    </footer>
  </div>
</div>

{% stylesheet %}
  .password-screen {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4rem) 1.5rem;
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .password-screen__container {
    max-width: 500px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Brand Header */
  .password-screen__brand {
    margin-bottom: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .password-screen__logo-link {
    display: inline-block;
  }

  .password-screen__logo {
    height: 56px;
    width: auto;
    object-fit: contain;
  }

  .password-screen__status-tag {
    color: var(--color-text-subtle);
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.75rem;
    background: var(--color-surface);
  }

  /* Main */
  .password-screen__main {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    width: 100%;
  }

  .password-screen__heading {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin: 0 0 1rem 0;
    text-wrap: balance;
  }

  .password-screen__description {
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin: 0 auto 2rem auto;
    max-width: 420px;
    text-wrap: pretty;
  }

  /* Forms */
  .password-screen__email-form,
  .password-screen__login-form {
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }

  .password-screen__input-wrap {
    display: flex;
    border: 1px solid var(--color-border-strong);
    background: var(--color-background);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .password-screen__input-wrap:focus-within {
    border-color: var(--color-text);
  }

  .password-screen__input {
    flex: 1;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    padding: 0.95rem 1rem;
    font-size: 16px;
    background: transparent;
    color: var(--color-text);
    -webkit-appearance: none;
    appearance: none;
  }

  .password-screen__btn {
    flex-shrink: 0;
    padding: 0.95rem 1.75rem;
    background: var(--color-text);
    color: var(--color-white);
    border: none;
    font-family: var(--font-body);
    font-size: var(--font-size-micro);
    font-weight: 600;
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color var(--transition-fast);
    min-height: 48px;
  }

  .password-screen__btn:hover {
    background-color: #333333;
  }

  .password-screen__feedback {
    margin-top: 0.75rem;
    display: block;
  }

  .password-screen__feedback--success { color: var(--color-in-stock); }
  .password-screen__feedback--error { color: var(--color-sale); }

  /* Drawer */
  .password-screen__footer {
    width: 100%;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .password-screen__details {
    margin-bottom: var(--space-md);
  }

  .password-screen__summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
    list-style: none;
    user-select: none;
  }

  .password-screen__summary::-webkit-details-marker { display: none; }
  .password-screen__summary:hover { color: var(--color-text); }

  .password-screen__details[open] .password-screen__summary svg {
    transform: rotate(180deg);
  }

  .password-screen__drawer {
    margin-top: 1.25rem;
  }

  .password-screen__copyright {
    color: var(--color-text-subtle);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
