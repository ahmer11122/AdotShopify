{% comment %}
  Clean Editorial Password Page
  - Store logo and coming soon message
  - Email notification signup form
  - Easy password toggle for store owner and invited guests
{% endcomment %}

<div class="password-screen">
  <div class="password-screen__container">
    {%- liquid
      assign brand_name = settings.brand_name | default: 'ADOT Official' | strip
      if brand_name == blank
        assign brand_name = shop.name
      endif
      assign brand_blurb = settings.brand_description | default: 'Menswear essentials — heavyweight hoodies and fleece sweatshirts. Cash on delivery across Pakistan.'
      assign wa_raw = settings.whatsapp_number | default: '923131707080' | replace: '+', '' | replace: ' ', '' | replace: '-', ''
      assign wa_href = 'https://wa.me/' | append: wa_raw
    -%}

    <!-- Brand Header -->
    <header class="password-screen__brand">
      <a href="{{ routes.root_url }}" class="password-screen__logo-link">
        <img
          src="{{ 'logo.png' | asset_url }}"
          alt="{{ brand_name | escape }}"
          width="70"
          height="75"
          loading="eager"
          class="password-screen__logo"
        >
      </a>
      <span class="password-screen__status-tag text-micro">COMING SOON</span>
    </header>

    <!-- Main Message -->
    <main class="password-screen__main">
      <h1 class="password-screen__heading">{{ brand_name }}</h1>
      <p class="password-screen__description">
        {{ shop.password_message | default: brand_blurb }}
      </p>

      {%- if settings.social_instagram_url != blank or settings.social_facebook_url != blank or wa_raw != blank or settings.support_email != blank -%}
        <ul class="password-screen__links text-micro">
          {%- if settings.social_instagram_url != blank -%}
            <li>
              <a href="{{ settings.social_instagram_url }}" target="_blank" rel="noopener noreferrer">Instagram</a>
            </li>
          {%- endif -%}
          {%- if settings.social_facebook_url != blank -%}
            <li>
              <a href="{{ settings.social_facebook_url }}" target="_blank" rel="noopener noreferrer">Facebook</a>
            </li>
          {%- endif -%}
          {%- if wa_raw != blank -%}
            <li>
              <a href="{{ wa_href }}" target="_blank" rel="noopener noreferrer">WhatsApp</a>
            </li>
          {%- endif -%}
          {%- if settings.support_email != blank -%}
            <li>
              <a href="mailto:{{ settings.support_email | escape }}">{{ settings.support_email | escape }}</a>
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}

      <!-- Email Signup -->
      {% form 'customer', class: 'password-screen__email-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter, coming-soon">
        <div class="password-screen__input-wrap">
          <label for="PasswordCustomerEmail" class="visually-hidden">Email address</label>
          <input
            type="email"
            name="contact[email]"
            id="PasswordCustomerEmail"
            placeholder="Enter your email for early access..."
            class="password-screen__input"
            autocomplete="email"
            aria-label="Email address"
            required
          >
          <button type="submit" class="password-screen__btn password-screen__btn--submit">
            Notify Me
          </button>
        </div>

        {% if form.posted_successfully? %}
          <p class="password-screen__feedback password-screen__feedback--success text-micro" role="status">
            Thank you! You are on our list. We will email you when we open.
          </p>
        {% endif %}

        {% if form.errors %}
          <p class="password-screen__feedback password-screen__feedback--error text-micro" role="alert">
            {{ form.errors | default_errors }}
          </p>
        {% endif %}
      {% endform %}
    </main>

    <!-- Password Access -->
    <footer class="password-screen__footer">
      <details class="password-screen__details" id="PasswordAccessDetails">
        <summary class="password-screen__summary text-micro">
          <span>Enter Store with Password</span>
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none" aria-hidden="true">
            <path d="M1 3.5L5 7.5L9 3.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </summary>

        <div class="password-screen__drawer">
          {% form 'storefront_password', class: 'password-screen__login-form' %}
            <label for="StorefrontPasswordInput" class="visually-hidden">{{ 'password.password' | t | default: 'Password' }}</label>
            <div class="password-screen__input-wrap">
              <input
                type="password"
                name="password"
                id="StorefrontPasswordInput"
                class="password-screen__input"
                placeholder="Enter password..."
                autocomplete="current-password"
                aria-label="{{ 'password.password' | t | default: 'Password' }}"
                required
              >
              <button type="submit" class="password-screen__btn password-screen__btn--enter">
                {{ 'password.enter' | t | default: 'Enter' }}
              </button>
            </div>

            {% if form.errors %}
              <p class="password-screen__feedback password-screen__feedback--error text-micro">
                Incorrect password. Please try again.
              </p>
            {% endif %}
          {% endform %}
        </div>
      </details>

      <div class="password-screen__copyright text-micro">
        &copy; {{ 'now' | date: '%Y' }} {{ brand_name }}. All rights reserved.
      </div>
    </footer>
  </div>
</div>

{% stylesheet %}
  .visually-hidden {
    position: absolute !important;
    width: 1px !important;
    height: 1px !important;
    padding: 0 !important;
    margin: -1px !important;
    overflow: hidden !important;
    clip: rect(0, 0, 0, 0) !important;
    white-space: nowrap !important;
    border: 0 !important;
  }

  .password-screen {
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(2rem, 5vw, 4rem) 1.5rem;
    background-color: var(--color-background);
    color: var(--color-text);
  }

  .password-screen__container {
    max-width: 500px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Brand Header */
  .password-screen__brand {
    margin-bottom: clamp(2rem, 4vw, 3rem);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }

  .password-screen__logo-link {
    display: inline-block;
  }

  .password-screen__logo {
    height: 56px;
    width: auto;
    object-fit: contain;
  }

  .password-screen__status-tag {
    color: var(--color-text-subtle);
    border: 1px solid var(--color-border);
    padding: 0.35rem 0.75rem;
    background: var(--color-surface);
  }

  /* Main */
  .password-screen__main {
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
    width: 100%;
  }

  .password-screen__heading {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
    margin: 0 0 1rem 0;
    text-wrap: balance;
  }

  .password-screen__description {
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
    margin: 0 auto 1.25rem auto;
    max-width: 420px;
    text-wrap: pretty;
  }

  .password-screen__links {
    list-style: none;
    margin: 0 auto 2rem auto;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 1.25rem;
    max-width: 420px;
  }

  .password-screen__links a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Forms */
  .password-screen__email-form,
  .password-screen__login-form {
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }

  .password-screen__input-wrap {
    display: flex;
    align-items: stretch;
    height: 52px;
    border: 1px solid var(--color-border-strong, #111111);
    background: var(--color-background, #FFFFFF);
    overflow: hidden;
    transition: border-color var(--transition-fast);
  }

  .password-screen__input-wrap:focus-within {
    border-color: var(--color-text, #111111);
  }

  .password-screen__input {
    flex: 1 1 0%;
    min-width: 0;
    height: 100%;
    border: none !important;
    outline: none !important;
    box-shadow: none !important;
    padding: 0 1.25rem;
    font-size: 16px;
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    background: transparent !important;
    color: var(--color-text, #111111);
    -webkit-appearance: none;
    appearance: none;
  }

  .password-screen__input::placeholder {
    color: var(--color-text-subtle, #737373);
    opacity: 1;
  }

  .password-screen__btn {
    flex-shrink: 0;
    height: 100%;
    padding: 0 1.75rem;
    background: var(--color-text, #111111);
    color: var(--color-white, #FFFFFF);
    border: none !important;
    border-radius: 0;
    margin: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-body, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif);
    font-size: var(--font-size-micro, 11px);
    font-weight: 600;
    letter-spacing: var(--tracking-micro, 0.08em);
    text-transform: uppercase;
    white-space: nowrap;
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .password-screen__btn:hover {
    background-color: #333333;
  }

  @media (max-width: 480px) {
    .password-screen__input-wrap {
      height: 48px;
    }
    .password-screen__input {
      padding: 0 0.85rem;
    }
    .password-screen__btn {
      padding: 0 1.25rem;
    }
  }

  .password-screen__feedback {
    margin-top: 0.75rem;
    display: block;
  }

  .password-screen__feedback--success { color: var(--color-in-stock); }
  .password-screen__feedback--error { color: var(--color-sale); }

  /* Drawer */
  .password-screen__footer {
    width: 100%;
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .password-screen__details {
    margin-bottom: var(--space-md);
  }

  .password-screen__summary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    color: var(--color-text-muted);
    transition: color var(--transition-fast);
    list-style: none;
    user-select: none;
  }

  .password-screen__summary::-webkit-details-marker { display: none; }
  .password-screen__summary:hover { color: var(--color-text); }

  .password-screen__details[open] .password-screen__summary svg {
    transform: rotate(180deg);
  }

  .password-screen__drawer {
    margin-top: 1.25rem;
  }

  .password-screen__copyright {
    color: var(--color-text-subtle);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
