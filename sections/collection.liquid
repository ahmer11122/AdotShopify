{% comment %}
  Modern Editorial Collection Template
  Clean 4-column desktop / 2-column mobile grid using product-card primitive.
  Features instant category tabs for Hoodies, Shirts, and Trousers with synchronized state.
{% endcomment %}

<div class="collection container" data-collection-page>
  {% # theme-check-disable ParserBlockingScript %}
  <script>
    (function (el) {
      var reduce = false;
      try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
      var design = !!(window.Shopify && Shopify.designMode);
      if (reduce || design || !('IntersectionObserver' in window)) return;
      el.setAttribute('data-reveal', 'pending');
    })(document.currentScript.parentElement);
  </script>
  {% # theme-check-enable ParserBlockingScript %}
  <header class="collection__header">
    <div class="collection__header-main">
      <div class="collection__title-group">
        {%- if collection.handle == 'all' or collection.title == 'Products' -%}
          {%- assign collection_heading = section.settings.all_title | default: 'All Essentials' -%}
        {%- else -%}
          {%- assign collection_heading = collection.title | default: section.settings.all_title | default: 'All Essentials' -%}
        {%- endif -%}
        <h1 class="collection__title" data-collection-title data-base-title="{{ collection_heading | escape }}">
          {{ collection_heading }}
        </h1>
        <span class="collection__count" data-collection-count>{{ collection.all_products_count }} items</span>
      </div>



    </div>
  </header>

  <div class="collection__grid" id="CollectionProductGrid">
    {% paginate collection.products by 50 %}
      {% for product in collection.products %}
        {% if product.handle == 'gift-card' %}
          {% continue %}
        {% endif %}
        {% assign item_category = product.type | downcase %}
        <div class="collection__item" data-category="{{ item_category }}">
          {% render 'product-card', product: product %}
        </div>
      {% else %}
        <p class="collection__empty">{{ 'collections.no_matches' | t }}</p>
      {% endfor %}

      {% if paginate.pages > 1 %}
        <div class="collection__pagination">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
  {% # theme-check-disable ParserBlockingScript %}
  <script>
    (function (el) {
      if (!el || el.getAttribute('data-reveal') !== 'pending') return;
      try {
        var nodes = el.querySelectorAll('.collection__item');
        if (!nodes.length) {
          el.removeAttribute('data-reveal');
          return;
        }
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-in');
            io.unobserve(entry.target);
          });
        }, { threshold: 0, rootMargin: '0px 0px -28% 0px' });
        nodes.forEach(function (node) { io.observe(node); });
      } catch (e) {
        el.removeAttribute('data-reveal');
      }
    })(document.currentScript.parentElement);
  </script>
  {% # theme-check-enable ParserBlockingScript %}
</div>

<style>
  .collection {
    padding-top: clamp(1.25rem, 2.5vw, 2.25rem);
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .collection__header {
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .collection__header-main {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media (min-width: 750px) {
    .collection__header-main {
      flex-direction: row;
      align-items: baseline;
      justify-content: space-between;
      gap: 2rem;
    }
  }

  .collection__title-group {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .collection__intro {
    margin-top: 1rem;
    max-width: 42rem;
    color: var(--color-text-muted, #555);
    font-size: var(--font-size-body, 0.9375rem);
    line-height: var(--leading-normal, 1.5);
  }

  .collection__intro p {
    margin: 0 0 0.75rem;
  }

  .collection__intro p:last-child {
    margin-bottom: 0;
  }

  .collection__title {
    font-family: var(--font-display, inherit);
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0;
    color: var(--color-text, #111111);
  }

  .collection__count {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-subtle, #737373);
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }



  .collection__item:nth-child(2n + 1) { --reveal-delay: 0ms; }
  .collection__item:nth-child(2n) { --reveal-delay: 70ms; }

  @media (min-width: 750px) {
    .collection__item:nth-child(3n + 1) { --reveal-delay: 0ms; }
    .collection__item:nth-child(3n + 2) { --reveal-delay: 70ms; }
    .collection__item:nth-child(3n + 3) { --reveal-delay: 140ms; }
  }

  @media (min-width: 990px) {
    .collection__item:nth-child(4n + 1) { --reveal-delay: 0ms; }
    .collection__item:nth-child(4n + 2) { --reveal-delay: 60ms; }
    .collection__item:nth-child(4n + 3) { --reveal-delay: 120ms; }
    .collection__item:nth-child(4n + 4) { --reveal-delay: 180ms; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .collection[data-reveal="pending"] .collection__item:not(.is-in) {
      opacity: 0;
      transform: translateY(8px);
    }

    .collection[data-reveal="pending"] .collection__item.is-in {
      opacity: 1;
      transform: none;
      transition:
        opacity 520ms var(--ease-out),
        transform 520ms var(--ease-out);
      transition-delay: var(--reveal-delay, 0ms);
    }
  }

  .collection__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
  }

  @media (min-width: 750px) {
    .collection__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-md);
    }
  }

  @media (min-width: 990px) {
    .collection__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--grid-gap);
    }
  }

  .collection__empty {
    grid-column: 1 / -1;
    padding-block: var(--space-lg);
    text-align: center;
    color: var(--color-text-muted);
  }

  .collection__pagination {
    grid-column: 1 / -1;
    margin-top: var(--space-lg);
    display: flex;
    justify-content: center;
    gap: var(--space-xs);
  }

  .collection__pagination a,
  .collection__pagination span {
    padding: var(--space-xs) var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    color: var(--color-text);
  }

  .collection__pagination .current {
    font-weight: 600;
    border-bottom: 1px solid var(--color-text);
  }
</style>



{% schema %}
{
  "name": "t:general.collection",
  "settings": [
    {
      "type": "text",
      "id": "all_title",
      "label": "All products title",
      "default": "All Essentials",
      "info": "Used when the collection handle is “all” or the title is “Products”."
    }
  ]
}
{% endschema %}
