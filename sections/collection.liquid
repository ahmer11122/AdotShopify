{% comment %}
  Modern Editorial Collection Template
  Clean 4-column desktop / 2-column mobile grid using product-card primitive.
{% endcomment %}

<div class="collection container">
  <header class="collection__header">
    <h1 class="collection__title">{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="collection__description caption">
        {{ collection.description }}
      </div>
    {% endif %}
  </header>

  <div class="collection__grid">
    {% paginate collection.products by 24 %}
      {% for product in collection.products %}
        <div class="collection__item">
          {% render 'product-card', product: product %}
        </div>
      {% else %}
        <p class="collection__empty">{{ 'collections.no_matches' | t }}</p>
      {% endfor %}

      {% if paginate.pages > 1 %}
        <div class="collection__pagination">
          {{ paginate | default_pagination }}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</div>

{% stylesheet %}
  .collection {
    padding-block: var(--space-lg);
  }

  .collection__header {
    margin-bottom: var(--space-md);
    text-align: left;
  }

  .collection__title {
    font-family: var(--font-display);
    font-size: var(--font-size-h1);
    font-weight: 400;
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-xs);
    color: var(--color-text);
  }

  .collection__description {
    max-width: 60ch;
    color: var(--color-text-muted);
  }

  .collection__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-sm);
  }

  @media (min-width: 750px) {
    .collection__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-md);
    }
  }

  @media (min-width: 990px) {
    .collection__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--grid-gap);
    }
  }

  .collection__empty {
    grid-column: 1 / -1;
    padding-block: var(--space-lg);
    text-align: center;
    color: var(--color-text-muted);
  }

  .collection__pagination {
    grid-column: 1 / -1;
    margin-top: var(--space-lg);
    display: flex;
    justify-content: center;
    gap: var(--space-xs);
  }

  .collection__pagination a,
  .collection__pagination span {
    padding: var(--space-xs) var(--space-sm);
    font-family: var(--font-body);
    font-size: var(--font-size-caption);
    color: var(--color-text);
  }

  .collection__pagination .current {
    font-weight: 600;
    border-bottom: 1px solid var(--color-text);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
