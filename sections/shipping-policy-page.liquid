{%- comment -%}
  Shipping & Exchanges — quiet editorial
{%- endcomment -%}
{%- capture wa_href -%}{% render 'adot-wa-link', message: 'Hello ADOT, I have a question about delivery.' %}{%- endcapture -%}
{%- assign support_email = settings.support_email | default: 'support@adotoffical.com' -%}
{%- assign mail_href = 'mailto:' | append: support_email -%}

{%- assign hero_headline = section.settings.headline | default: 'Delivery & *exchanges.*' -%}
{%- assign hero_intro = section.settings.intro | default: 'Order dispatch, Cash on Delivery and exchanges for ADOT Wear. Pakistan only.' -%}
{%- assign hero_meta = section.settings.last_updated | default: 'Last updated: October 2026' -%}
<div class="adot-page">
  <div class="adot-wrap">
    {% render 'adot-hero',
      label: 'Shipping & exchanges',
      headline: hero_headline,
      intro: hero_intro,
      meta: hero_meta
    %}

    <div class="adot-body">
      <div class="adot-main">
        <div class="adot-facts" data-reveal-group>
          {%- assign fact_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'fact' -%}
              <div class="adot-fact" data-reveal style="--i:{{ fact_i }}" {{ block.shopify_attributes }}>
                <span class="adot-fact__v"><span style="--i:{{ fact_i }}">{{ block.settings.value | escape }}</span></span>
                <span class="adot-fact__l">{{ block.settings.label | escape }}</span>
              </div>
              {%- assign fact_i = fact_i | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        <p class="adot-estimate" data-adot-eta hidden data-reveal>
          If you order today, expect arrival between <strong data-eta-range>—</strong>.
          <span class="adot-estimate__note">Estimate only. Remote areas, public holidays and weather can add time.</span>
        </p>

        <div class="adot-ledger" data-reveal-group>
          {%- assign sec_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'section' -%}
              {%- assign sec_i = sec_i | plus: 1 -%}
              {%- assign n = sec_i | prepend: '00' | slice: -2, 2 -%}
              <article class="adot-ledger__row" id="ship-{{ block.id }}" data-reveal {{ block.shopify_attributes }}>
                <span class="adot-ledger__n">{{ n }}</span>
                <h2 class="adot-ledger__title">{{ block.settings.title | escape }}</h2>
                <div class="adot-ledger__body rte">
                  {{ block.settings.body }}
                  {%- if block.settings.title == 'Contact us' -%}
                    <div class="adot-help__actions adot-ledger__actions">
                      {% render 'adot-btn', label: 'Chat on WhatsApp', href: wa_href, variant: 'primary', external: true %}
                      {% render 'adot-btn', label: 'Email us', href: mail_href, variant: 'ghost' %}
                    </div>
                  {%- endif -%}
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {% render 'adot-help-card', message: 'Hello ADOT, I have a question about delivery.' %}
  </div>
  {% render 'adot-mobile-help', message: 'Hello ADOT, I have a question about delivery.' %}
</div>

{% schema %}
{
  "name": "Shipping Policy Page",
  "settings": [
    {
      "type": "text",
      "id": "headline",
      "label": "Headline",
      "default": "Delivery & *exchanges.*"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Order dispatch, Cash on Delivery and exchanges for ADOT Wear. Pakistan only."
    },
    {
      "type": "text",
      "id": "last_updated",
      "label": "Last updated",
      "default": "Last updated: October 2026"
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "24h" },
        { "type": "text", "id": "label", "label": "Label", "default": "Order processing" }
      ]
    },
    {
      "type": "section",
      "name": "Section",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Where we deliver" },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body",
          "default": "<p>We deliver all over Pakistan. We do not ship outside Pakistan.</p>"
        }
      ]
    }
  ]
}
{% endschema %}
