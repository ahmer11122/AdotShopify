[
  {
    "name": "theme_info",
    "theme_name": "AdotShopify",
    "theme_version": "1.0.0",
    "theme_author": "ADOT STUDIO",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#111111",
        "label": "t:labels.foreground"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 0
      }
    ]
  },
  {
    "name": "Favicon / Branding",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Shown in browser tabs. Square PNG or ICO recommended."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo",
        "info": "Used for Organization schema and gift card template. Falls back to theme logo.png asset when empty."
      }
    ]
  },
  {
    "name": "Brand & Social",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Canonical brand name",
        "default": "ADOT Wear",
        "info": "Used in titles and Organization/WebSite schema. Also set the same string in Settings → Store details."
      },
      {
        "type": "text",
        "id": "brand_alternate_names",
        "label": "Alternate names (comma-separated)",
        "default": "AdotWear, ADOT Official, ADOT",
        "info": "Helps search/AI map aliases to this brand. Do not invent unrelated brands."
      },
      {
        "type": "textarea",
        "id": "brand_description",
        "label": "Brand one-liner",
        "default": "ADOT Wear menswear — shirts, hoodies, sweatshirts, and trousers with cash on delivery across Pakistan.",
        "info": "Plain factual sentence for meta fallback and Organization.description."
      },
      {
        "type": "text",
        "id": "social_instagram_url",
        "label": "Instagram URL",
        "info": "Full URL, e.g. https://www.instagram.com/adotofficial/"
      },
      {
        "type": "text",
        "id": "social_facebook_url",
        "label": "Facebook page URL"
      },
      {
        "type": "text",
        "id": "social_tiktok_url",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "social_youtube_url",
        "label": "YouTube URL"
      },
      {
        "type": "text",
        "id": "whatsapp_number",
        "label": "WhatsApp number",
        "default": "923706735800",
        "info": "Digits only with country code, no +. Used on FAQ, Contact, Size Guide, Shipping, policies, password page, and schema."
      },
      {
        "type": "text",
        "id": "support_email",
        "label": "Public support email",
        "default": "support@adotoffical.com",
        "info": "Central support address for footer pages and password page. Leave blank to hide on password."
      }
    ]
  }
]
