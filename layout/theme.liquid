<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#FFFFFF">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'logo.png' | asset_url }}">
    {%- endif -%}

    {% comment %}
      Web Fonts: Inter Tight (Display Headings) & Inter (Body/UI)
      Preconnect for optimal network latency and display=swap for Core Web Vitals
    {% endcomment %}
    {% # theme-check-disable RemoteAsset %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    {% # theme-check-enable RemoteAsset %}

    {% # Load design tokens first as the design system baseline %}
    {{ 'tokens.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Inlined Theme Editor CSS Variable Overrides (if customized by merchant) %}
    {% render 'css-variables' %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {% render 'threadline-assets', part: 'css' %}

    {%- liquid
      assign adot_pages_kit = false
      if template.name == 'page' or template.name == 'policy'
        assign adot_pages_kit = true
      endif
      if request.path contains '/policies/'
        assign adot_pages_kit = true
      endif
    -%}
    {%- if adot_pages_kit -%}
      {% # theme-check-disable ParserBlockingScript %}
      <script>document.documentElement.classList.add('js')</script>
      {% # theme-check-enable ParserBlockingScript %}
      {{ 'adot-pages.css' | asset_url | stylesheet_tag: preload: true }}
      <script src="{{ 'adot-pages.js' | asset_url }}" defer></script>
      <script src="{{ 'adot-pages-ui.js' | asset_url }}" defer></script>
    {%- endif -%}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {%- if request.page_type == 'search' -%}
      <meta name="robots" content="noindex, follow">
    {%- endif -%}

    {{ content_for_header }}
  </head>

  {%- liquid
    assign adot_is_policy = false
    if request.path contains '/policies/'
      assign adot_is_policy = true
    endif
  -%}
  <body class="template-{{ template.name | default: 'index' }}{% if adot_is_policy %} template-policy{% endif %}">
    <a class="skip-link" href="#MainContent">Skip to content</a>
    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {%- comment -%}
        Shopify ignores templates/policy.liquid and injects a bare
        shopify-policy__* shell into content_for_layout. Replace that shell
        with the Atelier Desk policy layout on every /policies/* URL.
      {%- endcomment -%}
      {%- if adot_is_policy -%}
        {% render 'adot-policy-layout' %}
      {%- else -%}
        {{ content_for_layout }}
      {%- endif -%}
    </main>

    {% sections 'footer-group' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'adot-ui.js' | asset_url }}" defer></script>
    <script src="{{ 'adot-header-drawer.js' | asset_url }}" defer></script>
    <script src="{{ 'adot-search-modal.js' | asset_url }}" defer></script>
    <script src="{{ 'adot-search-results.js' | asset_url }}" defer></script>
    <script src="{{ 'adot-cart-drawer.js' | asset_url }}" defer></script>
    <script src="{{ 'adot-cart-ops.js' | asset_url }}" defer></script>
    <script src="{{ 'adot-header-sticky.js' | asset_url }}" defer></script>
    {% render 'threadline-assets', part: 'js' %}
  </body>
</html>
